  "blocks": [
    {"id": "p41-b1", "type": "paragraph", "text": "Quản trị công ty năm 2025", "bbox": [64.56, 24.16, 253.05, 39.16]},
    {"id": "p41-b2", "type": "paragraph", "text": "Thành viên Ủy Ban Kiểm toán", "bbox": [86.52, 56.18, 271.85, 69.38]},
    {
      "id": "p41-b3",
      "type": "paragraph",
      "text": "Tại Đại hội đồng cổ đông thường niên năm 2025, đã thông qua việc chuyển đổi mô hình công ty từ\nBan Kiểm soát sang Ủy Ban kiểm toán và Hội đông quản trị đã thực hiện bổ nhiệm nhân sự phụ\ntrách g ồm 2 thành viên như sau",
      "bbox": [86.52, 90.86, 538.9, 129.38]
    },
    {"id": "p41-b4", "type": "paragraph", "text": "STT Thành viên Ủy Ban kiểm toán", "bbox": [80.4, 199.54, 277.12, 210.82]},
    {"id": "p41-b5", "type": "paragraph", "text": "Ông Đinh Thế Hiển", "bbox": [119.88, 233.38, 216.05, 244.66]},
    {"id": "p41-b6", "type": "paragraph", "text": "Ông Võ Xuân Vinh", "bbox": [119.88, 261.46, 212.89, 272.74]},
    {"id": "p41-b7", "type": "paragraph", "text": "Chủ tịch UBKT", "bbox": [121.2, 484.86, 196.93, 498.06]},
    {
      "id": "p41-b8",
      "type": "paragraph",
      "text": "Ông Võ Xuân Vinh là chuyên gia trong lĩnh vực kinh\ntế, tài chính và quản trị doanh nghiệp, hiện là Viện\ntrưởng Viện Nghiên cứu Kinh doanh và Giảng viên\nĐại học Kinh tế Thành phố Hồ Chí Minh. Ông có nhiều\nnăm kinh nghiệm nghiên cứu, giảng dạy và tham gia\ncác tổ chức học thuật, tài chính uy tín trong nước và\nquốc tế, đồng thời có đóng góp tích cực trong hoạt\nđộng nghiên cứu chính sách tài chính và phát triển\nkinh tế khu vực châu Á",
      "bbox": [75.84, 617.41, 326.07, 727.09]
    },
    {"id": "p41-b9", "type": "paragraph", "text": "Chức vụ", "bbox": [309.12, 199.54, 354.91, 210.82]},
    {"id": "p41-b10", "type": "paragraph", "text": "Chủ tịch\nUBKT", "bbox": [311.28, 226.66, 352.63, 251.5]},
    {"id": "p41-b11", "type": "paragraph", "text": "Thành viên", "bbox": [304.08, 261.46, 359.76, 272.74]},
    {
      "id": "p41-b12",
      "type": "paragraph",
      "text": "Ông Đinh Thế Hiển là một chuyên gia tài chính và\nkinh tế. Ông đã giữ nhiều vị trí quan trọng như Viện\ntrưởng Viện Nghiên cứu Tin học & Kinh tế ứng dụng,\nChủ tịch Ban Đại diện Quỹ Đầu tư Manulife, và nhiều\nvai trò lãnh đạo khác tại Eximbank, Đại học CNTT\nGia Định, và Học viện Tài Chính. Ông có nhiều đóng\ngóp lớn cho thị trường tài chính Việt Nam.",
      "bbox": [273.36, 361.46, 519.56, 457.34]
    },
    {"id": "p41-b13", "type": "paragraph", "text": "Trình độ", "bbox": [400.79, 192.82, 445.35, 204.1]},
    {"id": "p41-b14", "type": "paragraph", "text": "Tỷ lệ sở", "bbox": [489.95, 192.82, 533.16, 204.1]},
    {"id": "p41-b15", "type": "paragraph", "text": "chuyên môn", "bbox": [389.88, 206.38, 456.32, 217.66]},
    {"id": "p41-b16", "type": "paragraph", "text": "hữu", "bbox": [500.63, 206.38, 522.52, 217.66]},
    {"id": "p41-b17", "type": "paragraph", "text": "Cử nhân tài chính,", "bbox": [376.8, 226.66, 469.37, 237.94]},
