  "blocks": [
    {"id": "p56-b1", "type": "paragraph", "text": "Báo cáo thường niên 2024", "bbox": [49.49, 29.81, 146.07, 37.81]},
    {
      "id": "p56-b2",
      "type": "paragraph",
      "text": "CÔNG TY CỔ PHẦN CÔNG NGHỆ - VIỄN THÔNG ELCOM\nTòa nhà Elcom, phố Duy Tân, phường Dịch Vọng Hậu,\nquận Cầu Giấy, Hà Nội\nTHUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT (TIẾP)\n(Các thuyết minh này là bộ phận hợp thành và cần được đọc đồng thời với Báo cáo tài chính hợp nhất)",
      "bbox": [57.9, 68.82, 471.57, 129.61]
    },
    {"id": "p56-b3", "type": "heading", "text": "15. TÀI SẢN CỐ ĐỊNH VÔ HÌNH", "bbox": [57.9, 142.65, 233.74, 154.38]},
    {
      "id": "p56-b4",
      "type": "paragraph",
      "text": "NGUYÊN GIÁ\n01/01/2024\n- Mua trong năm\n- Tăng khác\n- Thanh lý, nhượng bán\n31/12/2024",
      "bbox": [96.31, 198.26, 217.44, 282.5]
    },
    {
      "id": "p56-b5",
      "type": "paragraph",
      "text": "HAO MÒN LŨY KẾ\n01/01/2024\n- Khấu hao trong năm\n- Thanh lý, nhượng bán\n31/12/2024",
      "bbox": [96.31, 289.44, 217.44, 359.48]
    },
    {"id": "p56-b6", "type": "paragraph", "text": "GIÁ TRỊ CÒN LẠI\n01/01/2024\n31/12/2024", "bbox": [96.31, 366.42, 188.04, 407.39]},
    {
      "id": "p56-b7",
      "type": "paragraph",
      "text": "- Nguyên giá tài sản cố định vô hình đã khấu hao hết nhưng vẫn còn sử dụng tại ngày\n31/12/2024 là 4.864.499.881 VND, tại ngày 01/01/2024 là 9.344.499.881 VND.",
      "bbox": [107.58, 422.4, 511.28, 447.03]
    },
    {"id": "p56-b8", "type": "heading", "text": "16. BẤT ĐỘNG SẢN ĐẦU TƯ", "bbox": [57.9, 460.22, 216.68, 471.95]},
    {"id": "p56-b9", "type": "paragraph", "text": "NGUYÊN GIÁ\n01/01/2024", "bbox": [96.31, 508.08, 164.17, 534.9]},
    {"id": "p56-b10", "type": "paragraph", "text": "31/12/2024", "bbox": [108.91, 542.39, 159.19, 552.82]},
    {"id": "p56-b11", "type": "paragraph", "text": "HAO MÒN LŨY KẾ\n01/01/2024", "bbox": [96.31, 565.91, 192.66, 591.58]},
    {"id": "p56-b12", "type": "paragraph", "text": "- Khấu hao trong năm", "bbox": [108.91, 599.04, 209.4, 610.41]},
    {"id": "p56-b13", "type": "paragraph", "text": "31/12/2024", "bbox": [108.91, 616.95, 159.19, 627.38]},
    {"id": "p56-b14", "type": "paragraph", "text": "GIÁ TRỊ CÒN LẠI\n01/01/2024", "bbox": [96.31, 640.48, 187.97, 666.15]},
    {"id": "p56-b15", "type": "paragraph", "text": "31/12/2024", "bbox": [108.91, 673.6, 159.19, 684.03]},
    {
      "id": "p56-b16",
      "type": "paragraph",
      "text": "- Giá trị còn lại của bất động sản đầu tư dùng để thế chấp, cầm cố, bảo đảm khoản vay tại ngày\n31/12/2024 là 3.129.237.304 VND (tại ngày 01/01/2024 là 3.129.237.304 VND)",
      "bbox": [93.89, 703.59, 511.3, 728.34]
    },
    {
      "id": "p56-b17",
      "type": "paragraph",
      "text": "Giá trị hợp lý của bất động sản đầu tư: Theo quy định tại Chuẩn mực kế toán Việt Nam số\n05 - Bất động sản đầu tư, giá trị hợp lý của bất động sản đầu tư tại ngày 31 tháng 12 năm 202 4\ncần được trình bày. Tuy nhiên, Công ty hiện chưa xác định được giá trị hợp lý này nên giá trị",
      "bbox": [93.89, 735.9, 511.46, 772.16]
    },
    {"id": "p56-b18", "type": "paragraph", "text": "Phần mềm\nmáy vi tính", "bbox": [270.43, 157.26, 325.25, 179.38]},
    {
