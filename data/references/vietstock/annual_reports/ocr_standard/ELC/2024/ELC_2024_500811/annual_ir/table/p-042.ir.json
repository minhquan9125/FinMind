    {"id": "p42-b6", "type": "paragraph", "text": "Năm 2023", "bbox": [465.53, 163.11, 512.82, 173.28]},
    {"id": "p42-b7", "type": "paragraph", "text": "số minh", "bbox": [268.69, 175.04, 315.88, 186.34]},
