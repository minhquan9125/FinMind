    {"id": "p42-b1", "type": "heading", "text": "CÔNG TY CỔ PHẦN CÔNG NGHỆ - VIỄN THÔNG ELCOM", "bbox": [61.65, 69.35, 333.93, 80.41]},
    {
      "id": "p42-b2",
      "type": "paragraph",
      "text": "BÁO CÁO LƯU CHUYỂN TIỀN TỆ HỢP NHẤT (TIẾP)\n(Theo phương pháp gián tiếp)\nCho năm tài chính kết thúc ngày 31/12/2024",
      "bbox": [151.43, 111.27, 423.71, 147.39]
    },
    {
      "id": "p42-b3",
      "type": "paragraph",
      "text": "MẪU SỐ B03-DN/HN\nBan hành theo Thông tư số 202/2014/TT-\nBTC ngày 22/12/2014 của Bộ Tài chính",
      "bbox": [348.97, 69.35, 516.14, 103.12]
    },
    {"id": "p42-b4", "type": "paragraph", "text": "Mã Thuyết", "bbox": [264.76, 161.98, 318.05, 173.28]},
