  "blocks": [
    {"id": "p4-b1", "type": "heading", "text": "THÔNG ĐIỆP CHỦ TỊCH HĐQT", "bbox": [429.49, 76.22, 1234.32, 134.22]},
    {
      "id": "p4-b2",
      "type": "paragraph",
      "text": "FPT dồn lực đầu tư, nghiên cứu AI và đã đạt được những\nbước tiến quan trọng cả về hạ tầng và phát triển hệ sinh thái\nAI tiên tiến.",
      "bbox": [1283.37, 409.68, 1860.5, 481.08]
    },
    {
      "id": "p4-b3",
      "type": "paragraph",
      "text": "Kính thưa Quý Cổ đông, Khách hàng, Đối tác và toàn thể Cán bộ nhân viên FPT,",
      "bbox": [1165.61, 582.99, 1789.88, 600.99]
    },
    {
      "id": "p4-b4",
      "type": "paragraph",
      "text": "Chúng ta đang sống trong thời đại công nghệ biến đổi nhanh như chớp mắt, nơi những\nđột phá vĩ đại của công nghệ đang tái định hình thế giới. Ngay ngày đầu năm mới, khi\nDeepSeek với mô hình AI giá rẻ tạo ra cơn địa chấn trên quy mô toàn cầu, tôi nhận thấy\ncơ hội lớn chưa từng có cho Việt Nam. Chúng ta đang đi sau nhưng có cơ hội để khẳng\nđịnh vị thế tiên phong, khai phá những đỉnh cao mới.",
      "bbox": [1165.61, 621.17, 1860.63, 735.14]
    },
    {"id": "p4-b5", "type": "paragraph", "text": "Đứng trong tâm điểm của dòng chảy công nghệ", "bbox": [1165.61, 755.32, 1564.85, 773.32]},
    {
      "id": "p4-b6",
      "type": "paragraph",
      "text": "Tại Đại hội Đồng cổ đông 2024, chúng tôi công bố chiến lược AI - Bán - Xe - Số - Xanh\n(Trí tuệ nhân tạo, Bán dẫn, Công nghệ ô tô số, Chuyển đổi số và Chuyển đổi xanh), trong\nđó, AI là trụ cột chiến lược quan trọng nhất.",
      "bbox": [1165.61, 793.5, 1860.64, 859.49]
    },
    {"id": "p4-b7", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN 2024", "bbox": [42.0, 125.96, 333.44, 146.96]},
