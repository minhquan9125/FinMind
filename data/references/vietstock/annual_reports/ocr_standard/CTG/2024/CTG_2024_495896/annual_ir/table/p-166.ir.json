    {
      "id": "p166-b28",
      "type": "paragraph",
      "text": "Ngân hàng Thương mại Cổ phần Công thương Việt Nam\n6 - THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT (Tiếp theo)",
      "bbox": [666.14, 35.62, 881.67, 54.14]
    },
    {"id": "p166-b29", "type": "paragraph", "text": "Phân tích dư nợ cho vay theo ngành", "bbox": [666.14, 76.63, 833.44, 86.63]},
    {"id": "p166-b30", "type": "paragraph", "text": "Nông nghiệp, lâm nghiệp và thủy sản", "bbox": [668.98, 139.5, 807.11, 147.5]},
    {"id": "p166-b31", "type": "paragraph", "text": "Khai khoáng", "bbox": [668.98, 159.63, 715.12, 167.63]},
    {"id": "p166-b32", "type": "paragraph", "text": "Sản xuất và gia công chế biến", "bbox": [668.98, 179.77, 782.82, 187.77]},
    {"id": "p166-b33", "type": "paragraph", "text": "Sản xuất và phân phối điện, khí đốt và nước", "bbox": [668.98, 199.9, 832.63, 207.9]},
    {"id": "p166-b34", "type": "paragraph", "text": "Xây dựng", "bbox": [668.98, 220.04, 704.31, 228.04]},
    {
      "id": "p166-b35",
      "type": "paragraph",
      "text": "Bán buôn và bán lẻ; sửa chữa ô tô, mô tô, xe máy và xe có động cơ khác",
      "bbox": [668.98, 240.18, 940.24, 248.18]
    },
    {"id": "p166-b36", "type": "paragraph", "text": "Vận tải kho bãi và thông tin liên lạc", "bbox": [668.98, 260.31, 799.39, 268.31]},
    {"id": "p166-b37", "type": "paragraph", "text": "Thương mại, dịch vụ", "bbox": [668.98, 280.45, 743.14, 288.45]},
    {
      "id": "p166-b38",
      "type": "paragraph",
      "text": "Hoạt động làm thuê các công việc trong các hộ gia đình, sản xuất sản\nphẩm vật chất và dịch vụ tự tiêu dùng của hộ gia đình",
      "bbox": [668.98, 300.58, 932.48, 317.38]
    },
    {"id": "p166-b39", "type": "paragraph", "text": "Ngành khác", "bbox": [668.98, 329.52, 714.0, 337.52]},
