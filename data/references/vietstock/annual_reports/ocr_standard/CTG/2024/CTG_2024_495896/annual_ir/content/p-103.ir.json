    {
      "id": "p103-b11",
      "type": "paragraph",
      "text": "Phê duyệt văn bản sửa đổi,\nbổ sung hợp đồng kết nối\nsố 01/VietinBank-VTBC giữa\nVietinBank và VTBC ngày",
      "bbox": [404.47, 174.73, 508.07, 209.13]
    },
    {"id": "p103-b12", "type": "paragraph", "text": "Nghị quyết số 023/", "bbox": [314.07, 205.53, 384.95, 213.53]},
    {"id": "p103-b13", "type": "paragraph", "text": "12/9/2022 về việc cung cấp", "bbox": [404.47, 209.93, 507.36, 217.93]},
    {"id": "p103-b14", "type": "paragraph", "text": "NQ-HĐQT-NHCT-\n31/01/2024", "bbox": [251.14, 214.33, 381.72, 226.73]},
    {"id": "p103-b15", "type": "paragraph", "text": "dịch vụ hỗ trợ mở tài khoản", "bbox": [404.47, 218.73, 506.0, 226.73]},
    {"id": "p103-b16", "type": "paragraph", "text": "VPHĐQT1 ngày", "bbox": [314.07, 223.13, 369.69, 231.13]},
    {"id": "p103-b17", "type": "paragraph", "text": "giao dịch chứng chỉ quỹ tại", "bbox": [404.47, 227.53, 505.2, 235.53]},
    {"id": "p103-b18", "type": "paragraph", "text": "31/01/2024", "bbox": [314.07, 231.93, 354.68, 239.93]},
    {
      "id": "p103-b19",
      "type": "paragraph",
      "text": "VietinBank Capital.\nVăn bản sửa đổi bổ sung hợp\nđồng nên không có giá trị giao\ndịch cụ thể.",
      "bbox": [404.47, 236.33, 519.19, 270.73]
    },
    {
      "id": "p103-b20",
      "type": "paragraph",
      "text": "Thông qua hợp đồng hạn\nmức giao dịch ngoại tệ giữa\nNghị quyết số 045/ VietinBank và VietinBank Lào.\nNQ-HĐQT-NHCT- Các giao dịch trên liên ngân\n11/03/2024\nVPHĐQT1 ngày",
      "bbox": [251.13, 291.66, 512.64, 334.86]
    },
    {"id": "p103-b21", "type": "paragraph", "text": "hàng phát sinh liên tục theo", "bbox": [404.46, 326.86, 508.28, 334.86]},
    {"id": "p103-b22", "type": "paragraph", "text": "07/03/2024", "bbox": [314.06, 335.66, 358.22, 343.66]},
    {
      "id": "p103-b23",
      "type": "paragraph",
      "text": "nhu cầu của 2 bên. Không cung\ncấp số lượng và giá trị giao\ndịch do bảo mật thông tin.",
      "bbox": [404.46, 335.66, 521.56, 361.26]
    },
    {"id": "p103-b24", "type": "paragraph", "text": "1. Nội dung: Thông qua hợp\nđồng cấp bảo lãnh, hợp đồng", "bbox": [404.45, 382.2, 516.92, 399.0]},
    {"id": "p103-b25", "type": "paragraph", "text": "- 2 hợp đồng", "bbox": [251.12, 395.1, 300.38, 403.1]},
    {"id": "p103-b26", "type": "paragraph", "text": "thế chấp tài sản, hợp đồng", "bbox": [404.45, 399.8, 505.97, 407.8]},
