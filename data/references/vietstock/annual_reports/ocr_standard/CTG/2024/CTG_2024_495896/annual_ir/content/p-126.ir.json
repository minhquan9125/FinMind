  "blocks": [
    {"id": "p126-b1", "type": "heading", "text": "3 - HOẠT ĐỘNG KINH DOANH HƯỚNG ĐẾN MÔI TRƯỜNG VÀ XÃ HỘI", "bbox": [70.87, 46.14, 319.33, 54.14]},
    {"id": "p126-b2", "type": "heading", "text": "GIÁ TRỊ KINH TẾ TRỰC TIẾP ĐƯỢC TẠO RA VÀ ĐƯỢC PHÂN BỔ", "bbox": [71.37, 100.63, 353.08, 110.63]},
    {
      "id": "p126-b3",
      "type": "paragraph",
      "text": "Năm 2024 là một năm đầy thách thức với nền kinh tế toàn cầu nói chung và kinh tế Việt Nam nói\nriêng. Vững bước phát triển trong bối cảnh đầy khó khăn, VietinBank luôn gắn kết HĐKD với sẻ chia\ngiá trị lâu dài và bền vững với các bên liên quan, bao gồm: Cổ đông và NĐT, khách hàng, CBNV, Nhà\nnước và cộng đồng xã hội. Năm 2024, với nỗ lực vượt qua mọi khó khăn, VietinBank đã hoàn thành\nxuất sắc kế hoạch kinh doanh được NHNN và ĐHĐCĐ giao. Ngân hàng tiếp tục phát huy thế mạnh,\nđẩy mạnh chuyển đổi số toàn diện, gia tăng tiện ích, trải nghiệm và bảo mật cho khách hàng, khẳng\nđịnh năng lực của NHTM hàng đầu trên thị trường tài chính Việt Nam.",
      "bbox": [71.37, 124.4, 524.98, 206.4]
    },
    {"id": "p126-b4", "type": "paragraph", "text": "Giá trị kinh tế trực tiếp được tạo ra", "bbox": [82.81, 239.37, 403.43, 259.37]},
    {"id": "p126-b5", "type": "paragraph", "text": "31.764\ntỷ đồng\nLNTT HỢP NHẤT\n↑ 27,1%\nso với năm 2023", "bbox": [326.63, 301.06, 402.41, 375.34]},
    {"id": "p126-b6", "type": "paragraph", "text": "81.910\ntỷ đồng", "bbox": [409.16, 406.91, 460.92, 436.35]},
    {"id": "p126-b7", "type": "paragraph", "text": "TỔNG THU NHẬP\nHOẠT ĐỘNG", "bbox": [409.16, 446.25, 489.6, 470.25]},
