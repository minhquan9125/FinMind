    {"id": "p151-b1", "type": "heading", "text": "PHẦN 7 BÁO CÁO TÀI CHÍNH HỢP NHẤT ĐÃ ĐƯỢC KIỂM TOÁN", "bbox": [75.89, 23.46, 304.23, 31.46]},
    {"id": "p151-b2", "type": "paragraph", "text": "Cho năm tài chính kết thúc ngày 31 tháng 12 năm 2024", "bbox": [172.96, 76.39, 422.32, 86.39]},
    {"id": "p151-b3", "type": "paragraph", "text": "01. Thu nhập lãi và các khoản thu nhập tương tự nhận được", "bbox": [73.7, 173.35, 311.78, 181.42]},
    {"id": "p151-b4", "type": "paragraph", "text": "Chênh lệch số tiền thực thu/thực chi từ hoạt động", "bbox": [102.04, 242.95, 288.1, 250.95]},
    {"id": "p151-b5", "type": "paragraph", "text": "06. Tiền thu các khoản nợ đã được xử lý xoá, bù đắp bằng nguồn rủi ro", "bbox": [73.7, 297.53, 352.39, 305.59]},
    {"id": "p151-b6", "type": "paragraph", "text": "07. Tiền chi trả cho nhân viên và hoạt động quản lý, công vụ", "bbox": [73.7, 321.34, 312.14, 329.4]},
    {"id": "p151-b7", "type": "paragraph", "text": "08. Tiền thuế thu nhập doanh nghiệp thực nộp trong năm", "bbox": [73.7, 345.15, 302.25, 353.21]},
    {
      "id": "p151-b8",
      "type": "paragraph",
      "text": "Lưu chuyển tiền thuần từ hoạt động kinh doanh trước những thay đổi về",
      "bbox": [102.04, 367.31, 369.04, 375.31]
    },
    {"id": "p151-b9", "type": "paragraph", "text": "09. Thay đổi các khoản tiền gửi và cho vay các TCTD khác", "bbox": [73.7, 421.71, 306.15, 429.77]},
    {
      "id": "p151-b10",
      "type": "paragraph",
      "text": "11. Thay đổi các công cụ tài chính phái sinh và các tài sản tài chính khác",
      "bbox": [73.7, 469.32, 360.35, 477.39]
    },
    {"id": "p151-b11", "type": "paragraph", "text": "13. Thay đổi nguồn dự phòng để xử lý rủi ro, xử lý, bù đắp tổn thất", "bbox": [73.7, 516.94, 331.89, 525.0]},
    {"id": "p151-b12", "type": "paragraph", "text": "16. Thay đổi các khoản tiền gửi, tiền vay các TCTD khác", "bbox": [73.7, 612.17, 296.52, 620.23]},
    {
      "id": "p151-b13",
      "type": "paragraph",
      "text": "Thay đổi phát hành giấy tờ có giá (ngoại trừ giấy tờ có giá phát hành",
      "bbox": [102.04, 657.95, 361.11, 665.95]
    },
    {"id": "p151-b14", "type": "paragraph", "text": "19. Thay đổi vốn tài trợ, ủy thác đầu tư, cho vay mà TCTD chịu rủi ro", "bbox": [73.7, 688.73, 339.77, 696.79]},
