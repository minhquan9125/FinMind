  "blocks": [
    {"id": "p179-b1", "type": "heading", "text": "PHẦN 7 BÁO CÁO TÀI CHÍNH HỢP NHẤT ĐÃ ĐƯỢC KIỂM TOÁN", "bbox": [75.89, 23.46, 304.23, 31.46]},
    {"id": "p179-b2", "type": "paragraph", "text": "6 - THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT (Tiếp theo)", "bbox": [70.87, 46.14, 286.4, 54.14]},
    {
      "id": "p179-b3",
      "type": "paragraph",
      "text": "Bộ phận theo lĩnh vực kinh doanh là một bộ phận có thể phân biệt được của Ngân hàng tham gia\nvào việc cung cấp các sản phẩm dịch vụ mà bộ phận này có rủi ro và lợi ích kinh tế khác nhau với",
      "bbox": [70.87, 100.4, 524.48, 122.4]
    },
    {
      "id": "p179-b4",
      "type": "paragraph",
      "text": "Bộ phận theo khu vực địa lý là một bộ phận có thể phân biệt được của Ngân hàng tham gia vào\nviệc cung cấp các sản phẩm dịch vụ mà bộ phận này có rủi ro và lợi ích kinh tế khác với bộ phận kinh",
      "bbox": [70.87, 148.4, 524.41, 170.4]
    },
    {
      "id": "p179-b5",
      "type": "paragraph",
      "text": "Báo cáo bộ phận chính yếu của Ngân hàng là chia theo khu vực kinh doanh, báo cáo bộ phận thứ",
      "bbox": [70.87, 196.4, 524.42, 206.4]
    },
    {
      "id": "p179-b6",
      "type": "paragraph",
      "text": "Ngân hàng Thương mại Cổ phần Công thương Việt Nam\n6 - THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT (Tiếp theo)",
      "bbox": [666.14, 35.62, 881.67, 54.14]
    },
    {"id": "p179-b7", "type": "paragraph", "text": "Báo cáo bộ phận theo lĩnh vực kinh doanh", "bbox": [666.14, 76.63, 861.78, 86.63]},
    {"id": "p179-b8", "type": "heading", "text": "STT CHỈ TIÊU", "bbox": [668.98, 125.81, 728.46, 133.81]},
    {"id": "p179-b9", "type": "paragraph", "text": "I.\nDoanh thu", "bbox": [669.01, 171.17, 736.36, 179.17]},
    {"id": "p179-b10", "type": "paragraph", "text": "1. Doanh thu lãi", "bbox": [669.02, 194.51, 746.98, 202.58]},
    {"id": "p179-b11", "type": "paragraph", "text": "- Doanh thu lãi từ khách hàng bên\nngoài", "bbox": [697.38, 216.34, 823.8, 233.14]},
    {"id": "p179-b12", "type": "paragraph", "text": "- Doanh thu lãi từ nội bộ", "bbox": [697.4, 246.98, 786.95, 254.98]},
    {"id": "p179-b13", "type": "paragraph", "text": "2. Doanh thu từ hoạt động dịch vụ", "bbox": [669.07, 270.5, 816.44, 278.57]},
    {"id": "p179-b14", "type": "paragraph", "text": "Doanh thu từ hoạt động kinh doanh\n3.\nkhác", "bbox": [669.09, 292.34, 830.82, 309.14]},
    {"id": "p179-b15", "type": "paragraph", "text": "II. Chi phí", "bbox": [669.1, 323.15, 723.45, 331.15]},
    {"id": "p179-b16", "type": "paragraph", "text": "1. Chi phí lãi", "bbox": [669.12, 346.5, 733.62, 354.56]},
    {"id": "p179-b17", "type": "paragraph", "text": "- Chi phí lãi khách hàng bên ngoài", "bbox": [697.48, 370.02, 824.3, 378.02]},
    {"id": "p179-b18", "type": "paragraph", "text": "- Chi phí lãi nội bộ", "bbox": [697.5, 393.55, 764.26, 401.55]},
    {"id": "p179-b19", "type": "paragraph", "text": "2. Chi phí khấu hao tài sản cố định", "bbox": [669.17, 417.08, 816.92, 425.14]},
    {"id": "p179-b20", "type": "paragraph", "text": "Chi phí liên quan trực tiếp đến hoạt\n3.\nđộng kinh doanh", "bbox": [669.18, 438.91, 828.85, 455.71]},
    {"id": "p179-b21", "type": "paragraph", "text": "Kết quả kinh doanh trước chi phí dự phòng\nrủi ro", "bbox": [669.2, 468.03, 827.58, 484.83]},
    {"id": "p179-b22", "type": "paragraph", "text": "Chi phí dự phòng rủi ro", "bbox": [669.22, 498.66, 753.88, 506.66]},
    {"id": "p179-b23", "type": "paragraph", "text": "Kết quả kinh doanh bộ phận trước thuế", "bbox": [669.23, 522.19, 815.47, 530.19]},
    {"id": "p179-b24", "type": "paragraph", "text": "Chi phí thuế TNDN", "bbox": [669.25, 545.54, 736.98, 553.54]},
    {"id": "p179-b25", "type": "paragraph", "text": "Chi phí thuế TNDN hoãn lại", "bbox": [669.26, 569.06, 768.77, 577.06]},
    {"id": "p179-b26", "type": "paragraph", "text": "Kết quả kinh doanh bộ phận sau thuế", "bbox": [669.28, 592.78, 809.18, 600.78]},
