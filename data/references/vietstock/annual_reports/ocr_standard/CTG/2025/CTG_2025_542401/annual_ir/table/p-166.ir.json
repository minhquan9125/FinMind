    {
      "id": "p166-b58",
      "type": "paragraph",
      "text": "Số thuế TNDN hiện hành trên lợi nhuận kế toán hợp nhất trước thuế của Ngân hàng khác với số thuế\nkhi (cid:22)ược tính theo thuế suất phổ thông áp dụng 20% như sau:",
      "bbox": [666.14, 124.41, 1119.65, 146.41]
    },
    {"id": "p166-b59", "type": "paragraph", "text": "Lợi nhuận kế toán hợp nhất trước thuế TNDN", "bbox": [668.98, 219.82, 834.38, 227.82]},
    {"id": "p166-b60", "type": "paragraph", "text": "Các khoản mục ‚iều chỉnh:", "bbox": [668.98, 239.77, 769.41, 247.77]},
    {"id": "p166-b61", "type": "paragraph", "text": "- Thu nhập từ cổ tức và lợi nhuận ‚ược chia không chịu thuế", "bbox": [668.98, 259.9, 892.96, 267.9]},
    {"id": "p166-b62", "type": "paragraph", "text": "- Lợi nhuận của công ty con", "bbox": [668.98, 280.04, 774.02, 288.04]},
    {"id": "p166-b63", "type": "paragraph", "text": "- Thu nhập từ lợi ích tăng lên tại các công ty liên doanh", "bbox": [668.98, 300.18, 875.62, 308.18]},
    {
      "id": "p166-b64",
      "type": "paragraph",
      "text": "- Biến ‚ộng dự phòng/‚ánh giá lại cho các khoản cho vay và trái phiểu\nkhi hợp nhất báo cáo tài chính",
      "bbox": [668.98, 320.31, 936.88, 337.11]
    },
    {"id": "p166-b65", "type": "paragraph", "text": "- Khác", "bbox": [668.98, 349.25, 694.12, 357.25]},
    {"id": "p166-b66", "type": "paragraph", "text": "Thu nhập chịu thuế TNDN hiện hành của Ngân hàng mẹ", "bbox": [668.98, 369.57, 874.38, 377.57]},
    {"id": "p166-b67", "type": "paragraph", "text": "Thuế suất thuế TNDN", "bbox": [668.98, 389.52, 747.62, 397.52]},
    {
      "id": "p166-b68",
      "type": "paragraph",
      "text": "Chi phí thuế TNDN hiện hành của Ngân hàng mẹ tính trên thu nhập chịu\nthuế ở trong nước",
      "bbox": [668.98, 409.66, 934.68, 426.46]
    },
    {
      "id": "p166-b69",
      "type": "paragraph",
      "text": "Chi phí thuế TNDN hiện hành của Ngân hàng mẹ tính trên thu nhập chịu\nthuế ở nước ngoài",
      "bbox": [668.98, 438.59, 934.68, 455.39]
    },
    {"id": "p166-b70", "type": "paragraph", "text": "Chi phí thuế TNDN hiện hành của công ty con", "bbox": [668.98, 467.53, 837.88, 475.53]},
    {"id": "p166-b71", "type": "paragraph", "text": "Chi phí thuế TNDN hiện hành tính trên thu nhập chịu thuế (*)", "bbox": [668.98, 487.85, 891.04, 495.85]},
    {"id": "p166-b72", "type": "paragraph", "text": "Thuế TNDN phải trả Èầu năm", "bbox": [668.98, 507.98, 776.64, 515.98]},
    {"id": "p166-b73", "type": "paragraph", "text": "Chi phí thuế TNDN hiện hành tính trên thu nhập chịu thuế", "bbox": [668.98, 527.94, 879.57, 535.94]},
    {"id": "p166-b74", "type": "paragraph", "text": "Điều chỉnh khác", "bbox": [668.98, 548.07, 727.76, 556.07]},
    {"id": "p166-b75", "type": "paragraph", "text": "Thuế TNDN ‚ã nộp trong năm", "bbox": [668.98, 568.21, 780.45, 576.21]},
    {"id": "p166-b76", "type": "paragraph", "text": "Thuế TNDN còn phải nộp cuối năm", "bbox": [668.98, 588.53, 796.68, 596.53]},
    {
      "id": "p166-b77",
      "type": "paragraph",
      "text": "(*) Chi phí thuế TNDN hiện hành cho năm tài chính ‚ược ước tính dựa vào thu nhập chịu thuế và có thể có những ‚iều chỉnh\ntùy thuộc vào sự kiểm tra của cơ quan thuế.",
      "bbox": [666.14, 607.57, 1119.6, 624.37]
    },
