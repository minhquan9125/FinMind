    {"id": "p156-b52", "type": "paragraph", "text": "8.1. Theo loại hình cho vay", "bbox": [666.14, 100.64, 787.1, 110.64]},
    {"id": "p156-b53", "type": "paragraph", "text": "Cho vay các tổ chức kinh tế, cá nhân trong nước", "bbox": [668.98, 169.85, 849.85, 177.85]},
    {"id": "p156-b54", "type": "paragraph", "text": "Cho vay chiết khấu công cụ chuyển nhượng và các giấy tờ có giá", "bbox": [668.98, 192.53, 913.42, 200.53]},
    {"id": "p156-b55", "type": "paragraph", "text": "Cho thuê tài chính", "bbox": [668.98, 215.21, 737.0, 223.21]},
    {"id": "p156-b56", "type": "paragraph", "text": "Các khoản trả thay khách hàng", "bbox": [668.98, 237.89, 787.63, 245.89]},
    {"id": "p156-b57", "type": "paragraph", "text": "Cho vay ‚ối với các tổ chức, cá nhân nước ngoài", "bbox": [668.98, 260.57, 850.96, 268.57]},
    {"id": "p156-b58", "type": "paragraph", "text": "Cho vay bằng vốn tài trợ, ủy thác ‚ầu tư", "bbox": [668.98, 283.25, 820.48, 291.25]},
    {
      "id": "p156-b59",
      "type": "paragraph",
      "text": "Cho vay trong nghiệp vụ phát hành thư tín dụng trả chậm có ‚iều khoản\ntrả ngay",
      "bbox": [668.98, 304.66, 939.12, 321.46]
    },
    {"id": "p156-b60", "type": "paragraph", "text": "8.2. Theo Èối tượng khách hàng", "bbox": [666.14, 376.63, 812.71, 386.63]},
    {"id": "p156-b61", "type": "paragraph", "text": "Công ty Nhà nước", "bbox": [668.98, 449.4, 736.72, 457.4]},
    {"id": "p156-b62", "type": "paragraph", "text": "Công ty TNHH MTV vốn Nhà nước 100%", "bbox": [668.98, 473.49, 813.47, 481.49]},
    {"id": "p156-b63", "type": "paragraph", "text": "Công ty TNHH MTV vốn Nhà nước trên 50%", "bbox": [668.98, 497.59, 826.94, 505.59]},
    {"id": "p156-b64", "type": "paragraph", "text": "Công ty TNHH khác", "bbox": [668.98, 521.68, 741.98, 529.68]},
    {"id": "p156-b65", "type": "paragraph", "text": "Công ty cổ phần vốn Nhà nước trên 50%", "bbox": [668.98, 545.78, 819.23, 553.78]},
    {"id": "p156-b66", "type": "paragraph", "text": "Công ty cổ phần khác", "bbox": [668.98, 569.88, 752.03, 577.88]},
    {"id": "p156-b67", "type": "paragraph", "text": "Công ty hợp danh", "bbox": [668.98, 593.97, 737.05, 601.97]},
    {"id": "p156-b68", "type": "paragraph", "text": "Doanh nghiệp tư nhân", "bbox": [668.98, 618.07, 752.2, 626.07]},
    {"id": "p156-b69", "type": "paragraph", "text": "Doanh nghiệp có vốn ‚ầu tư nước ngoài", "bbox": [668.98, 642.16, 819.59, 650.16]},
    {"id": "p156-b70", "type": "paragraph", "text": "Hợp tác xã và Liên hiệp Hợp tác xã", "bbox": [668.98, 666.26, 800.96, 674.26]},
    {"id": "p156-b71", "type": "paragraph", "text": "Hộ kinh doanh, cá nhân", "bbox": [668.98, 690.36, 756.79, 698.36]},
    {"id": "p156-b72", "type": "paragraph", "text": "Đơn vị hành chính sự nghiệp, Đảng, ‚oàn thể và hiệp hội", "bbox": [668.98, 714.45, 878.2, 722.45]},
