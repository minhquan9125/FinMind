    {"id": "p66-b1", "type": "heading", "text": "BẢNG CÂN ĐỐI KẾ TOÁN RIÊNG", "bbox": [192.68, 41.68, 406.04, 55.68]},
    {"id": "p66-b2", "type": "paragraph", "text": "Ngày 31 tháng 3 năm 2025", "bbox": [232.69, 57.59, 363.51, 67.59]},
    {"id": "p66-b3", "type": "paragraph", "text": "TM", "bbox": [297.25, 87.39, 312.35, 97.39]},
    {"id": "p66-b4", "type": "paragraph", "text": "Số cuối năm", "bbox": [356.58, 87.39, 416.67, 97.39]},
    {"id": "p66-b5", "type": "paragraph", "text": "Đơn vị tính: VND", "bbox": [470.19, 71.39, 533.81, 79.39]},
    {"id": "p66-b6", "type": "paragraph", "text": "Số đầu năm", "bbox": [469.82, 87.39, 527.23, 97.39]},
    {"id": "p66-b7", "type": "heading", "text": "NGUỒN VỐN", "bbox": [140.53, 87.94, 201.08, 97.94]},
    {"id": "p66-b8", "type": "heading", "text": "NỢ PHẢI TRẢ", "bbox": [124.93, 116.07, 176.43, 124.07]},
    {"id": "p66-b9", "type": "paragraph", "text": "Nợ ngắn hạn", "bbox": [122.67, 140.7, 171.54, 148.7]},
    {
      "id": "p66-b10",
      "type": "paragraph",
      "text": "Phải trả người bán ngắn hạn\nNgười mua trả tiền trước ngắn hạn\nThuế và các khoản phải nộp Nhà nước\nPhải trả người lao động\nChi phí phải trả ngắn hạn\nDoanh thu chưa thực hiện ngắn hạn\nPhải trả ngắn hạn khác\nVay ngắn hạn\nQuỹ khen thưởng, phúc lợi",
      "bbox": [122.36, 153.9, 271.42, 265.9]
    },
    {"id": "p66-b11", "type": "paragraph", "text": "Nợ dài hạn", "bbox": [122.68, 280.99, 164.32, 288.99]},
    {
      "id": "p66-b12",
      "type": "paragraph",
      "text": "Phải trả dài hạn khác\nVay dài hạn\nThuế thu nhập hoãn lại phải trả\nQuỹ phát triển khoa học và công nghệ",
      "bbox": [122.35, 297.43, 269.8, 344.43]
    },
    {"id": "p66-b13", "type": "heading", "text": "VỐN CHỦ SỞ HỮU", "bbox": [122.67, 364.44, 192.36, 372.44]},
    {"id": "p66-b14", "type": "paragraph", "text": "Vốn chủ sở hữu", "bbox": [122.67, 390.21, 182.74, 398.21]},
    {
      "id": "p66-b15",
      "type": "paragraph",
      "text": "Vốn cổ phần đã phát hành\nCổ phiếu phổ thông có quyền biểu quyết\nThặng dư vốn cổ phần\nCổ phiếu quỹ\nLợi nhuận sau thuế chưa phân phối\nLợi nhuận sau thuế chưa phân phối lũy kế\nđến cuối năm trước\nLợi nhuận sau thuế chưa phân phối năm nay",
      "bbox": [122.67, 403.42, 295.44, 502.42]
    },
