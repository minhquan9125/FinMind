    },
    {"id": "p117-b39", "type": "paragraph", "text": "16.619.167", "bbox": [424.27, 276.77, 474.32, 286.73]},
    {"id": "p117-b40", "type": "paragraph", "text": "và xử lý rác thải, nước thải", "bbox": [711.02, 286.25, 829.87, 296.21]},
    {"id": "p117-b41", "type": "paragraph", "text": "518.641.568", "bbox": [418.75, 296.24, 474.32, 306.2]},
    {
      "id": "p117-b42",
      "type": "paragraph",
      "text": "Xây dựng\nBán buôn và bán lẻ; sửa chữa mô tô,\nô tô, xe máy và xe có động cơ khác\nVận tải kho bãi\nDịch vụ lưu trú và ăn uống",
      "bbox": [711.02, 297.77, 876.02, 353.69]
    },
    {"id": "p117-b43", "type": "paragraph", "text": "31/12/2023", "bbox": [439.78, 344.21, 489.71, 354.17]},
    {"id": "p117-b44", "type": "paragraph", "text": "Thông tin và truyền thông", "bbox": [711.02, 355.25, 824.22, 365.21]},
