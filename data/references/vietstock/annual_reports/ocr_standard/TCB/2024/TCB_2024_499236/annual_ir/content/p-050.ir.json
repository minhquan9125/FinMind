    {"id": "p50-b1", "type": "heading", "text": "CƠ CẤU QUẢN TRỊ – ĐIỀU HÀNH", "bbox": [96.3, 67.03, 558.73, 100.03]},
    {"id": "p50-b2", "type": "paragraph", "text": "hoàn thiện, triển khai quy định pháp luật Việt Nam về tổ chức,", "bbox": [45.35, 191.92, 287.12, 200.92]},
    {"id": "p50-b3", "type": "paragraph", "text": "dụng các thực hành tốt nhất về quản trị doanh nghiệp trên thế", "bbox": [45.35, 235.12, 289.16, 244.12]},
    {"id": "p50-b4", "type": "paragraph", "text": "Quản trị công ty ASEAN, Bộ Nguyên tắc Quản trị công ty theo", "bbox": [45.35, 267.52, 287.13, 276.52]},
    {
      "id": "p50-b5",
      "type": "paragraph",
      "text": "đảm bảo quyền lợi của khách hàng, cán bộ nhân viên, cổ đông\nvà nhà đầu tư, từ đó đảm bảo sự phát triển và giá trị bền vững",
      "bbox": [45.35, 364.73, 291.78, 384.52]
    },
    {
      "id": "p50-b6",
      "type": "paragraph",
      "text": "Techcombank vinh dự\nđạt chứng nhận\nTop 50\n\" Doanh nghiệp tiên phong\nvà cam kết nâng cao\nquản trị công ty \"\n(VNCG50)",
      "bbox": [360.29, 245.54, 511.75, 348.34]
    },
    {"id": "p50-b7", "type": "paragraph", "text": "Mô hình Quản trị – Điều hành", "bbox": [629.29, 147.85, 776.43, 158.85]},
    {"id": "p50-b8", "type": "paragraph", "text": "Cơ cấu quản trị điều hành mục tiêu của Techcombank", "bbox": [629.29, 192.31, 847.43, 201.31]},
