    {"id": "p124-b1", "type": "paragraph", "text": "Ngân hàng TMCP Kỹ thương Việt Nam", "bbox": null},
    {
      "id": "p124-b2",
      "type": "paragraph",
      "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT (tiếp theo)\ntại ngày 31 tháng 12 năm 2024 và cho năm tài chính kết thúc cùng ngày",
      "bbox": null
    },
    {"id": "p124-b3", "type": "heading", "text": "18. TIỀN GỬI CỦA KHÁCH HÀNG", "bbox": null},
    {"id": "p124-b4", "type": "paragraph", "text": "18.1 Thuyết minh theo loại hình tiền gửi", "bbox": null},
    {"id": "p124-b5", "type": "paragraph", "text": "Tiền gửi không kỳ hạn\nTiền gửi không kỳ hạn bằng VND\nTiền gửi không kỳ hạn bằng ngoại tệ", "bbox": null},
    {"id": "p124-b6", "type": "paragraph", "text": "Tiền gửi có kỳ hạn\nTiền gửi có kỳ hạn bằng VND\nTiền gửi có kỳ hạn bằng ngoại tệ", "bbox": null},
    {"id": "p124-b7", "type": "paragraph", "text": "Tiền gửi ký quỹ\nTiền gửi ký quỹ bằng VND\nTiền gửi ký quỹ bằng ngoại tệ", "bbox": null},
    {"id": "p124-b8", "type": "paragraph", "text": "Lãi suất năm của các khoản tiền gửi tại thời điểm cuối năm như sau:", "bbox": null},
    {"id": "p124-b9", "type": "paragraph", "text": "Tiền gửi không kỳ hạn\nBằng VND\nBằng ngoại tệ", "bbox": null},
    {"id": "p124-b10", "type": "paragraph", "text": "Tiền gửi có kỳ hạn\nBằng VND\nBằng ngoại tệ", "bbox": null},
    {"id": "p124-b11", "type": "paragraph", "text": "18.2 Thuyết minh theo đối tượng khách hàng, loại hình doanh nghiệp", "bbox": null},
    {"id": "p124-b12", "type": "paragraph", "text": "Tiền gửi của các tổ chức kinh tế", "bbox": null},
    {
      "id": "p124-b13",
      "type": "paragraph",
      "text": "Công ty trách nhiệm hữu hạn Nhà nước\nCông ty trách nhiệm hữu hạn khác\nCông ty cổ phần có vốn cổ phần\ncủa Nhà nước\nCông ty cổ phần khác\nDoanh nghiệp tư nhân và công ty hợp danh\nDoanh nghiệp có vốn đầu tư nước ngoài\nHợp tác xã và liên hiệp hợp tác xã\nĐơn vị hành chính sự nghiệp, Đảng,\nđoàn thể và hiệp hội\nKhác",
      "bbox": null
    },
    {"id": "p124-b14", "type": "paragraph", "text": "Tiền gửi của cá nhân", "bbox": null},
