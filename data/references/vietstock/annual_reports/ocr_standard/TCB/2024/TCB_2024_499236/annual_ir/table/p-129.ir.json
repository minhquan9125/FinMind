    {"id": "p129-b18", "type": "paragraph", "text": "B05/TCTD-HN", "bbox": [451.96, 42.36, 516.75, 52.32]},
    {
      "id": "p129-b19",
      "type": "paragraph",
      "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT (tiếp theo)\ntại ngày 31 tháng 12 năm 2024 và cho năm tài chính kết thúc cùng ngày",
      "bbox": [687.41, 66.24, 1006.91, 87.74]
    },
    {"id": "p129-b20", "type": "heading", "text": "34. LÃI TRÊN CỔ PHIẾU", "bbox": [687.4, 112.73, 820.41, 122.69]},
    {
      "id": "p129-b21",
      "type": "paragraph",
      "text": "Lãi cơ bản trên cổ phiếu được tính bằng cách chia lợi nhuận hoặc lỗ sau thuế phân bổ cho",
      "bbox": [723.39, 135.27, 1131.12, 145.23]
    },
    {"id": "p129-b22", "type": "paragraph", "text": "2023", "bbox": [490.0, 135.38, 512.09, 145.34]},
    {
      "id": "p129-b23",
      "type": "paragraph",
      "text": "cổ đông sở hữu cổ phiếu phổ thông của Ngân hàng (sau khi đã điều chỉnh cho việc trích lập",
      "bbox": [723.39, 146.8, 1131.14, 156.76]
    },
    {"id": "p129-b24", "type": "paragraph", "text": "triệu đồng", "bbox": [467.68, 147.38, 512.05, 157.34]},
    {
      "id": "p129-b25",
      "type": "paragraph",
      "text": "quỹ khen thưởng, phúc lợi) cho số lượng bình quân gia quyền của số cổ phiếu phổ thông\nđang lưu hành trong năm.",
      "bbox": [723.39, 158.2, 1131.68, 179.69]
    },
    {"id": "p129-b26", "type": "paragraph", "text": "-", "bbox": [508.84, 177.86, 512.15, 187.82]},
    {
      "id": "p129-b27",
      "type": "paragraph",
      "text": "Lãi suy giảm trên cổ phiếu được tính bằng cách chia lợi nhuận hoặc lỗ sau thuế phân bổ cho",
      "bbox": [723.39, 192.77, 1131.27, 202.73]
    },
    {"id": "p129-b28", "type": "paragraph", "text": "679.579", "bbox": [476.08, 200.78, 512.18, 210.74]},
    {
      "id": "p129-b29",
      "type": "paragraph",
      "text": "cổ đông sở hữu cổ phiếu phổ thông của Ngân hàng (sau khi đã điều chỉnh cho cổ tức của cổ\nphiếu ưu đãi có quyền chuyển đổi) cho số lượng bình quân gia quyền của số cổ phiếu phổ",
      "bbox": [723.39, 204.3, 1131.67, 225.78]
    },
    {"id": "p129-b30", "type": "paragraph", "text": "3.529.151", "bbox": [467.68, 223.82, 512.07, 233.78]},
    {
      "id": "p129-b31",
      "type": "paragraph",
      "text": "thông đang lưu hành trong năm và số lượng bình quân gia quyền của cổ phiếu phổ thông sẽ\nđược phát hành trong trường hợp tất cả các cổ phiếu phổ thông tiềm năng có tác động suy\ngiảm đều được chuyển thành cổ phiếu phổ thông.",
      "bbox": [723.39, 227.22, 1131.29, 260.23]
    },
    {"id": "p129-b32", "type": "paragraph", "text": "(181.356)", "bbox": [469.24, 258.41, 512.02, 268.37]},
    {"id": "p129-b33", "type": "paragraph", "text": "Ngân hàng sử dụng các thông tin sau để tính lãi trên cổ phiếu:", "bbox": [723.39, 273.35, 999.28, 283.31]},
    {"id": "p129-b34", "type": "paragraph", "text": "(194)", "bbox": [488.8, 281.33, 512.14, 291.29]},
    {"id": "p129-b35", "type": "paragraph", "text": "(50.000)", "bbox": [474.88, 304.37, 512.14, 314.33]},
    {"id": "p129-b36", "type": "paragraph", "text": "Lợi nhuận thuần sau thuế phân bổ cho cổ đông", "bbox": [723.52, 319.25, 933.57, 329.21]},
    {"id": "p129-b37", "type": "paragraph", "text": "(56.112)", "bbox": [474.88, 325.85, 512.14, 335.81]},
    {
      "id": "p129-b38",
      "type": "paragraph",
      "text": "sở hữu cổ phiếu phổ thông (triệu đồng)\nĐiều chỉnh cho quỹ phúc lợi (triệu đồng)",
      "bbox": [723.52, 330.65, 900.62, 353.69]
    },
    {"id": "p129-b39", "type": "paragraph", "text": "3.921.068", "bbox": [467.68, 345.31, 512.07, 355.27]},
    {
      "id": "p129-b40",
      "type": "paragraph",
      "text": "Lợi nhuận thuần sau thuế phân bổ cho cổ đông\nsở hữu cổ phiếu phổ thông để tính lãi cơ bản\ntrên cổ phiếu (triệu đồng)",
      "bbox": [723.4, 361.25, 933.45, 394.13]
    },
    {
      "id": "p129-b41",
      "type": "paragraph",
      "text": "Lợi nhuận thuần sau thuế phân bổ cho cổ đông\nsở hữu cổ phiếu phổ thông sau khi đã điều\nchỉnh cho các yếu tố suy giảm (triệu đồng)\nBình quân gia quyền của số cổ phiếu phổ thông\nđể tính lãi cơ bản trên cổ phiếu (*)",
      "bbox": [723.4, 401.69, 935.22, 457.63]
    },
    {
      "id": "p129-b42",
      "type": "paragraph",
      "text": "Bình quân gia quyền của số cổ phiếu phổ\nthông đã điều chỉnh cho các yếu tố suy giảm",
      "bbox": [723.4, 467.73, 936.66, 489.21]
    },
    {"id": "p129-b43", "type": "paragraph", "text": "Lãi trên mỗi cổ phiếu (đồng)", "bbox": [723.4, 498.09, 857.91, 508.05]},
    {"id": "p129-b44", "type": "paragraph", "text": "Lãi cơ bản trên cổ phiếu (đồng) (**)", "bbox": [723.4, 518.71, 879.95, 528.67]},
    {
      "id": "p129-b45",
      "type": "paragraph",
      "text": "(*) Việc điều chỉnh lại tính đến ảnh hưởng của việc phát hành cổ phiếu để trả cổ tức theo\nNghị Quyết Đại hội đồng Cổ đông thường niên ngày 20 tháng 4 năm 2024 phê duyệt\nphương án tăng vốn điều lệ từ 35.225.108.110.000 đồng lên 70.450.216.220.000 đồng\nthông qua phát hành cổ phiếu từ nguồn vốn chủ sở hữu.",
      "bbox": [722.68, 541.75, 1131.32, 586.28]
    },
    {
      "id": "p129-b46",
      "type": "paragraph",
      "text": "(**) Tại ngày 31 tháng 12 năm 2024, lãi cơ bản trên cổ phiếu của Ngân hàng không bị ảnh\nhưởng bởi các yếu tố suy giảm.",
      "bbox": [723.4, 596.95, 1122.09, 618.43]
    },
    {"id": "p129-b47", "type": "heading", "text": "35. TIỀN VÀ CÁC KHOẢN TƯƠNG ĐƯƠNG TIỀN", "bbox": [687.4, 643.46, 934.77, 653.42]},
    {
