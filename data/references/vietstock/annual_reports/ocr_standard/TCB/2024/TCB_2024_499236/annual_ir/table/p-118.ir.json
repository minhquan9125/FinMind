      "id": "p118-b125",
      "type": "paragraph",
      "text": "Hợp tác xã và liên hiệp hợp tác xã\nĐơn vị hành chính sự nghiệp, Đảng,\nđoàn thể, hiệp hội và loại hình khác",
      "bbox": [115.22, 285.41, 276.17, 318.41]
    },
    {"id": "p118-b126", "type": "paragraph", "text": "Cho vay cá nhân", "bbox": [115.22, 324.92, 194.47, 334.88]},
    {"id": "p118-b127", "type": "paragraph", "text": "Các khoản cho vay giao dịch ký quỹ\nvà ứng trước cho khách hàng", "bbox": [115.22, 353.45, 274.67, 374.93]},
    {"id": "p118-b128", "type": "paragraph", "text": "Dự phòng chung\nDự phòng cụ thể", "bbox": [116.3, 495.91, 190.69, 518.47]},
    {"id": "p118-b129", "type": "paragraph", "text": "ứng trước cho khách hàng", "bbox": [116.3, 533.47, 234.43, 543.43]},
    {"id": "p118-b130", "type": "paragraph", "text": "năm 2024 như sau:", "bbox": [115.22, 587.96, 201.83, 597.92]},
    {
      "id": "p118-b131",
