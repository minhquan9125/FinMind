  "blocks": [
    {
      "id": "p129-b1",
      "type": "paragraph",
      "text": "Trong bối cảnh kinh tế vĩ mô còn nhiều trị, từ đó tiếp tục kiến tạo giá trị bền vững\nthách thức, Techcombank chủ động nhận cho khách hàng, cổ đông và nền kinh tế\ndiện các cơ hội tăng trưởng, đồng thời linh nói chung, qua đó khẳng định vị thế là một\nhoạt ứng phó với biến động của thị trường. trong những ngân hàng thương mại cổ\nNgân hàng kiên định với các ưu tiên chiến phần tư nhân hàng đầu tại Việt Nam.\nlược, củng cố nền tảng tài chính và quản",
      "bbox": [214.02, 160.1, 544.27, 221.09]
    },
    {
      "id": "p129-b2",
      "type": "paragraph",
      "text": "Techcombank ghi nhận tăng trưởng thu nhập hoạt động mạnh mẽ, phản ánh cơ cấu nguồn\nthu đa dạng, cùng với đó là tính kỷ luật trong quản trị bảng cân đối và năng lực duy trì lợi\nnhuận qua các chu kỳ kinh tế.",
      "bbox": [214.02, 259.84, 544.26, 289.33]
    },
    {"id": "p129-b3", "type": "paragraph", "text": "2023\n2024", "bbox": [407.26, 306.27, 481.89, 313.77]},
    {"id": "p129-b4", "type": "paragraph", "text": "Tổng thu nhập hoạt động (tỷ đồng)", "bbox": [216.85, 330.3, 331.96, 337.8]},
    {"id": "p129-b5", "type": "paragraph", "text": "40.061\n46.990", "bbox": [403.18, 330.3, 481.89, 337.8]},
    {
      "id": "p129-b6",
      "type": "paragraph",
      "text": "Tổng tài sản tăng trưởng ổn định, được hỗ trợ bởi tăng trưởng bảng cân đối thận trọng,\nquản lý thanh khoản bền vững và khả năng mở rộng tệp khách hàng ở cả phân khúc bán\nlẻ và doanh nghiệp.",
      "bbox": [214.02, 366.14, 544.29, 395.63]
    },
    {"id": "p129-b7", "type": "paragraph", "text": "2023\n2024", "bbox": [407.26, 412.57, 481.89, 420.07]},
    {"id": "p129-b8", "type": "paragraph", "text": "Tổng tài sản (tỷ đồng)", "bbox": [216.85, 436.6, 288.45, 444.1]},
    {"id": "p129-b9", "type": "paragraph", "text": "849.482\n978.799", "bbox": [397.55, 436.6, 481.89, 444.1]},
    {
      "id": "p129-b10",
      "type": "paragraph",
      "text": "Khả năng sinh lời được cải thiện theo thời gian, nhờ kiểm soát chi phí hiệu quả, thu nhập cốt",
      "bbox": [817.79, 159.68, 1148.05, 168.18]
    },
    {"id": "p129-b11", "type": "paragraph", "text": "Lợi nhuận trước thuế", "bbox": [646.3, 160.15, 737.41, 170.15]},
    {"id": "p129-b12", "type": "paragraph", "text": "lõi bền vững và khả năng nâng cao hiệu quả vận hành.", "bbox": [817.79, 170.18, 1018.34, 178.68]},
    {"id": "p129-b13", "type": "paragraph", "text": "Lợi nhuận trước thuế (tỷ đồng)", "bbox": [820.63, 219.64, 919.7, 227.14]},
    {"id": "p129-b14", "type": "paragraph", "text": "Biên lãi ròng (NIM) 2", "bbox": [646.3, 255.68, 731.17, 266.32]},
    {
      "id": "p129-b15",
      "type": "paragraph",
      "text": "Dù NIM giảm nhẹ theo điều kiện thị trường, Techcombank vẫn duy trì biên lợi nhuận cạnh\ntranh thông qua tối ưu hóa chủ động bảng cân đối và khả năng định giá.",
      "bbox": [817.79, 255.85, 1147.99, 274.85]
    },
    {
      "id": "p129-b16",
      "type": "paragraph",
      "text": "2 Biên lãi ròng trượt 12 tháng = Thu nhập lãi\nthuần 4 quý gần nhất/Trung bình tài sản\nsinh lãi theo ngày 5 quý gần nhất",
      "bbox": [646.3, 273.49, 772.45, 298.86]
    },
    {"id": "p129-b17", "type": "paragraph", "text": "2025", "bbox": [520.48, 306.27, 538.58, 313.77]},
    {"id": "p129-b18", "type": "paragraph", "text": "Biên lãi ròng (NIM)", "bbox": [820.63, 315.8, 881.29, 323.3]},
    {"id": "p129-b19", "type": "paragraph", "text": "53.391", "bbox": [516.91, 330.3, 538.58, 337.8]},
    {
      "id": "p129-b20",
      "type": "paragraph",
      "text": "Hiệu quả vận hành tiếp tục là một điểm nổi bật, với CIR duy trì ở mức thấp, phản ánh khả",
      "bbox": [817.79, 352.01, 1147.98, 360.51]
    },
    {"id": "p129-b21", "type": "paragraph", "text": "Tỷ lệ chi phí trên", "bbox": [646.3, 352.49, 718.76, 362.49]},
    {
      "id": "p129-b22",
      "type": "paragraph",
      "text": "năng quản trị chi phí hiệu quả với các khoản đầu tư liên tục cho chuyển đổi số.",
      "bbox": [817.79, 362.51, 1105.12, 371.01]
    },
    {"id": "p129-b23", "type": "paragraph", "text": "thu nhập (CIR)", "bbox": [646.3, 365.49, 709.05, 375.49]},
    {"id": "p129-b24", "type": "paragraph", "text": "Tỷ lệ chi phí trên thu nhập (CIR)", "bbox": [820.63, 411.97, 923.58, 419.47]},
    {"id": "p129-b25", "type": "paragraph", "text": "2025", "bbox": [520.48, 412.57, 538.58, 420.07]},
    {"id": "p129-b26", "type": "paragraph", "text": "1.192.344", "bbox": [508.94, 436.6, 538.58, 444.1]},
    {
      "id": "p129-b27",
      "type": "paragraph",
      "text": "Techcombank cũng đồng thời góp phần duy trì sự ổn định kinh tế vĩ mô và niềm tin của nhà",
      "bbox": [817.79, 448.18, 1148.03, 456.68]
    },
    {"id": "p129-b28", "type": "paragraph", "text": "Nền tảng vững vàng của Tech 257", "bbox": [1036.23, 25.6, 1148.03, 32.7]},
    {"id": "p129-b29", "type": "paragraph", "text": "2023\n2024\n2025", "bbox": [1011.04, 195.61, 1142.36, 203.11]},
    {"id": "p129-b30", "type": "paragraph", "text": "22.888\n27.538\n32.538", "bbox": [1005.17, 219.64, 1142.36, 227.14]},
    {"id": "p129-b31", "type": "paragraph", "text": "2023\n2024\n2025", "bbox": [1011.04, 291.77, 1142.36, 299.27]},
    {"id": "p129-b32", "type": "paragraph", "text": "3,97%\n4,17%\n3,67%", "bbox": [1009.15, 315.8, 1142.37, 323.3]},
    {"id": "p129-b33", "type": "paragraph", "text": "2023\n2024\n2025", "bbox": [1011.04, 387.94, 1142.36, 395.44]},
    {"id": "p129-b34", "type": "paragraph", "text": "33,1%\n32,7%\n30,8%", "bbox": [1011.31, 411.97, 1142.36, 419.47]},
    {"id": "p129-b35", "type": "heading", "text": "DUY TRÌ SỰ ỔN ĐỊNH", "bbox": [646.3, 448.76, 760.78, 460.76]},
    {
      "id": "p129-b36",
      "type": "paragraph",
      "text": "đầu tư thông qua hoạt động kiểm soát các nguồn tài chính bất hợp pháp và duy trì tuân thủ",
      "bbox": [817.79, 458.67, 1148.04, 467.17]
    },
    {"id": "p129-b37", "type": "heading", "text": "CỦA NỀN KINH TẾ", "bbox": [646.3, 462.76, 743.49, 474.76]},
    {
      "id": "p129-b38",
      "type": "paragraph",
      "text": "Tăng trưởng tín dụng duy trì ở mức cao và được kiểm soát tốt nhằm hỗ trợ hoạt động kinh\ntế, đồng thời chất lượng tài sản được đảm bảo thông qua quy trình thẩm định và thực hành",
      "bbox": [214.02, 472.8, 544.29, 491.8]
    },
    {"id": "p129-b39", "type": "paragraph", "text": "2023\n2024", "bbox": [407.26, 519.23, 481.89, 526.73]},
    {"id": "p129-b40", "type": "paragraph", "text": "Tổng dư nợ tín dụng (tỷ đồng)*", "bbox": [216.85, 543.26, 317.53, 550.76]},
    {"id": "p129-b41", "type": "paragraph", "text": "561.150\n683.028", "bbox": [400.87, 543.26, 481.89, 550.76]},
    {"id": "p129-b42", "type": "paragraph", "text": "Bao gồm trái phiếu doanh nghiệp", "bbox": [214.02, 569.1, 315.37, 576.1]},
    {
      "id": "p129-b43",
      "type": "paragraph",
      "text": "Vốn chủ sở hữu tăng trưởng nhất quán, phản ánh sự gia tăng đối với lợi nhuận giữ lại và nền\ntảng vốn vững chắc nhằm hỗ trợ hoạt động kinh doanh và tăng cường khả năng mở rộng",
      "bbox": [214.02, 594.81, 544.31, 613.8]
    },
    {"id": "p129-b44", "type": "paragraph", "text": "2023\n2024", "bbox": [407.26, 641.23, 481.89, 648.73]},
    {"id": "p129-b45", "type": "paragraph", "text": "Vốn chủ sở hữu (tỷ đồng)", "bbox": [216.85, 665.26, 299.56, 672.76]},
    {"id": "p129-b46", "type": "paragraph", "text": "131.616\n147.940", "bbox": [402.58, 665.26, 481.89, 672.76]},
    {
      "id": "p129-b47",
      "type": "paragraph",
      "text": "Techcombank duy trì tỷ lệ an toàn vốn ở mức vững chắc, cao hơn yêu cầu quy định, thể hiện\nquan điểm quản trị vốn thận trọng và năng lực hấp thụ các rủi ro tiềm ẩn.",
      "bbox": [214.02, 701.47, 544.23, 720.47]
    },
    {"id": "p129-b48", "type": "paragraph", "text": "2023\n2024", "bbox": [407.26, 737.4, 481.89, 744.9]},
    {"id": "p129-b49", "type": "paragraph", "text": "14,35%\n15,40%", "bbox": [402.47, 761.43, 481.89, 768.93]},
    {"id": "p129-b50", "type": "paragraph", "text": "quy định pháp luật.", "bbox": [817.79, 469.17, 887.99, 477.67]},
    {
      "id": "p129-b51",
      "type": "paragraph",
      "text": "Trong năm 2025, Techcombank đã hoàn tất chi trả 7.065 tỷ đồng cổ tức, phản ánh cam kết",
      "bbox": [817.79, 515.89, 1147.98, 524.39]
    },
    {"id": "p129-b52", "type": "paragraph", "text": "Chi trả cổ tức", "bbox": [646.3, 516.37, 704.82, 526.37]},
    {"id": "p129-b53", "type": "paragraph", "text": "2025", "bbox": [520.48, 519.23, 538.58, 526.73]},
    {
      "id": "p129-b54",
      "type": "paragraph",
      "text": "của Ngân hàng trong việc mang lại lợi suất bền vững và giá trị dài hạn cho cổ đông.",
      "bbox": [817.79, 526.39, 1123.41, 534.89]
    },
    {"id": "p129-b55", "type": "paragraph", "text": "824.104", "bbox": [512.95, 543.26, 538.58, 550.76]},
    {"id": "p129-b56", "type": "paragraph", "text": "Chi trả cổ tức (tỷ đồng)", "bbox": [820.63, 575.85, 895.4, 583.35]},
    {
      "id": "p129-b57",
      "type": "paragraph",
      "text": "Với các kết quả trên, Techcombank tiếp Mức tăng này phản ánh hiệu quả hoạt động\ntục đóng góp đáng kể cho nền kinh tế được cải thiện và việc tuân thủ đầy đủ, nhất\nthông qua các khoản thuế và nghĩa vụ quán các nghĩa vụ thuế và quy định. Thông",
      "bbox": [817.79, 612.04, 1148.05, 641.55]
    },
    {"id": "p129-b58", "type": "paragraph", "text": "2025", "bbox": [520.48, 641.23, 538.58, 648.73]},
    {
      "id": "p129-b59",
      "type": "paragraph",
      "text": "nộp ngân sách nhà nước. Năm 2025, qua các đóng góp tài khóa minh bạch và\nđóng góp của Techcombank cho ngân ổn định, Techcombank góp phần hỗ trợ các\nsách nhà nước tăng lên 8.645 tỷ đồng, so ưu tiên phát triển quốc gia và củng cố vai",
      "bbox": [817.79, 643.53, 1148.04, 673.05]
    },
    {"id": "p129-b60", "type": "paragraph", "text": "179.501", "bbox": [514.47, 665.26, 538.58, 672.76]},
    {
      "id": "p129-b61",
      "type": "paragraph",
      "text": "với 6.075 tỷ đồng năm 2024 và 6.265 tỷ trò là một định chế tài chính có trách nhiệm,\nđồng năm 2023.",
      "bbox": [817.79, 675.03, 1148.05, 694.04]
    },
    {"id": "p129-b62", "type": "paragraph", "text": "2025", "bbox": [520.48, 737.4, 538.58, 744.9]},
    {"id": "p129-b63", "type": "paragraph", "text": "Đóng góp ngân sách nhà nước (tỷ đồng)", "bbox": [820.63, 747.01, 953.57, 754.51]},
    {"id": "p129-b64", "type": "paragraph", "text": "14,60%", "bbox": [515.44, 761.43, 538.58, 768.93]},
    {"id": "p129-b65", "type": "paragraph", "text": "2023\n2024\n2025", "bbox": [1011.04, 551.82, 1142.36, 559.32]},
    {"id": "p129-b66", "type": "paragraph", "text": "–\n5.284\n7.065", "bbox": [1024.53, 575.85, 1142.36, 583.35]},
    {"id": "p129-b67", "type": "paragraph", "text": "đồng hành cùng sự phát triển kinh tế – xã\nhội của Việt Nam.", "bbox": [989.29, 685.52, 1148.03, 704.52]},
    {"id": "p129-b68", "type": "paragraph", "text": "2023\n2024\n2025", "bbox": [1011.04, 722.98, 1142.36, 730.48]},
    {"id": "p129-b69", "type": "paragraph", "text": "6.265\n6.075\n8.645", "bbox": [1009.4, 747.01, 1142.36, 754.51]},
    {"id": "p129-b70", "type": "paragraph", "text": "256 Báo cáo thường niên 2025", "bbox": [42.52, 25.6, 147.45, 32.7]},
    {"id": "p129-b71", "type": "paragraph", "text": "Xã hội", "bbox": [42.52, 106.56, 97.34, 126.56]},
    {"id": "p129-b72", "type": "paragraph", "text": "ĐÓNG GÓP KINH TẾ", "bbox": [42.52, 160.69, 151.29, 172.69]},
    {"id": "p129-b73", "type": "paragraph", "text": "Tổng thu nhập hoạt động", "bbox": [42.52, 260.31, 154.73, 270.31]},
    {"id": "p129-b74", "type": "paragraph", "text": "Tổng tài sản", "bbox": [42.52, 366.61, 96.79, 376.61]},
    {"id": "p129-b75", "type": "paragraph", "text": "Tổng dư nợ tín dụng 1", "bbox": [42.52, 472.64, 134.13, 483.28]},
    {"id": "p129-b76", "type": "paragraph", "text": "1 Dư nợ tín dụng bao gồm số dư nợ cho vay", "bbox": [42.52, 490.22, 173.49, 497.58]},
    {"id": "p129-b77", "type": "paragraph", "text": "quản trị rủi ro.", "bbox": [214.02, 493.8, 264.86, 502.3]},
    {
      "id": "p129-b78",
      "type": "paragraph",
      "text": "khách hàng và số dư trái phiếu doanh trên\nbáo cáo tài chính hợp nhất",
      "bbox": [42.52, 499.59, 173.47, 515.59]
    },
    {"id": "p129-b79", "type": "paragraph", "text": "Vốn chủ sở hữu", "bbox": [42.52, 595.28, 111.5, 605.28]},
    {"id": "p129-b80", "type": "paragraph", "text": "trong tương lai.", "bbox": [214.02, 615.8, 269.36, 624.3]},
