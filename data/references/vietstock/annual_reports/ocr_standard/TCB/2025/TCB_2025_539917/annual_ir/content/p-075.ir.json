  "blocks": [
    {"id": "p75-b1", "type": "paragraph", "text": "HĐQT đa dạng và chuyên nghiệp", "bbox": [214.02, 167.79, 360.99, 177.79]},
    {
      "id": "p75-b2",
      "type": "paragraph",
      "text": "Ngân hàng xác định quản trị công ty là nền đa dạng và chuyên nghiệp, phản ánh sự cân\ntảng cốt lõi cho sự phát triển bền vững và bằng về kinh nghiệm, giới tính, quốc tịch và\ntạo giá trị lâu dài cho cổ đông. Trong năm nhiệm kỳ. Các tiêu chí lựa chọn, nhiệm kỳ,\n2025, Techcombank tiếp tục thực hiện các quy trình đề cử, bổ nhiệm thành viên Hội\nnguyên tắc quản trị theo chuẩn mực quốc đồng quản trị được thực hiện theo quy định\ntế nhằm đảm bảo tính minh bạch, trách của pháp luật và được quy định rõ ràng\nnhiệm giải trình và hiệu quả trong hoạt động trong Điều lệ, Quy chế Quản trị Nội bộ, Quy\ncủa Hội đồng quản trị. Techcombank luôn định về Quy chế Tổ chức và Hoạt động của\nchú trọng xây dựng một Hội đồng quản trị Hội đồng Quản trị của Techcombank.",
      "bbox": [214.02, 195.2, 544.27, 287.7]
    },
    {"id": "p75-b3", "type": "paragraph", "text": "Trong năm 2025, HĐQT gồm 9 thành viên, tất cả đều là thành", "bbox": [299.76, 306.36, 544.29, 314.86]},
    {
      "id": "p75-b4",
      "type": "paragraph",
      "text": "Đa dạng về\ncơ cấu thành viên viên không điều hành; trong đó có 2 thành viên độc lập và 1 thành\nviên nữ. Cơ cấu này đảm bảo nguyên tắc đa dạng về kinh nghiệm,\nchuyên môn và giới tính, phù hợp với thông lệ quản trị tốt nhất.",
      "bbox": [214.02, 306.6, 544.29, 346.35]
    },
    {"id": "p75-b5", "type": "paragraph", "text": "Cơ cấu nhiệm kỳ của HĐQT được thiết kế hài hòa giữa sự ổn định", "bbox": [299.76, 364.62, 544.29, 373.12]},
    {"id": "p75-b6", "type": "paragraph", "text": "Đa dạng về", "bbox": [214.02, 364.82, 255.92, 373.32]},
    {"id": "p75-b7", "type": "paragraph", "text": "và đổi mới: 44% thành viên có nhiệm kỳ trên 10 năm, mang đến sự", "bbox": [299.76, 375.11, 544.25, 383.61]},
    {"id": "p75-b8", "type": "paragraph", "text": "nhiệm kỳ", "bbox": [214.02, 375.32, 247.27, 383.82]},
    {
      "id": "p75-b9",
      "type": "paragraph",
      "text": "hiểu biết sâu sắc về ngành ngân hàng và bối cảnh pháp lý; đồng\nthời, 44% thành viên có nhiệm kỳ dưới 5 năm, bổ sung năng lượng\nđổi mới, tư duy sáng tạo và khả năng ứng dụng công nghệ. Sự kết\nhợp này tạo nên một HĐQT vừa vững chắc về kinh nghiệm, vừa linh\nhoạt trong đổi mới.",
      "bbox": [299.76, 385.61, 544.28, 436.1]
    },
    {"id": "p75-b10", "type": "paragraph", "text": "HĐQT được thiết kế với sự kết hợp giữa thành viên trong nước và", "bbox": [299.76, 454.31, 544.25, 462.81]},
    {"id": "p75-b11", "type": "paragraph", "text": "Đa dạng về", "bbox": [214.02, 454.52, 255.92, 463.02]},
    {"id": "p75-b12", "type": "paragraph", "text": "quốc tế, với 2/9 thành viên là người nước ngoài. Sự hiện diện của", "bbox": [299.76, 464.81, 544.22, 473.31]},
    {"id": "p75-b13", "type": "paragraph", "text": "quốc tịch", "bbox": [214.02, 465.02, 247.5, 473.52]},
    {
      "id": "p75-b14",
      "type": "paragraph",
      "text": "thành viên quốc tế không chỉ mang đến kinh nghiệm từ các thị\ntrường phát triển mà còn giúp Ngân hàng tiếp cận thông lệ quản trị\ntiên tiến, nâng cao chuẩn mực minh bạch và quản trị rủi ro. Điều này\nđặc biệt quan trọng trong bối cảnh hội nhập, giúp cân bằng giữa đặc\nthù thị trường nội địa và cơ hội toàn cầu, đồng thời mở rộng hợp tác\nvà nâng cao uy tín thương hiệu.",
      "bbox": [299.76, 475.3, 544.27, 536.29]
    },
    {"id": "p75-b15", "type": "paragraph", "text": "Techcombank thực hiện nguyên tắc phân tách rõ ràng giữa vai trò", "bbox": [299.76, 554.53, 544.28, 563.03]},
    {
      "id": "p75-b16",
      "type": "paragraph",
      "text": "Phân tách vai trò\ncủa Chủ tịch HĐQT Chủ tịch HĐQT và (TGĐ), đảm bảo tính độc lập trong giám sát và\nvà Tổng Giám đốc minh bạch trong điều hành. Việc tách biệt này giúp giảm xung đột\nlợi ích, nâng cao hiệu quả phân quyền và trách nhiệm giải trình, đồng",
      "bbox": [214.02, 554.74, 544.29, 594.52]
    },
    {"id": "p75-b17", "type": "paragraph", "text": "(TGĐ)", "bbox": [214.02, 586.24, 235.07, 594.74]},
    {
      "id": "p75-b18",
      "type": "paragraph",
      "text": "thời củng cố niềm tin của cổ đông và các bên liên quan vào cơ chế\nquản trị chuyên nghiệp.",
      "bbox": [299.76, 596.52, 544.29, 615.52]
    },
    {"id": "p75-b19", "type": "paragraph", "text": "Quốc gia", "bbox": [207.86, 696.8, 239.7, 704.8]},
    {"id": "p75-b20", "type": "paragraph", "text": "Giới tính", "bbox": [299.55, 696.8, 329.02, 704.8]},
    {"id": "p75-b21", "type": "paragraph", "text": "Tuổi", "bbox": [397.32, 696.8, 412.26, 704.8]},
    {"id": "p75-b22", "type": "paragraph", "text": "Thành viên là", "bbox": [196.4, 749.77, 236.92, 756.77]},
    {"id": "p75-b23", "type": "paragraph", "text": "Nam (8)", "bbox": [305.65, 749.77, 329.61, 756.98]},
    {"id": "p75-b24", "type": "paragraph", "text": "41-50 (2)", "bbox": [394.9, 749.77, 421.29, 756.98]},
    {"id": "p75-b25", "type": "paragraph", "text": ">10 năm: 4 (44%)", "bbox": [473.07, 749.77, 524.22, 756.98]},
    {"id": "p75-b26", "type": "paragraph", "text": "người Việt Nam (7)", "bbox": [196.4, 757.78, 252.64, 764.99]},
    {"id": "p75-b27", "type": "paragraph", "text": "Nữ (1)", "bbox": [305.65, 765.45, 322.65, 772.66]},
    {"id": "p75-b28", "type": "paragraph", "text": "51-60 (3)", "bbox": [394.9, 765.45, 421.37, 772.66]},
    {"id": "p75-b29", "type": "paragraph", "text": "5-10 năm: 1 (11%)", "bbox": [473.07, 765.45, 522.72, 772.66]},
    {"id": "p75-b30", "type": "paragraph", "text": "Thiết lập một HĐQT có năng lực và chuyên nghiệp", "bbox": [646.3, 167.79, 868.49, 177.79]},
    {
      "id": "p75-b31",
      "type": "paragraph",
      "text": "Hội đồng quản trị nhiệm kỳ 2024–2029 bao gồm các thành viên sở hữu năng lực cốt lõi vững chắc, chuyên môn rộng và kinh nghiệm sâu\nsắc trong những lĩnh vực trọng yếu của ngành ngân hàng, đảm bảo cơ chế quản trị mạnh mẽ và hiệu quả.",
      "bbox": [646.3, 195.22, 1147.52, 214.22]
    },
