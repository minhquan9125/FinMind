    {
      "id": "p152-b7",
      "type": "paragraph",
      "text": "Thuyết minh báo cáo tài chính hợp nhất\ntại ngày 31 tháng 12 năm 2025 và cho năm tài chính kết thúc cùng ngày",
      "bbox": [646.79, 106.06, 986.09, 138.74]
    },
    {"id": "p152-b8", "type": "paragraph", "text": "Báo cáo tài chính 303", "bbox": [1069.29, 25.6, 1148.03, 32.7]},
    {"id": "p152-b9", "type": "paragraph", "text": "B05/TCTD-HN", "bbox": [1093.69, 62.52, 1148.03, 71.02]},
    {"id": "p152-b10", "type": "heading", "text": "1. THÔNG TIN CHUNG", "bbox": [646.48, 167.9, 763.55, 179.9]},
    {"id": "p152-b11", "type": "paragraph", "text": "Thuyết minh", "bbox": [292.17, 319.2, 334.29, 326.7]},
    {"id": "p152-b12", "type": "paragraph", "text": "2025", "bbox": [423.63, 319.2, 441.73, 326.7]},
    {"id": "p152-b13", "type": "paragraph", "text": "2024", "bbox": [520.56, 319.2, 538.58, 326.7]},
