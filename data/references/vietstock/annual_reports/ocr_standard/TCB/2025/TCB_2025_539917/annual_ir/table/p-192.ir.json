    {"id": "p192-b26", "type": "paragraph", "text": "Tăng lãi thuần từ hoạt động kinh doanh ngoại hối", "bbox": [651.97, 318.45, 814.09, 325.95]},
    {"id": "p192-b27", "type": "paragraph", "text": "(Giảm) lãi thuần từ mua bán chứng khoán kinh doanh", "bbox": [651.97, 337.13, 826.19, 344.63]},
    {"id": "p192-b28", "type": "paragraph", "text": "Tăng lãi thuần từ mua bán chứng khoán đầu tư", "bbox": [651.97, 355.81, 805.26, 363.31]},
    {"id": "p192-b29", "type": "paragraph", "text": "Tăng lãi thuần từ hoạt động khác", "bbox": [651.97, 374.5, 760.22, 382.0]},
    {"id": "p192-b30", "type": "paragraph", "text": "(Giảm) thu nhập từ góp vốn, mua cổ phần", "bbox": [651.97, 393.18, 788.39, 400.68]},
    {"id": "p192-b31", "type": "paragraph", "text": "(Tăng) chi phí hoạt động", "bbox": [651.97, 411.86, 731.56, 419.36]},
    {"id": "p192-b32", "type": "paragraph", "text": "(Tăng) chi phí dự phòng rủi ro tín dụng", "bbox": [651.97, 430.54, 777.8, 438.04]},
