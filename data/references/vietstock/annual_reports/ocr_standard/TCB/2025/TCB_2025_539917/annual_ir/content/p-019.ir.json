  "blocks": [
    {"id": "p19-b1", "type": "paragraph", "text": "Câu chuyện của Tech 37", "bbox": [1061.4, 25.6, 1148.03, 32.7]},
    {"id": "p19-b2", "type": "heading", "text": "CƠ CẤU CỔ ĐÔNG", "bbox": [646.3, 105.02, 748.07, 117.02]},
    {"id": "p19-b3", "type": "paragraph", "text": "Cơ cấu cổ đông, thay đổi vốn đầu tư của chủ sở hữu", "bbox": [42.52, 168.94, 487.71, 188.94]},
    {
      "id": "p19-b4",
      "type": "paragraph",
      "text": "Tổng số cổ phần phổ thông đang lưu hành của Techcombank tại ngày 31 tháng 12 năm 2025\nlà 7.086.240.414 cổ phần (tương đương với vốn điều lệ 70.862.404.140.000 đồng). Toàn bộ là\ncổ phần phổ thông, Ngân hàng không có cổ phần ưu đãi.",
      "bbox": [214.02, 227.67, 543.8, 257.16]
    },
    {"id": "p19-b5", "type": "paragraph", "text": "Cổ đông lớn, cổ đông khác", "bbox": [646.22, 134.39, 764.75, 144.39]},
    {"id": "p19-b6", "type": "paragraph", "text": "14,8%", "bbox": [727.7, 171.32, 744.77, 178.32]},
    {"id": "p19-b7", "type": "paragraph", "text": "85,2%", "bbox": [727.7, 201.42, 746.74, 208.42]},
    {
      "id": "p19-b8",
      "type": "paragraph",
      "text": "Theo điều 4.8 Luật các Tổ chức Tín dụng ban hành năm 2024, “cổ đông lớn” là cổ đông của tổ chức tín dụng là công ty cổ phần sở hữu từ 05% số cổ phần có quyền biểu\nquyết trở lên của tổ chức tín dụng đó, bao gồm cả số cổ phần cổ đông đó sở hữu gián tiếp.",
      "bbox": [646.3, 245.09, 1148.12, 261.09]
    },
    {"id": "p19-b9", "type": "paragraph", "text": "7.086.240.414", "bbox": [484.7, 276.27, 535.82, 284.77]},
    {"id": "p19-b10", "type": "paragraph", "text": "0", "bbox": [530.62, 301.76, 535.82, 310.26]},
    {"id": "p19-b11", "type": "paragraph", "text": "Cổ đông tổ chức và\ncổ đông cá nhân", "bbox": [646.3, 304.16, 731.93, 327.16]},
    {"id": "p19-b12", "type": "paragraph", "text": "1.266.778.075", "bbox": [484.81, 326.12, 535.82, 334.62]},
    {"id": "p19-b13", "type": "paragraph", "text": "46,12%", "bbox": [727.7, 341.25, 748.41, 348.25]},
    {"id": "p19-b14", "type": "paragraph", "text": "5.819.462.339", "bbox": [483.61, 350.21, 535.82, 358.71]},
    {"id": "p19-b15", "type": "paragraph", "text": "53,88%", "bbox": [727.7, 398.56, 750.59, 405.56]},
    {"id": "p19-b16", "type": "paragraph", "text": "Cổ đông trong nước và\ncổ đông nước ngoài", "bbox": [646.3, 448.22, 747.47, 471.22]},
    {"id": "p19-b17", "type": "paragraph", "text": "22,53%", "bbox": [727.69, 482.95, 750.68, 489.95]},
    {"id": "p19-b18", "type": "paragraph", "text": "77,47%", "bbox": [727.69, 516.05, 748.46, 523.05]},
    {"id": "p19-b19", "type": "paragraph", "text": "Cổ đông Nhà nước và\ncổ đông khác", "bbox": [646.3, 592.27, 741.95, 615.27]},
    {"id": "p19-b20", "type": "paragraph", "text": "0%", "bbox": [727.7, 625.75, 737.1, 632.75]},
    {"id": "p19-b21", "type": "paragraph", "text": "100%", "bbox": [727.7, 659.81, 743.75, 666.81]},
    {
      "id": "p19-b22",
      "type": "paragraph",
      "text": "Năm 2025, Techcombank tăng vốn điều lệ từ 70.648.517.390.000 đồng lên",
      "bbox": [817.73, 725.68, 1095.82, 734.18]
    },
