    {"id": "p191-b27", "type": "paragraph", "text": "Góp vốn, đầu tư dài hạn", "bbox": [651.97, 462.15, 731.17, 469.65]},
    {"id": "p191-b28", "type": "paragraph", "text": "Tài sản tài chính khác", "bbox": [651.97, 479.42, 722.59, 486.92]},
    {"id": "p191-b29", "type": "paragraph", "text": "Các công nợ tài chính", "bbox": [651.98, 514.27, 725.99, 521.77]},
    {"id": "p191-b30", "type": "paragraph", "text": "Các khoản nợ Chính phủ và\nNHNN", "bbox": [651.98, 531.21, 743.46, 548.71]},
    {"id": "p191-b31", "type": "paragraph", "text": "Tiền gửi và vay các tổ chức\ntài chính, các TCTD khác", "bbox": [651.98, 558.47, 741.51, 575.97]},
    {"id": "p191-b32", "type": "paragraph", "text": "Tiền gửi của khách hàng", "bbox": [651.98, 585.74, 733.12, 593.24]},
    {"id": "p191-b33", "type": "paragraph", "text": "Các công cụ tài chính phái\nsinh và các khoản nợ tài\nchính khác", "bbox": [651.98, 603.0, 739.36, 630.5]},
    {"id": "p191-b34", "type": "paragraph", "text": "Phát hành giấy tờ có giá", "bbox": [651.98, 640.25, 731.65, 647.75]},
    {"id": "p191-b35", "type": "paragraph", "text": "Các khoản nợ tài chính khác", "bbox": [651.98, 657.52, 745.48, 665.02]},
    {
      "id": "p191-b36",
      "type": "paragraph",
      "text": "(*) Ngân hàng chưa xác định giá trị hợp lý của các khoản mục này do chưa có đủ thông tin, cũng như chưa có hướng dẫn về xác định giá trị\nhợp lý theo Hệ thống Chuẩn mực kế toán Việt Nam và Chế độ báo cáo tài chính đối với các TCTD Việt Nam.",
      "bbox": [646.3, 733.06, 1148.05, 752.06]
    },
    {"id": "p191-b37", "type": "paragraph", "text": "Giá trị ghi sổ", "bbox": [897.04, 239.99, 939.34, 247.49]},
