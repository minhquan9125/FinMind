    {"id": "p191-b20", "type": "paragraph", "text": "Tiền mặt, vàng", "bbox": [651.97, 321.3, 700.66, 328.8]},
    {"id": "p191-b21", "type": "paragraph", "text": "Tiền gửi tại NHNN", "bbox": [651.97, 338.57, 711.94, 346.07]},
    {"id": "p191-b22", "type": "paragraph", "text": "Tiền gửi và cấp tín dụng cho\ncác TCTD khác", "bbox": [651.97, 355.83, 745.69, 373.33]},
    {"id": "p191-b23", "type": "paragraph", "text": "Chứng khoán kinh doanh", "bbox": [651.97, 383.09, 735.36, 390.59]},
    {"id": "p191-b24", "type": "paragraph", "text": "Cho vay khách hàng", "bbox": [651.97, 400.36, 719.55, 407.86]},
