    {
      "id": "p188-b197",
      "type": "paragraph",
      "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT (tiếp theo)\ntại ngày 31 tháng 12 năm 2025 và cho năm tài chính kết thúc cùng ngày",
      "bbox": [42.52, 62.52, 258.77, 80.12]
    },
    {"id": "p188-b198", "type": "paragraph", "text": "Tại 31/12/2025", "bbox": [48.19, 210.59, 97.58, 218.09]},
    {"id": "p188-b199", "type": "paragraph", "text": "Tài sản", "bbox": [48.19, 229.28, 71.63, 236.78]},
    {"id": "p188-b200", "type": "paragraph", "text": "Tiền mặt, vàng", "bbox": [48.19, 246.22, 95.9, 253.72]},
    {"id": "p188-b201", "type": "paragraph", "text": "Tiền gửi tại NHNN", "bbox": [48.19, 263.48, 106.95, 270.98]},
    {"id": "p188-b202", "type": "paragraph", "text": "Tiền gửi và cấp tín dụng cho các TCTD khác (*)", "bbox": [48.2, 280.75, 198.92, 288.25]},
    {"id": "p188-b203", "type": "paragraph", "text": "Chứng khoán kinh doanh (*)", "bbox": [48.2, 298.01, 138.07, 305.51]},
    {"id": "p188-b204", "type": "paragraph", "text": "Cho vay khách hàng (*)", "bbox": [48.21, 315.28, 122.57, 322.78]},
    {
      "id": "p188-b205",
      "type": "paragraph",
      "text": "Trong đó:\nCác khoản cho vay hoạt động ký quỹ và cho vay\nhoạt động ứng trước tiền bán của khách hàng",
      "bbox": [48.22, 333.39, 206.99, 360.89]
    },
    {"id": "p188-b206", "type": "paragraph", "text": "Mua nợ (*)", "bbox": [48.23, 370.75, 80.6, 378.25]},
    {"id": "p188-b207", "type": "paragraph", "text": "Chứng khoán đầu tư (*)", "bbox": [48.23, 388.01, 122.36, 395.51]},
    {
      "id": "p188-b208",
      "type": "paragraph",
      "text": "Trong đó:\nTrái phiếu Chính phủ và trái phiếu được Chính phủ\nbảo lãnh thanh toán",
      "bbox": [48.24, 406.13, 211.52, 433.62]
    },
    {"id": "p188-b209", "type": "paragraph", "text": "Góp vốn, đầu tư dài hạn (*)", "bbox": [48.24, 443.48, 133.84, 450.98]},
    {"id": "p188-b210", "type": "paragraph", "text": "Tài sản cố định", "bbox": [48.25, 472.37, 96.59, 479.87]},
    {"id": "p188-b211", "type": "paragraph", "text": "Tài sản Có khác (*)", "bbox": [48.25, 489.63, 107.38, 497.13]},
    {"id": "p188-b212", "type": "paragraph", "text": "Tổng tài sản", "bbox": [48.25, 507.22, 89.57, 514.72]},
    {"id": "p188-b213", "type": "paragraph", "text": "Nợ phải trả", "bbox": [48.26, 524.48, 85.51, 531.98]},
    {"id": "p188-b214", "type": "paragraph", "text": "Các khoản nợ Chính phủ và NHNN", "bbox": [48.26, 541.43, 160.95, 548.93]},
    {"id": "p188-b215", "type": "paragraph", "text": "Tiền gửi và vay các tổ chức tài chính, các TCTD\nkhác", "bbox": [48.26, 558.69, 200.26, 576.19]},
    {"id": "p188-b216", "type": "paragraph", "text": "Tiền gửi của khách hàng", "bbox": [48.27, 585.95, 127.76, 593.45]},
    {"id": "p188-b217", "type": "paragraph", "text": "Các công cụ tài chính phái sinh và các khoản nợ\ntài chính khác", "bbox": [48.28, 603.22, 203.91, 620.72]},
    {"id": "p188-b218", "type": "paragraph", "text": "Phát hành giấy tờ có giá", "bbox": [48.29, 630.48, 126.23, 637.98]},
    {"id": "p188-b219", "type": "paragraph", "text": "Các khoản nợ khác", "bbox": [48.29, 647.75, 110.68, 655.25]},
    {"id": "p188-b220", "type": "paragraph", "text": "Tổng nợ phải trả", "bbox": [48.29, 665.33, 103.55, 672.83]},
    {"id": "p188-b221", "type": "paragraph", "text": "Mức chênh nhạy cảm với lãi suất nội bảng", "bbox": [48.29, 682.6, 188.63, 690.1]},
