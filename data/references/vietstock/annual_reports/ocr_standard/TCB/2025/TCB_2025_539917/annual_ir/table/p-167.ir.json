    {"id": "p167-b37", "type": "paragraph", "text": "631.724.964", "bbox": [431.91, 683.67, 474.28, 691.17]},
    {
      "id": "p167-b38",
      "type": "paragraph",
      "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT (tiếp theo)\ntại ngày 31 tháng 12 năm 2025 và cho năm tài chính kết thúc cùng ngày",
      "bbox": [646.3, 62.52, 862.55, 80.12]
    },
    {"id": "p167-b39", "type": "paragraph", "text": "9.2. Phân tích dư nợ theo thời gian cho vay gốc", "bbox": [646.3, 167.71, 821.95, 176.21]},
    {"id": "p167-b40", "type": "paragraph", "text": "31/12/2024\nTriệu đồng", "bbox": [500.13, 203.81, 537.92, 220.99]},
    {"id": "p167-b41", "type": "paragraph", "text": "Nợ ngắn hạn", "bbox": [651.97, 220.9, 694.56, 228.4]},
    {"id": "p167-b42", "type": "paragraph", "text": "Nợ trung hạn", "bbox": [651.98, 236.74, 695.34, 244.24]},
    {"id": "p167-b43", "type": "paragraph", "text": "10.523.985", "bbox": [501.01, 249.44, 537.92, 256.94]},
    {"id": "p167-b44", "type": "paragraph", "text": "Nợ dài hạn", "bbox": [651.98, 252.59, 687.96, 260.09]},
    {"id": "p167-b45", "type": "paragraph", "text": "97", "bbox": [529.59, 266.7, 537.92, 274.2]},
    {"id": "p167-b46", "type": "paragraph", "text": "108.263", "bbox": [511.47, 283.97, 537.93, 291.47]},
    {
      "id": "p167-b47",
      "type": "paragraph",
      "text": "Các khoản cho vay hoạt động ký quỹ và cho vay hoạt động ứng trước\ntiền bán của khách hàng",
      "bbox": [651.99, 284.29, 881.41, 301.78]
    },
    {"id": "p167-b48", "type": "paragraph", "text": "4.528", "bbox": [518.68, 301.23, 537.93, 308.73]},
    {"id": "p167-b49", "type": "paragraph", "text": "25.911.246", "bbox": [502.76, 318.5, 537.93, 326.0]},
    {"id": "p167-b50", "type": "paragraph", "text": "9.3. Phân tích dư nợ theo ngành nghề kinh doanh", "bbox": [646.3, 367.48, 831.17, 375.98]},
    {"id": "p167-b51", "type": "paragraph", "text": "31/12/2024", "bbox": [500.13, 411.52, 537.92, 419.02]},
    {"id": "p167-b52", "type": "paragraph", "text": "Cho vay các tổ chức kinh tế", "bbox": [651.97, 420.1, 745.9, 427.6]},
    {"id": "p167-b53", "type": "paragraph", "text": "Nông nghiệp, lâm nghiệp và thuỷ sản", "bbox": [651.98, 435.62, 775.21, 443.12]},
    {"id": "p167-b54", "type": "paragraph", "text": "Khai khoáng", "bbox": [651.98, 451.47, 693.25, 458.97]},
    {"id": "p167-b55", "type": "paragraph", "text": "Công nghiệp chế biến, chế tạo", "bbox": [651.98, 467.32, 753.97, 474.82]},
    {
      "id": "p167-b56",
      "type": "paragraph",
      "text": "Sản xuất và phân phối điện, khí đốt và nước nóng, hơi nước và điều\nhòa không khí",
      "bbox": [651.98, 483.16, 873.96, 500.66]
    },
    {"id": "p167-b57", "type": "paragraph", "text": "Cung cấp nước; hoạt động quản lý và xử lý rác thải, nước thải", "bbox": [651.98, 509.01, 853.38, 516.51]},
    {"id": "p167-b58", "type": "paragraph", "text": "%", "bbox": [532.91, 524.21, 538.59, 531.71]},
    {"id": "p167-b59", "type": "paragraph", "text": "Xây dựng", "bbox": [651.98, 524.86, 683.58, 532.36]},
    {
      "id": "p167-b60",
      "type": "paragraph",
      "text": "Bán buôn và bán lẻ; sửa chữa mô tô, ô tô, xe máy và xe có động cơ khác",
      "bbox": [651.98, 540.7, 882.86, 548.2]
    },
    {"id": "p167-b61", "type": "paragraph", "text": "98,10", "bbox": [521.37, 542.57, 538.59, 550.07]},
    {"id": "p167-b62", "type": "paragraph", "text": "Vận tải kho bãi", "bbox": [651.98, 556.55, 700.94, 564.05]},
    {"id": "p167-b63", "type": "paragraph", "text": "0,73", "bbox": [524.85, 561.25, 538.59, 568.75]},
    {"id": "p167-b64", "type": "paragraph", "text": "Dịch vụ lưu trú và ăn uống", "bbox": [651.98, 572.4, 738.46, 579.9]},
    {"id": "p167-b65", "type": "paragraph", "text": "0,22", "bbox": [523.57, 579.93, 538.59, 587.43]},
    {"id": "p167-b66", "type": "paragraph", "text": "Thông tin và truyền thông", "bbox": [651.98, 588.25, 737.33, 595.75]},
    {"id": "p167-b67", "type": "paragraph", "text": "0,41", "bbox": [525.66, 598.62, 538.59, 606.12]},
    {"id": "p167-b68", "type": "paragraph", "text": "Hoạt động tài chính, ngân hàng và bảo hiểm", "bbox": [651.98, 604.09, 798.57, 611.59]},
    {"id": "p167-b69", "type": "paragraph", "text": "0,54", "bbox": [523.78, 617.3, 538.59, 624.8]},
    {"id": "p167-b70", "type": "paragraph", "text": "Hoạt động kinh doanh bất động sản", "bbox": [651.98, 619.94, 771.37, 627.44]},
    {"id": "p167-b71", "type": "paragraph", "text": "Hoạt động chuyên môn, khoa học và công nghệ", "bbox": [651.98, 635.79, 811.35, 643.29]},
    {"id": "p167-b72", "type": "paragraph", "text": "100,00", "bbox": [514.96, 636.3, 538.59, 643.8]},
    {"id": "p167-b73", "type": "paragraph", "text": "Hoạt động hành chính và dịch vụ hỗ trợ", "bbox": [651.98, 651.64, 782.55, 659.14]},
    {"id": "p167-b74", "type": "paragraph", "text": "Giáo dục và đào tạo", "bbox": [651.98, 667.48, 718.47, 674.98]},
    {"id": "p167-b75", "type": "paragraph", "text": "Y tế và hoạt động trợ giúp xã hội", "bbox": [651.98, 683.33, 760.17, 690.83]},
    {"id": "p167-b76", "type": "paragraph", "text": "Nghệ thuật, vui chơi và giải trí", "bbox": [651.98, 699.18, 750.04, 706.68]},
    {"id": "p167-b77", "type": "paragraph", "text": "Hoạt động dịch vụ khác", "bbox": [651.98, 715.03, 730.67, 722.53]},
    {"id": "p167-b78", "type": "paragraph", "text": "Cho vay cá nhân", "bbox": [651.98, 731.2, 708.76, 738.7]},
    {"id": "p167-b79", "type": "paragraph", "text": "Các khoản cho vay hoạt động ký quỹ và cho vay hoạt động ứng trước", "bbox": [651.99, 762.57, 881.42, 770.07]},
