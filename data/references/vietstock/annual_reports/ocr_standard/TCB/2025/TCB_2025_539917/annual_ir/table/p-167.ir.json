    {"id": "p167-b168", "type": "paragraph", "text": "332 Báo cáo thường niên 2025", "bbox": [42.52, 25.6, 152.46, 32.7]},
    {
      "id": "p167-b169",
      "type": "paragraph",
      "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT (tiếp theo)\ntại ngày 31 tháng 12 năm 2025 và cho năm tài chính kết thúc cùng ngày",
      "bbox": [42.52, 62.52, 258.77, 80.12]
    },
    {"id": "p167-b170", "type": "paragraph", "text": "9. CHO VAY KHÁCH HÀNG", "bbox": [42.52, 168.04, 184.27, 180.04]},
    {"id": "p167-b171", "type": "paragraph", "text": "Cho vay các tổ chức kinh tế và cá nhân trong nước", "bbox": [48.19, 232.17, 215.21, 239.67]},
    {"id": "p167-b172", "type": "paragraph", "text": "Cho vay chiết khấu công cụ chuyển nhượng và các giấy tờ có giá", "bbox": [48.19, 249.44, 262.98, 256.94]},
    {"id": "p167-b173", "type": "paragraph", "text": "Cho vay bằng vốn tài trợ, ủy thác đầu tư", "bbox": [48.19, 266.7, 179.78, 274.2]},
    {"id": "p167-b174", "type": "paragraph", "text": "Các khoản trả thay khách hàng", "bbox": [48.2, 283.97, 150.96, 291.47]},
    {"id": "p167-b175", "type": "paragraph", "text": "Cho vay đối với các tổ chức, cá nhân nước ngoài", "bbox": [48.2, 301.23, 207.98, 308.73]},
    {
      "id": "p167-b176",
      "type": "paragraph",
      "text": "Các khoản cho vay hoạt động ký quỹ và cho vay hoạt động ứng trước\ntiền bán của khách hàng",
      "bbox": [48.2, 318.5, 277.62, 335.99]
    },
    {"id": "p167-b177", "type": "paragraph", "text": "Bằng VND", "bbox": [48.19, 429.88, 82.99, 437.38]},
    {"id": "p167-b178", "type": "paragraph", "text": "Bằng ngoại tệ", "bbox": [48.19, 448.56, 94.41, 456.06]},
    {"id": "p167-b179", "type": "paragraph", "text": "9.1 . Phân tích chất lượng nợ cho vay", "bbox": [42.52, 482.19, 177.7, 490.69]},
    {"id": "p167-b180", "type": "paragraph", "text": "Nợ đủ tiêu chuẩn", "bbox": [48.19, 542.57, 104.94, 550.07]},
    {"id": "p167-b181", "type": "paragraph", "text": "Nợ cần chú ý", "bbox": [48.19, 561.25, 91.47, 568.75]},
    {"id": "p167-b182", "type": "paragraph", "text": "Nợ dưới tiêu chuẩn", "bbox": [48.19, 579.93, 110.97, 587.43]},
    {"id": "p167-b183", "type": "paragraph", "text": "Nợ nghi ngờ", "bbox": [48.19, 598.62, 89.03, 606.12]},
    {"id": "p167-b184", "type": "paragraph", "text": "Nợ có khả năng mất vốn", "bbox": [48.19, 617.3, 129.04, 624.8]},
    {
      "id": "p167-b185",
      "type": "paragraph",
      "text": "Các khoản cho vay hoạt động ký quỹ và cho vay hoạt động ứng trước\ntiền bán của khách hàng",
      "bbox": [48.2, 654.66, 277.62, 672.16]
    },
    {"id": "p167-b186", "type": "paragraph", "text": "tiền bán của khách hàng", "bbox": [651.99, 772.57, 733.33, 780.07]},
