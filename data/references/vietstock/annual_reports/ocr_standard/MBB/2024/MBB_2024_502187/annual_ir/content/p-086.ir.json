    {"id": "p86-b4", "type": "furniture", "text": "DOANH NGHIỆP SỐ TẬP ĐOÀN TÀI CHÍNH DẪN ĐẦU", "bbox": [657.65, 30.85, 828.85, 37.85]},
    {"id": "p86-b5", "type": "paragraph", "text": "171\nBÁO CÁO THƯỜNG NIÊN 2024", "bbox": [1002.34, 30.85, 1154.55, 37.85]},
    {"id": "p86-b6", "type": "heading", "text": "CẤU TRÚC QUẢN TRỊ PHÁT TRIỂN BỀN VỮNG", "bbox": [664.06, 123.43, 962.68, 137.43]},
    {"id": "p86-b7", "type": "heading", "text": "MÔ HÌNH TỔ CHỨC QUẢN TRỊ PHÁT TRIỂN BỀN VỮNG", "bbox": [42.11, 172.47, 399.48, 186.47]},
    {"id": "p86-b8", "type": "paragraph", "text": "Hội đồng quản trị", "bbox": [703.2, 163.28, 768.24, 171.78]},
    {"id": "p86-b9", "type": "paragraph", "text": "Chịu trách nhiệm cao nhất về PTBV\nTập đoàn:", "bbox": [666.14, 183.93, 805.28, 206.43]},
    {
      "id": "p86-b10",
      "type": "paragraph",
      "text": "Định hướng, hoạch định mục tiêu dài\nhạn và hoạt động bền vững của MB,\nthông qua các chủ đề môi trường –\nxã hội – quản trị trọng yếu và phạm\nvi chủ đề này",
      "bbox": [666.14, 246.31, 805.32, 310.81]
    },
    {"id": "p86-b11", "type": "paragraph", "text": "Chỉ đạo và giám sát triển khai hoạt\nđộng về PTBV", "bbox": [666.14, 327.15, 805.33, 349.65]},
    {"id": "p86-b12", "type": "paragraph", "text": "Rà soát định kỳ các mục tiêu PTBV", "bbox": [666.14, 365.24, 797.42, 373.74]},
    {"id": "p86-b13", "type": "paragraph", "text": "Ban Điều hành", "bbox": [878.44, 163.28, 933.74, 171.78]},
    {"id": "p86-b14", "type": "paragraph", "text": "Các đơn vị phụ trách triển khai", "bbox": [1018.99, 163.28, 1133.9, 171.78]},
    {"id": "p86-b15", "type": "paragraph", "text": "Tổng Giám đốc chịu trách nhiệm", "bbox": [836.5, 183.93, 975.64, 192.43]},
    {"id": "p86-b16", "type": "paragraph", "text": "Các đơn vị phụ trách triển khai", "bbox": [1006.87, 183.93, 1146.03, 192.43]},
    {"id": "p86-b17", "type": "paragraph", "text": "lãnh đạo tổ chức triển khai và giám", "bbox": [836.5, 197.93, 975.66, 206.43]},
    {"id": "p86-b18", "type": "paragraph", "text": "bao gồm:", "bbox": [1006.87, 197.93, 1043.26, 206.43]},
    {"id": "p86-b19", "type": "paragraph", "text": "sát triển khai mục tiêu PTBV được\nHĐQT thông qua:", "bbox": [836.5, 211.93, 975.67, 234.43]},
    {"id": "p86-b20", "type": "paragraph", "text": "VP HĐQT: đo lường hiệu suất và kết", "bbox": [1006.87, 246.31, 1146.04, 254.81]},
    {"id": "p86-b21", "type": "paragraph", "text": "Điều hành, tổ chức triển khai các chỉ", "bbox": [836.5, 246.49, 975.63, 254.99]},
    {"id": "p86-b22", "type": "paragraph", "text": "quả triển khai mục tiêu PTBV", "bbox": [1006.87, 260.31, 1116.2, 268.81]},
    {"id": "p86-b23", "type": "paragraph", "text": "đạo, nghị quyết liên quan tới PTBV", "bbox": [836.5, 260.49, 966.93, 268.99]},
    {
      "id": "p86-b24",
      "type": "paragraph",
      "text": "Khối QTRR: triển khai các công tác\nquản trị rủi ro liên quan đến PTBV",
      "bbox": [1006.87, 280.99, 1146.04, 303.49]
    },
    {"id": "p86-b25", "type": "paragraph", "text": "Giám sát các đơn vị triển khai nhiệm", "bbox": [836.5, 299.04, 975.64, 307.54]},
    {"id": "p86-b26", "type": "paragraph", "text": "tập đoàn", "bbox": [1006.87, 308.99, 1041.93, 317.49]},
    {"id": "p86-b27", "type": "paragraph", "text": "vụ được giao liên quan đến PTBV", "bbox": [836.5, 313.04, 962.49, 321.54]},
    {
      "id": "p86-b28",
      "type": "paragraph",
      "text": "Các đơn vị liên quan: chịu trách\nnhiệm triển khai kế hoạch hành động",
      "bbox": [1006.87, 329.99, 1146.02, 352.49]
    },
    {"id": "p86-b29", "type": "paragraph", "text": "Rà soát định kỳ các mục tiêu PTBV", "bbox": [836.5, 351.13, 967.77, 359.63]},
    {"id": "p86-b30", "type": "paragraph", "text": "về PTBV; phối hợp, đảm bảo thực\nhiện mục tiêu hiệu quả", "bbox": [1006.87, 357.99, 1146.05, 380.49]},
    {"id": "p86-b31", "type": "heading", "text": "NGUYÊN TẮC QUẢN TRỊ PHÁT TRIỂN BỀN VỮNG", "bbox": [664.06, 425.93, 981.74, 439.93]},
    {"id": "p86-b32", "type": "paragraph", "text": "Bà VŨ THỊ HẢI PHƯỢNG • Phó Chủ tịch HĐQT", "bbox": [291.54, 450.75, 470.81, 459.25]},
    {
      "id": "p86-b33",
      "type": "paragraph",
      "text": "Hỗ trợ Chủ tịch công tác định hướng, chỉ đạo, giám sát về phát triển\nbền vững tại MB",
      "bbox": [291.54, 474.28, 495.77, 490.28]
    },
    {"id": "p86-b34", "type": "paragraph", "text": "Ông PHẠM NHƯ ÁNH • Tổng Giám đốc", "bbox": [291.54, 762.75, 441.69, 771.25]},
    {
      "id": "p86-b35",
      "type": "paragraph",
      "text": "Phù hợp với định\nhướng, chính sách của\nChính phủ, NHNN về\nphát triển Ngân hàng\nxanh – Ngân hàng\nsố, và thông lệ tốt về\nquản trị",
      "bbox": [691.3, 634.81, 778.55, 709.3]
    },
    {"id": "p86-b36", "type": "paragraph", "text": "1", "bbox": [782.14, 545.66, 787.85, 562.26]},
    {"id": "p86-b37", "type": "paragraph", "text": "3", "bbox": [1061.88, 545.66, 1071.92, 562.26]},
    {"id": "p86-b38", "type": "paragraph", "text": "Kiểm soát chất lượng", "bbox": [833.69, 634.8, 916.65, 643.3]},
    {"id": "p86-b39", "type": "paragraph", "text": "Triển khai đúng và đầy", "bbox": [973.71, 634.8, 1060.64, 643.3]},
    {"id": "p86-b40", "type": "paragraph", "text": "thông qua mục tiêu,", "bbox": [839.97, 645.8, 916.65, 654.3]},
    {"id": "p86-b41", "type": "paragraph", "text": "đủ, vai trò trách nhiệm", "bbox": [974.31, 645.8, 1060.64, 654.3]},
    {"id": "p86-b42", "type": "paragraph", "text": "chỉ số hiệu suất", "bbox": [857.6, 656.8, 916.65, 665.3]},
    {"id": "p86-b43", "type": "paragraph", "text": "được phân giao", "bbox": [999.17, 656.8, 1060.65, 665.3]},
    {"id": "p86-b44", "type": "paragraph", "text": "2", "bbox": [922.27, 757.99, 931.74, 774.59]},
    {"id": "p86-b45", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN 2024", "bbox": [36.01, 30.85, 141.35, 37.85]},
    {"id": "p86-b46", "type": "paragraph", "text": "Không có sự thay đổi so với năm 2023, theo đó:", "bbox": [36.03, 197.25, 215.29, 205.75]},
    {"id": "p86-b47", "type": "paragraph", "text": "Mr. LUU TRUNG THAI • Chủ tịch HĐQT", "bbox": [36.0, 450.75, 182.86, 459.25]},
    {
      "id": "p86-b48",
      "type": "paragraph",
      "text": "Chủ trì, phụ trách công tác PTBV Tập đoàn (trọng tâm về các mô hình tổ\nchức, hoạt động kinh doanh, công nghệ)",
      "bbox": [36.0, 474.28, 251.88, 490.28]
    },
