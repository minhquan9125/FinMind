    {"id": "p88-b22", "type": "paragraph", "text": "Giao thông bền vững (0,1%)", "bbox": [1067.98, 287.07, 1154.57, 294.07]},
    {"id": "p88-b23", "type": "paragraph", "text": "Quản lý nước bền vững tại khu vực đô thị và nông thôn (2,0%)", "bbox": [960.57, 307.53, 1154.53, 314.53]},
    {"id": "p88-b24", "type": "paragraph", "text": "Tái chế, tái sử dụng các nguồn tài nguyên (0,8%)", "bbox": [1004.16, 327.99, 1154.54, 334.99]},
