  },
  "blocks": [
    {"id": "p83-b1", "type": "paragraph", "text": "Triển khai nhất quán trên cơ sở 8 nguyên tắc quản trị nội bộ MB, gồm:", "bbox": [218.27, 127.81, 482.14, 136.31]},
    {
      "id": "p83-b2",
      "type": "paragraph",
      "text": "Đảm bảo cơ chế quản trị,\nđiều hành MB minh bạch,\nhiệu quả, tuân thủ quy\nđịnh pháp luật và hướng\ntới thông lệ, chuẩn mực\nquốc tế.",
      "bbox": [255.49, 178.64, 358.31, 232.15]
    },
    {"id": "p83-b3", "type": "paragraph", "text": "Bảo đảm quyền của cổ\n05 đông, đối xử bình đẳng\ngiữa các cổ đông.", "bbox": [228.72, 270.15, 356.28, 296.65]},
    {
      "id": "p83-b4",
      "type": "paragraph",
      "text": "Tôn trọng và bảo đảm\nquyền, lợi ích hợp pháp của\ncác bên có quyền lợi liên\nquan trong quản trị MB.",
      "bbox": [262.35, 343.47, 365.17, 378.97]
    },
    {
      "id": "p83-b5",
      "type": "paragraph",
      "text": "• Phù hợp với định hướng, chính sách của Chính phủ, NHNN về phát triển ngân hàng xanh\nvà thông lệ tốt về quản trị;\n• Kiểm soát chất lượng thông qua mục tiêu, chỉ số hiệu suất;\n• Triển khai đúng và đầy đủ vai trò trách nhiệm được phân giao",
      "bbox": [218.27, 420.36, 555.59, 458.85]
    },
    {
      "id": "p83-b6",
      "type": "paragraph",
      "text": "MB đã hoàn thiện và ban hành Chính sách ESG, thiết lập khuôn khổ quản trị phát triển bền\nvững thống nhất trên toàn hệ thống. Chính sách ESG đóng vai trò định hướng các nguyên\ntắc và hướng dẫn triển khai các hoạt động liên quan đến phát triển bền vững đảm bảo\ntính chặt chẽ, an toàn và hiệu quả trong quản trị, đồng thời phù hợp với quy định pháp\nluật, quy định nội bộ của MB và kế hoạch kinh doanh – tài chính hàng năm.",
      "bbox": [218.27, 489.86, 555.64, 538.35]
    },
    {
      "id": "p83-b7",
      "type": "paragraph",
      "text": "Việc triển khai Chính sách ESG tại MB được thực hiện theo 06 nguyên tắc:",
      "bbox": [218.27, 549.85, 497.95, 558.35]
    },
    {"id": "p83-b8", "type": "paragraph", "text": "Tuân thủ và liêm chính\nBảo đảm tuân thủ", "bbox": [228.98, 576.43, 315.55, 594.93]},
    {"id": "p83-b9", "type": "paragraph", "text": "Công bố thông tin", "bbox": [343.65, 596.39, 430.21, 604.89]},
    {"id": "p83-b10", "type": "paragraph", "text": "pháp luật, chuẩn mực", "bbox": [228.98, 596.43, 315.55, 604.93]},
    {"id": "p83-b11", "type": "paragraph", "text": "đầy đủ, chính xác và", "bbox": [343.65, 606.38, 430.21, 614.88]},
    {"id": "p83-b12", "type": "paragraph", "text": "đạo đức nghề nghiệp", "bbox": [231.73, 606.43, 312.8, 614.93]},
    {"id": "p83-b13", "type": "paragraph", "text": "nhất quán, hướng tới", "bbox": [343.65, 616.38, 430.22, 624.88]},
    {"id": "p83-b14", "type": "paragraph", "text": "Đổi mới để phát triển", "bbox": [346.8, 669.32, 427.07, 677.82]},
    {"id": "p83-b15", "type": "paragraph", "text": "Lấy khách hàng làm", "bbox": [233.14, 669.37, 311.4, 677.87]},
    {"id": "p83-b16", "type": "paragraph", "text": "Chuyển đổi số toàn", "bbox": [343.65, 679.32, 430.21, 687.82]},
    {"id": "p83-b17", "type": "paragraph", "text": "trung tâm", "bbox": [253.24, 679.36, 291.29, 687.86]},
    {"id": "p83-b18", "type": "paragraph", "text": "diện, sử dụng công", "bbox": [343.65, 689.32, 430.22, 697.82]},
    {"id": "p83-b19", "type": "paragraph", "text": "Tăng cường tài chính", "bbox": [228.98, 689.37, 315.56, 697.87]},
    {"id": "p83-b20", "type": "paragraph", "text": "nghệ để thúc đẩy phát", "bbox": [343.65, 699.31, 430.23, 707.81]},
    {
      "id": "p83-b21",
      "type": "paragraph",
      "text": "toàn diện, tài chính\nbền vững, nâng cao\ntrải nghiệm số, an\ntoàn dữ liệu và bảo\nmật thông tin",
      "bbox": [228.98, 699.37, 315.55, 747.85]
    },
    {"id": "p83-b22", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN • 2025", "bbox": [448.19, 34.45, 555.59, 41.45]},
    {"id": "p83-b23", "type": "paragraph", "text": "Cơ cấu quản trị hợp lý,\n03\nhiệu quả.", "bbox": [407.36, 196.68, 530.75, 214.18]},
    {
      "id": "p83-b24",
      "type": "paragraph",
      "text": "Bảo đảm vai trò của nhà\nđầu tư, thị trường chứng\n06 khoán và các tổ chức trung\ngian trong việc hỗ trợ hoạt\nđộng quản trị MB.",
      "bbox": [407.12, 261.12, 546.33, 305.63]
    },
    {
      "id": "p83-b25",
      "type": "paragraph",
      "text": "Công bố thông tin kịp thời,\nđầy đủ, chính xác và minh\n08 bạch hoạt động của MB;\nbảo đảm số đông được tiếp\ncận thông tin công bằng.",
      "bbox": [409.78, 338.71, 548.03, 383.21]
    },
    {"id": "p83-b26", "type": "paragraph", "text": "Quản trị dựa trên rủi", "bbox": [459.54, 576.34, 546.11, 584.84]},
    {"id": "p83-b27", "type": "paragraph", "text": "Minh bạch và trách", "bbox": [350.58, 576.39, 423.28, 584.89]},
    {"id": "p83-b28", "type": "paragraph", "text": "ro, bao gồm rủi ro ESG", "bbox": [459.77, 586.34, 545.87, 594.84]},
    {"id": "p83-b29", "type": "paragraph", "text": "nhiệm giải trình", "bbox": [357.32, 586.38, 416.53, 594.88]},
    {
      "id": "p83-b30",
      "type": "paragraph",
      "text": "Tích hợp rủi ro khí hậu,\nrủi ro môi trường – xã\nhội vào hệ thống quản\ntrị rủi ro của ngân hàng",
      "bbox": [459.54, 596.35, 546.13, 634.83]
    },
    {"id": "p83-b31", "type": "paragraph", "text": "chuẩn mực cao", "bbox": [356.89, 626.38, 416.97, 634.88]},
    {
      "id": "p83-b32",
      "type": "paragraph",
      "text": "Đóng góp bền vững\ncho cộng đồng và\nmôi trường\nGắn tăng trưởng với\ntrách nhiệm đối với xã",
      "bbox": [459.54, 669.28, 546.12, 717.77]
    },
    {"id": "p83-b33", "type": "paragraph", "text": "triển bền vững", "bbox": [358.75, 709.31, 415.11, 717.81]},
    {"id": "p83-b34", "type": "paragraph", "text": "hội và tương lai xanh", "bbox": [462.64, 719.26, 543.0, 727.76]},
    {"id": "p83-b35", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN • 2025", "bbox": [634.96, 34.45, 742.36, 41.45]},
    {"id": "p83-b36", "type": "paragraph", "text": "Kế hoạch năm 2026", "bbox": [634.96, 127.91, 744.96, 139.91]},
    {
      "id": "p83-b37",
      "type": "paragraph",
      "text": "Nhận diện, đánh giá\nvà quản lý các yếu\ntố rủi ro liên quan\nđến môi trường – xã\nhội, bao gồm yếu tố\nkhí hậu, tác động tới\nrủi ro trọng yếu của\nNgân hàng",
      "bbox": [670.9, 198.46, 754.92, 278.36]
    },
    {"id": "p83-b38", "type": "heading", "text": "CHƯƠNG 5 • BÁO CÁO PHÁT TRIỂN BỀN VỮNG • 161", "bbox": [977.11, 34.45, 1150.87, 41.45]},
    {"id": "p83-b39", "type": "paragraph", "text": "Nghiên cứu, khai thác", "bbox": [796.46, 198.44, 871.65, 206.44]},
    {"id": "p83-b40", "type": "paragraph", "text": "Tăng cường đào tạo,", "bbox": [1035.73, 198.44, 1116.79, 206.44]},
    {"id": "p83-b41", "type": "paragraph", "text": "Hoàn thiện hệ", "bbox": [920.94, 198.46, 995.39, 206.96]},
    {"id": "p83-b42", "type": "paragraph", "text": "và quản lý các cơ hội", "bbox": [796.46, 208.04, 871.67, 216.04]},
    {"id": "p83-b43", "type": "paragraph", "text": "nâng cao năng lực", "bbox": [1035.73, 208.04, 1116.79, 216.04]},
    {"id": "p83-b44", "type": "paragraph", "text": "thống dữ liệu", "bbox": [920.94, 208.66, 995.39, 217.16]},
    {"id": "p83-b45", "type": "paragraph", "text": "kinh doanh liên quan", "bbox": [796.46, 217.64, 871.66, 225.64]},
    {"id": "p83-b46", "type": "paragraph", "text": "chuyên môn về phát", "bbox": [1035.73, 217.64, 1116.81, 225.64]},
    {"id": "p83-b47", "type": "paragraph", "text": "ESG, hướng tới tự", "bbox": [920.94, 218.86, 995.39, 227.36]},
    {"id": "p83-b48", "type": "paragraph", "text": "đến phát triển bền", "bbox": [796.46, 227.24, 871.65, 235.24]},
    {"id": "p83-b49", "type": "paragraph", "text": "triển bền vững cho", "bbox": [1035.73, 227.24, 1116.81, 235.24]},
    {"id": "p83-b50", "type": "paragraph", "text": "động hóa thu thập", "bbox": [920.94, 229.06, 995.39, 237.56]},
    {"id": "p83-b51", "type": "paragraph", "text": "vững trên cơ sở phù", "bbox": [796.46, 236.84, 871.66, 244.84]},
    {"id": "p83-b52", "type": "paragraph", "text": "các vị trí trọng yếu", "bbox": [1035.73, 236.84, 1116.79, 244.84]},
    {"id": "p83-b53", "type": "paragraph", "text": "và quản lý thông", "bbox": [920.94, 239.26, 995.39, 247.76]},
    {"id": "p83-b54", "type": "paragraph", "text": "hợp quy định pháp", "bbox": [796.46, 246.44, 871.66, 254.44]},
    {"id": "p83-b55", "type": "paragraph", "text": "trong lĩnh vực quản trị", "bbox": [1035.73, 246.44, 1116.81, 254.44]},
    {"id": "p83-b56", "type": "paragraph", "text": "tin, đáp ứng các", "bbox": [920.94, 249.46, 995.38, 257.96]},
    {"id": "p83-b57", "type": "paragraph", "text": "luật và định hướng", "bbox": [796.46, 256.04, 871.66, 264.04]},
    {"id": "p83-b58", "type": "paragraph", "text": "rủi ro, kinh doanh, đầu", "bbox": [1035.73, 256.04, 1116.8, 264.04]},
    {"id": "p83-b59", "type": "paragraph", "text": "chuẩn mực quốc tế", "bbox": [920.94, 259.66, 995.39, 268.16]},
    {"id": "p83-b60", "type": "paragraph", "text": "chiến lược MB", "bbox": [809.51, 265.64, 858.6, 273.64]},
    {"id": "p83-b61", "type": "paragraph", "text": "tư và quản trị dữ liệu", "bbox": [1037.4, 265.64, 1115.13, 273.64]},
    {"id": "p83-b62", "type": "paragraph", "text": "về công bố thông\ntin bền vững", "bbox": [920.94, 269.86, 995.39, 288.56]},
    {"id": "p83-b63", "type": "paragraph", "text": "160 • CHƯƠNG 5 • BÁO CÁO PHÁT TRIỂN BỀN VỮNG", "bbox": [39.69, 34.45, 215.54, 41.45]},
    {"id": "p83-b64", "type": "paragraph", "text": "Nguyên tắc quản trị\nphát triển bền vững", "bbox": [40.08, 127.91, 150.24, 154.31]},
    {"id": "p83-b65", "type": "paragraph", "text": "Phát thải trực tiếp từ\n01", "bbox": [50.83, 196.68, 166.76, 210.64]},
    {"id": "p83-b66", "type": "paragraph", "text": "02", "bbox": [228.79, 200.64, 240.31, 210.64]},
    {"id": "p83-b67", "type": "paragraph", "text": "hoạt động ngân hàng.", "bbox": [83.91, 205.68, 170.94, 214.18]},
    {
      "id": "p83-b68",
      "type": "paragraph",
      "text": "Bảo đảm hiệu quả hoạt\nđộng của HĐQT, BKS; nâng\n04\ncao trách nhiệm của HĐQT\nđối với MB và cổ đông.",
      "bbox": [50.04, 265.61, 183.99, 301.11]
    },
    {"id": "p83-b69", "type": "paragraph", "text": "07", "bbox": [231.61, 356.46, 242.69, 366.46]},
    {"id": "p83-b70", "type": "paragraph", "text": "Đảm bảo:", "bbox": [218.27, 410.35, 255.91, 418.85]},
    {"id": "p83-b71", "type": "paragraph", "text": "Kết quả hoạt động\nnăm 2025", "bbox": [40.08, 489.96, 143.32, 516.36]},
    {
      "id": "p83-b72",
      "type": "paragraph",
      "text": "Bổ sung đầy đủ vai trò và chức năng phát triển bền vững vào mô hình tổ chức hiện hữu\ntheo thông lệ quốc tế, bảo đảm việc triển khai ESG được tích hợp vào hoạt động quản trị\nvà vận hành, giúp tối ưu nguồn lực triển khai, và phù hợp với đặc thù thị trường Việt Nam.",
      "bbox": [218.27, 772.41, 555.62, 800.9]
    }
  ]
}
