    {"id": "p75-b75", "type": "paragraph", "text": "I. Các khoản nợ Chính phủ và Ngân hàng Trung ương", "bbox": [663.81, 329.57, 865.5, 337.57]},
    {"id": "p75-b76", "type": "paragraph", "text": "II. Tiền gửi và vay các TCTD khác", "bbox": [662.63, 346.9, 792.7, 354.9]},
