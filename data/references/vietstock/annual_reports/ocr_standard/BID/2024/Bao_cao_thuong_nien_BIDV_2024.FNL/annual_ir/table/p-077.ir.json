  "blocks": [
    {
      "id": "p77-b1",
      "type": "paragraph",
      "text": "LƯU CHUYỂN TIỀN TỆ HỢP NHẤT\nCho năm kết thúc ngày 31 tháng 12 năm 2024",
      "bbox": [56.69, 122.72, 413.52, 173.66]
    },
    {
      "id": "p77-b2",
      "type": "paragraph",
      "text": "Chênh lệch số tiền thực thu từ hoạt động kinh doanh ngoại tệ, chứng khoán",
      "bbox": [60.7, 294.27, 322.54, 302.27]
    },
    {
      "id": "p77-b3",
      "type": "paragraph",
      "text": "Tiền thu các khoản nợ đã được xử lý xóa, bù đắp bằng nguồn dự phòng rủi ro",
      "bbox": [60.71, 328.94, 327.5, 336.94]
    },
    {
      "id": "p77-b4",
      "type": "paragraph",
      "text": "Lưu chuyển tiền thuần từ hoạt động kinh doanh trước những thay đổi về tài",
      "bbox": [60.71, 380.95, 327.31, 388.95]
    },
    {
      "id": "p77-b5",
      "type": "paragraph",
      "text": "(Tăng)/giảm các công cụ tài chính phái sinh và các tài sản tài chính khác",
      "bbox": [60.72, 462.8, 314.74, 470.8]
    },
    {
      "id": "p77-b6",
      "type": "paragraph",
      "text": "Giảm nguồn dự phòng để xử lý rủi ro, xử lý, bù đắp tổn thất các khoản nợ xấu,",
      "bbox": [60.73, 497.47, 328.43, 505.47]
    },
    {
      "id": "p77-b7",
      "type": "paragraph",
      "text": "Tăng phát hành giấy tờ có giá (ngoại trừ giấy tờ có giá phát hành được tính",
      "bbox": [60.74, 613.99, 320.22, 621.99]
    },
    {
      "id": "p77-b8",
      "type": "paragraph",
      "text": "Giảm các nguồn vốn tài trợ, ủy thác đầu tư, cho vay mà TCTD chịu rủi ro",
      "bbox": [60.75, 643.83, 310.96, 651.83]
    },
    {
      "id": "p77-b9",
      "type": "paragraph",
      "text": "(Giảm)/tăng các công cụ tài chính phái sinh và các khoản nợ tài chính khác",
      "bbox": [60.76, 661.17, 323.07, 669.17]
    },
