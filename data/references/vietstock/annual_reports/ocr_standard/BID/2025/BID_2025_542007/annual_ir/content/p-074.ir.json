  },
  "blocks": [
    {"id": "p74-b1", "type": "paragraph", "text": "Hoạt động quản trị công ty", "bbox": [56.69, 47.41, 315.39, 67.41]},
    {"id": "p74-b2", "type": "heading", "text": "VIỆC THỰC HIỆN CÁC QUY ĐỊNH VỀ QUẢN TRỊ DOANH NGHIỆP", "bbox": [56.69, 129.37, 412.89, 141.37]},
    {
      "id": "p74-b3",
      "type": "paragraph",
      "text": "Quyền tham gia hiệu quả vào và biểu quyết trong ĐHĐCĐ được thông báo trong các quy định, bao gồm thủ tục",
      "bbox": [99.21, 266.41, 532.79, 274.41]
    },
    {"id": "p74-b4", "type": "paragraph", "text": "Công ty có cho phép sử dụng biểu quyết vắng mặt bằng phương", "bbox": [99.21, 298.89, 342.98, 306.89]},
    {
      "id": "p74-b5",
      "type": "paragraph",
      "text": "Công ty có ra thông báo về ĐHĐCĐ (có chương trình chi tiết và thông\n(B)A.2.1 báo giải thích), như thông báo cho Sở Giao dịch, tối thiểu 28 ngày",
      "bbox": [62.49, 372.34, 342.98, 392.34]
    },
    {"id": "p74-b6", "type": "paragraph", "text": "Cách thức quản lý rủi ro và cơ hội liên quan đến biến đổi khí hậu có", "bbox": [99.21, 437.31, 342.97, 445.31]},
    {"id": "p74-b7", "type": "paragraph", "text": "Báo cáo Phát triển bền vững của Công ty có được kiểm định bởi tổ", "bbox": [99.21, 469.79, 342.96, 477.79]},
    {
      "id": "p74-b8",
      "type": "paragraph",
      "text": "Công ty có công bố kênh tương tác/đối thoại với các bên hữu quan\n(B)B.1.3 và các công ty phản hồi các mối quan ngại về ESG của các bên hữu",
      "bbox": [62.69, 502.28, 342.97, 522.28]
    },
    {
      "id": "p74-b9",
      "type": "paragraph",
      "text": "Công ty có thành lập một đơn vị/bộ phận/Ủy ban chịu trách nhiệm\ngiám sát/quản lý các vấn đề quản trị bền vững không?",
      "bbox": [99.21, 558.76, 342.98, 578.76]
    },
    {
      "id": "p74-b10",
      "type": "paragraph",
      "text": "Công ty có công bố các hoạt động thực tế của HĐQT đối với việc\nquản trị các rủi ro và cơ hội liên quan đến phát triển bền vững không ?",
      "bbox": [99.21, 603.25, 342.98, 623.25]
    },
    {
      "id": "p74-b11",
      "type": "paragraph",
      "text": "Công ty có kết nối chính sách thu nhập cấp thành viên HĐQT điều\n(B)B.1.6 hành và các quản lý cấp cao với hiệu quả hoạt động quản trị bền vững",
      "bbox": [62.6, 635.73, 342.97, 655.73]
    },
    {"id": "p74-b12", "type": "paragraph", "text": "Chính sách/hệ thống tố giác của Công ty có được quản lý bởi các", "bbox": [99.21, 680.21, 342.96, 688.21]},
    {"id": "p74-b13", "type": "paragraph", "text": "(tiếp theo)", "bbox": [323.9, 52.84, 370.8, 62.84]},
    {"id": "p74-b14", "type": "paragraph", "text": "Kết quả\nCơ sở đánh giá\nđánh giá", "bbox": [355.91, 213.38, 459.73, 233.38]},
    {"id": "p74-b15", "type": "paragraph", "text": "Từ kỳ ĐHĐCĐ thường niên 2024 đã\náp dụng hình thức Bỏ phiếu Điện tử", "bbox": [402.52, 298.89, 528.37, 318.89]},
    {
      "id": "p74-b16",
      "type": "paragraph",
      "text": "Thông báo mời họp, Tài liệu ĐHĐCĐ\nthường niên 2025 được công bố\ntrên Website ngày 13/03/2025.",
      "bbox": [402.52, 372.34, 529.87, 404.34]
    },
    {"id": "p74-b17", "type": "paragraph", "text": "Thể hiện tại Báo cáo Phát triển bền\nvững", "bbox": [402.52, 437.31, 526.65, 457.31]},
    {"id": "p74-b18", "type": "paragraph", "text": "X\nBIDV đang nghiên cứu triển khai", "bbox": [370.21, 475.79, 516.67, 483.79]},
    {"id": "p74-b19", "type": "paragraph", "text": "Thể hiện tại Báo cáo Phát triển bền\nvững", "bbox": [402.52, 508.28, 526.65, 528.28]},
    {
      "id": "p74-b20",
      "type": "paragraph",
      "text": "BIDV đã thành lập Ban chỉ đạo và\nBan quản lý dự án Xây dựng và triển\nkhai Chiến lược phát triển bền vững\nvà thực hành ESG tổng thể tại BIDV.",
      "bbox": [402.52, 546.76, 529.81, 590.76]
    },
    {"id": "p74-b21", "type": "paragraph", "text": "Thể hiện tại Báo cáo Phát triển bền\nvững", "bbox": [402.52, 603.25, 526.65, 623.25]},
    {"id": "p74-b22", "type": "paragraph", "text": "Thể hiện tại Báo cáo Phát triển bền\nvững", "bbox": [402.52, 641.73, 526.65, 661.73]},
    {"id": "p74-b23", "type": "paragraph", "text": "X\nBIDV đang nghiên cứu để triển khai", "bbox": [370.21, 686.21, 527.84, 694.21]},
    {"id": "p74-b24", "type": "paragraph", "text": "X - Tuân thủ một phần/Các lĩnh vực cần cải thiện", "bbox": [303.51, 760.0, 475.17, 768.0]},
    {"id": "p74-b25", "type": "paragraph", "text": "Mục Nội dung", "bbox": [661.82, 219.38, 729.71, 227.38]},
    {"id": "p74-b26", "type": "paragraph", "text": "(B)C.1 Chất lượng báo cáo thường niên", "bbox": [658.63, 246.3, 819.43, 254.3]},
    {
      "id": "p74-b27",
      "type": "paragraph",
      "text": "Báo cáo tài chính hàng năm được kiểm toán có được công bố công\n(B)C.1.1\nkhai trong vòng 60 ngày kể từ khi kết thúc năm tài chính?",
      "bbox": [658.57, 266.78, 938.23, 286.78]
    },
    {"id": "p74-b28", "type": "paragraph", "text": "(B)D. Trách nhiệm của HĐQT", "bbox": [659.91, 299.27, 783.18, 307.27]},
    {"id": "p74-b29", "type": "paragraph", "text": "(B)D.1 Năng lực và sự Đa dạng của HĐQT", "bbox": [658.59, 319.75, 825.64, 327.75]},
    {"id": "p74-b30", "type": "paragraph", "text": "(B)D.1.1 Công ty có tối thiểu một thành viên HĐQT độc lập là nữ?", "bbox": [658.79, 340.23, 895.62, 348.23]},
    {
      "id": "p74-b31",
      "type": "paragraph",
      "text": "Công ty có công bố chính sách và các mục tiêu có thể đo lường để\n(B)D.1.2\nthực thi sự đa dạng của HĐQT và báo cáo tiến độ đạt được?",
      "bbox": [657.65, 360.72, 938.22, 380.72]
    },
    {"id": "p74-b32", "type": "paragraph", "text": "(B)D.2 Cấu trúc HĐQT", "bbox": [657.44, 393.2, 752.42, 401.2]},
    {"id": "p74-b33", "type": "paragraph", "text": "(B)D.2.1 Ủy ban Bổ nhiệm có bao gồm toàn bộ thành viên HĐQT độc lập?", "bbox": [657.65, 425.68, 923.78, 433.68]},
    {
      "id": "p74-b34",
      "type": "paragraph",
      "text": "Ủy ban Bổ nhiệm có thực hiện quy trình xây dựng tiêu chí chất lượng các\n(B)D.2.2\nthành viên HĐQT phù hợp với định hướng chiến lược của Công ty?",
      "bbox": [656.51, 470.17, 938.24, 490.17]
    },
    {"id": "p74-b35", "type": "paragraph", "text": "(B)D.3 Bổ nhiệm và tái cử HĐQT", "bbox": [657.36, 514.65, 790.05, 522.65]},
    {
      "id": "p74-b36",
      "type": "paragraph",
      "text": "Công ty có sử dụng các công ty tìm kiếm hay nguồn ứng cử viên độc\nlập bên ngoài (như cơ sở dữ liệu thành viên HĐQT do các viện thành\n(B)D.3.1\nviên HĐQT hay hiệp hội cổ đông thiết lập) khi tìm kiếm ứng cử viên\ncho thành viên HĐQT?",
      "bbox": [657.67, 535.14, 938.26, 579.14]
    },
    {"id": "p74-b37", "type": "paragraph", "text": "(B)D.4 Cơ cấu & Thành phần HĐQT", "bbox": [657.49, 591.62, 800.72, 599.62]},
    {
      "id": "p74-b38",
      "type": "paragraph",
      "text": "Công ty có số thành viên HĐQT độc lập không điều hành chiếm trên\n(B)D.4.1\n50% số thành viên HĐQT với chủ tịch là thành viên độc lập?",
      "bbox": [657.62, 618.1, 938.24, 638.1]
    },
    {"id": "p74-b39", "type": "paragraph", "text": "(B)D.5 Quản lý rủi ro", "bbox": [657.51, 656.59, 746.63, 664.59]},
    {
      "id": "p74-b40",
      "type": "paragraph",
      "text": "HĐQT có mô tả quy trình quản trị về vấn đề liên quan công nghệ\nthông tin như gián đoạn, an ninh mạng, khôi phục thảm hoạ, để đảm\n(B)D.5.1\nbảo rằng tất cả các rủi ro chính được xác định, quản lý và báo cáo\ncho HĐQT?",
      "bbox": [657.5, 677.07, 938.26, 721.07]
    },
    {"id": "p74-b41", "type": "paragraph", "text": "(B)D.6 Hiệu quả hoạt động của HĐQT", "bbox": [657.37, 733.56, 811.11, 741.56]},
    {"id": "p74-b42", "type": "paragraph", "text": "(B)D.6.1 Công ty có Ủy ban quản lý Rủi ro riêng biệt?", "bbox": [657.53, 760.04, 850.16, 768.04]},
    {"id": "p74-b43", "type": "paragraph", "text": "143", "bbox": [1163.42, 23.28, 1178.07, 32.28]},
    {"id": "p74-b44", "type": "paragraph", "text": "I I Ớ Ớ\nƯ Ư\nL L\nG G\nN N\nẠ Ạ\nM M", "bbox": [1168.86, 48.42, 1176.86, 91.78]},
    {"id": "p74-b45", "type": "paragraph", "text": "O O H H\nÁ Á N N\nC C Í Í H H\nO O C C\nÁ Á I I À À\nB B T T", "bbox": [1163.36, 128.85, 1182.36, 165.83]},
    {"id": "p74-b46", "type": "paragraph", "text": "Ị R Y\nT T", "bbox": [1163.53, 206.44, 1182.53, 217.87]},
    {"id": "p74-b47", "type": "paragraph", "text": "Kết quả", "bbox": [953.11, 213.38, 982.94, 221.38]},
    {"id": "p74-b48", "type": "heading", "text": "N G", "bbox": [1163.53, 217.98, 1182.53, 225.41]},
    {"id": "p74-b49", "type": "paragraph", "text": "Cơ sở đánh giá", "bbox": [997.79, 219.38, 1055.0, 227.38]},
    {"id": "p74-b50", "type": "heading", "text": "Ả N", "bbox": [1163.53, 224.28, 1182.53, 230.86]},
    {"id": "p74-b51", "type": "paragraph", "text": "đánh giá", "bbox": [951.19, 225.38, 984.86, 233.38]},
    {"id": "p74-b52", "type": "paragraph", "text": "U Ô\nQ C", "bbox": [1163.53, 230.04, 1182.53, 242.55]},
    {"id": "p74-b53", "type": "paragraph", "text": "BIDV công bố thông tin đảm bảo\nquy định hiện hành.", "bbox": [997.79, 266.78, 1114.43, 286.78]},
    {"id": "p74-b54", "type": "paragraph", "text": "A\nỦ\nC\nÁ H\nI N\nG\nÀ\nH H\nN\nU\nÁ Ề\nĐ I\nĐ\nO N", "bbox": [1163.36, 283.25, 1182.36, 348.48]},
    {"id": "p74-b55", "type": "paragraph", "text": "X\nHiện chưa có tại BIDV", "bbox": [965.49, 340.23, 1074.62, 348.23]},
    {"id": "p74-b56", "type": "paragraph", "text": "Á A\nC B\nO\nÁ", "bbox": [1163.36, 346.39, 1182.36, 370.9]},
    {"id": "p74-b57", "type": "paragraph", "text": "X\nBIDV đang nghiên cứu để triển khai", "bbox": [965.49, 366.72, 1123.12, 374.72]},
    {"id": "p74-b58", "type": "paragraph", "text": "B", "bbox": [1163.36, 370.9, 1171.36, 375.7]},
    {"id": "p74-b59", "type": "paragraph", "text": "Số lượng Ủy viên HĐQT độc lập tại", "bbox": [997.79, 413.68, 1119.8, 421.68]},
    {"id": "p74-b60", "type": "paragraph", "text": "Ị\nR\nT", "bbox": [1174.36, 418.18, 1182.36, 428.97]},
    {"id": "p74-b61", "type": "paragraph", "text": "BIDV 01 người và hiện là thành viên", "bbox": [997.79, 425.68, 1121.33, 433.68]},
    {"id": "p74-b62", "type": "paragraph", "text": "A N\nỦ Ả", "bbox": [1163.36, 428.98, 1182.36, 441.7]},
    {"id": "p74-b63", "type": "paragraph", "text": "của Ủy ban Nhân sự.", "bbox": [997.79, 437.68, 1070.41, 445.68]},
    {"id": "p74-b64", "type": "paragraph", "text": "C\nU\nÁ Q\nI G G", "bbox": [1163.36, 439.29, 1182.36, 461.35]},
    {"id": "p74-b65", "type": "paragraph", "text": "Ủy ban Nhân sự có tham gia tham", "bbox": [997.79, 458.17, 1118.15, 466.17]},
    {"id": "p74-b66", "type": "paragraph", "text": "H N\nN Ồ", "bbox": [1163.36, 461.35, 1182.36, 473.5]},
    {"id": "p74-b67", "type": "paragraph", "text": "mưu, tư vấn xây dựng bộ chỉ tiêu", "bbox": [997.79, 470.17, 1113.93, 478.17]},
    {"id": "p74-b68", "type": "paragraph", "text": "Á Đ\nĐ I", "bbox": [1163.36, 473.38, 1182.36, 484.03]},
    {"id": "p74-b69", "type": "paragraph", "text": "KPIs đối với các thành viên HĐQT,", "bbox": [997.79, 482.17, 1117.27, 490.17]},
    {"id": "p74-b70", "type": "paragraph", "text": "Ộ\nH", "bbox": [1174.36, 482.78, 1182.36, 494.87]},
    {"id": "p74-b71", "type": "paragraph", "text": "Ban Điều hành BIDV.", "bbox": [997.79, 494.17, 1069.33, 502.17]},
    {"id": "p74-b72", "type": "paragraph", "text": "G H\nN N", "bbox": [1163.36, 545.83, 1182.36, 558.5]},
    {"id": "p74-b73", "type": "paragraph", "text": "X\nBIDV đang nghiên cứu để triển khai", "bbox": [965.49, 553.14, 1123.12, 561.14]},
    {"id": "p74-b74", "type": "paragraph", "text": "Ộ A\nO\nĐ\nD\nT\nẠ H\nO N\nH I K", "bbox": [1163.36, 556.96, 1182.36, 593.96]},
    {
      "id": "p74-b75",
      "type": "paragraph",
      "text": "Chủ tịch HĐQT là thành viên HĐQT\nX\nkhông điều hành, và HĐQT có 1\nthành viên HĐQT độc lập",
      "bbox": [965.49, 612.1, 1122.16, 644.1]
    },
    {"id": "p74-b76", "type": "paragraph", "text": "N\nA 5\nU 2\n0\nQ 2\nG V\nN D\nỔ I B\nT", "bbox": [1163.36, 648.48, 1182.36, 695.13]},
    {"id": "p74-b77", "type": "paragraph", "text": "Thể hiện tại Báo cáo thường niên", "bbox": [997.79, 695.07, 1114.89, 703.07]},
    {"id": "p74-b78", "type": "paragraph", "text": "5\n2\n0\n2\nP", "bbox": [1168.86, 733.26, 1176.86, 757.61]},
    {"id": "p74-b79", "type": "paragraph", "text": "BIDV có Ủy ban Quản lý rủi ro trực", "bbox": [997.79, 754.04, 1118.88, 762.04]},
    {"id": "p74-b80", "type": "paragraph", "text": "Ệ\nI Đ", "bbox": [1168.86, 757.61, 1176.86, 769.36]},
    {"id": "p74-b81", "type": "paragraph", "text": "thuộc HĐQT.", "bbox": [997.79, 766.04, 1043.47, 774.04]},
    {"id": "p74-b82", "type": "paragraph", "text": "Thẻ điểm thưởng", "bbox": [56.69, 168.77, 139.79, 178.77]},
    {"id": "p74-b83", "type": "paragraph", "text": "Mục Nội dung", "bbox": [66.54, 219.38, 134.44, 227.38]},
    {"id": "p74-b84", "type": "paragraph", "text": "(B)A. Quyền của cổ đông", "bbox": [64.69, 245.92, 173.98, 253.92]},
    {"id": "p74-b85", "type": "paragraph", "text": "(B)A.1\nbiểu quyết diễn ra trong ĐHĐCĐ.", "bbox": [63.38, 272.41, 227.46, 286.41]},
    {"id": "p74-b86", "type": "paragraph", "text": "(B)A.1.1\nthức điện tử có đảm bảo tại đại hội cổ đông?", "bbox": [63.63, 304.89, 267.83, 318.89]},
    {"id": "p74-b87", "type": "paragraph", "text": "(B)A.2 Đối xử công bằng với cổ đông", "bbox": [62.23, 331.37, 213.84, 339.37]},
    {"id": "p74-b88", "type": "paragraph", "text": "(B)A.2 Thông báo ĐHĐCĐ", "bbox": [62.23, 351.86, 171.29, 359.86]},
    {"id": "p74-b89", "type": "paragraph", "text": "trước ngày họp?", "bbox": [99.21, 396.34, 158.33, 404.34]},
    {"id": "p74-b90", "type": "paragraph", "text": "(B)B. Vai trò của các bên có quyền lợi liên quan", "bbox": [64.89, 416.83, 258.74, 424.83]},
    {"id": "p74-b91", "type": "paragraph", "text": "(B)B.1.1\nđược công bố không?", "bbox": [63.87, 443.31, 179.68, 457.31]},
    {"id": "p74-b92", "type": "paragraph", "text": "(B)B.1.2\nchức độc lập không?", "bbox": [62.73, 475.79, 175.74, 489.79]},
    {"id": "p74-b93", "type": "paragraph", "text": "quan không?", "bbox": [99.21, 526.28, 146.35, 534.28]},
    {"id": "p74-b94", "type": "paragraph", "text": "(B)B.1.4", "bbox": [62.63, 564.76, 87.6, 572.76]},
    {"id": "p74-b95", "type": "paragraph", "text": "(B)B.1.5", "bbox": [62.58, 609.25, 87.65, 617.25]},
    {"id": "p74-b96", "type": "paragraph", "text": "trong năm trước không?", "bbox": [99.21, 659.73, 187.03, 667.73]},
    {"id": "p74-b97", "type": "paragraph", "text": "(B)B.1.7\nbên/tổ chức độc lập không?", "bbox": [62.85, 686.21, 203.91, 700.21]},
