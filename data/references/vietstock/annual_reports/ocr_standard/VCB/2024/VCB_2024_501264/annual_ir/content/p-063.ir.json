  "blocks": [
    {"id": "p63-b1", "type": "heading", "text": "BẢNG THÔNG TIN SỐ LIỆU VỀ ASXH NĂM 2024 VÀ GIAI ĐOẠN 5 NĂM 2020 - 2024", "bbox": [36.0, 99.49, 458.91, 109.49]},
    {"id": "p63-b2", "type": "paragraph", "text": "Tổng số tiền tài trợ cho hoạt động an sinh xã hội của", "bbox": [94.01, 236.65, 286.49, 245.15]},
    {"id": "p63-b3", "type": "paragraph", "text": "Tài trợ cho người nghèo/xây dựng nhà tình nghĩa, nhà đại đoàn kết…", "bbox": [94.0, 502.28, 343.21, 510.78]},
    {
      "id": "p63-b4",
      "type": "paragraph",
      "text": "Tặng quà cho các bà mẹ VNAH, thân nhân liệt sỹ, các công tác cho người có công…",
      "bbox": [94.0, 520.19, 396.9, 528.69]
    },
    {
      "id": "p63-b5",
      "type": "paragraph",
      "text": "Một số chương trình/công trình an sinh xã hội tiêu biểu Vietcombank đã triển khai trong năm 2024:",
      "bbox": [40.0, 584.51, 430.18, 593.01]
    },
    {"id": "p63-b6", "type": "paragraph", "text": "Ủng hộ xóa nhà tạm, nhà dột nát cho hộ nghèo của Thủ tướng phát động", "bbox": [94.0, 638.53, 364.19, 647.03]},
    {
      "id": "p63-b7",
      "type": "paragraph",
      "text": "Ủng hộ Quỹ “Vì người nghèo” Trung ương để hỗ trợ xóa nhà tạm, nhà dột nát",
      "bbox": [94.0, 655.54, 378.99, 664.04]
    },
    {
      "id": "p63-b8",
      "type": "paragraph",
      "text": "Tài trợ xây Trường Tiểu học 2, thị trấn Rạch Gốc, huyện Ngọc Hiển, tỉnh Cà Mau",
      "bbox": [94.0, 672.55, 391.1, 681.05]
    },
    {
      "id": "p63-b9",
      "type": "paragraph",
      "text": "Tài trợ kinh phí xây dựng Trường Phổ thông Dân tộc bán trú Tiểu học xã Cao Sơn,",
      "bbox": [94.0, 688.26, 394.9, 696.76]
    },
    {
      "id": "p63-b10",
      "type": "paragraph",
      "text": "Hỗ trợ kinh phí để xây dựng nhà Đại đoàn kết cho hộ nghèo trên địa bàn tỉnh",
      "bbox": [94.0, 714.15, 389.82, 722.65]
    },
    {
      "id": "p63-b11",
      "type": "paragraph",
      "text": "Tài trợ kinh phí đầu tư xây dựng trường Tiểu học và Trung học cơ sở Mỹ lộc,",
      "bbox": [94.0, 740.03, 372.84, 748.53]
    },
