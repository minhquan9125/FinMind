      "bbox": [768.19, 336.46, 1118.6, 344.97]
    },
    {"id": "p33-b25", "type": "paragraph", "text": "• Được bổ nhiệm chức danh Chủ tịch HĐQT VCB kể từ ngày 26/07/2024.", "bbox": [768.19, 357.96, 1056.62, 366.48]},
    {
