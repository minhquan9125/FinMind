    {"id": "p41-b82", "type": "paragraph", "text": "Nội dung, số lượng,", "bbox": [977.94, 140.39, 1072.39, 150.39]},
    {"id": "p41-b83", "type": "paragraph", "text": "ĐHĐCĐ/HĐQT", "bbox": [867.39, 146.39, 944.01, 156.39]},
    {"id": "p41-b84", "type": "paragraph", "text": "tổng giá trị giao dịch", "bbox": [977.94, 152.39, 1078.35, 162.39]},
    {"id": "p41-b85", "type": "paragraph", "text": "thông qua", "bbox": [867.39, 158.39, 916.11, 168.39]},
    {
      "id": "p41-b86",
      "type": "paragraph",
      "text": "Phê duyệt chủ trương giao dịch với VCBS\nvà VCBF. Bao gồm mua/bán chứng chỉ\ntiền gửi, giấy tờ có giá, mua bán ngoại tệ\nvà cung cấp dịch vụ quản trị quỹ cho danh",
      "bbox": [977.95, 179.48, 1139.33, 218.58]
    },
    {"id": "p41-b87", "type": "paragraph", "text": "ngày 14/10/2025", "bbox": [867.4, 215.18, 934.62, 223.68]},
    {"id": "p41-b88", "type": "paragraph", "text": "mục ủy thác đầu tư tại VCBF và quỹ đầu tư\ndo VCBF quản lý.", "bbox": [977.95, 220.28, 1143.92, 238.98]},
    {
      "id": "p41-b89",
      "type": "paragraph",
      "text": "Phê duyệt tăng vốn điều lệ cho Công ty\nNghị quyết 715/NQ-VCB- VCBS từ 2.500 tỷ đồng lên 12.500 tỷ đồng\nHĐQT ngày 25/12/2025 (tăng 10.000 tỷ đồng tương đương 400%\nvốn điều lệ VCBS trước thời điểm tăng vốn).",
      "bbox": [867.4, 266.22, 1145.16, 305.32]
    },
    {"id": "p41-b90", "type": "paragraph", "text": "Phê duyệt nội dung thỏa thuận hợp tác", "bbox": [977.95, 337.65, 1127.63, 346.15]},
    {"id": "p41-b91", "type": "paragraph", "text": "Nghị quyết 728/", "bbox": [867.4, 347.85, 930.88, 356.35]},
    {
      "id": "p41-b92",
      "type": "paragraph",
      "text": "về việc thực hiện giao dịch chứng chỉ\ntiền gửi do VCB phát hành bằng phương",
      "bbox": [977.95, 347.85, 1131.19, 366.55]
    },
    {"id": "p41-b93", "type": "paragraph", "text": "30/12/2025", "bbox": [867.4, 368.25, 915.44, 376.75]},
    {"id": "p41-b94", "type": "paragraph", "text": "tiện điện tử giữa KHCN của VCB và VCBS\ntrên hệ thống của VCB.", "bbox": [977.95, 368.25, 1137.95, 386.95]},
    {
      "id": "p41-b95",
      "type": "paragraph",
      "text": "Phê duyệt chủ trương giao dịch với VCBS\nvà VCBF. Các giao dịch bao gồm mua/bán",
      "bbox": [977.95, 409.08, 1140.04, 427.78]
    },
    {"id": "p41-b96", "type": "paragraph", "text": "Nghị quyết 592/", "bbox": [867.4, 424.38, 930.92, 432.88]},
    {"id": "p41-b97", "type": "paragraph", "text": "chứng chỉ tiền gửi, giấy tờ có giá, mua bán", "bbox": [977.95, 429.48, 1139.63, 437.98]},
    {"id": "p41-b98", "type": "paragraph", "text": "NQ-VCB-HĐQT ngày", "bbox": [867.4, 434.58, 951.0, 443.08]},
    {"id": "p41-b99", "type": "paragraph", "text": "ngoại tệ và cung cấp dịch vụ quản trị quỹ", "bbox": [977.95, 439.68, 1134.95, 448.18]},
    {"id": "p41-b100", "type": "paragraph", "text": "14/10/2025", "bbox": [867.4, 444.78, 913.75, 453.28]},
