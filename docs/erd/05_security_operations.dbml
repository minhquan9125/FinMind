// Identity, authorization, and operational tracking.
Table users {
  user_id uuid [pk, not null]
  email varchar [not null, unique]
  username varchar [unique]
  password_hash varchar [not null]
  full_name varchar
  is_active boolean [default: true]
  last_login_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table roles {
  role_id varchar [pk, not null]
  role_name varchar [not null]
  description text
}

Table permissions {
  permission_id varchar [pk, not null]
  resource varchar [not null]
  action varchar [not null]
  description text
}

Table user_roles {
  user_id uuid [not null]
  role_id varchar [not null]
  Indexes {
    (user_id, role_id) [pk]
  }
}

Table role_permissions {
  role_id varchar [not null]
  permission_id varchar [not null]
  Indexes {
    (role_id, permission_id) [pk]
  }
}

Table sessions {
  session_id uuid [pk, not null]
  user_id uuid [not null]
  token_hash varchar [not null]
  issued_at timestamp [not null]
  expires_at timestamp [not null]
  revoked_at timestamp
  ip_address varchar
  user_agent text
}

Table feedback {
  feedback_id uuid [pk, not null]
  query_id uuid
  citation_id uuid
  user_id uuid
  issue_type varchar [not null]
  comment text
  status varchar [default: 'OPEN']
  created_at timestamp [default: `now()`]
  resolved_at timestamp
  resolved_by uuid
}

Table audit_logs {
  audit_id uuid [pk, not null]
  user_id uuid
  action varchar [not null]
  resource_type varchar
  resource_id varchar
  outcome varchar
  ip_address varchar
  user_agent text
  metadata_json jsonb
  created_at timestamp [default: `now()`]
}

Table system_configs {
  config_id uuid [pk, not null]
  config_key varchar [not null, unique]
  config_value text [not null]
  value_type varchar
  version int [default: 1]
  updated_by uuid
  updated_at timestamp [default: `now()`]
  is_active boolean [default: true]
}

Ref: user_roles.user_id > users.user_id
Ref: user_roles.role_id > roles.role_id
Ref: role_permissions.role_id > roles.role_id
Ref: role_permissions.permission_id > permissions.permission_id
Ref: sessions.user_id > users.user_id
Ref: feedback.user_id > users.user_id
Ref: feedback.resolved_by > users.user_id
Ref: audit_logs.user_id > users.user_id
Ref: system_configs.updated_by > users.user_id
