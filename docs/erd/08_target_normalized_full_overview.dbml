// PROPOSED normalized full-system overview (34 tables).
// Consolidates RAG on documents -> text_chunks -> embeddings; not current live schema.

Table companies {
  symbol varchar [pk]
  company_name varchar
}
Table reporting_periods {
  period_id varchar [pk]
  year int
  quarter int
  period_type varchar
}
Table metrics {
  metric_id varchar [pk]
  code varchar
  section varchar
}
Table price_bars {
  price_id varchar [pk]
  symbol varchar
  date date
  close double
}
Table datasets {
  dataset_id varchar [pk]
  symbol varchar
  dataset_version varchar
  graph_version varchar
}
Table financial_reports {
  report_id varchar [pk]
  symbol varchar
  period_id varchar
  section varchar
}
Table observations {
  observation_id varchar [pk]
  report_id varchar
  metric_id varchar
  code varchar
  value double
}
Table dataset_reports {
  dataset_id varchar
  report_id varchar
  Indexes {
    (dataset_id, report_id) [pk]
  }
}
Table dataset_prices {
  dataset_id varchar
  price_id varchar
  Indexes {
    (dataset_id, price_id) [pk]
  }
}

Table documents {
  document_id uuid [pk]
  symbol varchar
  period_id varchar
  title varchar
}
Table text_chunks {
  chunk_id uuid [pk]
  document_id uuid
  chunk_index int
  page_number int
}
Table embeddings {
  embedding_id uuid [pk]
  chunk_id uuid
  model_name varchar
  vector_dim int
  embedding vector
}

Table users {
  user_id uuid [pk]
  email varchar
}
Table roles {
  role_id varchar [pk]
  role_name varchar
}
Table permissions {
  permission_id varchar [pk]
  resource varchar
  action varchar
}
Table user_roles {
  user_id uuid
  role_id varchar
  Indexes {
    (user_id, role_id) [pk]
  }
}
Table role_permissions {
  role_id varchar
  permission_id varchar
  Indexes {
    (role_id, permission_id) [pk]
  }
}
Table sessions {
  session_id uuid [pk]
  user_id uuid
  expires_at timestamp
}
Table audit_logs {
  audit_id uuid [pk]
  user_id uuid
  action varchar
}
Table system_configs {
  config_id uuid [pk]
  config_key varchar
  updated_by uuid
}

Table queries {
  query_id uuid [pk]
  symbol varchar
  user_id uuid
  query_text text
}
Table vector_retrieval_results {
  result_id uuid [pk]
  query_id uuid
  chunk_id uuid
  rank_order int
}
Table graph_nodes {
  node_id uuid [pk]
  node_type varchar
  node_key varchar
  corpus_version varchar
}
Table graph_edges {
  edge_id uuid [pk]
  source_node_id uuid
  target_node_id uuid
  provenance_document_id uuid
  relation_type varchar
}
Table evidence_packages {
  package_id uuid [pk]
  query_id uuid
  gate_status varchar
}
Table answer_citations {
  citation_id uuid [pk]
  query_id uuid
  document_id uuid
  chunk_id uuid
  observation_id varchar
}
Table answer_verifications {
  verification_id uuid [pk]
  query_id uuid
  status varchar
}
Table feedback {
  feedback_id uuid [pk]
  query_id uuid
  citation_id uuid
  user_id uuid
  resolved_by uuid
}

Table corpus_versions {
  corpus_version varchar [pk]
  frozen_by uuid
  frozen_at timestamp
}
Table corpus_documents {
  corpus_version varchar
  document_id uuid
  document_hash varchar
  Indexes {
    (corpus_version, document_id) [pk]
  }
}
Table golden_questions {
  question_id uuid [pk]
  symbol varchar
  period_id varchar
  dataset_version varchar
}
Table evaluation_runs {
  run_id uuid [pk]
  corpus_version varchar
  triggered_by uuid
  dataset_version varchar
}
Table evaluation_results {
  result_id uuid [pk]
  run_id uuid
  question_id uuid
  correctness double
}
Table budget_ledger {
  entry_id uuid [pk]
  period_start date
  period_end date
  cost_usd double
}

// Core financial data
Ref: price_bars.symbol > companies.symbol
Ref: datasets.symbol > companies.symbol
Ref: financial_reports.symbol > companies.symbol
Ref: financial_reports.period_id > reporting_periods.period_id
Ref: observations.report_id > financial_reports.report_id
Ref: observations.metric_id > metrics.metric_id
Ref: dataset_reports.dataset_id > datasets.dataset_id
Ref: dataset_reports.report_id > financial_reports.report_id
Ref: dataset_prices.dataset_id > datasets.dataset_id
Ref: dataset_prices.price_id > price_bars.price_id

// Consolidated source-document and chunk store
Ref: documents.symbol > companies.symbol
Ref: documents.period_id > reporting_periods.period_id
Ref: text_chunks.document_id > documents.document_id
Ref: embeddings.chunk_id > text_chunks.chunk_id

// Users and access control
Ref: user_roles.user_id > users.user_id
Ref: user_roles.role_id > roles.role_id
Ref: role_permissions.role_id > roles.role_id
Ref: role_permissions.permission_id > permissions.permission_id
Ref: sessions.user_id > users.user_id
Ref: audit_logs.user_id > users.user_id
Ref: system_configs.updated_by > users.user_id

// Query, retrieval, evidence, and feedback
Ref: queries.symbol > companies.symbol
Ref: queries.user_id > users.user_id
Ref: vector_retrieval_results.query_id > queries.query_id
Ref: vector_retrieval_results.chunk_id > text_chunks.chunk_id
Ref: graph_edges.source_node_id > graph_nodes.node_id
Ref: graph_edges.target_node_id > graph_nodes.node_id
Ref: graph_edges.provenance_document_id > documents.document_id
Ref: evidence_packages.query_id > queries.query_id
Ref: answer_citations.query_id > queries.query_id
Ref: answer_citations.document_id > documents.document_id
Ref: answer_citations.chunk_id > text_chunks.chunk_id
Ref: answer_citations.observation_id > observations.observation_id
Ref: answer_verifications.query_id > queries.query_id
Ref: feedback.query_id > queries.query_id
Ref: feedback.citation_id > answer_citations.citation_id
Ref: feedback.user_id > users.user_id
Ref: feedback.resolved_by > users.user_id

// Corpus and evaluation
Ref: corpus_versions.frozen_by > users.user_id
Ref: corpus_documents.corpus_version > corpus_versions.corpus_version
Ref: corpus_documents.document_id > documents.document_id
Ref: golden_questions.symbol > companies.symbol
Ref: golden_questions.period_id > reporting_periods.period_id
Ref: evaluation_runs.corpus_version > corpus_versions.corpus_version
Ref: evaluation_runs.triggered_by > users.user_id
Ref: evaluation_results.run_id > evaluation_runs.run_id
Ref: evaluation_results.question_id > golden_questions.question_id

// Target model: graph_nodes/graph_edges are PostgreSQL tables, not Neo4j.
// This target requires migrating active API ingestion/search off rag_* tables; see README.md.
