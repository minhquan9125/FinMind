// ========================================================
// FINMIND — ERD PostgreSQL/Supabase (TARGET: API JSON + scraped news)
// 31 TABLES · 5 DOMAINS
// Neo4j tách riêng (backend kết nối Docker, không FK)
// Financial facts: API -> normalized JSON -> datasets/reports/observations.
// News: source-specific scraper -> documents -> text_chunks -> pgvector embeddings.
// ========================================================

// ========================================================
// DOMAIN A1 — FINANCIAL CORE & DATASETS (9 bảng)
// ========================================================

Table companies {
  symbol varchar [pk]
  company_name varchar
  sector varchar
  exchange varchar
}

Table reporting_periods {
  period_id varchar [pk]
  year int
  quarter int
  period_type varchar
}

Table metrics {
  metric_id varchar [pk]
  code varchar
  canonical_name varchar [note: 'Tên chỉ tiêu chuẩn hóa; giữ code nguồn nếu chưa xác minh mapping']
  section varchar
  source varchar
  unit varchar [note: 'Đơn vị chuẩn, ví dụ triệu VND, %, lần']
  unit_status varchar
  mapping_status varchar [note: 'VERIFIED, REVIEW hoặc UNMAPPED']
}

Table price_bars {
  price_id varchar [pk]
  symbol varchar [ref: > companies.symbol]
  date date
  open double
  high double
  low double
  close double
  volume bigint
  source_timestamp bigint
  source varchar
  source_file text
  json_pointer varchar
  payload_json text
}

Table datasets {
  dataset_id varchar [pk]
  symbol varchar [ref: > companies.symbol]
  dataset_version varchar
  schema_version varchar
  graph_version varchar [note: 'Phiên bản Knowledge Graph khi build dataset']
  generated_at timestamp
  source_file text
  checksum varchar
  payload_json text
  quality_json text
  sources_json text
  meta_json text
  status varchar
}

Table financial_reports {
  report_id varchar [pk]
  document_id uuid [ref: > documents.document_id, note: 'Artifact JSON/API nguồn nếu được lưu thành document']
  symbol varchar [ref: > companies.symbol]
  period_id varchar [ref: > reporting_periods.period_id]
  section varchar
  basis varchar
  source varchar
  source_file text
  json_pointer varchar
  payload_json text
}

Table observations {
  observation_id varchar [pk]
  report_id varchar [ref: > financial_reports.report_id]
  metric_id varchar [ref: > metrics.metric_id]
  code varchar
  value double
  value_json text
  value_type varchar
  is_null boolean
  json_pointer varchar
}

Table dataset_reports {
  dataset_id varchar [ref: > datasets.dataset_id]
  report_id varchar [ref: > financial_reports.report_id]
  Indexes {
    (dataset_id, report_id) [pk]
  }
}

Table dataset_prices {
  dataset_id varchar [ref: > datasets.dataset_id]
  price_id varchar [ref: > price_bars.price_id]
  Indexes {
    (dataset_id, price_id) [pk]
  }
}

// ========================================================
// DOMAIN A2 — DOCUMENTS & VECTOR (2 bảng)
// ========================================================

Table documents {
  document_id uuid [pk]
  symbol varchar [ref: > companies.symbol]
  period_id varchar [ref: > reporting_periods.period_id]
  dataset_id varchar [ref: > datasets.dataset_id, note: 'Nullable; liên kết artifact JSON với dataset, news độc lập để null']
  title varchar
  filename text
  document_type varchar [note: 'FINANCIAL_JSON hoặc NEWS']
  source_type varchar [note: 'FINANCIAL_API hoặc NEWS_SCRAPER']
  source_name varchar [note: 'Ví dụ Vietcap/Entrade hoặc tên báo']
  external_id varchar [note: 'ID bài viết/API nếu nguồn cung cấp']
  file_type varchar
  report_type varchar
  page_count int
  file_size bigint
  source_url varchar
  author varchar
  language varchar
  published_at timestamp
  scraped_at timestamp
  sha256_hash varchar
  created_at timestamp

  Indexes {
    (source_name, external_id) [unique]
    (source_url) [unique]
  }
}

Table text_chunks {
  chunk_id uuid [pk]
  document_id uuid [ref: > documents.document_id]
  symbol varchar [ref: > companies.symbol]
  period_id varchar [ref: > reporting_periods.period_id]
  chunk_index int
  page_number int
  section_label varchar
  chunk_text text
  word_count int
  token_count int
  unique_count int
  embedding vector(1024) [note: 'pgvector; phải cùng chiều với vector query']
  model_name varchar [note: 'BAAI/bge-m3']
  model_version varchar
  vector_dim int [note: '1024']
  created_at timestamp

  Indexes {
    (document_id, chunk_index) [unique]
  }
}

// ========================================================
// DOMAIN A3 — IDENTITY & ACCESS (8 bảng)
// ========================================================

Table users {
  user_id uuid [pk]
  email varchar [unique]
  username varchar [unique]
  password_hash varchar
  full_name varchar
  is_active boolean
  last_login_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table roles {
  role_id varchar [pk]
  role_name varchar
  description text
}

Table permissions {
  permission_id varchar [pk]
  resource varchar
  action varchar
  description text
}

Table user_roles {
  user_id uuid [ref: > users.user_id]
  role_id varchar [ref: > roles.role_id]
  Indexes {
    (user_id, role_id) [pk]
  }
}

Table role_permissions {
  role_id varchar [ref: > roles.role_id]
  permission_id varchar [ref: > permissions.permission_id]
  Indexes {
    (role_id, permission_id) [pk]
  }
}

Table sessions {
  session_id uuid [pk]
  user_id uuid [ref: > users.user_id]
  token_hash varchar
  issued_at timestamp
  expires_at timestamp
  revoked_at timestamp
  ip_address varchar
  user_agent text
}

Table audit_logs {
  audit_id uuid [pk]
  user_id uuid [ref: > users.user_id]
  action varchar
  resource_type varchar
  resource_id varchar
  outcome varchar
  ip_address varchar
  user_agent text
  metadata_json jsonb
  created_at timestamp
}

Table system_configs {
  config_id uuid [pk]
  config_key varchar [unique]
  config_value text
  value_type varchar
  version int
  updated_by uuid [ref: > users.user_id]
  updated_at timestamp
  is_active boolean
}

// ========================================================
// DOMAIN B1 — QUERY & EVIDENCE (6 bảng)
// (Đã bỏ graph_nodes, graph_edges — Neo4j tách riêng)
// ========================================================

Table queries {
  query_id uuid [pk]
  query_text text
  symbol varchar [ref: > companies.symbol]
  filter_metadata jsonb
  language varchar
  execution_time_ms int
  trace_id varchar
  user_id uuid [ref: > users.user_id]
  created_at timestamp
}

Table vector_retrieval_results {
  result_id uuid [pk]
  query_id uuid [ref: > queries.query_id]
  chunk_id uuid [ref: > text_chunks.chunk_id]
  similarity_score double
  rank_order int
  retrieved_at timestamp
}

Table evidence_packages {
  package_id uuid [pk]
  query_id uuid [ref: > queries.query_id]
  gate_status varchar
  gate_reason_code varchar
  freshness_score double
  relevance_score double
  contradiction_flag boolean
  mandatory_branch_missing boolean
  selected_evidence_json jsonb
  branch_scores_json jsonb
  created_at timestamp
}

Table answer_citations {
  citation_id uuid [pk]
  query_id uuid [ref: > queries.query_id]
  claim_text text
  evidence_type varchar
  evidence_id varchar
  document_id uuid [ref: > documents.document_id]
  chunk_id uuid [ref: > text_chunks.chunk_id]
  observation_id varchar [ref: > observations.observation_id]
  page_number int
  section_label varchar
  source_url varchar
  publication_date date
  created_at timestamp
}

Table answer_verifications {
  verification_id uuid [pk]
  query_id uuid [ref: > queries.query_id]
  status varchar
  values_check boolean
  units_check boolean
  periods_check boolean
  scope_check boolean
  calculations_check boolean
  citation_coverage_check boolean
  findings_json jsonb
  created_at timestamp
}

Table feedback {
  feedback_id uuid [pk]
  query_id uuid [ref: > queries.query_id]
  citation_id uuid [ref: > answer_citations.citation_id]
  user_id uuid [ref: > users.user_id]
  issue_type varchar
  comment text
  status varchar
  created_at timestamp
  resolved_at timestamp
  resolved_by uuid [ref: > users.user_id]
}

// ========================================================
// DOMAIN B2 — CORPUS & EVALUATION (6 bảng)
// ========================================================

Table corpus_versions {
  corpus_version varchar [pk]
  description text
  frozen_at timestamp
  frozen_by uuid [ref: > users.user_id]
  manifest_json jsonb
  status varchar
  is_immutable boolean
}

Table corpus_documents {
  corpus_version varchar [ref: > corpus_versions.corpus_version]
  document_id uuid [ref: > documents.document_id]
  document_hash varchar
  Indexes {
    (corpus_version, document_id) [pk]
  }
}

Table golden_questions {
  question_id uuid [pk]
  question_text text
  category varchar
  symbol varchar [ref: > companies.symbol]
  period_id varchar [ref: > reporting_periods.period_id]
  answerability varchar
  reference_answer text
  canonical_numeric_value double
  gold_evidence_ids jsonb
  dataset_split varchar
  dataset_version varchar
  created_at timestamp
}

Table evaluation_runs {
  run_id uuid [pk]
  configuration varchar
  dataset_version varchar
  corpus_version varchar [ref: > corpus_versions.corpus_version]
  model_name varchar
  prompt_hash varchar
  started_at timestamp
  completed_at timestamp
  status varchar
  triggered_by uuid [ref: > users.user_id]
  config_json jsonb
}

Table evaluation_results {
  result_id uuid [pk]
  run_id uuid [ref: > evaluation_runs.run_id]
  question_id uuid [ref: > golden_questions.question_id]
  correctness double
  faithfulness double
  citation_correctness double
  citation_coverage double
  context_precision double
  retrieval_recall double
  latency_ms int
  token_input int
  token_output int
  cost_usd double
  trace_id varchar
  created_at timestamp
}

Table budget_ledger {
  entry_id uuid [pk]
  period_start date
  period_end date
  tokens_input bigint
  tokens_output bigint
  cost_usd double
  ceiling_usd double
  status varchar
  updated_at timestamp
}

// ========================================================
// TABLE GROUPS — 5 DOMAIN
// ========================================================

TableGroup a1_financial_core {
  companies
  reporting_periods
  metrics
  price_bars
  datasets
  financial_reports
  observations
  dataset_reports
  dataset_prices
}

TableGroup a2_documents_vector {
  documents
  text_chunks
}

TableGroup a3_identity_access {
  users
  roles
  permissions
  user_roles
  role_permissions
  sessions
  audit_logs
  system_configs
}

TableGroup b1_query_evidence {
  queries
  vector_retrieval_results
  evidence_packages
  answer_citations
  answer_verifications
  feedback
}

TableGroup b2_corpus_evaluation {
  corpus_versions
  corpus_documents
  golden_questions
  evaluation_runs
  evaluation_results
  budget_ledger
}

// ========================================================
// GHI CHÚ KIẾN TRÚC
// ========================================================
// - Neo4j chạy Docker riêng (backend kết nối qua Bolt/HTTP).
// - Knowledge Graph KHÔNG lưu FK vào PostgreSQL.
// - datasets.graph_version = nhãn phiên bản graph tương ứng
//   để biết dataset nào build từ graph version nào.
// - documents.dataset_id: mỗi document thuộc đúng 1 dataset.
// - documents KHÔNG có source_document_id (không có use case
//   self-reference; nếu cần sau này sẽ thêm cột riêng).
// - API JSON được chuẩn hóa thành datasets/financial_reports/observations;
//   metrics giữ tên chuẩn, đơn vị và trạng thái mapping.
// - News được lưu trong documents với URL/nguồn/tác giả/ngày đăng/ngày scrape;
//   nội dung chia text_chunks và embedding để Vector RAG truy xuất.
// - News không bắt buộc thuộc dataset; financial_reports.document_id truy nguyên
//   JSON nguồn khi artifact đó được lưu vào documents.
// - Đây là mô hình mục tiêu. FastAPI hiện vẫn ghi rag_documents/rag_document_chunks;
//   cần chuyển code và dữ liệu trước khi schema chạy theo ERD này.
