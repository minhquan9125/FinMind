// Frozen corpus membership and evaluation runs/results.
Table users {
  user_id uuid [pk, not null]
  email varchar [not null]
}

Table documents {
  document_id uuid [pk, not null]
  title varchar [not null]
  sha256_hash varchar
}

Table companies {
  symbol varchar [pk, not null]
  company_name varchar
}

Table reporting_periods {
  period_id varchar [pk, not null]
  year int [not null]
  quarter int
  period_type varchar [not null]
}

Table corpus_versions {
  corpus_version varchar [pk, not null]
  description text
  frozen_at timestamp [not null]
  frozen_by uuid
  manifest_json jsonb [not null]
  status varchar [default: 'ACTIVE']
  is_immutable boolean [default: true]
}

Table corpus_documents {
  corpus_version varchar [not null]
  document_id uuid [not null]
  document_hash varchar [not null]
  Indexes {
    (corpus_version, document_id) [pk]
  }
}

Table golden_questions {
  question_id uuid [pk, not null]
  question_text text [not null]
  category varchar [not null]
  symbol varchar
  period_id varchar
  answerability varchar
  reference_answer text
  canonical_numeric_value double
  gold_evidence_ids jsonb
  dataset_split varchar
  dataset_version varchar [not null]
  created_at timestamp [default: `now()`]
}

Table evaluation_runs {
  run_id uuid [pk, not null]
  configuration varchar [not null]
  dataset_version varchar [not null]
  corpus_version varchar [not null]
  model_name varchar
  prompt_hash varchar
  started_at timestamp [not null]
  completed_at timestamp
  status varchar
  triggered_by uuid
  config_json jsonb
}

Table evaluation_results {
  result_id uuid [pk, not null]
  run_id uuid [not null]
  question_id uuid [not null]
  correctness double
  faithfulness double
  citation_correctness double
  citation_coverage double
  context_precision double
  retrieval_recall double
  latency_ms int
  token_input int
  token_output int
  cost_usd double
  trace_id varchar
  created_at timestamp [default: `now()`]
}

Table budget_ledger {
  entry_id uuid [pk, not null]
  period_start date [not null]
  period_end date [not null]
  tokens_input bigint [default: 0]
  tokens_output bigint [default: 0]
  cost_usd double [default: 0]
  ceiling_usd double
  status varchar [default: 'OK']
  updated_at timestamp [default: `now()`]
}

Ref: corpus_versions.frozen_by > users.user_id
Ref: corpus_documents.corpus_version > corpus_versions.corpus_version
Ref: corpus_documents.document_id > documents.document_id
Ref: golden_questions.symbol > companies.symbol
Ref: golden_questions.period_id > reporting_periods.period_id
Ref: evaluation_runs.corpus_version > corpus_versions.corpus_version
Ref: evaluation_runs.triggered_by > users.user_id
Ref: evaluation_results.run_id > evaluation_runs.run_id
Ref: evaluation_results.question_id > golden_questions.question_id
