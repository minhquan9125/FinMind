# Copy these settings into .env at the repository root.
# For Aura, use the username and database from your Aura credentials.
NEO4J_URI=neo4j+s://YOUR_HOST.databases.neo4j.io
NEO4J_USER=YOUR_DATABASE_USERNAME
NEO4J_PASSWORD='YOUR_NEW_DATABASE_PASSWORD'
NEO4J_DATABASE=YOUR_DATABASE_NAME

# For local Docker, replace URI, user and database with:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j
# Set a separate local password (at least 8 characters).

# Text2Cypher prototype. Create the key at your LLM provider and keep it only in .env.
OPENAI_API_KEY='YOUR_OPENAI_API_KEY'
GRAPH_LLM_MODEL=gpt-4o-mini
