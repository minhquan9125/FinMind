    {"id": "p175-b3", "type": "heading", "text": "CHO NĂM TÀI CHÍNH KẾT THÚC NGÀY 31 THÁNG 12 NĂM 2024", "bbox": [428.22, 114.6, 1279.68, 144.6]},
    {"id": "p175-b4", "type": "paragraph", "text": "3\nHỢP NHẤT KINH DOANH (tiếp theo)", "bbox": [428.23, 188.02, 755.62, 206.02]},
    {
      "id": "p175-b5",
      "type": "paragraph",
      "text": "(b)\nĐiều chỉnh do phân bổ lại giá mua các giao dịch hợp nhất kinh doanh thực hiện trong năm tài chính kết thúc ngày 31 tháng 12 năm 2023",
      "bbox": [428.22, 218.54, 1618.11, 236.54]
    },
    {"id": "p175-b6", "type": "paragraph", "text": "Nợ phải trả", "bbox": [428.23, 361.34, 520.98, 379.34]},
    {"id": "p175-b7", "type": "paragraph", "text": "Phải trả người bán ngắn hạn", "bbox": [428.23, 392.21, 650.74, 410.21]},
    {"id": "p175-b8", "type": "paragraph", "text": "Phải trả người lao động", "bbox": [428.23, 423.08, 611.66, 441.08]},
    {"id": "p175-b9", "type": "paragraph", "text": "Thuế và các khoản phải nộp Nhà nước", "bbox": [428.23, 453.95, 731.26, 471.95]},
    {"id": "p175-b10", "type": "paragraph", "text": "Thuế thu nhập hoãn lại phải trả", "bbox": [428.23, 484.82, 674.28, 502.82]},
