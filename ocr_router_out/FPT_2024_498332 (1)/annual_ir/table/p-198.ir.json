  "blocks": [
    {"id": "p198-b1", "type": "heading", "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT", "bbox": [428.22, 68.74, 1105.62, 100.74]},
    {"id": "p198-b2", "type": "form_code", "text": "MẪU SỐ B 09 – DN/HN", "bbox": [1673.66, 77.8, 1859.49, 95.8]},
    {"id": "p198-b3", "type": "heading", "text": "CHO NĂM TÀI CHÍNH KẾT THÚC NGÀY 31 THÁNG 12 NĂM 2024", "bbox": [428.22, 114.6, 1279.68, 144.6]},
    {"id": "p198-b4", "type": "paragraph", "text": "34\nBÁO CÁO BỘ PHẬN (tiếp theo)", "bbox": [428.22, 186.71, 712.65, 204.71]},
    {"id": "p198-b5", "type": "paragraph", "text": "(a)\nBáo cáo bộ phận theo lĩnh vực kinh doanh của Tập đoàn", "bbox": [428.22, 217.22, 952.42, 235.22]},
    {
      "id": "p198-b6",
      "type": "paragraph",
      "text": "Cho năm tài chính kết thúc ngày 31 tháng 12 năm 2023 (Đơn vị: triệu đồng)",
      "bbox": [428.22, 253.39, 1054.39, 271.39]
    },
    {"id": "p198-b7", "type": "paragraph", "text": "Doanh thu thuần theo bộ phận", "bbox": [428.2, 442.49, 669.29, 460.49]},
    {"id": "p198-b8", "type": "paragraph", "text": "Chi phí theo bộ phận (*)", "bbox": [428.2, 476.2, 618.96, 494.2]},
    {"id": "p198-b9", "type": "paragraph", "text": "Trong đó:", "bbox": [428.2, 509.92, 503.67, 527.92]},
    {"id": "p198-b10", "type": "paragraph", "text": "- Tổng chi phí khấu hao TSCĐ và phân bổ LTTM", "bbox": [428.2, 543.63, 802.65, 561.63]},
    {"id": "p198-b11", "type": "paragraph", "text": "- Tổng phân bổ chi phí trả trước dài hạn", "bbox": [428.18, 577.35, 738.91, 595.35]},
    {"id": "p198-b12", "type": "paragraph", "text": "Phần (lỗ)/ lãi trong công ty liên doanh, liên kết", "bbox": [428.2, 611.06, 791.01, 629.06]},
    {"id": "p198-b13", "type": "paragraph", "text": "Kết quả HĐKD theo bộ phận", "bbox": [428.16, 644.77, 662.62, 662.77]},
    {"id": "p198-b14", "type": "paragraph", "text": "Lợi nhuận trước thuế theo bộ phận", "bbox": [428.18, 678.49, 716.88, 696.49]},
    {"id": "p198-b15", "type": "paragraph", "text": "Tổng chi phí đã phát sinh để mua TSCĐ và các\ntài sản dài hạn khác", "bbox": [428.16, 712.2, 796.95, 752.2]},
    {"id": "p198-b16", "type": "paragraph", "text": "Tài sản bộ phận tại 31/12/2023", "bbox": [428.18, 767.91, 674.98, 785.91]},
    {"id": "p198-b17", "type": "paragraph", "text": "Nợ phải trả bộ phận tại 31/12/2023", "bbox": [428.18, 801.62, 705.35, 819.62]},
    {
      "id": "p198-b18",
      "type": "paragraph",
      "text": "(*) Chi phí theo bộ phận là chi phí phát sinh từ các hoạt động kinh doanh của bộ phận được tính trực tiếp cho bộ phận đó và phần chi phí chung của Tập đoàn được phân bổ cho bộ phận đó. Theo đó, chi phí\ntheo bộ phận này bao gồm giá vốn hàng bán và dịch vụ cung cấp, chi phí bán hàng và chi phí quản lý doanh nghiệp.",
      "bbox": [428.22, 852.26, 1860.49, 892.26]
    },
    {"id": "p198-b19", "type": "paragraph", "text": "(tiếp theo)", "bbox": [956.93, 220.04, 1020.8, 234.04]},
    {"id": "p198-b20", "type": "paragraph", "text": "Công nghệ thông tin và viễn thông", "bbox": [994.7, 302.61, 1276.84, 320.61]},
