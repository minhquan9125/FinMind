  "blocks": [
    {"id": "p197-b1", "type": "heading", "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT", "bbox": [428.22, 68.74, 1105.62, 100.74]},
    {"id": "p197-b2", "type": "form_code", "text": "MẪU SỐ B 09 – DN/HN", "bbox": [1673.66, 77.81, 1859.49, 95.81]},
    {"id": "p197-b3", "type": "heading", "text": "CHO NĂM TÀI CHÍNH KẾT THÚC NGÀY 31 THÁNG 12 NĂM 2024", "bbox": [428.22, 114.6, 1279.68, 144.6]},
    {"id": "p197-b4", "type": "paragraph", "text": "34\nBÁO CÁO BỘ PHẬN", "bbox": [428.22, 186.71, 644.35, 204.71]},
    {"id": "p197-b5", "type": "paragraph", "text": "(a)\nBáo cáo bộ phận theo lĩnh vực kinh doanh của Tập đoàn", "bbox": [428.22, 217.22, 952.42, 235.22]},
    {
      "id": "p197-b6",
      "type": "paragraph",
      "text": "Cho năm tài chính kết thúc ngày 31 tháng 12 năm 2024 (Đơn vị: triệu đồng)",
      "bbox": [428.22, 253.4, 1054.39, 271.4]
    },
    {"id": "p197-b7", "type": "paragraph", "text": "Doanh thu thuần theo bộ phận", "bbox": [428.22, 442.49, 669.31, 460.49]},
    {"id": "p197-b8", "type": "paragraph", "text": "Chi phí theo bộ phận (*)", "bbox": [428.18, 476.2, 618.95, 494.2]},
    {"id": "p197-b9", "type": "paragraph", "text": "Trong đó:", "bbox": [428.18, 509.92, 503.65, 527.92]},
    {"id": "p197-b10", "type": "paragraph", "text": "- Tổng chi phí khấu hao TSCĐ và phân bổ LTTM", "bbox": [428.18, 549.62, 802.63, 567.62]},
    {"id": "p197-b11", "type": "paragraph", "text": "- Tổng phân bổ chi phí trả trước dài hạn", "bbox": [428.2, 583.34, 738.93, 601.34]},
    {"id": "p197-b12", "type": "paragraph", "text": "Phần (lỗ)/ lãi trong công ty liên doanh, liên kết", "bbox": [428.2, 617.05, 791.01, 635.05]},
    {"id": "p197-b13", "type": "paragraph", "text": "Kết quả HĐKD theo bộ phận", "bbox": [428.18, 650.77, 662.64, 668.77]},
    {"id": "p197-b14", "type": "paragraph", "text": "Lợi nhuận trước thuế theo bộ phận", "bbox": [428.17, 684.48, 716.86, 702.48]},
    {"id": "p197-b15", "type": "paragraph", "text": "Tổng chi phí đã phát sinh để mua TSCĐ và các\ntài sản dài hạn khác", "bbox": [428.15, 718.19, 796.93, 758.19]},
    {"id": "p197-b16", "type": "paragraph", "text": "Tài sản bộ phận tại 31/12/2024", "bbox": [428.17, 773.9, 674.96, 791.9]},
    {"id": "p197-b17", "type": "paragraph", "text": "Nợ phải trả bộ phận tại 31/12/2024", "bbox": [428.17, 807.62, 705.33, 825.62]},
