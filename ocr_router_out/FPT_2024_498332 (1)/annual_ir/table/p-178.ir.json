    {"id": "p178-b12", "type": "paragraph", "text": "liên kết trong năm", "bbox": [428.23, 425.83, 571.26, 443.83]},
    {"id": "p178-b13", "type": "paragraph", "text": "392.531.256.272", "bbox": [787.83, 459.53, 924.93, 477.53]},
    {
      "id": "p178-b14",
      "type": "paragraph",
      "text": "Phần lãi của Tập đoàn trong kết quả\nkinh doanh của các công ty liên\ndoanh, liên kết",
      "bbox": [428.22, 459.55, 711.99, 525.54]
    },
