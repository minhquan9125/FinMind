    {"id": "p178-b4", "type": "paragraph", "text": "5\nĐẦU TƯ TÀI CHÍNH (tiếp theo)", "bbox": [428.22, 188.53, 706.46, 206.53]},
    {"id": "p178-b5", "type": "paragraph", "text": "(b)\nĐầu tư góp vốn vào đơn vị khác", "bbox": [428.22, 219.04, 741.84, 237.04]},
    {"id": "p178-b6", "type": "paragraph", "text": "(tiếp theo)", "bbox": [746.3, 221.87, 810.17, 235.87]},
    {
      "id": "p178-b7",
      "type": "paragraph",
      "text": "Biến động đầu tư vào công ty liên doanh, liên kết trong năm tài chính như sau:",
      "bbox": [428.22, 255.21, 1043.44, 273.21]
    },
    {"id": "p178-b8", "type": "paragraph", "text": "Số dư đầu năm", "bbox": [428.23, 367.82, 547.85, 385.82]},
    {"id": "p178-b9", "type": "paragraph", "text": "2.107.616.686.383", "bbox": [772.57, 367.82, 924.92, 385.82]},
    {"id": "p178-b10", "type": "paragraph", "text": "Tăng đầu tư vào công ty liên doanh,", "bbox": [428.23, 401.84, 709.24, 419.84]},
