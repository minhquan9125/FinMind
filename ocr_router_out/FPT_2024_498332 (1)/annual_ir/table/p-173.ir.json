  "blocks": [
    {"id": "p173-b1", "type": "heading", "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT", "bbox": [428.22, 68.74, 1105.62, 100.74]},
    {"id": "p173-b2", "type": "form_code", "text": "MẪU SỐ B 09 – DN/HN", "bbox": [1673.66, 77.75, 1859.49, 95.75]},
    {"id": "p173-b3", "type": "heading", "text": "CHO NĂM TÀI CHÍNH KẾT THÚC NGÀY 31 THÁNG 12 NĂM 2024", "bbox": [428.22, 114.6, 1279.68, 144.6]},
    {"id": "p173-b4", "type": "paragraph", "text": "3\nHỢP NHẤT KINH DOANH", "bbox": [428.22, 188.04, 687.33, 206.04]},
    {
      "id": "p173-b5",
      "type": "paragraph",
      "text": "(a)\nHợp nhất kinh doanh trong năm tài chính kết thúc ngày 31 tháng 12 năm 2024",
      "bbox": [428.22, 218.55, 1122.89, 236.55]
    },
    {
      "id": "p173-b6",
      "type": "paragraph",
      "text": "Trong năm tài chính kết thúc ngày 31 tháng 12 năm 2024, Tập đoàn có thực hiện một số\ngiao dịch hợp nhất kinh doanh như sau:",
      "bbox": [428.22, 251.06, 1122.94, 293.05]
    },
    {"id": "p173-b7", "type": "paragraph", "text": "Công nghệ thông tin và viễn thông", "bbox": [428.22, 313.23, 715.73, 331.23]},
    {
      "id": "p173-b8",
      "type": "paragraph",
      "text": "Mua Công ty TNHH Tư vấn AOSIS:\nNgày 31 tháng 1 năm 2024, Tập đoàn đã mua lại 80% vốn chủ sở hữu của Công ty TNHH\nTư vấn AOSIS, một công ty được thành lập và hoạt động tại Pháp, và nắm quyền kiểm soát\ncông ty này. Công ty này trở thành công ty con và được hợp nhất vào báo cáo tài chính\nhợp nhất của Tập đoàn kể từ ngày nêu trên.",
      "bbox": [428.22, 351.88, 1123.0, 471.05]
    },
    {
      "id": "p173-b9",
      "type": "paragraph",
      "text": "Mua Công ty TNHH NAC:\nNgày 29 tháng 2 năm 2024, Tập đoàn đã mua lại 100% vốn chủ sở hữu của Công ty TNHH\nNAC, một công ty được thành lập và hoạt động tại Nhật, và nắm quyền kiểm soát công ty\nnày. Công ty này trở thành công ty con và được hợp nhất vào báo cáo tài chính hợp nhất\ncủa Tập đoàn kể từ ngày nêu trên.",
      "bbox": [428.22, 491.7, 1122.99, 610.88]
    },
    {"id": "p173-b10", "type": "paragraph", "text": "Đầu tư, giáo dục và khác", "bbox": [428.22, 629.06, 635.38, 647.06]},
    {
      "id": "p173-b11",
      "type": "paragraph",
      "text": "Mua Trường THPT Tây Hà Nội:\nNgày 31 tháng 1 năm 2024, Tập đoàn đã mua lại 100% vốn chủ sở hữu của Trường THPT\nTây Hà Nội, một công ty được thành lập và hoạt động tại Việt Nam, và nắm quyền kiểm\nsoát công ty này. Công ty này trở thành công ty con và được hợp nhất vào báo cáo tài\nchính hợp nhất của Tập đoàn kể từ ngày nêu trên.",
      "bbox": [428.22, 667.7, 1123.32, 786.88]
    },
    {
      "id": "p173-b12",
      "type": "paragraph",
      "text": "Việc hợp nhất kinh doanh này có ảnh hưởng đến tài sản thuần của Tập đoàn tại ngày mua\nnhư sau:",
      "bbox": [1165.6, 216.52, 1859.5, 258.51]
    },
    {"id": "p173-b13", "type": "paragraph", "text": "Tài sản", "bbox": [1165.6, 339.78, 1226.82, 357.78]},
    {"id": "p173-b14", "type": "paragraph", "text": "Tiền và các khoản tương đương tiền", "bbox": [1165.6, 370.65, 1448.22, 388.65]},
    {"id": "p173-b15", "type": "paragraph", "text": "Các khoản phải thu ngắn hạn", "bbox": [1165.6, 401.52, 1397.46, 419.52]},
    {"id": "p173-b16", "type": "paragraph", "text": "Thuế và các khoản phải thu Nhà nước", "bbox": [1165.6, 432.39, 1463.86, 450.39]},
    {"id": "p173-b17", "type": "paragraph", "text": "TSCĐ vô hình", "bbox": [1165.6, 463.26, 1272.07, 481.26]},
    {"id": "p173-b18", "type": "paragraph", "text": "Tài sản khác", "bbox": [1165.6, 494.13, 1264.22, 512.13]},
    {"id": "p173-b19", "type": "paragraph", "text": "Nợ phải trả", "bbox": [1165.6, 555.87, 1258.35, 573.87]},
    {"id": "p173-b20", "type": "paragraph", "text": "Phải trả người bán ngắn hạn", "bbox": [1165.6, 586.74, 1388.11, 604.74]},
    {"id": "p173-b21", "type": "paragraph", "text": "Phải trả người lao động", "bbox": [1165.6, 617.61, 1349.03, 635.61]},
    {"id": "p173-b22", "type": "paragraph", "text": "Thuế và các khoản phải nộp Nhà nước", "bbox": [1165.6, 648.48, 1468.63, 666.48]},
    {"id": "p173-b23", "type": "paragraph", "text": "Vay và nợ thuê tài chính", "bbox": [1165.6, 679.35, 1353.08, 697.35]},
    {"id": "p173-b24", "type": "paragraph", "text": "Thuế thu nhập hoãn lại phải trả", "bbox": [1165.6, 710.22, 1411.65, 728.22]},
    {"id": "p173-b25", "type": "paragraph", "text": "Nợ phải trả khác", "bbox": [1165.6, 741.09, 1295.59, 759.09]},
    {"id": "p173-b26", "type": "paragraph", "text": "Tài sản thuần", "bbox": [1165.6, 802.83, 1279.68, 820.83]},
    {"id": "p173-b27", "type": "paragraph", "text": "Lợi ích cổ đông không kiểm soát (Thuyết minh 24)", "bbox": [1165.6, 833.7, 1556.14, 851.7]},
    {"id": "p173-b28", "type": "paragraph", "text": "Tài sản thuần theo tỷ lệ sở hữu", "bbox": [1165.6, 864.57, 1405.99, 882.57]},
    {"id": "p173-b29", "type": "paragraph", "text": "Lợi thế thương mại (Thuyết minh 16)", "bbox": [1165.6, 895.44, 1453.67, 913.44]},
    {"id": "p173-b30", "type": "paragraph", "text": "Tổng giá phí", "bbox": [1165.6, 926.31, 1262.97, 944.31]},
    {"id": "p173-b31", "type": "paragraph", "text": "Khoản tiền thu được", "bbox": [1165.6, 957.18, 1325.1, 975.18]},
    {"id": "p173-b32", "type": "paragraph", "text": "Giá trị hợp lý tại ngày mua\nVND", "bbox": [1645.25, 284.42, 1859.53, 326.41]},
