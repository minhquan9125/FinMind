    {"id": "p193-b3", "type": "heading", "text": "CHO NĂM TÀI CHÍNH KẾT THÚC NGÀY 31 THÁNG 12 NĂM 2024", "bbox": [428.22, 114.6, 1279.68, 144.6]},
    {"id": "p193-b4", "type": "paragraph", "text": "25\nLÃI TRÊN CỔ PHIẾU", "bbox": [428.22, 186.71, 646.47, 204.71]},
    {"id": "p193-b5", "type": "paragraph", "text": "(a)\nLãi cơ bản trên cổ phiếu", "bbox": [428.22, 217.22, 682.81, 235.22]},
    {
      "id": "p193-b6",
      "type": "paragraph",
      "text": "Lãi cơ bản trên cổ phiếu được tính bằng hiệu của số lợi nhuận thuần phân bổ cho các\ncổ đông và số trích quỹ khen thưởng, phúc lợi và cổ tức của cổ phiếu ưu đãi, chia cho số\nlượng bình quân gia quyền của số cổ phiếu phổ thông đang lưu hành trong năm tài chính,\nđiều chỉnh cho cổ phiếu thưởng phát hành trong năm trừ đi cổ phiếu quỹ. Chi tiết như sau:",
      "bbox": [428.22, 253.4, 1123.05, 337.39]
    },
    {"id": "p193-b7", "type": "paragraph", "text": "Lợi nhuận thuần phân bổ cho các\ncổ đông (VND)", "bbox": [428.24, 431.71, 692.67, 473.7]},
    {"id": "p193-b8", "type": "paragraph", "text": "Trích quỹ khen thưởng, phúc lợi (VND)", "bbox": [428.24, 489.41, 729.1, 507.41]},
    {"id": "p193-b9", "type": "paragraph", "text": "Bình quân số cổ phiếu phổ thông đang\nlưu hành (cổ phiếu)", "bbox": [428.22, 557.45, 734.34, 599.45]},
    {"id": "p193-b10", "type": "paragraph", "text": "Lãi cơ bản trên mỗi cổ phiếu (VND)", "bbox": [428.22, 615.16, 706.0, 633.16]},
    {"id": "p193-b11", "type": "paragraph", "text": "2024\n(Điều chỉnh lại (*))", "bbox": [899.04, 373.51, 1124.05, 415.5]},
