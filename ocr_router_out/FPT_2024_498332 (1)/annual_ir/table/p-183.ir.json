    {
      "id": "p183-b23",
      "type": "paragraph",
      "text": "Nguyên giá TSCĐ vô hình của Tập đoàn đã khấu hao hết nhưng còn sử dụng tại ngày 31 tháng 12 năm 2024 là 974.197 triệu Đồng (tại ngày 31 tháng 12 năm 2023: 707.574 triệu Đồng).",
      "bbox": [428.22, 962.79, 1860.22, 980.79]
    },
