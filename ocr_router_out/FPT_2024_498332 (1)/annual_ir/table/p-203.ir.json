  "blocks": [
    {"id": "p203-b1", "type": "heading", "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT", "bbox": [428.22, 68.74, 1105.62, 100.74]},
    {"id": "p203-b2", "type": "form_code", "text": "MẪU SỐ B 09 – DN/HN", "bbox": [1673.66, 77.79, 1859.49, 95.79]},
    {"id": "p203-b3", "type": "heading", "text": "CHO NĂM TÀI CHÍNH KẾT THÚC NGÀY 31 THÁNG 12 NĂM 2024", "bbox": [428.22, 114.6, 1279.68, 144.6]},
    {"id": "p203-b4", "type": "paragraph", "text": "37\nCÁC KHOẢN MỤC NGOÀI BẢNG CÂN ĐỐI KẾ TOÁN HỢP NHẤT", "bbox": [428.22, 193.89, 998.53, 211.89]},
    {"id": "p203-b5", "type": "paragraph", "text": "Nợ khó đòi đã xử lý", "bbox": [479.25, 224.4, 638.78, 242.4]},
    {"id": "p203-b6", "type": "paragraph", "text": "Nợ khó đòi", "bbox": [428.22, 338.04, 514.17, 356.04]},
    {"id": "p203-b7", "type": "paragraph", "text": "638.434.100.449", "bbox": [787.36, 338.04, 924.46, 356.04]},
    {
      "id": "p203-b8",
      "type": "paragraph",
      "text": "Số nợ khó đòi đã xử lý trong năm 2024 chủ yếu bao gồm các khoản phải thu khách hàng\ncá nhân sử dụng dịch vụ internet bị quá hạn trên 2 năm và đã được Ban Tổng Giám đốc\nđánh giá không còn khả năng thu hồi.",
      "bbox": [428.22, 394.96, 1123.02, 460.95]
    },
    {
      "id": "p203-b9",
      "type": "paragraph",
      "text": "Báo cáo tài chính hợp nhất của Tập đoàn cho năm tài chính kết thúc ngày 31 tháng 12 năm 2024 đã được Phó Tổng Giám đốc của Công ty phê chuẩn ngày 11 tháng 3 năm 2025.",
      "bbox": [428.22, 552.37, 1827.87, 570.37]
    },
    {"id": "p203-b10", "type": "paragraph", "text": "38\nNỢ TIỀM TÀNG", "bbox": [1165.61, 193.86, 1344.33, 211.86]},
    {"id": "p203-b11", "type": "paragraph", "text": "Nghĩa vụ hoàn nguyên đối với khu đất thuê", "bbox": [1165.61, 232.04, 1522.9, 250.04]},
    {
      "id": "p203-b12",
      "type": "paragraph",
      "text": "Tập đoàn ký hợp đồng thuê các hợp đồng thuê đất và đã thực hiện việc xây dựng công",
      "bbox": [1165.61, 264.55, 1860.38, 282.55]
    },
    {"id": "p203-b13", "type": "paragraph", "text": "31/12/2024", "bbox": [832.84, 279.85, 924.5, 297.85]},
    {"id": "p203-b14", "type": "paragraph", "text": "31/12/2023", "bbox": [1031.37, 279.85, 1123.02, 297.85]},
    {
      "id": "p203-b15",
      "type": "paragraph",
      "text": "trình và hạ tầng trên các lô đất thuê này. Đa số các hợp đồng thuê đất này không có quy",
      "bbox": [1165.61, 288.54, 1860.38, 306.54]
    },
    {"id": "p203-b16", "type": "paragraph", "text": "VND", "bbox": [887.56, 303.84, 924.57, 321.84]},
    {"id": "p203-b17", "type": "paragraph", "text": "VND", "bbox": [1086.09, 303.84, 1123.09, 321.84]},
    {
      "id": "p203-b18",
      "type": "paragraph",
      "text": "định rõ về nghĩa vụ hoàn nguyên đối với đất thuê. Ban Tổng Giám đốc của Công ty đánh\ngiá là Tập đoàn có thể có nghĩa vụ trong tương lai liên quan đến việc tháo dỡ, di dời các tài",
      "bbox": [1165.61, 312.54, 1860.42, 354.53]
    },
    {"id": "p203-b19", "type": "paragraph", "text": "181.168.486.772", "bbox": [985.88, 338.04, 1122.99, 356.04]},
    {
      "id": "p203-b20",
      "type": "paragraph",
      "text": "sản của Tập đoàn ra khỏi khu đất thuê và phục hồi khu đất về tình trạng ban đầu tại cuối\nthời hạn thuê đất. Nghĩa vụ này chỉ có thể xác định được khi có thêm các sự kiện trong\ntương lai, như các trao đổi bổ sung với bên cho thuê đất hay khi cơ quan chức năng ban\nhành bổ sung các văn bản pháp luật làm rõ nghĩa vụ của bên đi thuê khi hợp đồng thuê\nđất không nêu rõ điều khoản hoàn nguyên. Do đó, Tập đoàn không ghi nhận khoản dự\nphòng chi phí hoàn nguyên đối với đất thuê vào báo cáo tài chính hợp nhất của Tập đoàn\ncho năm tài chính kết thúc ngày 31 tháng 12 năm 2024.",
      "bbox": [1165.61, 360.52, 1860.46, 522.49]
    },
    {"id": "p203-b21", "type": "heading", "text": "LÊ VĂN TRUNG", "bbox": [961.39, 819.2, 1088.31, 837.2]},
    {"id": "p203-b22", "type": "heading", "text": "HOÀNG HỮU CHIẾN", "bbox": [1235.96, 819.2, 1401.83, 837.2]},
    {"id": "p203-b23", "type": "paragraph", "text": "Người lập", "bbox": [961.39, 843.19, 1037.87, 861.19]},
    {"id": "p203-b24", "type": "paragraph", "text": "Kế toán trưởng", "bbox": [1235.96, 843.19, 1353.03, 861.19]},
    {
      "id": "p203-b25",
      "type": "paragraph",
      "text": "NGUYỄN THẾ PHƯƠNG\nPhó Tổng Giám đốc\nChữ ký được ủy quyền\nNgày 11 tháng 3 năm 2025",
      "bbox": [1517.71, 820.2, 1732.66, 910.18]
