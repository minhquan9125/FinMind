  "blocks": [
    {"id": "p195-b1", "type": "heading", "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT", "bbox": [428.22, 68.74, 1105.62, 100.74]},
    {"id": "p195-b2", "type": "form_code", "text": "MẪU SỐ B 09 – DN/HN", "bbox": [1673.65, 77.76, 1859.48, 95.76]},
    {"id": "p195-b3", "type": "heading", "text": "CHO NĂM TÀI CHÍNH KẾT THÚC NGÀY 31 THÁNG 12 NĂM 2024", "bbox": [428.22, 114.6, 1279.68, 144.6]},
    {"id": "p195-b4", "type": "paragraph", "text": "30\nCHI PHÍ BÁN HÀNG", "bbox": [428.22, 186.71, 643.67, 204.71]},
    {"id": "p195-b5", "type": "paragraph", "text": "Chi phí nhân viên", "bbox": [428.22, 295.89, 564.41, 313.89]},
    {"id": "p195-b6", "type": "paragraph", "text": "4.076.793.428.900", "bbox": [772.09, 295.89, 924.44, 313.89]},
    {"id": "p195-b7", "type": "paragraph", "text": "Khác (*)", "bbox": [428.22, 329.91, 494.64, 347.91]},
    {"id": "p195-b8", "type": "paragraph", "text": "2.039.168.542.883", "bbox": [772.09, 329.91, 924.44, 347.91]},
    {"id": "p195-b9", "type": "paragraph", "text": "6.115.961.971.783", "bbox": [769.5, 363.93, 924.44, 381.93]},
    {
      "id": "p195-b10",
      "type": "paragraph",
      "text": "(*) Khoản mục này chủ yếu bao gồm chi phí quảng cáo, khuyến mại, phí hoa hồng, thuê đất và văn\nphòng và các khoản chi phí bán hàng khác. Không có khoản mục chi phí nào chiếm hơn 10% trên\ntổng chi phí bán hàng.",
      "bbox": [428.22, 414.21, 1123.1, 478.21]
    },
    {"id": "p195-b11", "type": "paragraph", "text": "31\nCHI PHÍ QUẢN LÝ DOANH NGHIỆP", "bbox": [428.22, 535.38, 765.77, 553.38]},
    {"id": "p195-b12", "type": "paragraph", "text": "Chi phí nhân viên", "bbox": [428.22, 645.41, 564.41, 663.41]},
    {"id": "p195-b13", "type": "paragraph", "text": "4.251.955.881.293", "bbox": [772.09, 645.41, 924.44, 663.41]},
    {"id": "p195-b14", "type": "paragraph", "text": "Khác (*)", "bbox": [428.22, 679.43, 494.64, 697.43]},
    {"id": "p195-b15", "type": "paragraph", "text": "2.822.082.733.481", "bbox": [772.09, 679.43, 924.44, 697.43]},
    {"id": "p195-b16", "type": "paragraph", "text": "7.074.038.614.774", "bbox": [769.5, 713.45, 924.44, 731.45]},
    {
      "id": "p195-b17",
      "type": "paragraph",
      "text": "(*) Khoản mục này chủ yếu bao gồm chi phí khấu hao, dịch vụ thuê ngoài, dự phòng khoản phải thu\nkhó đòi và các khoản chi phí quản lý doanh nghiệp khác. Không có khoản mục chi phí nào chiếm hơn\n10% trên tổng chi phí quản lý doanh nghiệp.",
      "bbox": [428.22, 763.77, 1123.1, 827.77]
    },
    {"id": "p195-b18", "type": "paragraph", "text": "32\nTHUẾ THU NHẬP DOANH NGHIỆP (“TNDN”)", "bbox": [1165.61, 186.71, 1585.68, 204.71]},
    {
      "id": "p195-b19",
      "type": "paragraph",
      "text": "Theo quy định trong các Giấy Chứng nhận Đăng ký Doanh nghiệp của Công ty và các",
      "bbox": [1165.61, 219.22, 1860.45, 237.22]
    },
    {"id": "p195-b20", "type": "paragraph", "text": "2024", "bbox": [883.93, 237.69, 924.53, 255.69]},
    {"id": "p195-b21", "type": "paragraph", "text": "2023", "bbox": [1082.45, 237.69, 1123.06, 255.69]},
    {
      "id": "p195-b22",
      "type": "paragraph",
      "text": "công ty con và các quy định thuế hiện hành, các Công ty trong Tập đoàn có nghĩa vụ nộp",
      "bbox": [1165.61, 243.21, 1860.39, 261.21]
    },
    {"id": "p195-b23", "type": "paragraph", "text": "VND", "bbox": [887.56, 261.69, 924.57, 279.69]},
    {"id": "p195-b24", "type": "paragraph", "text": "VND", "bbox": [1086.08, 261.69, 1123.09, 279.69]},
    {
      "id": "p195-b25",
      "type": "paragraph",
      "text": "thuế TNDN với thuế suất 10% trên lợi nhuận chịu thuế đối với dịch vụ đào tạo đã cung\ncấp; thuế suất ưu đãi theo địa bàn đối với hoạt động sản xuất kinh doanh của một số đơn",
      "bbox": [1165.61, 267.21, 1860.38, 309.2]
    },
    {"id": "p195-b26", "type": "paragraph", "text": "3.395.892.582.048", "bbox": [970.61, 295.89, 1122.97, 313.89]},
    {
      "id": "p195-b27",
      "type": "paragraph",
      "text": "vị trong các khu công nghệ cao; và 20% trên lợi nhuận chịu thuế đối với các hoạt động",
      "bbox": [1165.61, 315.2, 1860.36, 333.2]
    },
    {"id": "p195-b28", "type": "paragraph", "text": "1.846.659.324.912", "bbox": [970.61, 329.91, 1122.97, 347.91]},
    {
      "id": "p195-b29",
      "type": "paragraph",
      "text": "sản xuất kinh doanh còn lại. Ngoài ra, các công ty con ở nước ngoài đóng thuế theo thuế\nsuất hiện hành tại nước sở tại.",
      "bbox": [1165.61, 339.19, 1860.36, 381.18]
    },
    {"id": "p195-b30", "type": "paragraph", "text": "5.242.551.906.960", "bbox": [968.02, 363.93, 1122.97, 381.93]},
    {"id": "p195-b31", "type": "paragraph", "text": "(a)\nChi phí thuế TNDN hiện hành", "bbox": [1165.6, 483.25, 1458.6, 501.25]},
    {"id": "p195-b32", "type": "paragraph", "text": "Chi phí thuế TNDN tính trên thu nhập\nchịu thuế năm hiện hành", "bbox": [1165.6, 516.96, 1457.46, 558.95]},
    {"id": "p195-b33", "type": "paragraph", "text": "Điều chỉnh chi phí thuế TNDN của các", "bbox": [1165.6, 574.67, 1465.5, 592.67]},
    {"id": "p195-b34", "type": "paragraph", "text": "2024", "bbox": [883.93, 587.21, 924.53, 605.21]},
    {"id": "p195-b35", "type": "paragraph", "text": "2023", "bbox": [1082.45, 587.21, 1123.06, 605.21]},
    {"id": "p195-b36", "type": "paragraph", "text": "năm trước vào chi phí thuế thu nhập", "bbox": [1165.6, 596.66, 1450.71, 614.66]},
    {"id": "p195-b37", "type": "paragraph", "text": "VND", "bbox": [887.56, 611.21, 924.57, 629.21]},
    {"id": "p195-b38", "type": "paragraph", "text": "VND", "bbox": [1086.08, 611.21, 1123.09, 629.21]},
    {"id": "p195-b39", "type": "paragraph", "text": "hiện hành năm nay", "bbox": [1165.6, 618.66, 1315.72, 636.66]},
    {"id": "p195-b40", "type": "paragraph", "text": "3.824.628.795.622", "bbox": [970.61, 645.41, 1122.97, 663.41]},
    {"id": "p195-b41", "type": "paragraph", "text": "Tổng chi phí thuế TNDN hiện hành (*)", "bbox": [1165.6, 652.37, 1462.79, 670.37]},
    {"id": "p195-b42", "type": "paragraph", "text": "2.800.744.842.737", "bbox": [970.61, 679.43, 1122.97, 697.43]},
    {"id": "p195-b43", "type": "paragraph", "text": "(b)\nThu nhập thuế TNDN hoãn lại", "bbox": [1165.6, 695.2, 1463.5, 713.2]},
    {"id": "p195-b44", "type": "paragraph", "text": "6.625.373.638.359", "bbox": [968.02, 713.45, 1122.97, 731.45]},
    {
      "id": "p195-b45",
      "type": "paragraph",
      "text": "Thu nhập thuế TNDN hoãn lại phát\nsinh từ các khoản chênh lệch tạm\nthời được khấu trừ",
      "bbox": [1165.6, 728.91, 1439.43, 794.9]
    },
    {
      "id": "p195-b46",
      "type": "paragraph",
      "text": "Chi phí thuế TNDN hoãn lại phát sinh\ntừ các khoản chênh lệch tạm thời\nphải chịu thuế",
      "bbox": [1165.6, 810.59, 1457.77, 876.58]
    },
    {"id": "p195-b47", "type": "paragraph", "text": "Tổng thu nhập thuế TNDN hoãn lại (*)", "bbox": [1165.6, 892.28, 1464.79, 910.28]},
    {"id": "p195-b48", "type": "paragraph", "text": "2024", "bbox": [1621.31, 416.23, 1661.92, 434.23]},
