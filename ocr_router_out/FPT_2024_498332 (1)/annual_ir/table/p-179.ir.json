    {"id": "p179-b4", "type": "paragraph", "text": "8\nPHẢI THU/PHẢI TRẢ THEO TIẾN ĐỘ KẾ HOẠCH HỢP ĐỒNG", "bbox": [432.61, 188.39, 972.97, 206.39]},
