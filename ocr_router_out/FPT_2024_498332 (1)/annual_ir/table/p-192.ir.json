    {"id": "p192-b17", "type": "paragraph", "text": "1.570.654.718.266", "bbox": [684.22, 663.66, 836.57, 681.66]},
    {"id": "p192-b18", "type": "paragraph", "text": "Trích lập quỹ", "bbox": [428.22, 697.68, 528.9, 715.68]},
    {"id": "p192-b19", "type": "paragraph", "text": "(156.081.719.685)", "bbox": [687.17, 697.68, 836.59, 715.68]},
    {"id": "p192-b20", "type": "paragraph", "text": "khen thưởng phúc lợi", "bbox": [428.22, 721.68, 594.87, 739.68]},
    {"id": "p192-b21", "type": "paragraph", "text": "Chia cổ tức bằng tiền", "bbox": [428.22, 755.39, 596.49, 773.39]},
    {"id": "p192-b22", "type": "paragraph", "text": "(553.843.649.346)", "bbox": [687.17, 755.39, 836.59, 773.39]},
    {"id": "p192-b23", "type": "paragraph", "text": "33.453.322.461", "bbox": [709.63, 789.39, 836.59, 807.39]},
    {
