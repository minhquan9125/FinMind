  "blocks": [
    {"id": "p105-b1", "type": "heading", "text": "HOẠT ĐỘNG VÌ MÔI TRƯỜNG XANH", "bbox": [428.22, 63.5, 724.9, 81.5]},
    {"id": "p105-b2", "type": "paragraph", "text": "Vấn đề trọng yếu", "bbox": [442.39, 106.71, 581.89, 124.71]},
    {"id": "p105-b3", "type": "paragraph", "text": "Cam kết", "bbox": [626.73, 106.71, 694.78, 124.71]},
    {"id": "p105-b4", "type": "paragraph", "text": "Mục tiêu", "bbox": [846.6, 106.71, 918.55, 124.71]},
    {"id": "p105-b5", "type": "paragraph", "text": "• Mục tiêu ngắn hạn: Đến năm", "bbox": [853.24, 141.22, 1093.18, 159.22]},
    {"id": "p105-b6", "type": "paragraph", "text": "Bảo vệ môi trường", "bbox": [442.38, 141.24, 595.41, 159.24]},
    {"id": "p105-b7", "type": "paragraph", "text": "Không ngừng cải thiện", "bbox": [626.71, 141.24, 805.26, 159.24]},
    {"id": "p105-b8", "type": "paragraph", "text": "2030, bằng nguồn lực của FPT", "bbox": [864.58, 165.21, 1106.72, 183.21]},
    {"id": "p105-b9", "type": "paragraph", "text": "môi trường làm việc", "bbox": [626.71, 165.23, 783.55, 183.23]},
    {"id": "p105-b10", "type": "paragraph", "text": "giảm 15,8% tổng lượng khí thải", "bbox": [864.58, 189.21, 1112.38, 207.21]},
    {"id": "p105-b11", "type": "paragraph", "text": "hướng tới môi trường", "bbox": [626.71, 189.22, 793.16, 207.22]},
    {"id": "p105-b12", "type": "paragraph", "text": "khí nhà kính phù hợp với mục", "bbox": [864.58, 213.2, 1095.98, 231.2]},
    {"id": "p105-b13", "type": "paragraph", "text": "làm việc xanh, an toàn,", "bbox": [626.71, 213.22, 809.2, 231.22]},
    {"id": "p105-b14", "type": "paragraph", "text": "tiêu chung của Việt Nam;", "bbox": [864.58, 237.19, 1064.65, 255.19]},
    {"id": "p105-b15", "type": "paragraph", "text": "lành mạnh.", "bbox": [626.71, 237.21, 715.54, 255.21]},
    {
      "id": "p105-b16",
      "type": "paragraph",
      "text": "• Mục tiêu dài hạn đến năm 2040\nlà NetZero (Cắt giảm lượng\nkhí thải gây hiệu ứng nhà kính\nxuống bằng 0) như cam kết của\nChính phủ Việt Nam tại COP 26.",
      "bbox": [853.24, 269.7, 1116.93, 383.68]
    },
    {"id": "p105-b17", "type": "heading", "text": "VÌ SỰ PHÁT TRIỂN CỦA CỘNG ĐỒNG", "bbox": [428.19, 475.89, 732.11, 493.89]},
    {"id": "p105-b18", "type": "paragraph", "text": "Vấn đề trọng yếu", "bbox": [442.39, 527.2, 581.89, 545.2]},
    {"id": "p105-b19", "type": "paragraph", "text": "Cam kết", "bbox": [639.69, 527.2, 707.74, 545.2]},
    {"id": "p105-b20", "type": "paragraph", "text": "Mục tiêu", "bbox": [843.79, 527.2, 915.74, 545.2]},
    {"id": "p105-b21", "type": "paragraph", "text": "• Đào tạo 10.000 kỹ sư bán dẫn,", "bbox": [850.47, 561.69, 1102.92, 579.69]},
    {"id": "p105-b22", "type": "paragraph", "text": "Là đơn vị dẫn đầu", "bbox": [639.71, 561.71, 779.89, 579.71]},
    {"id": "p105-b23", "type": "paragraph", "text": "Đào tạo nguồn", "bbox": [442.41, 561.73, 566.14, 579.73]},
    {"id": "p105-b24", "type": "paragraph", "text": "50.000 kỹ sư AI vào năm 2030;", "bbox": [861.81, 585.68, 1105.42, 603.68]},
    {"id": "p105-b25", "type": "paragraph", "text": "trong đào tạo công", "bbox": [639.71, 585.7, 790.77, 603.7]},
    {"id": "p105-b26", "type": "paragraph", "text": "nhân lực công nghệ", "bbox": [442.41, 585.72, 608.18, 603.72]},
    {"id": "p105-b27", "type": "paragraph", "text": "dân số có năng lực", "bbox": [639.71, 609.7, 789.72, 627.7]},
    {"id": "p105-b28", "type": "paragraph", "text": "chất lượng cao", "bbox": [442.41, 609.71, 567.63, 627.71]},
    {"id": "p105-b29", "type": "paragraph", "text": "• Đào tạo 01 triệu công dân số", "bbox": [850.47, 618.19, 1090.84, 636.19]},
    {"id": "p105-b30", "type": "paragraph", "text": "cạnh tranh toàn cầu.", "bbox": [639.71, 633.69, 802.91, 651.69]},
    {"id": "p105-b31", "type": "paragraph", "text": "toàn cầu vào năm 2030.", "bbox": [861.81, 642.19, 1052.96, 660.19]},
    {"id": "p105-b32", "type": "paragraph", "text": "Tiếp tục duy trì quỹ dành cho các", "bbox": [843.83, 804.33, 1105.69, 822.33]},
    {"id": "p105-b33", "type": "paragraph", "text": "Định hướng hoạt", "bbox": [639.73, 804.37, 771.11, 822.37]},
    {"id": "p105-b34", "type": "paragraph", "text": "Tạo điều kiện tốt", "bbox": [442.43, 804.38, 581.37, 822.38]},
    {"id": "p105-b35", "type": "paragraph", "text": "hoạt động phát triển vì cộng đồng", "bbox": [843.83, 828.32, 1111.44, 846.32]},
    {"id": "p105-b36", "type": "paragraph", "text": "động CSR vào hỗ trợ", "bbox": [639.73, 828.36, 801.9, 846.36]},
    {"id": "p105-b37", "type": "paragraph", "text": "nhất để trẻ em Việt", "bbox": [442.43, 828.38, 600.73, 846.38]},
    {"id": "p105-b38", "type": "paragraph", "text": "tập trung chủ yếu vào các hoạt", "bbox": [843.83, 852.32, 1087.36, 870.32]},
    {"id": "p105-b39", "type": "paragraph", "text": "điều kiện học tập tốt", "bbox": [639.73, 852.35, 801.27, 870.35]},
    {"id": "p105-b40", "type": "paragraph", "text": "Nam có cơ hội tiếp", "bbox": [442.43, 852.37, 599.86, 870.37]},
    {"id": "p105-b41", "type": "paragraph", "text": "động giáo dục.", "bbox": [843.83, 876.31, 962.74, 894.31]},
    {"id": "p105-b42", "type": "paragraph", "text": "hơn cho các hoàn", "bbox": [639.73, 876.35, 781.14, 894.35]},
    {"id": "p105-b43", "type": "paragraph", "text": "cận giáo dục chất", "bbox": [442.43, 876.37, 592.59, 894.37]},
    {"id": "p105-b44", "type": "paragraph", "text": "cảnh yếu thế tại các", "bbox": [639.73, 900.34, 797.71, 918.34]},
    {"id": "p105-b45", "type": "paragraph", "text": "lượng và bền vững", "bbox": [442.43, 900.36, 595.96, 918.36]},
    {"id": "p105-b46", "type": "paragraph", "text": "khu vực kinh tế khó\nkhăn, thuộc vùng núi,\nvùng sâu, vùng xa.", "bbox": [639.73, 924.34, 810.15, 990.32]},
    {"id": "p105-b47", "type": "paragraph", "text": "Kết quả nổi bật 2024", "bbox": [1164.64, 106.71, 1334.19, 124.71]},
    {"id": "p105-b48", "type": "paragraph", "text": "• Ban hành Chính sách môi trường;", "bbox": [1153.72, 141.18, 1429.64, 159.18]},
    {
      "id": "p105-b49",
      "type": "paragraph",
      "text": "• Chuẩn hoá phương pháp kiểm kê dữ liệu phát thải khí nhà kính cho phạm vi phát thải\n01 và phạm vi phát thải 02;",
      "bbox": [1153.72, 173.69, 1833.4, 215.68]
    },
    {"id": "p105-b50", "type": "paragraph", "text": "• 100% số liệu sử dụng năng lượng tại FPT được giám sát;", "bbox": [1153.72, 230.19, 1611.43, 248.19]},
    {"id": "p105-b51", "type": "paragraph", "text": "• Triển khai sử dụng 100% bóng đèn Led trong các cơ sở xây mới;", "bbox": [1153.72, 262.7, 1671.91, 280.7]},
    {
      "id": "p105-b52",
      "type": "paragraph",
      "text": "• Triệt để triển khai các chương trình xanh hoá như: 100% sử dụng cốc bằng vật liệu\nthân thiện môi trường, 100% không sử dụng chai nhựa trong văn phòng, 100% túi\nđựng rác trong văn phòng bằng các vật liệu có thể tái chế;",
      "bbox": [1153.72, 295.21, 1814.47, 361.2]
    },
    {
      "id": "p105-b53",
      "type": "paragraph",
      "text": "• 100% CBNV được đào tạo về chính sách môi trường và bảo vệ môi trường hàng năm.",
      "bbox": [1153.72, 375.7, 1835.2, 393.7]
    },
    {"id": "p105-b54", "type": "paragraph", "text": "Kết quả nổi bật 2024", "bbox": [1167.51, 527.2, 1337.05, 545.2]},
    {
      "id": "p105-b55",
      "type": "paragraph",
      "text": "• Nghiên cứu, ứng dụng và phát triển các giải pháp công nghệ tiên tiến nhất, gia tăng\ntương tác và cá nhân hóa trải nghiệm của người học; Đưa AI vào đào tạo từ Phổ thông\ntới Đại học, triển khai các buổi hướng dẫn ứng dụng các công cụ AI cho sinh viên;",
      "bbox": [1156.62, 561.69, 1843.27, 627.68]
    },
    {
      "id": "p105-b56",
      "type": "paragraph",
      "text": "• Mở chuyên ngành đào tạo bán dẫn và triển khai ba chương trình đào tạo bán dẫn\nchuyên sâu. Năm 2024 tuyển sinh 1.600 sinh viên ngành bán dẫn;",
      "bbox": [1156.62, 642.19, 1806.01, 684.18]
    },
    {
      "id": "p105-b57",
      "type": "paragraph",
      "text": "• Đẩy mạnh các chương trình học bổng tài năng: Trung tâm bồi dưỡng tài năng trẻ\nFPT (FYT), học bổng Nguyễn Văn Đạo và các chương trình tín dụng sinh viên để\ntạo cơ hội học tập cho sinh viên. Năm 2024, FPT đã trao 168,1 tỷ đồng học bổng\nNguyễn Văn Đạo.",
      "bbox": [1156.62, 698.69, 1804.42, 788.67]
    },
    {"id": "p105-b58", "type": "paragraph", "text": "• Sử dụng 66,3 tỷ đồng cho các hoạt động trách nhiệm xã hội;", "bbox": [1156.63, 804.31, 1649.43, 822.31]},
    {
      "id": "p105-b59",
      "type": "paragraph",
      "text": "• Đẩy mạnh xây dựng và nâng cấp các cơ sở giáo dục dành cho trẻ em; cung cấp môi\ntrường học tập an toàn, toàn diện và hiệu quả cho tất cả mọi người với các dự án\nÁnh sáng học đường, Chắp cánh ước mơ, Vệ sinh học đường, trường Hy Vọng ....\nTổng số học sinh tại trường Hy Vọng hết năm 2024 là 307 học sinh.",
      "bbox": [1156.63, 836.82, 1828.2, 926.8]
    },
    {"id": "p105-b60", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN 2024", "bbox": [42.0, 125.96, 333.44, 146.96]},
