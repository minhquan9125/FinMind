    {"id": "p105-b62", "type": "furniture", "text": "02\nDẤU ẤN 2024 & TỔNG QUAN VỀ FPT", "bbox": [40.5, 263.69, 315.44, 282.69]},
    {"id": "p105-b63", "type": "furniture", "text": "03\nCHIẾN LƯỢC PHÁT TRIỂN", "bbox": [39.5, 314.03, 243.52, 333.03]},
    {"id": "p105-b64", "type": "furniture", "text": "04\nPHÂN TÍCH HOẠT ĐỘNG KINH DOANH", "bbox": [39.5, 364.37, 326.26, 383.37]},
    {"id": "p105-b65", "type": "furniture", "text": "05\nQUẢN TRỊ CÔNG TY", "bbox": [39.5, 414.71, 206.67, 433.71]},
    {"id": "p105-b66", "type": "furniture", "text": "06\nBÁO CÁO ESG", "bbox": [45.96, 468.22, 178.32, 487.22]},
    {"id": "p105-b67", "type": "furniture", "text": "Thông điệp và Định hướng ESG", "bbox": [85.0, 513.58, 275.88, 527.58]},
    {"id": "p105-b68", "type": "furniture", "text": "Quản trị hướng đến phát triển bền vững", "bbox": [85.0, 545.54, 326.01, 559.54]},
    {"id": "p105-b69", "type": "furniture", "text": "Môi trường làm việc đẳng cấp, hạnh phúc", "bbox": [85.0, 577.5, 340.61, 591.5]},
    {"id": "p105-b70", "type": "furniture", "text": "Hoạt động vì môi trường xanh", "bbox": [85.0, 609.46, 267.5, 623.46]},
    {"id": "p105-b71", "type": "furniture", "text": "Song hành vì sự phát triển cộng đồng", "bbox": [85.5, 641.42, 315.28, 655.42]},
    {"id": "p105-b72", "type": "furniture", "text": "07\nBÁO CÁO TÀI CHÍNH", "bbox": [39.5, 681.36, 212.6, 700.36]},
