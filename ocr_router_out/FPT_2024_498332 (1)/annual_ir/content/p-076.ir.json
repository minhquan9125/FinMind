  "blocks": [
    {"id": "p76-b1", "type": "paragraph", "text": "NỘI DUNG CÁC PHIÊN HỌP VÀ NGHỊ QUYẾT (tiếp theo)", "bbox": [428.22, 63.5, 863.86, 81.5]},
    {"id": "p76-b2", "type": "paragraph", "text": "Phiên họp", "bbox": [442.39, 112.69, 525.16, 130.69]},
    {"id": "p76-b3", "type": "paragraph", "text": "Thành phần tham dự", "bbox": [560.31, 112.69, 731.17, 130.69]},
    {"id": "p76-b4", "type": "paragraph", "text": "Nội dung họp và Nghị quyết", "bbox": [801.26, 112.69, 1029.26, 130.69]},
    {"id": "p76-b5", "type": "paragraph", "text": "Phiên 10", "bbox": [442.39, 149.73, 514.74, 167.73]},
    {"id": "p76-b6", "type": "paragraph", "text": "Xin ý kiến bằng văn bản.", "bbox": [560.31, 149.73, 751.95, 167.73]},
    {"id": "p76-b7", "type": "paragraph", "text": "• Tăng vốn điều lệ cho Công ty Cổ phần FPT;", "bbox": [807.92, 149.73, 1157.62, 167.73]},
    {"id": "p76-b8", "type": "paragraph", "text": "Ban hành Nghị quyết số", "bbox": [560.31, 182.24, 748.73, 200.24]},
    {
      "id": "p76-b9",
      "type": "paragraph",
      "text": "• Giao cho Người đại diện theo pháp luật của Công ty tổ chức thực hiện việc cập nhật nội dung đăng ký",
      "bbox": [807.92, 185.07, 1684.12, 203.07]
    },
    {"id": "p76-b10", "type": "paragraph", "text": "Từ ngày", "bbox": [442.39, 187.91, 504.1, 205.91]},
    {"id": "p76-b11", "type": "paragraph", "text": "01.10-2024/NQ-HĐQTFPT", "bbox": [560.31, 206.24, 768.71, 224.24]},
    {"id": "p76-b12", "type": "paragraph", "text": "doanh nghiệp và cập nhật Điều lệ Công ty tương ứng.", "bbox": [819.26, 209.06, 1238.56, 227.06]},
    {"id": "p76-b13", "type": "paragraph", "text": "15/10 đến", "bbox": [442.39, 211.91, 522.37, 229.91]},
    {"id": "p76-b14", "type": "paragraph", "text": "ngày 22/10/2024.", "bbox": [560.31, 230.23, 699.43, 248.23]},
    {"id": "p76-b15", "type": "paragraph", "text": "21/10/2024", "bbox": [442.39, 235.9, 533.87, 253.9]},
    {"id": "p76-b16", "type": "paragraph", "text": "Phiên 11", "bbox": [442.39, 272.4, 514.74, 290.4]},
    {"id": "p76-b17", "type": "paragraph", "text": "HĐQT: 06/07 thành viên.", "bbox": [560.31, 272.4, 753.96, 290.4]},
    {
      "id": "p76-b18",
      "type": "paragraph",
      "text": "• Thông qua việc tăng vốn điều lệ cho FPT Smart Cloud từ mức vốn hiện tại là 200 tỷ VNĐ lên 1.000 tỷ VNĐ.",
      "bbox": [807.92, 272.4, 1651.27, 290.4]
    },
    {"id": "p76-b19", "type": "paragraph", "text": "Quan sát viên:", "bbox": [560.31, 304.91, 673.48, 322.91]},
    {"id": "p76-b20", "type": "paragraph", "text": "30/10/2024", "bbox": [442.39, 310.58, 533.87, 328.58]},
    {"id": "p76-b21", "type": "paragraph", "text": "• Ban Kiểm soát: 03/03;", "bbox": [566.97, 337.42, 753.65, 355.42]},
    {"id": "p76-b22", "type": "paragraph", "text": "• Ban Điều hành: 03/03.", "bbox": [566.97, 369.93, 754.14, 387.93]},
    {"id": "p76-b23", "type": "paragraph", "text": "Ban hành Nghị quyết số\n02.10-2024/NQ-HĐQTFPT\nngày 31/10/2024.", "bbox": [560.31, 402.44, 768.71, 468.42]},
    {
      "id": "p76-b24",
      "type": "paragraph",
      "text": "Thành viên HĐQT có trách nhiệm tham gia tất cả các cuộc họp trong năm và có ý kiến rõ ràng về các vấn đề được đưa ra thảo luận, đồng thời đảm bảo tối thiểu 01 cuộc họp/quý.\nTrong trường hợp không thể tham dự cuộc họp, thành viên HĐQT phải thông báo bằng văn bản cho Văn phòng Chủ tịch HĐQT.",
      "bbox": [428.22, 521.3, 1860.19, 563.29]
    },
    {"id": "p76-b25", "type": "paragraph", "text": "Ghi chú", "bbox": [1704.09, 112.69, 1766.89, 130.69]},
    {"id": "p76-b26", "type": "paragraph", "text": "Đã công bố thông\ntin tại văn bản số\n250/FPT-FAF ngày\n22/10/2024.", "bbox": [1704.09, 149.72, 1847.27, 239.7]},
    {"id": "p76-b27", "type": "paragraph", "text": "Đã công bố thông\ntin tại văn bản số\n274/FPT-FAF ngày\n01/11/2024.", "bbox": [1704.09, 272.4, 1847.27, 362.39]},
