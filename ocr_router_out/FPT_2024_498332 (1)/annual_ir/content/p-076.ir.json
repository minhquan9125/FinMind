    {"id": "p76-b36", "type": "paragraph", "text": "Thành viên HĐQT có kinh nghiệm", "bbox": [825.31, 827.27, 1089.65, 845.27]},
    {"id": "p76-b37", "type": "paragraph", "text": "dày dạn chuyên sâu trong", "bbox": [471.3, 851.27, 674.92, 869.27]},
    {"id": "p76-b38", "type": "paragraph", "text": "dày dạn chuyên sâu trong lĩnh", "bbox": [825.31, 851.27, 1062.11, 869.27]},
    {"id": "p76-b39", "type": "paragraph", "text": "lĩnh vực CNTT", "bbox": [471.3, 875.26, 581.87, 893.26]},
