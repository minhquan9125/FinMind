    {"id": "p106-b8", "type": "heading", "text": "MÔI TRƯỜNG LÀM VIỆC ĐẲNG CẤP, HẠNH PHÚC", "bbox": [428.22, 434.88, 837.88, 452.88]},
    {"id": "p106-b9", "type": "paragraph", "text": "TT\nCam kết", "bbox": [449.56, 478.08, 564.27, 496.08]},
    {"id": "p106-b10", "type": "paragraph", "text": "1\nNơi làm việc hạnh phúc", "bbox": [449.96, 512.6, 681.65, 530.6]},
    {"id": "p106-b11", "type": "paragraph", "text": "2\nNơi làm việc hạnh phúc", "bbox": [449.94, 546.32, 681.63, 564.32]},
    {"id": "p106-b12", "type": "paragraph", "text": "3\nTổ chức học tập suốt đời", "bbox": [449.92, 580.03, 690.92, 598.03]},
    {"id": "p106-b13", "type": "paragraph", "text": "4\nBình đẳng và đa dạng", "bbox": [449.9, 613.74, 667.46, 631.74]},
