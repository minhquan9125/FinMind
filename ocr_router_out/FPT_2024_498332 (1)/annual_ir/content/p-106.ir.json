    {"id": "p106-b15", "type": "heading", "text": "HOẠT ĐỘNG VÌ MÔI TRƯỜNG XANH", "bbox": [428.22, 764.8, 724.9, 782.8]},
    {"id": "p106-b16", "type": "paragraph", "text": "TT\nCam kết", "bbox": [449.56, 808.0, 564.29, 826.0]},
    {"id": "p106-b17", "type": "paragraph", "text": "1\nChính sách môi trường", "bbox": [449.97, 842.53, 676.04, 860.53]},
    {"id": "p106-b18", "type": "paragraph", "text": "2\nGiám sát số liệu sử dụng năng lượng", "bbox": [449.96, 876.24, 784.81, 894.24]},
    {"id": "p106-b19", "type": "paragraph", "text": "3\nChính sách môi trường", "bbox": [449.94, 909.95, 676.0, 927.95]},
    {"id": "p106-b20", "type": "paragraph", "text": "4\nTiết kiệm điện", "bbox": [449.92, 943.67, 607.49, 961.67]},
    {"id": "p106-b21", "type": "paragraph", "text": "Chỉ tiêu", "bbox": [867.86, 166.49, 930.74, 184.49]},
    {
      "id": "p106-b22",
      "type": "paragraph",
      "text": "Số lượng sự cố an toàn thông tin ảnh hưởng đến danh tiếng Tập đoàn bằng 0.",
      "bbox": [867.84, 201.01, 1478.31, 219.01]
    },
    {"id": "p106-b23", "type": "paragraph", "text": "100% nhân viên được đào tạo an toàn bảo mật thông tin.", "bbox": [867.82, 234.73, 1318.25, 252.73]},
    {"id": "p106-b24", "type": "paragraph", "text": "100% cán bộ mua sắm được đào tạo về mua sắm bền vững.", "bbox": [867.81, 268.44, 1342.37, 286.44]},
    {
      "id": "p106-b25",
      "type": "paragraph",
      "text": "Không ký hợp đồng với các nhà cung cấp có các hoạt động ảnh hưởng đến sức\nkhoẻ, an toàn lao động và môi trường.",
      "bbox": [867.79, 302.16, 1491.1, 344.15]
    },
    {"id": "p106-b26", "type": "paragraph", "text": "Chỉ tiêu", "bbox": [867.86, 478.08, 930.74, 496.08]},
    {
      "id": "p106-b27",
      "type": "paragraph",
      "text": "Tỷ lệ nghỉ việc thấp hơn so với mức trung bình thị trường (cho khối Công nghệ).",
      "bbox": [867.84, 512.6, 1490.78, 530.6]
    },
    {"id": "p106-b28", "type": "paragraph", "text": "Số lượng CBNV được hỗ trợ mua nhà, mua xe.", "bbox": [867.82, 546.32, 1230.69, 564.32]},
    {"id": "p106-b29", "type": "paragraph", "text": "Số giờ học với số giờ đào tạo trung bình CBNV/năm.", "bbox": [867.81, 580.03, 1277.15, 598.03]},
    {"id": "p106-b30", "type": "paragraph", "text": "Tỷ lệ nữ giới trong quy mô nhân sự.", "bbox": [867.79, 613.74, 1143.85, 631.74]},
    {"id": "p106-b31", "type": "paragraph", "text": "Tỷ lệ nữ giới là quản lý trong quy mô nhân sự.", "bbox": [867.77, 647.46, 1223.77, 665.46]},
    {"id": "p106-b32", "type": "paragraph", "text": "Chỉ tiêu", "bbox": [867.88, 808.0, 930.75, 826.0]},
    {"id": "p106-b33", "type": "paragraph", "text": "Tỷ lệ nhân viên được đào tạo chính sách môi trường.", "bbox": [867.86, 842.53, 1280.27, 860.53]},
    {"id": "p106-b34", "type": "paragraph", "text": "Tỷ lệ năng lượng sử dụng được giám sát.", "bbox": [867.84, 876.24, 1188.22, 894.24]},
    {"id": "p106-b35", "type": "paragraph", "text": "Tỷ lệ túi rác trong văn phòng sử dụng vật liệu tái chế.", "bbox": [867.83, 909.95, 1283.32, 927.95]},
    {"id": "p106-b36", "type": "paragraph", "text": "Tỷ lệ sử dụng đèn Led.", "bbox": [867.81, 943.67, 1045.19, 961.67]},
