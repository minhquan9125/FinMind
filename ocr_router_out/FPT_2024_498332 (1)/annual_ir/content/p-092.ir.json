  "blocks": [
    {"id": "p92-b1", "type": "heading", "text": "BÁO CÁO CỦA BAN KIỂM SOÁT", "bbox": [429.49, 76.22, 1251.61, 134.22]},
    {"id": "p92-b2", "type": "heading", "text": "THÀNH PHẦN VÀ CƠ CẤU BAN KIỂM SOÁT", "bbox": [429.35, 163.57, 1216.76, 203.57]},
    {
      "id": "p92-b3",
      "type": "paragraph",
      "text": "Năm 2024, Ban Kiểm soát (BKS) không có sự thay đổi vị trí cũng như số lượng từ đầu\nnhiệm kỳ 2022-2027. Căn cứ theo luật định, Ban Kiểm soát có các nhiệm vụ chính sau:",
      "bbox": [432.0, 221.47, 1122.99, 263.47]
    },
    {"id": "p92-b4", "type": "paragraph", "text": "Thực hiện các quyền giám sát thực thi\nĐiều lệ công ty.", "bbox": [432.0, 397.95, 743.96, 439.94]},
    {
      "id": "p92-b5",
      "type": "paragraph",
      "text": "Phối hợp cùng kiểm toán độc lập\ngiám sát tính minh bạch hoạt động tài\nchính của Tập đoàn.",
      "bbox": [432.0, 592.29, 743.95, 658.28]
    },
    {"id": "p92-b6", "type": "heading", "text": "THÔNG TIN VỀ THÀNH VIÊN BAN KIỂM SOÁT", "bbox": [428.74, 791.84, 804.38, 809.84]},
    {"id": "p92-b7", "type": "paragraph", "text": "STT\nThành viên BKS", "bbox": [471.63, 835.2, 673.41, 853.2]},
    {"id": "p92-b8", "type": "paragraph", "text": "1\nÔng Nguyễn Việt Thắng", "bbox": [482.6, 869.4, 732.15, 887.4]},
    {"id": "p92-b9", "type": "paragraph", "text": "2\nÔng Nguyễn Khải Hoàn", "bbox": [482.63, 903.12, 729.46, 921.12]},
    {"id": "p92-b10", "type": "paragraph", "text": "3\nBà Dương Thùy Dương", "bbox": [482.67, 936.83, 721.68, 954.83]},
    {
      "id": "p92-b11",
      "type": "paragraph",
      "text": "Giám sát việc thực thi Nghị quyết\nĐHĐCĐ thường niên 2024 nhằm bảo vệ\nquyền lợi của Cổ đông.",
      "bbox": [804.01, 397.96, 1115.98, 463.95]
    },
    {
      "id": "p92-b12",
      "type": "paragraph",
      "text": "Giám sát việc triển khai các chức năng,\nnhiệm vụ và tính minh bạch của thành\nviên HĐQT, thành viên Ban Điều hành\ntheo luật định.",
      "bbox": [804.01, 592.27, 1116.03, 682.26]
    },
    {"id": "p92-b13", "type": "paragraph", "text": "Chức vụ", "bbox": [812.55, 835.2, 879.08, 853.2]},
    {"id": "p92-b14", "type": "paragraph", "text": "Ngày bắt đầu là thành viên BKS", "bbox": [1097.44, 835.2, 1355.48, 853.2]},
    {"id": "p92-b15", "type": "paragraph", "text": "Trưởng Ban Kiểm soát", "bbox": [812.59, 869.4, 987.32, 887.4]},
    {"id": "p92-b16", "type": "paragraph", "text": "07/04/2022 tái bầu cử", "bbox": [1097.48, 869.4, 1271.34, 887.4]},
    {"id": "p92-b17", "type": "paragraph", "text": "Thành viên Ban Kiểm soát", "bbox": [812.63, 903.12, 1018.39, 921.12]},
    {"id": "p92-b18", "type": "paragraph", "text": "07/04/2022 tái bầu cử", "bbox": [1097.51, 903.12, 1271.38, 921.12]},
    {"id": "p92-b19", "type": "paragraph", "text": "Thành viên Ban Kiểm soát", "bbox": [812.66, 936.83, 1018.42, 954.83]},
