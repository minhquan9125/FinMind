  "blocks": [
    {"id": "p87-b1", "type": "heading", "text": "QUAN HỆ VỚI CÁC BÊN CÓ QUYỀN LỢI LIÊN QUAN", "bbox": [428.53, 71.04, 1357.68, 111.04]},
    {
      "id": "p87-b2",
      "type": "paragraph",
      "text": "Song song với việc đảm bảo tăng trưởng ổn định trước\ntình hình địa chính trị phức tạp và nền kinh tế trì trệ, các\nhoạt động kinh doanh của Tập đoàn đều được thực hiện\ntrên nguyên tắc đảm bảo lợi ích cao nhất cho các bên\nliên quan. Đồng thời, để các bên liên quan có thể lên\ntiếng và/hoặc khiếu kiện về những vi phạm có thể xảy ra\nđối với quyền lợi của họ, FPT công khai thông tin liên hệ\ntheo từng lĩnh vực trên website của Tập đoàn tại địa chỉ:\nhttps://fpt.com/vi/lien-he.",
      "bbox": [428.22, 131.27, 870.9, 341.23]
    },
    {"id": "p87-b3", "type": "heading", "text": "NGUYÊN TẮC 10", "bbox": [930.26, 141.68, 1079.65, 159.68]},
    {"id": "p87-b4", "type": "paragraph", "text": "Tăng cường tham gia hiệu quả của các bên có quyền lợi liên quan", "bbox": [913.23, 194.48, 1463.78, 212.48]},
    {"id": "p87-b5", "type": "paragraph", "text": "Bên liên quan", "bbox": [927.4, 247.41, 1039.76, 265.41]},
    {"id": "p87-b6", "type": "paragraph", "text": "Cam kết của FPT", "bbox": [1200.86, 247.41, 1339.96, 265.41]},
    {"id": "p87-b7", "type": "paragraph", "text": "Khách hàng", "bbox": [927.4, 281.93, 1022.04, 299.93]},
    {
      "id": "p87-b8",
      "type": "paragraph",
      "text": "Đầu tư phát triển các nền tảng, giải pháp, sản phẩm công nghệ, viễn thông, giáo\ndục đáp ứng nhu cầu của khách hàng và không ngừng nâng cao uy tín thương hiệu,\nchất lượng nguồn nhân lực nhằm đảm bảo uy tín với khách hàng.",
      "bbox": [1200.86, 281.93, 1846.09, 347.92]
    },
    {"id": "p87-b9", "type": "paragraph", "text": "Cổ đông, nhà đầu tư", "bbox": [927.4, 363.63, 1088.45, 381.63]},
    {
      "id": "p87-b10",
      "type": "paragraph",
      "text": "Minh bạch hóa thông tin và nỗ lực mang lại lợi ích cao nhất cho cổ đông, nhà đầu tư.",
      "bbox": [1200.86, 363.63, 1845.99, 381.63]
    },
    {"id": "p87-b11", "type": "paragraph", "text": "Cán bộ nhân viên", "bbox": [927.4, 397.65, 1064.72, 415.65]},
    {"id": "p87-b12", "type": "paragraph", "text": "Tạo điều kiện tốt nhất để CBNV phát huy thế mạnh và thành công.", "bbox": [1200.86, 397.65, 1720.53, 415.65]},
    {"id": "p87-b13", "type": "paragraph", "text": "Cộng đồng", "bbox": [927.4, 431.67, 1015.01, 449.67]},
    {
      "id": "p87-b14",
      "type": "paragraph",
      "text": "Ứng dụng công nghệ kết nối cộng đồng, mang lại những giá trị tốt đẹp hơn cho\ncuộc sống và trở thành điểm tựa tin cậy cho sự phát triển của cộng đồng.",
      "bbox": [1200.86, 431.67, 1845.99, 473.67]
    },
    {"id": "p87-b15", "type": "paragraph", "text": "Chính phủ và các bộ,", "bbox": [927.4, 489.38, 1093.38, 507.38]},
    {
      "id": "p87-b16",
      "type": "paragraph",
      "text": "Luôn đồng hành với các chương trình, đề án lớn của Quốc gia hướng đến mục tiêu",
      "bbox": [1200.86, 489.38, 1846.03, 507.38]
    },
    {"id": "p87-b17", "type": "paragraph", "text": "ban ngành", "bbox": [927.4, 513.38, 1011.82, 531.38]},
    {"id": "p87-b18", "type": "paragraph", "text": "vì một Việt Nam hùng cường.", "bbox": [1200.86, 513.38, 1430.95, 531.38]},
    {"id": "p87-b19", "type": "paragraph", "text": "Đối tác, nhà cung cấp", "bbox": [927.4, 547.09, 1100.29, 565.09]},
    {
      "id": "p87-b20",
      "type": "paragraph",
      "text": "Nỗ lực thiết lập quan hệ với các đối tác trên cơ sở thấu hiểu sâu sắc, phát huy tối\nđa sức mạnh hợp tác, gắn bó lâu dài, cùng thành công và phát triển bền vững.",
      "bbox": [1200.86, 547.09, 1845.96, 589.08]
    },
    {"id": "p87-b21", "type": "paragraph", "text": "Báo chí và cơ quan", "bbox": [927.4, 604.8, 1077.21, 622.8]},
    {
      "id": "p87-b22",
      "type": "paragraph",
      "text": "Cung cấp kịp thời và minh bạch các thông tin liên quan đến hoạt động của FPT",
      "bbox": [1200.86, 604.8, 1846.36, 622.8]
    },
    {"id": "p87-b23", "type": "paragraph", "text": "truyền thông", "bbox": [927.4, 628.79, 1027.6, 646.79]},
    {"id": "p87-b24", "type": "paragraph", "text": "cũng như các CTTV.", "bbox": [1200.86, 628.79, 1359.6, 646.79]},
    {
      "id": "p87-b25",
      "type": "paragraph",
      "text": "HĐQT cũng đã ban hành Nghị quyết Quản lý giao dịch với các bên liên quan đối với các giao dịch nhỏ hơn 35% tổng giá\ntrị tài sản của Tập đoàn được ghi trong Báo cáo Tài chính tại thời điểm gần nhất. Trong năm 2024, FPT không phát hiện\nbất kỳ giao dịch nào có xung đột lợi ích với Tập đoàn. Chính sách chống tham nhũng và chống hối lộ cũng được Tập đoàn\nthực hiện nghiêm ngặt.",
      "bbox": [913.24, 708.84, 1860.34, 798.82]
    },
    {"id": "p87-b26", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN 2024", "bbox": [42.0, 125.96, 333.44, 146.96]},
    {"id": "p87-b27", "type": "furniture", "text": "01\nTHÔNG ĐIỆP BAN LÃNH ĐẠO", "bbox": [43.5, 213.56, 271.58, 232.56]},
    {"id": "p87-b28", "type": "furniture", "text": "02\nDẤU ẤN 2024 & TỔNG QUAN VỀ FPT", "bbox": [40.5, 263.9, 315.44, 282.9]},
    {"id": "p87-b29", "type": "furniture", "text": "03\nCHIẾN LƯỢC PHÁT TRIỂN", "bbox": [39.5, 314.24, 243.52, 333.24]},
    {"id": "p87-b30", "type": "furniture", "text": "04\nPHÂN TÍCH HOẠT ĐỘNG KINH DOANH", "bbox": [39.5, 364.58, 326.26, 383.58]},
    {"id": "p87-b31", "type": "furniture", "text": "05\nQUẢN TRỊ CÔNG TY", "bbox": [45.96, 418.09, 213.95, 437.09]},
    {"id": "p87-b32", "type": "furniture", "text": "Mô hình quản trị và vai trò của các bên", "bbox": [85.0, 463.45, 322.68, 477.45]},
    {"id": "p87-b33", "type": "furniture", "text": "Quản trị công ty năm 2024", "bbox": [85.0, 495.41, 248.7, 509.41]},
