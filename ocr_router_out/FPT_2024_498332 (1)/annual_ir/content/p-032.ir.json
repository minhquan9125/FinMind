    {"id": "p32-b34", "type": "heading", "text": "THỐNG KÊ GIAO DỊCH VÀ GIÁ CỔ PHIẾU NĂM 2024", "bbox": [428.51, 664.22, 855.33, 682.22]},
    {"id": "p32-b35", "type": "paragraph", "text": "Giá cao nhất", "bbox": [442.75, 718.77, 546.76, 736.77]},
    {"id": "p32-b36", "type": "paragraph", "text": "152.500\nVNĐ/cổ phiếu", "bbox": [431.66, 766.2, 545.98, 808.19]},
    {"id": "p32-b37", "type": "paragraph", "text": "Vốn điều lệ", "bbox": [701.39, 114.88, 793.02, 132.88]},
    {"id": "p32-b38", "type": "paragraph", "text": "Lý do", "bbox": [835.56, 114.88, 878.99, 132.88]},
    {
      "id": "p32-b39",
      "type": "paragraph",
      "text": "Tăng vốn thông qua phát hành cổ phiếu cho CBNV có thành tích đóng góp trong năm 2019.",
      "bbox": [835.56, 173.1, 1558.72, 191.1]
    },
    {
      "id": "p32-b40",
      "type": "paragraph",
      "text": "Tăng vốn từ kết quả kinh doanh năm 2019 thông qua trả cổ tức bằng cổ phiếu theo tỉ lệ 15%.",
      "bbox": [835.56, 206.81, 1567.45, 224.81]
    },
    {
      "id": "p32-b41",
      "type": "paragraph",
      "text": "Tăng vốn thông qua phát hành cổ phiếu theo chương trình lựa chọn cho đối tượng là CBNV có thành tích đóng góp trong năm\n2020; và phát hành cổ phiếu mới theo chương trình phát hành cổ phiếu cho đối tượng là cán bộ lãnh đạo cấp cao năm 2021.",
      "bbox": [835.56, 240.52, 1845.98, 282.52]
    },
    {
      "id": "p32-b42",
      "type": "paragraph",
      "text": "Tăng vốn từ kết quả kinh doanh năm 2020 thông qua trả cổ tức bằng cổ phiếu theo tỉ lệ 15%.",
      "bbox": [835.56, 298.23, 1567.45, 316.23]
    },
    {
      "id": "p32-b43",
      "type": "paragraph",
      "text": "Tăng vốn thông qua phát hành cổ phiếu theo chương trình lựa chọn cho đối tượng là CBNV có thành tích đóng góp trong năm\n2021; và phát hành cổ phiếu mới theo chương trình phát hành cổ phiếu cho đối tượng là cán bộ lãnh đạo cấp cao năm 2022.",
      "bbox": [835.56, 331.95, 1845.98, 373.94]
    },
    {
      "id": "p32-b44",
      "type": "paragraph",
      "text": "Tăng vốn từ kết quả kinh doanh năm 2021 thông qua trả cổ tức bằng cổ phiếu theo tỉ lệ 20%.",
      "bbox": [835.56, 389.65, 1567.45, 407.65]
    },
    {
      "id": "p32-b45",
      "type": "paragraph",
      "text": "Tăng vốn thông qua phát hành cổ phiếu theo chương trình lựa chọn cho đối tượng là CBNV có thành tích đóng góp trong năm\n2022; và phát hành cổ phiếu mới theo chương trình phát hành cổ phiếu cho đối tượng là cán bộ lãnh đạo cấp cao năm 2023.",
      "bbox": [835.56, 423.37, 1845.98, 465.36]
    },
    {
      "id": "p32-b46",
      "type": "paragraph",
      "text": "Tăng vốn từ kết quả kinh doanh năm 2022 thông qua trả cổ tức bằng cổ phiếu theo tỉ lệ 15%.",
      "bbox": [835.56, 481.08, 1567.45, 499.08]
    },
    {
      "id": "p32-b47",
      "type": "paragraph",
      "text": "Tăng vốn sau đợt phát hành cổ phiếu để tăng vốn từ nguồn vốn chủ sở hữu cho cổ đông hiện hữu theo tỉ lệ 15%.",
      "bbox": [835.56, 514.79, 1718.85, 532.79]
    },
    {
      "id": "p32-b48",
      "type": "paragraph",
      "text": "Tăng vốn thông qua phát hành cổ phiếu theo chương trình lựa chọn cho đối tượng là CBNV có thành tích đóng góp trong\nnăm 2023; và phát hành cổ phiếu theo chương trình lựa chọn cho đối tượng là cán bộ lãnh đạo cấp cao năm 2024.",
      "bbox": [835.56, 548.5, 1845.96, 590.5]
    },
