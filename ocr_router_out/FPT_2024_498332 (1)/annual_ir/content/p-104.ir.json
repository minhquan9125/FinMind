  "blocks": [
    {"id": "p104-b1", "type": "heading", "text": "TẠO MÔI TRƯỜNG LÀM VIỆC ĐẲNG CẤP, HẠNH PHÚC", "bbox": [428.03, 63.5, 877.47, 81.5]},
    {"id": "p104-b2", "type": "paragraph", "text": "Vấn đề trọng yếu", "bbox": [442.21, 108.75, 581.7, 126.75]},
    {"id": "p104-b3", "type": "paragraph", "text": "Cam kết", "bbox": [626.74, 108.75, 694.79, 126.75]},
    {"id": "p104-b4", "type": "paragraph", "text": "Mục tiêu", "bbox": [952.92, 108.75, 1024.87, 126.75]},
    {"id": "p104-b5", "type": "paragraph", "text": "• Đạt và duy trì liên tục Danh hiệu", "bbox": [959.58, 143.22, 1220.99, 161.22]},
    {"id": "p104-b6", "type": "paragraph", "text": "Nơi làm", "bbox": [442.21, 143.27, 507.12, 161.27]},
    {"id": "p104-b7", "type": "paragraph", "text": "Dựa trên nền tảng giá trị văn hóa", "bbox": [626.74, 143.27, 884.25, 161.27]},
    {"id": "p104-b8", "type": "paragraph", "text": "Nơi làm việc xuất sắc nhất châu Á", "bbox": [970.92, 167.21, 1238.1, 185.21]},
    {"id": "p104-b9", "type": "paragraph", "text": "việc hạnh phúc", "bbox": [442.21, 167.27, 569.73, 185.27]},
    {"id": "p104-b10", "type": "paragraph", "text": "Tôn - Đổi - Đồng, Chí - Gương -", "bbox": [626.74, 167.27, 879.8, 185.27]},
    {"id": "p104-b11", "type": "paragraph", "text": "do Great Place To Work ® công bố;", "bbox": [970.92, 190.58, 1238.58, 209.27]},
    {"id": "p104-b12", "type": "paragraph", "text": "Sáng, FPT cam kết duy trì một nơi\nlàm việc hạnh phúc mà ở đó mọi cá", "bbox": [626.74, 191.26, 907.6, 233.26]},
    {"id": "p104-b13", "type": "paragraph", "text": "• Hướng đến xây dựng môi trường", "bbox": [959.57, 223.77, 1225.53, 241.77]},
    {"id": "p104-b14", "type": "paragraph", "text": "nhân dễ dàng hòa nhập, có cơ hội", "bbox": [626.74, 239.25, 896.0, 257.25]},
    {"id": "p104-b15", "type": "paragraph", "text": "làm việc hạnh phúc dựa trên nhiều", "bbox": [970.91, 247.77, 1243.12, 265.77]},
    {"id": "p104-b16", "type": "paragraph", "text": "tham gia, đóng góp, phát triển một", "bbox": [626.74, 263.24, 902.91, 281.24]},
    {"id": "p104-b17", "type": "paragraph", "text": "khía cạnh: Chăm sóc sức khỏe thể", "bbox": [970.91, 271.76, 1242.78, 289.76]},
    {"id": "p104-b18", "type": "paragraph", "text": "cách tự do và công bằng. Đồng thời,", "bbox": [626.74, 287.24, 913.22, 305.24]},
    {"id": "p104-b19", "type": "paragraph", "text": "chất và tinh thần, điều kiện làm", "bbox": [970.91, 295.76, 1217.41, 313.76]},
    {"id": "p104-b20", "type": "paragraph", "text": "luôn đổi mới, sáng tạo để mang lại", "bbox": [626.74, 311.23, 900.49, 329.23]},
    {"id": "p104-b21", "type": "paragraph", "text": "việc hiện đại, thu nhập và phúc lợi", "bbox": [970.91, 319.75, 1238.96, 337.75]},
    {"id": "p104-b22", "type": "paragraph", "text": "hạnh phúc cho CBNV dựa trên các", "bbox": [626.74, 335.23, 898.77, 353.23]},
    {"id": "p104-b23", "type": "paragraph", "text": "tốt, có cơ hội được phát triển, được", "bbox": [970.91, 343.74, 1248.61, 361.74]},
    {"id": "p104-b24", "type": "paragraph", "text": "yếu tố: tài chính, thể chất, trí tuệ và", "bbox": [626.74, 359.22, 904.0, 377.22]},
    {"id": "p104-b25", "type": "paragraph", "text": "tham gia đóng góp cho cộng đồng.", "bbox": [970.91, 367.74, 1249.44, 385.74]},
    {"id": "p104-b26", "type": "paragraph", "text": "tinh thần.", "bbox": [626.74, 383.21, 701.78, 401.21]},
    {"id": "p104-b27", "type": "paragraph", "text": "• Sử dụng công nghệ để cá thể hóa", "bbox": [959.57, 498.92, 1236.83, 516.92]},
    {"id": "p104-b28", "type": "paragraph", "text": "Tổ chức học", "bbox": [442.2, 498.94, 544.17, 516.94]},
    {"id": "p104-b29", "type": "paragraph", "text": "Duy trì FPT luôn là tổ chức học", "bbox": [626.73, 498.94, 867.33, 516.94]},
    {"id": "p104-b30", "type": "paragraph", "text": "việc học tập của mỗi cá nhân;", "bbox": [970.91, 522.92, 1207.49, 540.92]},
    {"id": "p104-b31", "type": "paragraph", "text": "tập suốt đời", "bbox": [442.2, 522.93, 542.2, 540.93]},
    {"id": "p104-b32", "type": "paragraph", "text": "tập, kiến tạo việc học tập suốt\nđời của CBNV.", "bbox": [626.73, 522.93, 864.04, 564.93]},
    {"id": "p104-b33", "type": "paragraph", "text": "• Đẩy mạnh và nâng cao số giờ học\ntập cho CBNV;", "bbox": [959.57, 555.42, 1237.54, 597.42]},
    {
      "id": "p104-b34",
      "type": "paragraph",
      "text": "• Nâng cao hiệu quả đào tạo bằng\ncông nghệ tiên tiến: AI Mentor,\nText-to-voice, chatbot ….",
      "bbox": [959.57, 611.93, 1229.5, 677.91]
    },
    {"id": "p104-b35", "type": "paragraph", "text": "• Duy trì tỷ lệ nữ giới trong quy mô", "bbox": [959.57, 702.07, 1226.28, 720.07]},
    {"id": "p104-b36", "type": "paragraph", "text": "Bình đẳng", "bbox": [442.2, 702.12, 527.54, 720.12]},
    {"id": "p104-b37", "type": "paragraph", "text": "Duy trì một môi trường làm việc bình", "bbox": [626.73, 702.12, 913.82, 720.12]},
    {"id": "p104-b38", "type": "paragraph", "text": "nhân sự trên 35%;", "bbox": [970.91, 726.06, 1115.78, 744.06]},
    {"id": "p104-b39", "type": "paragraph", "text": "và đa dạng", "bbox": [442.2, 726.12, 534.75, 744.12]},
    {
      "id": "p104-b40",
      "type": "paragraph",
      "text": "đẳng, tôn trọng cá nhân, không phân\nbiệt đối xử vì các lý do: Chủng tộc,",
      "bbox": [626.73, 726.12, 919.88, 768.11]
    },
    {"id": "p104-b41", "type": "paragraph", "text": "• Duy trì và tăng cường sự đa dạng", "bbox": [959.57, 758.57, 1230.86, 776.57]},
    {"id": "p104-b42", "type": "paragraph", "text": "màu da, dân tộc, quốc tịch, tôn giáo,", "bbox": [626.73, 774.11, 917.74, 792.11]},
    {"id": "p104-b43", "type": "paragraph", "text": "số lượng CBNV có quốc tịch", "bbox": [970.91, 782.57, 1192.69, 800.57]},
    {"id": "p104-b44", "type": "paragraph", "text": "giới tính, tuổi tác, khuynh hướng tình", "bbox": [626.73, 798.1, 915.74, 816.1]},
    {"id": "p104-b45", "type": "paragraph", "text": "nước ngoài.", "bbox": [970.91, 806.56, 1064.6, 824.56]},
    {
      "id": "p104-b46",
      "type": "paragraph",
      "text": "dục, khuyết tật, hoặc bất kỳ hành vi\nphân biệt đối xử nào khác bị cấm bởi\nPháp luật Nhà nước Việt Nam hoặc\ncác quốc gia trên toàn cầu mà FPT\ncó hiện diện.",
      "bbox": [626.73, 822.09, 917.51, 936.07]
    },
    {"id": "p104-b47", "type": "paragraph", "text": "Kết quả nổi bật 2024", "bbox": [1296.0, 108.75, 1465.55, 126.75]},
    {
      "id": "p104-b48",
      "type": "paragraph",
      "text": "• Triển khai các chính sách phúc lợi chăm sóc sức khỏe thể chất và\ntinh thần cho CBNV: Khám sức khỏe cho 100% CBNV; bảo hiểm y tế\nriêng FPT Care cho 100% CBNV;",
      "bbox": [1285.08, 143.24, 1835.09, 209.23]
    },
    {"id": "p104-b49", "type": "paragraph", "text": "• Tổ chức chuỗi chương trình Vui khỏe - Gắn kết - Yêu thương;", "bbox": [1285.08, 223.74, 1770.66, 241.74]},
    {
      "id": "p104-b50",
      "type": "paragraph",
      "text": "• Đưa vào hoạt động phân khu ba của Khu Công nghệ thông tin\ntập trung FPT Complex tại Đà Nẵng, đáp ứng chỗ làm việc cho\n10.000 nhân sự;",
      "bbox": [1285.08, 256.25, 1788.39, 322.23]
    },
    {
      "id": "p104-b51",
      "type": "paragraph",
      "text": "• Đẩy mạnh triển khai và nâng cao hiệu quả chương trình khoán thu\nnhập đảm bảo các yếu tố: Minh bạch, làm nhiều hưởng nhiều và trả\nsớm, hướng tới nâng cao mặt bằng thu nhập;",
      "bbox": [1285.08, 336.74, 1828.05, 402.73]
    },
    {
      "id": "p104-b52",
      "type": "paragraph",
      "text": "• Xây dựng và phát triển các chính sách phúc lợi ngoài lương: Chính\nsách An cư lạc nghiệp (hỗ trợ mua nhà, xe). Đã có hơn 3.500 CBNV\nđược hỗ trợ mua nhà, mua xe.",
      "bbox": [1285.08, 417.24, 1826.27, 483.23]
    },
    {
      "id": "p104-b53",
      "type": "paragraph",
      "text": "• Ứng dụng AI Mentoring, AI Knowledge Explore trong việc cá thể hóa\nlộ trình học tập cho CBNV;",
      "bbox": [1285.08, 498.9, 1832.66, 540.9]
    },
    {
      "id": "p104-b54",
      "type": "paragraph",
      "text": "• Ký kết hợp tác cùng Udemy, cung cấp hơn 58.200 tài khoản học tập\ncho CBNV toàn Tập đoàn;",
      "bbox": [1285.08, 555.41, 1830.61, 597.4]
    },
    {"id": "p104-b55", "type": "paragraph", "text": "• Đạt 139 giờ học trung bình/năm/CBNV;", "bbox": [1285.08, 611.91, 1603.9, 629.91]},
    {
      "id": "p104-b56",
      "type": "paragraph",
      "text": "• 184,7 tỷ đồng chi cho hoạt động đào tạo, ghi nhận trên 06 triệu\ngiờ đào tạo.",
      "bbox": [1285.08, 644.42, 1796.32, 686.41]
    },
    {
      "id": "p104-b57",
      "type": "paragraph",
      "text": "• Ban hành các chính sách đảm bảo tính công bằng, dân chủ và đa\ndạng như: Chính sách tôn trọng quyền con người, Quy định chăm sóc\nsức khoẻ cho CBNV, Quy định chế độ đãi ngộ cho CBNV, Quy định đối\nthoại định kỳ tại nơi làm việc …;",
      "bbox": [1285.08, 702.05, 1845.5, 792.03]
    },
    {"id": "p104-b58", "type": "paragraph", "text": "• Tỷ lệ nhân sự nữ chiếm 37,1% tổng nhân sự;", "bbox": [1285.08, 806.54, 1646.62, 824.54]},
    {
      "id": "p104-b59",
      "type": "paragraph",
      "text": "• Tích cực mở rộng tuyển dụng CBNV người nước ngoài. Trong năm\n2024, số CBNV người nước ngoài là 3.489 người với 87 quốc tịch,\ntăng 19,3% so với cùng kỳ.",
      "bbox": [1285.08, 839.05, 1815.28, 905.04]
    },
    {"id": "p104-b60", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN 2024", "bbox": [42.0, 125.96, 333.44, 146.96]},
    {"id": "p104-b61", "type": "furniture", "text": "01\nTHÔNG ĐIỆP BAN LÃNH ĐẠO", "bbox": [43.5, 213.35, 271.58, 232.35]},
    {"id": "p104-b62", "type": "furniture", "text": "02\nDẤU ẤN 2024 & TỔNG QUAN VỀ FPT", "bbox": [40.5, 263.69, 315.44, 282.69]},
    {"id": "p104-b63", "type": "furniture", "text": "03\nCHIẾN LƯỢC PHÁT TRIỂN", "bbox": [39.5, 314.03, 243.52, 333.03]},
    {"id": "p104-b64", "type": "furniture", "text": "04\nPHÂN TÍCH HOẠT ĐỘNG KINH DOANH", "bbox": [39.5, 364.37, 326.26, 383.37]},
    {"id": "p104-b65", "type": "furniture", "text": "05\nQUẢN TRỊ CÔNG TY", "bbox": [39.5, 414.71, 206.67, 433.71]},
    {"id": "p104-b66", "type": "furniture", "text": "06\nBÁO CÁO ESG", "bbox": [45.96, 468.22, 178.32, 487.22]},
    {"id": "p104-b67", "type": "furniture", "text": "Thông điệp và Định hướng ESG", "bbox": [85.0, 513.58, 275.88, 527.58]},
    {"id": "p104-b68", "type": "furniture", "text": "Quản trị hướng đến phát triển bền vững", "bbox": [85.0, 545.54, 326.01, 559.54]},
    {"id": "p104-b69", "type": "furniture", "text": "Môi trường làm việc đẳng cấp, hạnh phúc", "bbox": [85.0, 577.5, 340.61, 591.5]},
    {"id": "p104-b70", "type": "furniture", "text": "Hoạt động vì môi trường xanh", "bbox": [85.0, 609.46, 267.5, 623.46]},
    {"id": "p104-b71", "type": "furniture", "text": "Song hành vì sự phát triển cộng đồng", "bbox": [85.5, 641.42, 315.28, 655.42]},
    {"id": "p104-b72", "type": "furniture", "text": "07\nBÁO CÁO TÀI CHÍNH", "bbox": [39.5, 681.36, 212.6, 700.36]},
    {"id": "p104-b73", "type": "furniture", "text": "06", "bbox": [30.0, 961.65, 198.17, 1080]},
