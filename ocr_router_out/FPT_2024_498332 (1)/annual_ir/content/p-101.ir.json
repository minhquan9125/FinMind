  "blocks": [
    {"id": "p101-b1", "type": "heading", "text": "ĐỊNH HƯỚNG VÀ CAM KẾT VỀ ESG CỦA TẬP ĐOÀN", "bbox": [429.35, 71.04, 1369.43, 111.04]},
    {"id": "p101-b2", "type": "heading", "text": "Định hướng ESG", "bbox": [428.03, 130.69, 660.35, 162.69]},
    {
      "id": "p101-b3",
      "type": "paragraph",
      "text": "Định hướng và những ưu tiên về ESG được xem là một phần quan trọng trong chiến lược phát triển của FPT và phản ánh vai trò, trách nhiệm của Tập đoàn với các bên liên quan trọng yếu.",
      "bbox": [428.03, 177.22, 1860.35, 195.22]
    },
    {"id": "p101-b4", "type": "paragraph", "text": "ESG tạo thêm sức mạnh để FPT phát huy giá trị cốt lõi,", "bbox": [917.27, 323.79, 1372.15, 341.79]},
    {"id": "p101-b5", "type": "paragraph", "text": "tiếp tục thực hiện sứ mệnh Tập đoàn toàn cầu trường tồn và hạnh phúc.", "bbox": [845.29, 353.8, 1444.09, 371.8]},
    {"id": "p101-b6", "type": "paragraph", "text": "Tạo môi trường làm việc đẳng", "bbox": [945.92, 435.26, 1195.16, 453.26]},
    {"id": "p101-b7", "type": "paragraph", "text": "Các vấn đề trọng yếu", "bbox": [447.18, 447.27, 623.35, 465.27]},
    {"id": "p101-b8", "type": "paragraph", "text": "Quản trị xuất sắc", "bbox": [704.76, 447.27, 847.17, 465.27]},
