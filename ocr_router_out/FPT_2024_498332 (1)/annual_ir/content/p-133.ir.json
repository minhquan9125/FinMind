  "blocks": [
    {"id": "p133-b1", "type": "heading", "text": "QUẢN LÝ HIỆU QUẢ TIÊU THỤ NĂNG LƯỢNG VÀ KIỂM KÊ KHÍ NHÀ KÍNH", "bbox": [428.53, 71.51, 1743.18, 111.51]},
    {
      "id": "p133-b2",
      "type": "paragraph",
      "text": "2024 là năm thứ hai FPT triển khai kiểm kê khí nhà kính trên phạm vi toàn Tập đoàn",
      "bbox": [428.22, 118.94, 1083.74, 136.94]
    },
    {"id": "p133-b3", "type": "paragraph", "text": "Phạm vi và phương pháp", "bbox": [522.56, 228.17, 729.95, 246.17]},
    {"id": "p133-b4", "type": "kpi", "text": "100%", "bbox": [428.98, 290.0, 579.43, 348.0]},
    {
      "id": "p133-b5",
      "type": "paragraph",
      "text": "Cơ sở thuộc quyền kiểm soát vận hành của FPT\nđược tiến hành kiểm kê khí nhà kính",
      "bbox": [428.98, 351.63, 803.6, 393.63]
    },
    {"id": "p133-b6", "type": "kpi", "text": "100%", "bbox": [428.98, 424.44, 579.43, 482.44]},
    {
      "id": "p133-b7",
      "type": "paragraph",
      "text": "Dữ liệu phát thải khí nhà kính phạm vi 1,2 và 3\nđược chuẩn hoá và triển khai đồng bộ tới CTTV",
      "bbox": [428.98, 483.07, 799.88, 525.06]
    },
    {"id": "p133-b8", "type": "kpi", "text": "100%", "bbox": [428.98, 579.13, 579.43, 637.13]},
    {"id": "p133-b9", "type": "paragraph", "text": "Dữ liệu phát thải phạm vi 1 và 2 được thu thập, tính toán", "bbox": [428.98, 637.76, 859.22, 655.76]},
    {"id": "p133-b10", "type": "heading", "text": "Phạm vi 3", "bbox": [428.22, 710.5, 559.85, 739.5]},
    {"id": "p133-b11", "type": "paragraph", "text": "Triển khai thí điểm tại CTTV", "bbox": [428.22, 751.67, 646.17, 769.67]},
    {"id": "p133-b12", "type": "paragraph", "text": "Dữ liệu phát thải FPT 2024", "bbox": [998.91, 228.17, 1217.94, 246.17]},
    {"id": "p133-b13", "type": "kpi", "text": "143.574", "bbox": [921.63, 290.0, 1134.31, 348.0]},
    {"id": "p133-b14", "type": "heading", "text": "tấn CO2", "bbox": [1142.86, 309.8, 1252.15, 339.8]},
    {"id": "p133-b15", "type": "paragraph", "text": "Tổng phát thải khí nhà kính thuộc phạm vi 1 và 2", "bbox": [921.65, 351.63, 1303.28, 369.63]},
    {"id": "p133-b16", "type": "paragraph", "text": "Lượng phát thải chủ yếu đến từ điện năng phục vụ sản", "bbox": [921.26, 415.61, 1371.02, 433.61]},
    {
      "id": "p133-b17",
      "type": "paragraph",
      "text": "xuất kinh doanh của FPT (Phạm vi 2 chiếm 96,6%). Lượng\nphát thải từ điện năng này tăng 16% so với năm 2023, tỷ lệ\nthuận với xu hướng tăng trưởng của FPT trong năm 2024)",
      "bbox": [921.26, 439.61, 1371.0, 505.6]
    },
    {
      "id": "p133-b18",
      "type": "paragraph",
      "text": "FPT đang tích cực triển khai các biện pháp để giảm\nthiểu phát thải khí nhà kính từ điện năng nói riêng và tất\ncả các nguồn phát thải nói chung, phục vụ mục tiêu đạt",
      "bbox": [921.26, 525.77, 1371.02, 591.76]
    },
    {"id": "p133-b19", "type": "paragraph", "text": "NetZero vào 2040.", "bbox": [921.26, 597.76, 1067.93, 615.76]},
    {"id": "p133-b20", "type": "paragraph", "text": "4.826", "bbox": [953.2, 673.26, 1002.12, 692.26]},
    {"id": "p133-b21", "type": "paragraph", "text": "Các nguồn phát thải khí nhà kính được FPT thực\nhiện bao gồm:", "bbox": [1413.54, 773.29, 1860.47, 815.29]},
    {
      "id": "p133-b22",
      "type": "paragraph",
      "text": "• Phạm vi 1 - Phát thải khí nhà kính trực tiếp phát sinh từ\ncác nguồn do FPT sở hữu hoặc kiểm soát.",
      "bbox": [1401.11, 835.19, 1860.47, 877.19]
    },
    {"id": "p133-b23", "type": "paragraph", "text": "138.748", "bbox": [1265.92, 871.6, 1336.28, 890.6]},
    {
      "id": "p133-b24",
      "type": "paragraph",
      "text": "• Phạm vi 2 - Phát thải khí nhà kính gián tiếp phát sinh từ\nviệc sử dụng điện, hơi nước, nhiệt được mua từ nhà cung\ncấp bên ngoài.",
      "bbox": [1401.11, 897.37, 1860.48, 963.35]
    },
