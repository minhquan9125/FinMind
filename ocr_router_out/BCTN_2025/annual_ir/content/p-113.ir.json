  "blocks": [
    {"id": "p113-b1", "type": "paragraph", "text": "Định hướng và cam kết về ESG của Tập đoàn", "bbox": [259.29, 42.24, 587.99, 58.24]},
    {"id": "p113-b2", "type": "paragraph", "text": "• Định hướng ESG", "bbox": [259.19, 73.48, 357.23, 85.48]},
    {
      "id": "p113-b3",
      "type": "paragraph",
      "text": "Định hướng và các ưu tiên ESG tiếp tục được FPT xác định là một cấu phần quan\ntrọng trong chiến lược phát triển dài hạn, qua đó thể hiện rõ vai trò và trách nhiệm\ncủa Tập đoàn đối với các bên liên quan trọng yếu.",
      "bbox": [259.19, 101.53, 623.56, 135.53]
    },
    {"id": "p113-b4", "type": "paragraph", "text": "Các vấn đề trọng yếu", "bbox": [271.6, 240.75, 370.19, 250.75]},
    {"id": "p113-b5", "type": "paragraph", "text": "Quản trị xuất sắc", "bbox": [405.62, 240.75, 485.05, 250.75]},
    {"id": "p113-b6", "type": "paragraph", "text": "Phương pháp", "bbox": [423.4, 296.86, 465.35, 303.86]},
    {"id": "p113-b7", "type": "paragraph", "text": "Tiêu chuẩn GRI (*)", "bbox": [271.61, 303.02, 355.85, 313.02]},
    {"id": "p113-b8", "type": "paragraph", "text": "quản trị", "bbox": [423.4, 305.26, 447.62, 312.26]},
    {"id": "p113-b9", "type": "paragraph", "text": "Quản trị Công ty", "bbox": [403.36, 363.18, 477.5, 373.18]},
    {"id": "p113-b10", "type": "paragraph", "text": "Quản trị dữ liệu", "bbox": [403.36, 390.18, 471.54, 400.18]},
    {"id": "p113-b11", "type": "paragraph", "text": "Quản trị rủi ro,", "bbox": [403.36, 417.18, 467.71, 427.18]},
    {"id": "p113-b12", "type": "paragraph", "text": "Cam kết của FPT", "bbox": [275.61, 423.63, 354.15, 433.63]},
    {"id": "p113-b13", "type": "paragraph", "text": "chống tham nhũng", "bbox": [403.36, 429.18, 487.48, 439.18]},
    {"id": "p113-b14", "type": "paragraph", "text": "Quản trị an toàn thông tin", "bbox": [403.36, 456.18, 518.1, 466.18]},
    {"id": "p113-b15", "type": "paragraph", "text": "Quản trị mua sắm\nbền vững", "bbox": [403.36, 483.18, 483.23, 505.18]},
    {
      "id": "p113-b16",
      "type": "paragraph",
      "text": "(*) Tổ chức sử dụng một số tiêu chuẩn hoặc một phần nội dung của tiêu chuẩn GRI để báo cáo các tác động liên quan đến từng chủ đề kinh tế, xã hội hoặc môi trường.",
      "bbox": [275.6, 535.63, 824.89, 543.13]
    },
    {
      "id": "p113-b17",
      "type": "paragraph",
      "text": "Trên nền tảng bốn trục nội dung xuyên suốt gồm: Quản trị xuất sắc, Môi trường làm\nviệc đẳng cấp và hạnh phúc, Hoạt động vì môi trường xanh và Song hành vì sự phát\ntriển cộng đồng, FPT tăng cường đầu tư vào công nghệ, con người và năng lực\nquản trị nhằm cụ thể hóa các cam kết ESG, bảo đảm tạo lập giá trị bền vững và lâu\ndài cho Tập đoàn.",
      "bbox": [651.24, 101.53, 1016.4, 159.53]
    },
    {
      "id": "p113-b18",
      "type": "paragraph",
      "text": "ESG tạo thêm sức mạnh để FPT phát huy giá trị cốt lõi,\ntiếp tục thực hiện sứ mệnh Tập đoàn toàn cầu trường tồn và hạnh phúc.",
      "bbox": [483.25, 191.12, 794.86, 213.12]
    },
    {"id": "p113-b19", "type": "paragraph", "text": "Hoạt động", "bbox": [743.35, 234.75, 791.82, 244.75]},
    {"id": "p113-b20", "type": "paragraph", "text": "Tạo môi trường làm việc", "bbox": [549.32, 234.83, 655.01, 244.83]},
    {"id": "p113-b21", "type": "paragraph", "text": "vì môi trường xanh", "bbox": [743.35, 246.75, 829.09, 256.75]},
    {"id": "p113-b22", "type": "paragraph", "text": "đẳng cấp, hạnh phúc", "bbox": [549.32, 246.83, 641.62, 256.83]},
    {"id": "p113-b23", "type": "paragraph", "text": "Kinh tế", "bbox": [566.88, 296.86, 588.59, 303.86]},
    {"id": "p113-b24", "type": "paragraph", "text": "Xã hội", "bbox": [652.92, 296.86, 672.32, 303.86]},
    {"id": "p113-b25", "type": "paragraph", "text": "Môi trường", "bbox": [760.72, 296.86, 795.16, 303.86]},
    {"id": "p113-b26", "type": "paragraph", "text": "GRI", "bbox": [455.72, 313.95, 471.66, 323.25]},
    {"id": "p113-b27", "type": "paragraph", "text": "GRI", "bbox": [599.2, 313.95, 615.14, 323.25]},
    {"id": "p113-b28", "type": "paragraph", "text": "GRI", "bbox": [685.24, 313.95, 701.18, 323.25]},
    {"id": "p113-b29", "type": "paragraph", "text": "103", "bbox": [451.05, 324.33, 471.66, 336.73]},
    {"id": "p113-b30", "type": "paragraph", "text": "200", "bbox": [592.3, 324.33, 615.14, 336.73]},
    {"id": "p113-b31", "type": "paragraph", "text": "400", "bbox": [677.84, 324.33, 701.18, 336.73]},
    {"id": "p113-b32", "type": "paragraph", "text": "Mục tiêu ngắn hạn đến", "bbox": [743.35, 375.94, 853.29, 385.94]},
    {"id": "p113-b33", "type": "paragraph", "text": "Nơi làm việc hạnh phúc", "bbox": [545.77, 385.0, 652.16, 395.0]},
    {"id": "p113-b34", "type": "paragraph", "text": "năm 2030, giảm 15,8%\ntổng lượng khí thải\nkhí nhà kính", "bbox": [743.35, 387.94, 853.29, 421.94]},
    {"id": "p113-b35", "type": "paragraph", "text": "Tổ chức học tập suốt đời", "bbox": [545.77, 439.26, 657.75, 449.26]},
    {"id": "p113-b36", "type": "paragraph", "text": "Mục tiêu dài hạn đến\nnăm 2040 là Net Zero", "bbox": [742.61, 468.82, 854.02, 490.82]},
    {"id": "p113-b37", "type": "paragraph", "text": "Bình đẳng và đa dạng", "bbox": [545.77, 481.66, 645.65, 491.66]},
    {"id": "p113-b38", "type": "paragraph", "text": "Vì sự phát triển\ncủa cộng đồng", "bbox": [886.58, 234.75, 956.71, 256.75]},
    {"id": "p113-b39", "type": "paragraph", "text": "Xã hội", "bbox": [906.2, 296.86, 925.6, 303.86]},
    {"id": "p113-b40", "type": "paragraph", "text": "GRI", "bbox": [793.04, 313.95, 808.98, 323.25]},
    {"id": "p113-b41", "type": "paragraph", "text": "GRI", "bbox": [938.52, 313.95, 954.46, 323.25]},
    {"id": "p113-b42", "type": "paragraph", "text": "300", "bbox": [785.95, 324.33, 808.98, 336.73]},
    {"id": "p113-b43", "type": "paragraph", "text": "400", "bbox": [931.12, 324.33, 954.46, 336.73]},
    {"id": "p113-b44", "type": "paragraph", "text": "Đào tạo nguồn nhân lực\ncông nghệ chất lượng cao", "bbox": [886.57, 382.91, 999.66, 404.91]},
    {
      "id": "p113-b45",
      "type": "paragraph",
      "text": "Tạo điều kiện tốt nhất để\ntrẻ em Việt Nam có cơ hội\ntiếp cận giáo dục chất lượng\nvà bền vững",
      "bbox": [886.57, 456.45, 997.99, 500.15]
    },
    {"id": "p113-b46", "type": "furniture", "text": "LÀM CHỦ\nCÔNG NGHỆ CHIẾN LƯỢC\nBÁO CÁO THƯỜNG NIÊN 2025", "bbox": [73.25, 40.48, 190.71, 69.69]},
