    {"id": "p34-b35", "type": "paragraph", "text": "Vốn điều lệ", "bbox": [521.45, 73.54, 569.7, 83.04]},
    {"id": "p34-b36", "type": "paragraph", "text": "Lý do", "bbox": [602.82, 74.19, 626.21, 83.69]},
    {"id": "p34-b37", "type": "paragraph", "text": "sau khi phát hành", "bbox": [492.15, 84.54, 569.7, 94.04]},
    {"id": "p34-b38", "type": "paragraph", "text": "547.292.000.000", "bbox": [493.14, 113.32, 569.71, 122.82]},
    {"id": "p34-b39", "type": "paragraph", "text": "Tăng vốn điều lệ từ kết quả kinh doanh năm 2005.", "bbox": [603.57, 113.34, 819.55, 122.84]},
    {"id": "p34-b40", "type": "paragraph", "text": "608.102.300.000", "bbox": [493.33, 135.32, 569.71, 144.82]},
    {"id": "p34-b41", "type": "paragraph", "text": "Tăng vốn điều lệ từ bán cổ phần cho nhà đầu tư chiến lược năm 2006.", "bbox": [603.57, 135.34, 904.57, 144.84]},
    {"id": "p34-b42", "type": "paragraph", "text": "912.153.440.000", "bbox": [496.76, 157.32, 569.71, 166.82]},
    {
      "id": "p34-b43",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua trả cổ tức bằng cổ phiếu theo tỷ lệ 2:1 từ lợi nhuận năm 2006.",
      "bbox": [603.57, 157.34, 987.52, 166.84]
    },
    {"id": "p34-b44", "type": "paragraph", "text": "923.525.790.000", "bbox": [494.17, 179.32, 569.71, 188.82]},
    {
      "id": "p34-b45",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua phát hành cổ phần phổ thông thưởng cho CBNV có thành tích đóng\ngóp trong năm 2006 và cổ phần phổ thông cho CBNV.",
      "bbox": [603.57, 179.34, 1014.77, 200.84]
    },
    {"id": "p34-b46", "type": "paragraph", "text": "941.606.160.000", "bbox": [496.18, 213.32, 569.71, 222.82]},
    {
      "id": "p34-b47",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua phát hành cổ phần phổ thông thưởng cho CBNV có thành tích đóng\ngóp trong năm 2007 và cổ phần phổ thông cho CBNV.",
      "bbox": [603.57, 213.34, 1014.77, 234.84]
    },
    {"id": "p34-b48", "type": "paragraph", "text": "1.411.620.740.000", "bbox": [490.63, 247.32, 569.71, 256.82]},
    {
      "id": "p34-b49",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua phát hành thêm cổ phiếu thưởng cho cổ đông hiện hữu từ Quỹ\nthặng dư vốn theo tỷ lệ 2:1.",
      "bbox": [603.57, 247.34, 989.69, 268.84]
    },
    {"id": "p34-b50", "type": "paragraph", "text": "1.438.319.670.000", "bbox": [489.13, 281.32, 569.71, 290.82]},
    {
      "id": "p34-b51",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua phát hành cổ phần phổ thông thưởng cho CBNV có thành tích đóng\ngóp trong năm 2008 và cổ phần phổ thông cho CBNV.",
      "bbox": [603.57, 281.34, 1014.77, 302.84]
    },
    {"id": "p34-b52", "type": "paragraph", "text": "1.916.659.080.000", "bbox": [488.06, 315.32, 569.71, 324.82]},
    {
      "id": "p34-b53",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua trả cổ tức bằng cổ phiếu theo tỷ lệ 3:1 từ kết quả kinh doanh năm 2009.",
      "bbox": [603.57, 315.34, 1010.47, 324.84]
    },
    {"id": "p34-b54", "type": "paragraph", "text": "1.934.805.170.000", "bbox": [488.6, 337.33, 569.71, 346.83]},
    {
      "id": "p34-b55",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua phát hành cổ phần phổ thông thưởng cho CBNV có thành tích đóng\ngóp trong năm 2009 và cổ phần phổ thông cho CBNV.",
      "bbox": [603.57, 337.35, 1014.77, 358.84]
    },
    {"id": "p34-b56", "type": "paragraph", "text": "2.133.110.660.000", "bbox": [489.9, 371.33, 569.71, 380.83]},
    {
      "id": "p34-b57",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua phát hành cổ phiếu của Công ty Cổ phần FPT để thực hiện hoán đổi\ncổ phiếu cho các cổ đông hiện hữu của Công ty Cổ phần Hệ thống thông tin FPT, Công ty Cổ\nphần Phần mềm FPT và Công ty Cổ phần Thương mại FPT nhằm tái cấu trúc Tập đoàn.",
      "bbox": [603.57, 371.35, 1015.46, 404.84]
    },
    {"id": "p34-b58", "type": "paragraph", "text": "2.160.826.760.000", "bbox": [487.32, 417.33, 569.71, 426.83]},
    {
      "id": "p34-b59",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua phát hành cổ phần phổ thông thưởng cho CBNV có thành tích đóng\ngóp trong năm 2010.",
      "bbox": [603.57, 417.35, 1014.77, 438.84]
    },
    {"id": "p34-b60", "type": "paragraph", "text": "2.700.859.340.000", "bbox": [484.85, 451.33, 569.71, 460.83]},
    {
      "id": "p34-b61",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua trả cổ tức bằng cổ phiếu theo tỷ lệ 4:1 từ kết quả kinh doanh năm 2011.",
      "bbox": [603.57, 451.35, 1008.37, 460.85]
    },
    {"id": "p34-b62", "type": "paragraph", "text": "2.738.488.330.000", "bbox": [485.59, 473.33, 569.71, 482.83]},
    {
      "id": "p34-b63",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua phát hành cổ phần phổ thông thưởng cho CBNV có thành tích đóng\ngóp trong năm 2011 và cổ phần phổ thông cho CBNV.",
      "bbox": [603.57, 473.35, 1014.77, 494.85]
    },
    {"id": "p34-b64", "type": "paragraph", "text": "2.752.017.550.000", "bbox": [487.96, 507.33, 569.71, 516.83]},
    {
      "id": "p34-b65",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua phát hành cổ phiếu cho CBNV có thành tích đóng góp trong năm 2012.",
      "bbox": [603.57, 507.35, 1010.08, 516.85]
    },
    {"id": "p34-b66", "type": "paragraph", "text": "3.439.766.000.000", "bbox": [484.83, 529.33, 569.71, 538.83]},
    {
      "id": "p34-b67",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua trả cổ tức bằng cổ phiếu theo tỷ lệ 4:1 từ kết quả kinh doanh năm 2013.",
      "bbox": [603.57, 529.35, 1010.1, 538.85]
    },
