    {
      "id": "p150-b1",
      "type": "paragraph",
      "text": "Kết quả phân tích môi trường nước thải tại vị trí quan trắc của Tập đoàn cho thấy các\nthông số đều nằm trong giới hạn cho phép theo tiêu chuẩn QCVN 14:2008/BTNMT.",
      "bbox": [259.36, 43.27, 624.13, 65.27]
    },
    {"id": "p150-b2", "type": "paragraph", "text": "Kết quả quan trắc môi trường nước thải tại FPT Tower", "bbox": [259.38, 79.99, 557.14, 91.99]},
    {"id": "p150-b3", "type": "paragraph", "text": "TT Thông số", "bbox": [268.68, 117.45, 331.11, 127.45]},
