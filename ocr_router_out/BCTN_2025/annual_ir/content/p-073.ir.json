  "blocks": [
    {"id": "p73-b1", "type": "paragraph", "text": "Lĩnh vực Giáo dục", "bbox": [303.94, 50.44, 402.81, 62.44]},
    {"id": "p73-b2", "type": "paragraph", "text": "180 Đối tác\nquốc tế từ", "bbox": [454.92, 149.45, 578.6, 185.45]},
    {"id": "p73-b3", "type": "heading", "text": "Ông LÊ TRƯỜNG TÙNG", "bbox": [652.03, 132.7, 780.72, 144.99]},
    {"id": "p73-b4", "type": "paragraph", "text": "Tổng Giám đốc FPT Education", "bbox": [652.03, 156.11, 818.71, 168.11]},
    {"id": "p73-b5", "type": "heading", "text": "40", "bbox": [522.27, 188.36, 566.7, 224.36]},
    {"id": "p73-b6", "type": "paragraph", "text": "Hệ thống giáo dục có\ntầm ảnh hưởng khu vực\nchâu Á-Thái Bình Dương", "bbox": [264.84, 190.33, 398.43, 232.33]},
    {"id": "p73-b7", "type": "paragraph", "text": "Quốc gia", "bbox": [522.27, 222.53, 572.34, 234.53]},
    {"id": "p73-b8", "type": "heading", "text": "3.700", "bbox": [265.7, 270.71, 361.39, 306.71]},
    {"id": "p73-b9", "type": "heading", "text": "19/34", "bbox": [510.5, 270.96, 606.59, 306.96]},
    {"id": "p73-b10", "type": "paragraph", "text": "Sinh viên chuyên ngành\nđào tạo AI, Thiết kế vi mạch\nbán dẫn", "bbox": [265.52, 310.11, 418.86, 352.11]},
    {"id": "p73-b11", "type": "paragraph", "text": "Tỉnh thành có cơ sở đào tạo", "bbox": [454.92, 310.11, 607.11, 322.11]},
    {
      "id": "p73-b12",
      "type": "paragraph",
      "text": "Năm 2025, hệ thống giáo dục của FPT tập trung vào ba từ khóa\nquan trọng đó là: hệ thống rộng khắp, trải nghiệm vượt trội và\nthầy trò hạnh phúc nhằm tiếp tục đưa trí tuệ Việt Nam vươn xa,",
      "bbox": [652.03, 347.95, 1016.18, 389.95]
    },
    {"id": "p73-b13", "type": "heading", "text": "100%", "bbox": [265.29, 385.22, 357.99, 421.22]},
    {"id": "p73-b14", "type": "paragraph", "text": "Học sinh từ lớp 1 đến lớp 12\nđược tiếp cận AI", "bbox": [265.11, 424.38, 413.62, 451.38]},
    {"id": "p73-b15", "type": "paragraph", "text": "vươn cao trên toàn cầu.", "bbox": [652.03, 392.95, 782.88, 404.95]},
    {
      "id": "p73-b16",
      "type": "paragraph",
      "text": "Năm 2026, hệ thống giáo dục FPT tiếp tục kiên định với ba từ\nkhóa quan trọng này, đồng thời tăng cường hơn nữa việc đưa AI\nvào học tập theo hướng thực tiễn, gắn với mô hình “học – ứng\ndụng – thử nghiệm” góp phần đổi mới phương pháp dạy và học\ntrong bối cảnh chuyển đổi số.",
      "bbox": [652.03, 422.95, 1016.16, 494.95]
    },
    {"id": "p73-b17", "type": "furniture", "text": "LÀM CHỦ\nCÔNG NGHỆ CHIẾN LƯỢC\nBÁO CÁO THƯỜNG NIÊN 2025", "bbox": [73.25, 40.48, 190.71, 69.69]},
