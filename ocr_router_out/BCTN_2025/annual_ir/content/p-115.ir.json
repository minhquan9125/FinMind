  "blocks": [
    {"id": "p115-b1", "type": "paragraph", "text": "• Cam kết, mục tiêu và kết quả nổi bật về ESG", "bbox": [259.29, 46.09, 515.61, 58.09]},
    {"id": "p115-b2", "type": "heading", "text": "CÁC CHỈ TIÊU ESG CAM KẾT", "bbox": [259.29, 77.56, 392.01, 87.56]},
    {"id": "p115-b3", "type": "paragraph", "text": "TT Cam kết", "bbox": [268.27, 120.85, 329.85, 131.01]},
    {"id": "p115-b4", "type": "heading", "text": "QUẢN TRỊ XUẤT SẮC", "bbox": [268.27, 152.2, 364.77, 162.2]},
    {"id": "p115-b5", "type": "paragraph", "text": "1 Quản trị an toàn thông tin", "bbox": [268.27, 186.82, 402.19, 197.17]},
    {"id": "p115-b6", "type": "paragraph", "text": "2 Quản trị mua sắm bền vững", "bbox": [268.27, 231.52, 410.17, 242.19]},
    {"id": "p115-b7", "type": "heading", "text": "MÔI TRƯỜNG LÀM VIỆC ĐẲNG CẤP, HẠNH PHÚC", "bbox": [268.27, 278.26, 498.7, 288.26]},
    {"id": "p115-b8", "type": "paragraph", "text": "3 Nơi làm việc hạnh phúc", "bbox": [268.27, 315.35, 394.89, 326.85]},
    {"id": "p115-b9", "type": "paragraph", "text": "4 Tổ chức học tập suốt đời", "bbox": [268.27, 351.15, 400.28, 361.76]},
    {"id": "p115-b10", "type": "paragraph", "text": "5 Bình đẳng và đa dạng", "bbox": [268.27, 386.23, 388.58, 396.9]},
    {"id": "p115-b11", "type": "heading", "text": "HOẠT ĐỘNG VÌ MÔI TRƯỜNG XANH", "bbox": [268.27, 425.15, 436.08, 435.15]},
    {"id": "p115-b12", "type": "paragraph", "text": "6 Chính sách môi trường", "bbox": [268.27, 466.37, 391.51, 476.37]},
    {"id": "p115-b13", "type": "paragraph", "text": "7 Giám sát số liệu sử dụng\nnăng lượng", "bbox": [268.27, 501.93, 399.18, 523.93]},
    {"id": "p115-b14", "type": "paragraph", "text": "8 Tiết kiệm điện", "bbox": [268.27, 534.49, 352.76, 544.66]},
    {"id": "p115-b15", "type": "paragraph", "text": "Chỉ tiêu", "bbox": [430.75, 121.01, 466.22, 131.01]},
    {
      "id": "p115-b16",
      "type": "paragraph",
      "text": "Số lượng sự cố an toàn thông tin ảnh hưởng đến danh tiếng Tập đoàn bằng 0.",
      "bbox": [430.75, 176.96, 765.64, 186.96]
    },
    {"id": "p115-b17", "type": "paragraph", "text": "100% CBNV trải qua đào tạo/diễn tập an toàn bảo mật thông tin.", "bbox": [430.75, 199.96, 713.87, 209.96]},
    {"id": "p115-b18", "type": "paragraph", "text": "100% cán bộ mua sắm được đào tạo về mua sắm bền vững.", "bbox": [430.75, 222.96, 688.32, 232.96]},
    {
      "id": "p115-b19",
      "type": "paragraph",
      "text": "Không ký hợp đồng với các nhà cung cấp có các hoạt động ảnh hưởng đến\nsức khoẻ, an toàn lao động và môi trường.",
      "bbox": [430.75, 242.96, 753.41, 264.96]
    },
    {
      "id": "p115-b20",
      "type": "paragraph",
      "text": "Tỷ lệ nghỉ việc thấp hơn so với mức trung bình thị trường (Khối Công nghệ).",
      "bbox": [430.75, 302.02, 751.7, 312.02]
    },
    {"id": "p115-b21", "type": "paragraph", "text": "Hỗ trợ CBNV mua nhà, mua xe.", "bbox": [430.75, 327.22, 566.15, 337.22]},
    {"id": "p115-b22", "type": "paragraph", "text": "Đẩy mạnh và nâng cao số giờ học trung bình CBNV/năm (giờ).", "bbox": [430.75, 351.22, 701.7, 361.22]},
    {"id": "p115-b23", "type": "paragraph", "text": "Tỷ lệ nữ giới trong tổng số nhân sự.", "bbox": [430.75, 375.22, 580.33, 385.22]},
    {"id": "p115-b24", "type": "paragraph", "text": "Tỷ lệ nữ giới là quản lý trong tổng số nhân sự quản lý.", "bbox": [430.75, 399.22, 657.63, 409.22]},
    {"id": "p115-b25", "type": "paragraph", "text": "Tỷ lệ nhân viên được đào tạo nâng cao ý thức về môi trường.", "bbox": [430.75, 453.64, 691.13, 463.64]},
    {"id": "p115-b26", "type": "paragraph", "text": "Tỷ lệ túi rác trong văn phòng sử dụng vật liệu tái chế.", "bbox": [430.75, 480.85, 658.39, 490.85]},
    {"id": "p115-b27", "type": "paragraph", "text": "Tỷ lệ năng lượng sử dụng được giám sát.", "bbox": [430.75, 501.93, 604.74, 511.93]},
    {"id": "p115-b28", "type": "paragraph", "text": "Tỷ lệ sử dụng bóng đèn LED.", "bbox": [430.75, 534.67, 552.77, 544.67]},
