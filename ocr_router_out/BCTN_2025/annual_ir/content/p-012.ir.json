  "blocks": [
    {"id": "p12-b1", "type": "paragraph", "text": "Tình hình tài chính và kết quả kinh doanh nổi bật giai đoạn 2021-2025", "bbox": [259.29, 42.56, 771.21, 58.56]},
    {
      "id": "p12-b2",
      "type": "paragraph",
      "text": "Số liệu tài chính trong Báo cáo này được trích xuất từ Báo cáo tài chính hợp nhất đã kiểm toán bao gồm Báo cáo tài chính Công ty mẹ, Báo cáo tài chính của các công ty\ndo Tập đoàn nắm quyền kiểm soát (Công ty con) và kết quả kinh doanh hợp nhất của các công ty liên kết theo phương pháp vốn chủ.",
      "bbox": [259.29, 73.5, 1016.27, 95.5]
    },
