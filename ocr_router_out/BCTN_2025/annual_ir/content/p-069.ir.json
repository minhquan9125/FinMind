  "blocks": [
    {"id": "p69-b1", "type": "paragraph", "text": "Khối Viễn thông", "bbox": [303.94, 50.44, 391.45, 62.44]},
    {"id": "p69-b2", "type": "heading", "text": "LĨNH VỰC DỊCH VỤ VIỄN THÔNG", "bbox": [259.41, 100.05, 408.27, 110.05]},
    {"id": "p69-b3", "type": "heading", "text": "Ông HOÀNG VIỆT ANH", "bbox": [652.03, 132.71, 778.48, 144.99]},
    {"id": "p69-b4", "type": "heading", "text": "Top 3", "bbox": [259.29, 145.15, 352.06, 181.15]},
    {
      "id": "p69-b5",
      "type": "paragraph",
      "text": "Nhà cung cấp dịch vụ Internet băng thông rộng; trung tâm dữ\nliệu và dịch vụ tên miền; dịch vụ trực tuyến và cho thuê; dịch vụ\ntruyền hình trả tiền",
      "bbox": [260.08, 188.03, 606.08, 230.03]
    },
    {
      "id": "p69-b6",
      "type": "paragraph",
      "text": "34 Tỉnh, thành trên\ntoàn quốc có hạ\ntầng viễn thông\nvà mạng lưới\ncung cấp dịch vụ",
      "bbox": [456.07, 268.91, 605.67, 343.36]
    },
    {"id": "p69-b7", "type": "paragraph", "text": "Chủ tịch FPT Telecom", "bbox": [652.03, 156.12, 772.62, 168.12]},
    {
      "id": "p69-b8",
      "type": "paragraph",
      "text": "Công ty đã hoàn thành các mục tiêu thách thức về tăng trưởng\nkhách hàng, khẳng định vị thế là nhà cung cấp dịch vụ Internet\nhàng đầu, nền tảng hàng đầu về giải trí thể thao, đặc biệt là thể thao\nbóng đá.",
      "bbox": [652.03, 347.95, 1016.19, 404.95]
    },
    {
      "id": "p69-b9",
      "type": "paragraph",
      "text": "Giai đoạn 2026-2028, Công ty hướng đến trở thành doanh nghiệp\ntiên phong với ba nhiệm vụ trọng tâm: trở thành trụ cột trong",
      "bbox": [652.03, 422.95, 1016.12, 449.95]
    },
    {"id": "p69-b10", "type": "heading", "text": "04", "bbox": [257.85, 450.46, 302.27, 486.46]},
    {"id": "p69-b11", "type": "heading", "text": "6.800", "bbox": [454.92, 450.89, 553.23, 486.89]},
    {"id": "p69-b12", "type": "paragraph", "text": "Trung tâm dữ liệu đạt chuẩn\nUptime Tier III quốc tế", "bbox": [258.64, 488.04, 414.58, 515.04]},
    {"id": "p69-b13", "type": "paragraph", "text": "Dung lượng hạ tầng\nkết nối quốc tế", "bbox": [454.92, 488.04, 563.62, 515.04]},
    {
      "id": "p69-b14",
      "type": "paragraph",
      "text": "các dự án trọng điểm an ninh quốc gia; thúc đẩy kinh doanh, mở rộng\nthị phần, tiên phong ứng dụng công nghệ Internet mới nhất tại",
      "bbox": [652.03, 452.95, 1016.16, 479.95]
    },
    {"id": "p69-b15", "type": "paragraph", "text": "Gbps", "bbox": [553.23, 469.13, 582.49, 481.13]},
    {
      "id": "p69-b16",
      "type": "paragraph",
      "text": "Việt Nam; nghiên cứu, sáng tạo, làm chủ công nghệ lõi, hướng tới\nxuất khẩu.",
      "bbox": [652.03, 482.95, 1016.16, 509.95]
    },
