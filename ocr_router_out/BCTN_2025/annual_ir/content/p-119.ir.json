  "blocks": [
    {"id": "p119-b1", "type": "heading", "text": "HOẠT ĐỘNG VÌ MÔI TRƯỜNG XANH", "bbox": [259.29, 43.31, 427.1, 53.31]},
    {"id": "p119-b2", "type": "paragraph", "text": "Vấn đề", "bbox": [272.09, 81.05, 304.27, 91.05]},
    {"id": "p119-b3", "type": "paragraph", "text": "Cam kết", "bbox": [393.85, 88.76, 432.72, 98.76]},
    {"id": "p119-b4", "type": "paragraph", "text": "trọng yếu", "bbox": [272.09, 93.05, 316.25, 103.05]},
    {
      "id": "p119-b5",
      "type": "paragraph",
      "text": "Không ngừng cải thiện môi trường • Mục tiêu trung hạn: đến năm 2030, • Chuẩn hóa phương pháp kiểm kê số liệu phát thải khí",
      "bbox": [393.85, 125.71, 986.84, 135.71]
    },
    {"id": "p119-b6", "type": "paragraph", "text": "Bảo vệ", "bbox": [272.09, 125.95, 302.84, 135.95]},
    {"id": "p119-b7", "type": "paragraph", "text": "làm việc hướng tới môi trường làm", "bbox": [393.85, 137.71, 543.47, 147.71]},
    {"id": "p119-b8", "type": "paragraph", "text": "môi trường", "bbox": [272.09, 137.95, 321.93, 147.95]},
    {"id": "p119-b9", "type": "paragraph", "text": "việc xanh, an toàn, lành mạnh.", "bbox": [393.85, 149.71, 530.28, 159.71]},
    {"id": "p119-b10", "type": "heading", "text": "VÌ SỰ PHÁT TRIỂN CỦA CỘNG ĐỒNG", "bbox": [259.29, 280.46, 431.05, 290.46]},
    {"id": "p119-b11", "type": "paragraph", "text": "Vấn đề", "bbox": [272.09, 315.56, 304.27, 325.56]},
    {"id": "p119-b12", "type": "paragraph", "text": "Cam kết", "bbox": [393.85, 323.27, 432.72, 333.27]},
    {"id": "p119-b13", "type": "paragraph", "text": "trọng yếu", "bbox": [272.09, 327.56, 316.25, 337.56]},
    {
      "id": "p119-b14",
      "type": "paragraph",
      "text": "Là đơn vị dẫn đầu trong đào tạo • Đào tạo 10.000 kỹ sư bán dẫn vào • 3.700 sinh viên theo học các chương trình và chuyên ngành",
      "bbox": [393.85, 360.22, 1017.99, 370.22]
    },
    {"id": "p119-b15", "type": "paragraph", "text": "Đào tạo nguồn", "bbox": [272.09, 360.46, 336.9, 370.46]},
    {"id": "p119-b16", "type": "paragraph", "text": "nhân lực số có năng lực cạnh tranh", "bbox": [393.85, 372.22, 542.73, 382.22]},
    {"id": "p119-b17", "type": "paragraph", "text": "nhân lực công nghệ", "bbox": [272.09, 372.46, 358.14, 382.46]},
    {"id": "p119-b18", "type": "paragraph", "text": "toàn cầu.", "bbox": [393.85, 384.22, 435.05, 394.22]},
    {"id": "p119-b19", "type": "paragraph", "text": "chất lượng cao", "bbox": [272.09, 384.46, 338.1, 394.46]},
    {
      "id": "p119-b20",
      "type": "paragraph",
      "text": "Chú trọng hỗ trợ tạo điều kiện • Tiếp tục duy trì quỹ dành cho các • Sử dụng 72,8 tỷ đồng cho các hoạt động trách nhiệm xã hội;",
      "bbox": [393.85, 484.94, 1017.4, 494.95]
    },
    {"id": "p119-b21", "type": "paragraph", "text": "Tạo điều kiện", "bbox": [272.09, 485.18, 330.73, 495.18]},
    {"id": "p119-b22", "type": "paragraph", "text": "học tập tốt hơn cho các hoàn cảnh", "bbox": [393.85, 496.94, 542.25, 506.94]},
    {"id": "p119-b23", "type": "paragraph", "text": "tốt nhất để trẻ em", "bbox": [272.09, 497.18, 351.37, 507.18]},
    {"id": "p119-b24", "type": "paragraph", "text": "yếu thế tại các khu vực kinh tế", "bbox": [393.85, 508.94, 542.23, 518.94]},
    {"id": "p119-b25", "type": "paragraph", "text": "Việt Nam có cơ hội", "bbox": [272.09, 509.18, 354.64, 519.18]},
    {"id": "p119-b26", "type": "paragraph", "text": "khó khăn, vùng núi, vùng sâu,", "bbox": [393.85, 520.94, 542.24, 530.94]},
    {"id": "p119-b27", "type": "paragraph", "text": "tiếp cận giáo dục\nchất lượng và bền vững vùng xa.", "bbox": [272.09, 521.18, 431.3, 543.18]},
    {"id": "p119-b28", "type": "paragraph", "text": "Mục tiêu", "bbox": [561.39, 87.05, 601.84, 97.05]},
    {
      "id": "p119-b29",
      "type": "paragraph",
      "text": "giảm 15,8% tổng lượng phát thải\nkhí nhà kính phù hợp với mục tiêu\nchung của Việt Nam;",
      "bbox": [569.61, 137.71, 725.16, 171.71]
    },
    {
      "id": "p119-b30",
      "type": "paragraph",
      "text": "• Mục tiêu dài hạn: đến năm 2040\nđạt Net Zero như cam kết của • Triển khai 02 hệ thống điện mặt trời mái nhà với tổng\nChính phủ Việt Nam tại COP 26.",
      "bbox": [561.39, 182.71, 986.27, 216.71]
    },
    {"id": "p119-b31", "type": "paragraph", "text": "Mục tiêu", "bbox": [561.39, 321.56, 601.84, 331.56]},
    {"id": "p119-b32", "type": "paragraph", "text": "năm 2030;", "bbox": [569.89, 372.22, 619.01, 382.22]},
    {
      "id": "p119-b33",
      "type": "paragraph",
      "text": "• Đưa AI vào đào tạo người học ở tất • Nghiên cứu, ứng dụng và phát triển các giải pháp công nghệ\ncả các bậc học thuộc hệ thống\ngiáo dục của FPT.",
      "bbox": [561.39, 393.22, 1017.97, 430.22]
    },
    {
      "id": "p119-b34",
      "type": "paragraph",
      "text": "hoạt động phát triển vì cộng đồng\ntập trung chủ yếu vào các hoạt • Trường Hy Vọng nhận giải thưởng Hành động vì cộng đồng ở\nđộng giáo dục.",
      "bbox": [569.89, 496.95, 1017.98, 530.95]
    },
    {"id": "p119-b35", "type": "paragraph", "text": "Kết quả nổi bật 2025", "bbox": [741.34, 86.6, 837.76, 96.6]},
    {
      "id": "p119-b36",
      "type": "paragraph",
      "text": "nhà kính cho Phạm vi 1 và Phạm vi 2; thực hiện kiểm kê và\ntheo dõi số liệu toàn Tập đoàn định kỳ theo quý;",
      "bbox": [749.56, 137.71, 1016.18, 159.71]
    },
    {"id": "p119-b37", "type": "paragraph", "text": "• 100% số liệu sử dụng năng lượng được giám sát;", "bbox": [741.34, 170.71, 965.22, 180.71]},
    {"id": "p119-b38", "type": "paragraph", "text": "sản lượng 842.749 kWh;", "bbox": [750.54, 203.71, 857.85, 213.71]},
    {
      "id": "p119-b39",
      "type": "paragraph",
      "text": "• 100% cơ sở được kiểm kê và giám sát phát thải khí nhà kính\nđịnh kỳ.",
      "bbox": [741.34, 224.71, 1016.12, 246.71]
    },
    {"id": "p119-b40", "type": "paragraph", "text": "Kết quả nổi bật 2025", "bbox": [741.34, 321.11, 837.76, 331.11]},
    {"id": "p119-b41", "type": "paragraph", "text": "đào tạo AI, thiết kế vi mạch bán dẫn của hệ thống giáo dục FPT;", "bbox": [749.55, 372.22, 1017.9, 382.22]},
    {
      "id": "p119-b42",
      "type": "paragraph",
      "text": "tiên tiến nhất, gia tăng tương tác và cá nhân hóa trải nghiệm\ncủa người học; đưa AI vào đào tạo từ bậc tiểu học đến\nphổ thông, cao đẳng, đại học và sau đại học;",
      "bbox": [749.55, 405.22, 1017.99, 439.22]
    },
    {"id": "p119-b43", "type": "paragraph", "text": "• Trao 151 tỷ đồng học bổng Nguyễn Văn Đạo.", "bbox": [741.33, 450.22, 946.09, 460.22]},
    {"id": "p119-b44", "type": "paragraph", "text": "hạng mục Dự án kịp thời;", "bbox": [749.84, 520.95, 860.26, 530.95]},
    {"id": "p119-b45", "type": "furniture", "text": "LÀM CHỦ\nCÔNG NGHỆ CHIẾN LƯỢC\nBÁO CÁO THƯỜNG NIÊN 2025", "bbox": [73.25, 40.48, 190.71, 69.69]},
