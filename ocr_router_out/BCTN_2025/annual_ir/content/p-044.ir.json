  "blocks": [
    {"id": "p44-b1", "type": "paragraph", "text": "Ban Kiểm soát", "bbox": [258.89, 80.7, 365.04, 96.7]},
    {
      "id": "p44-b2",
      "type": "paragraph",
      "text": "Ban Kiểm soát gồm ba thành viên là những người có nhiều năm kinh nghiệm trong\nlĩnh vực tài chính, đồng thời có đầy đủ các chứng chỉ nghiệp vụ đáp ứng yêu cầu\nvề tiêu chuẩn và điều kiện của thành viên Ban Kiểm soát theo đúng quy định pháp luật\nliên quan.",
      "bbox": [258.9, 108.5, 623.13, 154.5]
    },
    {"id": "p44-b3", "type": "heading", "text": "Ông NGUYỄN VIỆT THẮNG", "bbox": [258.57, 381.31, 406.68, 393.6]},
    {"id": "p44-b4", "type": "heading", "text": "Ông NGUYỄN KHẢI HOÀN", "bbox": [546.19, 381.82, 690.73, 394.11]},
    {"id": "p44-b5", "type": "heading", "text": "Bà DƯƠNG THÙY DƯƠNG", "bbox": [833.54, 381.82, 976.14, 394.11]},
    {"id": "p44-b6", "type": "paragraph", "text": "Trưởng Ban Kiểm soát", "bbox": [259.05, 400.6, 381.32, 412.6]},
    {
      "id": "p44-b7",
      "type": "paragraph",
      "text": "Ông là thành viên Ban Kiểm soát FPT từ\nnăm 2008 và được bầu làm Trưởng Ban\nKiểm soát nhiệm kỳ 2012-2017, 2017-2022\nvà 2022-2027. Hiện ông đảm nhiệm vị trí\nPhó hiệu trưởng trường Đại học FPT kiêm\nViện trưởng Viện Quản trị và Công nghệ\nFSB thuộc trường Đại học FPT.",
      "bbox": [258.9, 428.07, 444.49, 510.07]
    },
    {"id": "p44-b8", "type": "paragraph", "text": "Thành viên Ban Kiểm soát", "bbox": [546.19, 401.12, 688.89, 413.12]},
    {
      "id": "p44-b9",
      "type": "paragraph",
      "text": "Ông là thành viên Ban Kiểm soát FPT từ\nnăm 2007 và là người có nhiều năm kinh\nnghiệm trong lĩnh vực tài chính. Hiện\nông đảm nhiệm vị trí Phó tổng giám đốc\nFPT Software, kiêm Tổng giám đốc FPT\nkhu vực châu Mỹ.",
      "bbox": [546.19, 428.56, 731.49, 498.56]
    },
    {"id": "p44-b10", "type": "paragraph", "text": "Thành viên Ban Kiểm soát", "bbox": [834.02, 401.12, 976.73, 413.12]},
    {
      "id": "p44-b11",
      "type": "paragraph",
      "text": "Làm việc trong lĩnh vực đầu tư ngay sau\nkhi tốt nghiệp, bà là một tài năng trẻ với\nnhiều kinh nghiệm trong quản trị doanh\nnghiệp, có nhiều đóng góp và hỗ trợ đắc\nlực cho công tác quản lý vốn nhà nước tại\ncác doanh nghiệp.",
      "bbox": [834.03, 428.56, 1019.33, 498.56]
    },
    {"id": "p44-b12", "type": "furniture", "text": "LÀM CHỦ\nCÔNG NGHỆ CHIẾN LƯỢC\nBÁO CÁO THƯỜNG NIÊN 2025", "bbox": [73.25, 40.48, 190.71, 69.69]},
    {"id": "p44-b13", "type": "furniture", "text": "01 THÔNG ĐIỆP BAN LÃNH ĐẠO", "bbox": [25.47, 109.12, 155.29, 117.31]},
    {"id": "p44-b14", "type": "furniture", "text": "02 DẤU ẤN 2025", "bbox": [25.47, 135.12, 96.98, 143.31]},
    {"id": "p44-b15", "type": "furniture", "text": "03 TỔNG QUAN VỀ FPT", "bbox": [25.47, 161.31, 121.93, 169.31]},
    {
      "id": "p44-b16",
      "type": "furniture",
      "text": "Thông tin chung\nSứ mệnh, giá trị cốt lõi\nNgành nghề kinh doanh\nVị thế và quy mô\n06\nHành trình khẳng định năng lực\nvà vị thế\nCơ cấu quản trị và bộ máy quản lý\nBan Lãnh đạo",
      "bbox": [25.73, 183.92, 191.17, 290.92]
    },
    {"id": "p44-b17", "type": "furniture", "text": "04 CHIẾN LƯỢC PHÁT TRIỂN", "bbox": [25.47, 306.12, 142.43, 314.31]},
    {"id": "p44-b18", "type": "furniture", "text": "05 PHÂN TÍCH HOẠT ĐỘNG KINH DOANH", "bbox": [25.47, 332.12, 190.19, 340.31]},
