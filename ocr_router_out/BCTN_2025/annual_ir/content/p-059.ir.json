    {"id": "p59-b29", "type": "paragraph", "text": "Vòng quay tiền mặt (ngày)", "bbox": [667.49, 374.3, 788.06, 384.3]},
    {"id": "p59-b30", "type": "paragraph", "text": "47,1\n49,0", "bbox": [913.85, 374.33, 998.63, 384.33]},
    {"id": "p59-b31", "type": "paragraph", "text": "4. Chỉ tiêu về khả năng sinh lời", "bbox": [667.49, 396.54, 807.28, 406.54]},
