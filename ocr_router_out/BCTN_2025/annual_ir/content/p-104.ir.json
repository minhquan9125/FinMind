  "blocks": [
    {"id": "p104-b1", "type": "heading", "text": "BÁO CÁO CỦA BAN KIỂM SOÁT", "bbox": [257.03, 42.2, 550.15, 62.2]},
    {
      "id": "p104-b2",
      "type": "paragraph",
      "text": "Căn cứ theo luật định và Điều lệ Công ty, BKS nhiệm\nkỳ 2022-2027, có các nhiệm vụ chính sau:",
      "bbox": [258.9, 86.92, 492.03, 108.92]
    },
    {"id": "p104-b3", "type": "paragraph", "text": "Thực hiện các quyền giám sát việc thực thi\nĐiều lệ Công ty;", "bbox": [312.63, 142.47, 493.99, 164.47]},
    {
      "id": "p104-b4",
      "type": "paragraph",
      "text": "Giám sát việc thực thi Nghị quyết của\nĐHĐCĐ thường niên 2025 nhằm bảo vệ\nquyền lợi của cổ đông;",
      "bbox": [312.63, 189.47, 494.03, 223.47]
    },
    {
      "id": "p104-b5",
      "type": "paragraph",
      "text": "Phối hợp cùng đơn vị kiểm toán độc lập\ngiám sát tính minh bạch trong hoạt động\ntài chính của Tập đoàn;",
      "bbox": [312.63, 248.47, 494.03, 282.47]
    },
    {
      "id": "p104-b6",
      "type": "paragraph",
      "text": "Giám sát việc triển khai chức năng,\nnhiệm vụ của HĐQT và Ban Điều hành;\ntính minh bạch của các thành viên\nHĐQT, các thành viên Ban Điều hành\ntheo luật định;",
      "bbox": [312.63, 307.47, 494.04, 365.47]
    },
    {
      "id": "p104-b7",
      "type": "paragraph",
      "text": "Kiểm tra và giám sát đột xuất những nội dung\nphát sinh thuộc thẩm quyền của BKS.",
      "bbox": [312.63, 390.47, 494.03, 412.47]
    },
    {"id": "p104-b8", "type": "paragraph", "text": "Thành phần và cơ cấu Ban Kiểm soát", "bbox": [520.73, 82.88, 792.12, 98.88]},
    {
      "id": "p104-b9",
      "type": "paragraph",
      "text": "Trong năm 2025, BKS nhiệm kỳ 2022-2027 không có sự thay đổi vị trí cũng như số lượng các thành viên.",
      "bbox": [520.74, 110.52, 981.0, 120.52]
    },
    {"id": "p104-b10", "type": "paragraph", "text": "Danh sách thành viên và số lượng cuộc họp", "bbox": [520.25, 137.68, 718.75, 147.68]},
    {"id": "p104-b11", "type": "paragraph", "text": "Chức vụ Trình độ", "bbox": [645.65, 175.31, 736.57, 185.08]},
