  "blocks": [
    {"id": "p65-b1", "type": "paragraph", "text": "Nhân lực chất lượng cao, động lực cho công nghệ mũi nhọn", "bbox": [259.29, 42.28, 526.12, 52.28]},
    {
      "id": "p65-b2",
      "type": "paragraph",
      "text": "Nhiều chương trình kinh doanh trọng điểm trong các lĩnh vực công nghệ ô tô,\nchăm sóc sức khỏe, dữ liệu và điện toán đám mây lần đầu tiên đạt quy mô doanh\nthu trên 100 triệu USD. Kết quả này phản ánh hiệu quả của chiến lược tập trung\ntheo ngành và theo nền tảng công nghệ, đồng thời cho thấy năng lực triển khai\nnhất quán của FPT trên quy mô toàn cầu.",
      "bbox": [259.29, 66.04, 623.41, 124.04]
    },
    {"id": "p65-b3", "type": "paragraph", "text": "Doanh thu từ Dịch vụ AI/Data Analytics", "bbox": [259.31, 144.45, 435.06, 154.45]},
    {"id": "p65-b4", "type": "paragraph", "text": "980\n1.221", "bbox": [340.76, 190.89, 429.76, 200.89]},
    {"id": "p65-b5", "type": "paragraph", "text": "3.000", "bbox": [282.05, 206.51, 304.3, 214.51]},
    {"id": "p65-b6", "type": "paragraph", "text": "2.500", "bbox": [282.65, 230.51, 304.3, 238.51]},
    {"id": "p65-b7", "type": "paragraph", "text": "2.000", "bbox": [282.21, 254.51, 304.3, 262.51]},
    {"id": "p65-b8", "type": "paragraph", "text": "1.500", "bbox": [283.94, 278.51, 304.3, 286.51]},
    {"id": "p65-b9", "type": "paragraph", "text": "1.000", "bbox": [283.5, 302.51, 304.3, 310.51]},
    {"id": "p65-b10", "type": "paragraph", "text": "500", "bbox": [289.24, 326.51, 304.3, 334.51]},
    {"id": "p65-b11", "type": "paragraph", "text": "0\n2022\n2023", "bbox": [299.13, 350.51, 430.15, 371.57]},
    {
      "id": "p65-b12",
      "type": "paragraph",
      "text": "Cùng với mở rộng hoạt động kinh doanh, FPT từng bước chuyển đổi lực lượng\nkỹ sư theo mô hình Kỹ sư tăng cường AI, trong đó AI được tích hợp trực tiếp vào\nquy trình phát triển phần mềm, quản trị dự án và vận hành nội bộ giúp cải thiện\nnăng suất, rút ngắn thời gian triển khai và tối ưu chi phí. Song song, Tập đoàn\ntriển khai chương trình đào tạo và tái đào tạo AI trên diện rộng, đặt mục tiêu phổ cập\nnăng lực AI cho phần lớn đội ngũ kỹ sư, đồng thời hình thành trung tâm năng lực\nAI (AI Center of Excellence) tại các thị trường trọng điểm. Với đội ngũ chuyên gia,\nnền tảng công nghệ và hệ sinh thái đào tạo đồng bộ, FPT sẵn sàng nắm bắt\nlàn sóng AI và mở rộng quy mô các dự án chuyển đổi số toàn cầu.",
      "bbox": [258.93, 434.31, 623.95, 540.31]
    },
    {
      "id": "p65-b13",
      "type": "paragraph",
      "text": "Nhân sự bình quân của lĩnh vực Dịch vụ CNTT cho thị trường nước ngoài và\nnăng suất lao động",
      "bbox": [651.91, 44.16, 984.31, 65.16]
    },
