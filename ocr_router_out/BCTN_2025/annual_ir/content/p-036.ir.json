    {"id": "p36-b23", "type": "paragraph", "text": "Vốn điều lệ", "bbox": [521.44, 73.54, 569.69, 83.04]},
    {"id": "p36-b24", "type": "paragraph", "text": "Lý do", "bbox": [602.83, 74.19, 626.21, 83.69]},
    {"id": "p36-b25", "type": "paragraph", "text": "sau khi phát hành", "bbox": [492.14, 84.54, 569.69, 94.04]},
    {"id": "p36-b26", "type": "paragraph", "text": "11.043.316.220.000", "bbox": [484.43, 113.28, 569.69, 122.78]},
    {
      "id": "p36-b27",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua phát hành cổ phiếu theo chương trình lựa chọn cho đối tượng là CBNV có\nthành tích đóng góp trong năm 2022; phát hành cổ phiếu mới theo chương trình phát hành cổ phiếu\ncho đối tượng là cán bộ lãnh đạo cấp cao năm 2023.",
      "bbox": [603.55, 113.28, 1014.76, 146.78]
    },
    {"id": "p36-b28", "type": "paragraph", "text": "12.699.688.750.000", "bbox": [481.97, 158.28, 569.69, 167.78]},
    {
      "id": "p36-b29",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua trả cổ tức bằng cổ phiếu theo tỷ lệ 15% từ kết quả kinh doanh năm 2022.",
      "bbox": [603.55, 159.28, 1013.56, 168.78]
    },
    {"id": "p36-b30", "type": "paragraph", "text": "14.604.480.660.000", "bbox": [480.25, 181.28, 569.69, 190.78]},
    {
      "id": "p36-b31",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ sau phát hành cổ phiếu để tăng vốn từ nguồn vốn chủ sở hữu cho cổ đông hiện hữu\ntheo tỷ lệ 15%.",
      "bbox": [603.55, 181.28, 1014.85, 202.78]
    },
    {
      "id": "p36-b32",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua phát hành cổ phiếu theo chương trình lựa chọn cho đối tượng là CBNV",
      "bbox": [603.55, 215.28, 1007.78, 224.78]
    },
    {"id": "p36-b33", "type": "paragraph", "text": "14.710.691.830.000", "bbox": [484.7, 216.28, 569.69, 225.78]},
    {
      "id": "p36-b34",
      "type": "paragraph",
      "text": "có thành tích đóng góp trong năm 2023 và phát hành cổ phiếu theo chương trình lựa chọn cho đối\ntượng là cán bộ lãnh đạo cấp cao năm 2024.",
      "bbox": [603.55, 227.28, 1009.17, 248.78]
    },
    {
      "id": "p36-b35",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ thông qua phát hành cổ phiếu theo chương trình lựa chọn cho đối tượng CBNV có",
      "bbox": [603.55, 261.28, 1010.52, 270.78]
    },
    {"id": "p36-b36", "type": "paragraph", "text": "14.813.301.220.000", "bbox": [484.29, 262.28, 569.69, 271.78]},
    {
      "id": "p36-b37",
      "type": "paragraph",
      "text": "thành tích đóng góp trong năm 2024 và phát hành cổ phiếu theo chương trình lựa chọn cho đối\ntượng là cán bộ lãnh đạo cấp cao năm 2025.",
      "bbox": [603.55, 273.28, 996.67, 294.78]
    },
    {
      "id": "p36-b38",
      "type": "paragraph",
      "text": "Tăng vốn điều lệ sau đợt phát hành cổ phiếu để tăng vốn từ nguồn vốn chủ sở hữu cho cổ đông",
      "bbox": [603.55, 307.28, 998.15, 316.78]
    },
    {"id": "p36-b39", "type": "paragraph", "text": "17.035.071.210.000", "bbox": [485.01, 308.28, 569.69, 317.78]},
