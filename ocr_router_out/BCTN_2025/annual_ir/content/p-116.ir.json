    {"id": "p116-b50", "type": "furniture", "text": "06 QUẢN TRỊ CÔNG TY", "bbox": [25.47, 239.12, 121.59, 247.31]},
    {"id": "p116-b51", "type": "furniture", "text": "07 BÁO CÁO ESG", "bbox": [25.47, 265.31, 100.05, 273.31]},
    {
      "id": "p116-b52",
      "type": "furniture",
      "text": "Thông điệp và định hướng ESG\nQuản trị hướng đến phát triển bền vững\nMôi trường làm việc đẳng cấp,\nhạnh phúc\nHoạt động vì môi trường xanh\nSong hành vì sự phát triển cộng đồng",
      "bbox": [67.84, 287.87, 199.86, 365.87]
    },
    {"id": "p116-b53", "type": "furniture", "text": "08 BÁO CÀO TÀI CHÍNH HỢP NHẤT", "bbox": [25.47, 377.12, 166.49, 385.31]},
    {"id": "p116-b54", "type": "paragraph", "text": "• Xử lý nghiêm minh với các trường hợp vi phạm.", "bbox": [721.15, 546.39, 936.04, 556.39]},
