    {
      "id": "p94-b1",
      "type": "paragraph",
      "text": "Với mô hình công ty mẹ, công ty con, một số thành viên HĐQT và Tổng giám đốc của Tập đoàn, đồng thời kiêm nhiệm các vị trí trong HĐQT/HĐTV và BKS của công ty thành viên.\nTrong năm 2025, FPT thực hiện các giao dịch thường xuyên với công ty thành viên và công ty mà FPT nắm quyền kiểm soát như sau:",
      "bbox": [258.89, 42.02, 1015.88, 63.52]
    },
    {"id": "p94-b2", "type": "paragraph", "text": "Hợp đồng hoặc giao dịch với cổ đông nội bộ", "bbox": [258.52, 88.03, 452.87, 98.03]},
    {
      "id": "p94-b3",
      "type": "paragraph",
      "text": "STT Tên tổ chức Mối quan hệ Số giấy NSH,\nliên quan\nvới công ty nơi cấp",
      "bbox": [260.61, 123.43, 481.97, 157.21]
    },
    {
      "id": "p94-b4",
      "type": "paragraph",
      "text": "1 Công ty TNHH Công ty con • 0101601092 Tầng 6-12,\nPhần mềm FPT trong cùng\nTập đoàn",
      "bbox": [262.13, 193.72, 552.31, 227.21]
    },
    {
      "id": "p94-b5",
      "type": "paragraph",
      "text": "2 Công ty TNHH Công ty con • 0104128565 Số 10 phố\nFPT IS\ntrong cùng\nTập đoàn",
      "bbox": [262.13, 364.58, 548.89, 398.08]
    },
    {"id": "p94-b6", "type": "paragraph", "text": "Địa chỉ\nThời Số nghị quyết/ quyết định của", "bbox": [506.57, 123.43, 747.33, 133.23]},
    {"id": "p94-b7", "type": "paragraph", "text": "Nội dung và", "bbox": [773.43, 123.73, 825.68, 133.23]},
    {"id": "p94-b8", "type": "paragraph", "text": "trụ sở chính điểm ĐHĐCĐ/ HĐQT… thông qua", "bbox": [506.57, 134.73, 737.43, 144.93]},
    {"id": "p94-b9", "type": "paragraph", "text": "tổng giá trị giao dịch", "bbox": [773.43, 134.73, 864.46, 144.23]},
    {"id": "p94-b10", "type": "paragraph", "text": "ngày cấp,", "bbox": [425.5, 135.43, 468.77, 144.93]},
