    {"id": "p211-b3", "type": "heading", "text": "CHO NĂM TÀI CHÍNH KẾT THÚC NGÀY 31 THÁNG 12 NĂM 2025", "bbox": [258.9, 65.25, 846.14, 85.25]},
    {
      "id": "p211-b4",
      "type": "paragraph",
      "text": "32. Thuế thu nhập doanh nghiệp (“TNDN”)\nBiến động gộp về thuế TNDN hoãn lại trong năm tài chính như sau:",
      "bbox": [258.77, 98.51, 568.27, 130.42]
    },
    {"id": "p211-b5", "type": "paragraph", "text": "Tài sản thuế TNDN hoãn lại:", "bbox": [273.26, 139.49, 393.63, 148.99]},
    {"id": "p211-b6", "type": "paragraph", "text": "Số dư đầu năm", "bbox": [273.26, 196.18, 338.1, 205.68]},
    {"id": "p211-b7", "type": "paragraph", "text": "575.767.686.189 360.946.956.414", "bbox": [449.9, 196.23, 612.29, 205.73]},
    {
      "id": "p211-b8",
      "type": "paragraph",
      "text": "Ghi nhận vào báo cáo kết quả hoạt 241.646.085.537 209.467.184.394\nđộng kinh doanh hợp nhất",
      "bbox": [273.26, 214.18, 612.29, 233.69]
    },
    {
      "id": "p211-b9",
      "type": "paragraph",
      "text": "Bù trừ các số dư liên quan đến cùng (229.117.058.933)\nmột cơ quan thuế",
      "bbox": [273.26, 242.19, 520.79, 261.69]
    },
    {"id": "p211-b10", "type": "paragraph", "text": "Khác", "bbox": [273.26, 270.19, 295.49, 279.69]},
    {"id": "p211-b11", "type": "paragraph", "text": "Số dư cuối năm", "bbox": [273.26, 288.2, 339.78, 297.7]},
    {
      "id": "p211-b12",
      "type": "paragraph",
      "text": "(*) Chi phí/(thu nhập) thuế TNDN trong năm tài chính được ước tính dựa vào thu nhập\nchịu thuế và có thể có những điều chỉnh tùy thuộc vào sự kiểm tra của cơ quan thuế.",
      "bbox": [259.09, 322.19, 623.56, 344.19]
    },
    {"id": "p211-b13", "type": "paragraph", "text": "33. Chi phí sản xuất kinh doanh theo yếu tố", "bbox": [259.02, 382.67, 576.25, 398.67]},
