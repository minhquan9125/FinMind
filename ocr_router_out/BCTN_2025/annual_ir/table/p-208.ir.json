  "blocks": [
    {"id": "p208-b1", "type": "heading", "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT", "bbox": [258.9, 42.25, 696.64, 62.25]},
    {"id": "p208-b2", "type": "paragraph", "text": "Mẫu số B 09 – DN/HN", "bbox": [899.64, 48.6, 1016.96, 60.6]},
    {"id": "p208-b3", "type": "heading", "text": "CHO NĂM TÀI CHÍNH KẾT THÚC NGÀY 31 THÁNG 12 NĂM 2025", "bbox": [258.9, 65.25, 846.14, 85.25]},
    {"id": "p208-b4", "type": "paragraph", "text": "25. Lãi trên cổ phiếu\n(a) Lãi cơ bản trên cổ phiếu", "bbox": [258.9, 105.5, 409.43, 137.18]},
    {
      "id": "p208-b5",
      "type": "paragraph",
      "text": "Lãi cơ bản trên cổ phiếu được tính bằng hiệu của số lợi nhuận thuần phân bổ cho\ncác cổ đông và số trích quỹ khen thưởng, phúc lợi và cổ tức của cổ phiếu ưu đãi,\nchia cho số lượng bình quân gia quyền của số cổ phiếu phổ thông đang lưu hành\ntrong năm tài chính, điều chỉnh cho cổ phiếu thưởng phát hành trong năm trừ đi\ncổ phiếu quỹ. Chi tiết như sau:",
      "bbox": [258.9, 146.18, 624.21, 204.18]
    },
    {"id": "p208-b6", "type": "paragraph", "text": "Lợi nhuận thuần phân bổ cho", "bbox": [266.67, 279.06, 392.49, 288.56]},
    {"id": "p208-b7", "type": "paragraph", "text": "9.376.127.629.501", "bbox": [434.45, 279.08, 512.29, 288.58]},
    {"id": "p208-b8", "type": "paragraph", "text": "các cổ đông", "bbox": [266.67, 289.06, 320.34, 298.56]},
    {"id": "p208-b9", "type": "paragraph", "text": "Trích quỹ khen thưởng, phúc lợi", "bbox": [266.67, 309.06, 401.2, 318.56]},
    {"id": "p208-b10", "type": "paragraph", "text": "(510.167.707.669)", "bbox": [436.03, 309.08, 512.29, 318.58]},
    {"id": "p208-b11", "type": "paragraph", "text": "8.865.959.921.832", "bbox": [431.65, 329.07, 512.29, 338.57]},
    {"id": "p208-b12", "type": "paragraph", "text": "Bình quân số cổ phiếu phổ\nthông đang lưu hành (cổ phiếu)", "bbox": [266.67, 349.06, 401.39, 368.57]},
    {"id": "p208-b13", "type": "paragraph", "text": "Lãi cơ bản trên mỗi cổ phiếu", "bbox": [266.67, 379.07, 389.22, 388.57]},
    {
      "id": "p208-b14",
      "type": "paragraph",
      "text": "(*) Trong năm, Công ty đã thực hiện tăng vốn từ nguồn vốn chủ sở hữu cho cổ\nđông hiện hữu cho năm 2024, dẫn đến việc điều chỉnh lại số lượng cổ phiếu phổ\nthông “ bình quân đang lưu hành của năm tài chính kết thúc ngày 31 tháng 12 năm\n2024 như sau:",
      "bbox": [258.94, 412.44, 624.26, 458.44]
    },
    {"id": "p208-b15", "type": "paragraph", "text": "Đơn vị: VNĐ", "bbox": [579.84, 221.19, 623.15, 229.19]},
    {"id": "p208-b16", "type": "paragraph", "text": "Lợi nhuận thuần phân 7.856.767.812.178\nbổ cho các cổ đông", "bbox": [658.76, 222.12, 847.44, 241.62]},
    {"id": "p208-b17", "type": "paragraph", "text": "2025", "bbox": [489.82, 243.28, 512.28, 252.78]},
    {"id": "p208-b18", "type": "paragraph", "text": "2024\nTrích quỹ khen thưởng, (624.987.179.579)", "bbox": [594.5, 243.28, 847.44, 261.64]},
    {"id": "p208-b19", "type": "paragraph", "text": "(Điều chỉnh lại (*))", "bbox": [538.14, 254.28, 617.21, 263.78]},
    {"id": "p208-b20", "type": "paragraph", "text": "phúc lợi", "bbox": [658.76, 262.12, 692.74, 271.62]},
