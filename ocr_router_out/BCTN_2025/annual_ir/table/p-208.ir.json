    {"id": "p208-b23", "type": "paragraph", "text": "Bình quân gia quyền", "bbox": [658.76, 302.13, 746.86, 311.63]},
    {"id": "p208-b24", "type": "paragraph", "text": "(624.987.179.579)", "bbox": [540.4, 309.08, 617.22, 318.58]},
    {"id": "p208-b25", "type": "paragraph", "text": "số cổ phiếu phổ thông\nđang lưu hành (cổ phiếu)", "bbox": [658.76, 312.13, 758.44, 331.63]},
    {"id": "p208-b26", "type": "paragraph", "text": "7.231.780.632.599", "bbox": [537.51, 329.07, 617.22, 338.57]},
    {"id": "p208-b27", "type": "paragraph", "text": "Lãi cơ bản trên mỗi", "bbox": [658.76, 342.13, 735.19, 351.63]},
    {"id": "p208-b28", "type": "paragraph", "text": "1.699.740.091", "bbox": [452.21, 349.07, 512.29, 358.57]},
    {"id": "p208-b29", "type": "paragraph", "text": "1.684.830.543", "bbox": [554.95, 349.07, 617.22, 358.57]},
    {"id": "p208-b30", "type": "paragraph", "text": "cổ phiếu", "bbox": [658.76, 352.13, 693.09, 361.63]},
    {"id": "p208-b31", "type": "paragraph", "text": "5.216", "bbox": [489.36, 379.07, 512.29, 388.57]},
    {"id": "p208-b32", "type": "paragraph", "text": "4.292\n(b) Lãi suy giảm trên cổ phiếu", "bbox": [592.79, 379.07, 786.92, 402.96]},
    {
      "id": "p208-b33",
      "type": "paragraph",
      "text": "Lãi suy giảm trên cổ phiếu bằng lãi cơ bản trên cổ phiếu. Công ty không có cổ\nphiếu phổ thông tiềm tàng có tác động suy giảm trong năm tài chính và đến ngày\nlập báo cáo tài chính hợp nhất này.",
      "bbox": [652.66, 411.28, 1017.98, 445.28]
    },
    {"id": "p208-b34", "type": "paragraph", "text": "Đơn vị: VNĐ", "bbox": [973.45, 129.54, 1016.77, 137.54]},
