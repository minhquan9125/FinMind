  "blocks": [
    {"id": "p212-b1", "type": "heading", "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT", "bbox": [259.68, 43.32, 697.42, 63.32]},
    {"id": "p212-b2", "type": "paragraph", "text": "Mẫu số B 09 – DN/HN", "bbox": [898.78, 50.14, 1016.1, 62.14]},
    {"id": "p212-b3", "type": "heading", "text": "CHO NĂM TÀI CHÍNH KẾT THÚC NGÀY 31 THÁNG 12 NĂM 2025", "bbox": [259.68, 67.32, 846.92, 87.32]},
    {"id": "p212-b4", "type": "paragraph", "text": "34. Báo cáo bộ phận", "bbox": [259.77, 112.21, 406.46, 128.21]},
    {
      "id": "p212-b5",
      "type": "paragraph",
      "text": "(a) Báo cáo bộ phận theo lĩnh vực kinh doanh của Tập đoàn\nCho năm tài chính kết thúc ngày 31 tháng 12 năm 2025",
      "bbox": [260.07, 145.03, 518.82, 169.44]
    },
    {"id": "p212-b6", "type": "paragraph", "text": "Doanh thu thuần theo bộ phận", "bbox": [270.17, 269.68, 402.1, 279.18]},
    {"id": "p212-b7", "type": "paragraph", "text": "Chi phí theo bộ phận (*)", "bbox": [270.17, 289.67, 373.31, 299.17]},
    {"id": "p212-b8", "type": "paragraph", "text": "Trong đó:", "bbox": [270.17, 309.67, 311.53, 319.17]},
    {"id": "p212-b9", "type": "paragraph", "text": "• Tổng chi phí khấu hao TSCĐ và\nphân bổ LTTM", "bbox": [270.17, 329.67, 422.96, 350.57]},
    {"id": "p212-b10", "type": "paragraph", "text": "• Tổng phân bổ chi phí trả trước dài hạn", "bbox": [270.17, 361.07, 453.34, 370.57]},
    {"id": "p212-b11", "type": "paragraph", "text": "Phần (lỗ)/ lãi trong công ty liên doanh, liên kết", "bbox": [270.17, 381.06, 458.62, 390.56]},
    {"id": "p212-b12", "type": "paragraph", "text": "Kết quả HĐKD theo bộ phận", "bbox": [270.17, 401.29, 392.51, 410.79]},
    {"id": "p212-b13", "type": "paragraph", "text": "Lợi nhuận trước thuế theo bộ phận", "bbox": [270.17, 421.29, 420.72, 430.79]},
    {"id": "p212-b14", "type": "paragraph", "text": "Tổng chi phí đã phát sinh để mua TSCĐ\nvà các tài sản dài hạn khác", "bbox": [270.17, 461.06, 440.5, 481.96]},
    {"id": "p212-b15", "type": "paragraph", "text": "Tài sản bộ phận tại 31/12/2025", "bbox": [270.17, 492.46, 405.86, 501.96]},
    {"id": "p212-b16", "type": "paragraph", "text": "Nợ phải trả bộ phận tại 31/12/2025", "bbox": [270.17, 512.46, 423.61, 521.96]},
    {"id": "p212-b17", "type": "paragraph", "text": "Công nghệ thông tin và viễn thông", "bbox": [557.84, 199.99, 708.44, 209.49]},
