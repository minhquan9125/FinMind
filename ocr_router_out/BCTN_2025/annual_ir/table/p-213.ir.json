  "blocks": [
    {"id": "p213-b1", "type": "heading", "text": "THUYẾT MINH BÁO CÀO TÀI CHÍNH HỢP NHẤT", "bbox": [259.68, 43.32, 697.42, 63.32]},
    {"id": "p213-b2", "type": "paragraph", "text": "Mẫu số B 09 – DN/HN", "bbox": [898.78, 50.14, 1016.1, 62.14]},
    {"id": "p213-b3", "type": "heading", "text": "CHO NĂM TÀI CHÍNH KẾT THÚC NGÀY 31 THÁNG 12 NĂM 2025", "bbox": [259.68, 67.32, 846.92, 87.32]},
    {"id": "p213-b4", "type": "paragraph", "text": "34. Báo cáo bộ phận", "bbox": [259.77, 112.21, 406.46, 128.21]},
    {
      "id": "p213-b5",
      "type": "paragraph",
      "text": "(a) Báo cáo bộ phận theo lĩnh vực kinh doanh của Tập đoàn (Tiếp theo)\nCho năm tài chính kết thúc ngày 31 tháng 12 năm 2024",
      "bbox": [260.07, 145.03, 560.47, 169.36]
    },
    {"id": "p213-b6", "type": "paragraph", "text": "Doanh thu thuần theo bộ phận", "bbox": [270.16, 269.51, 402.09, 279.01]},
    {"id": "p213-b7", "type": "paragraph", "text": "Chi phí theo bộ phận (*)", "bbox": [270.16, 289.51, 373.3, 299.01]},
    {"id": "p213-b8", "type": "paragraph", "text": "Trong đó:", "bbox": [270.16, 309.51, 311.52, 319.01]},
    {"id": "p213-b9", "type": "paragraph", "text": "• Tổng chi phí khấu hao TSCĐ và\nphân bổ LTTM", "bbox": [270.16, 329.51, 416.54, 350.41]},
    {"id": "p213-b10", "type": "paragraph", "text": "• Tổng phân bổ chi phí trả trước dài hạn", "bbox": [270.16, 360.9, 453.33, 370.4]},
    {"id": "p213-b11", "type": "paragraph", "text": "Phần (lỗ)/lãi trong công ty liên doanh, liên kết", "bbox": [270.16, 380.9, 456.56, 390.4]},
    {"id": "p213-b12", "type": "paragraph", "text": "Kết quả HĐKD theo bộ phận", "bbox": [270.16, 401.13, 392.5, 410.63]},
    {"id": "p213-b13", "type": "paragraph", "text": "Lợi nhuận trước thuế theo bộ phận", "bbox": [270.16, 421.12, 420.71, 430.62]},
    {"id": "p213-b14", "type": "paragraph", "text": "Tổng chi phí đã phát sinh để mua TSCĐ và\ncác tài sản dài hạn khác", "bbox": [270.16, 460.9, 453.17, 481.8]},
    {"id": "p213-b15", "type": "paragraph", "text": "Tài sản bộ phận tại 31/12/2024", "bbox": [270.16, 492.3, 405.82, 501.8]},
    {"id": "p213-b16", "type": "paragraph", "text": "Nợ phải trả bộ phận tại 31/12/2024", "bbox": [270.16, 512.3, 423.57, 521.8]},
    {
      "id": "p213-b17",
      "type": "paragraph",
      "text": "(*) Chi phí theo bộ phận là chi phí phát sinh từ các hoạt động kinh doanh của bộ phận được tính trực tiếp cho bộ phận đó và phần chi phí chung của Tập đoàn được phân bổ",
      "bbox": [259.29, 534.15, 999.64, 543.65]
    },
    {"id": "p213-b18", "type": "paragraph", "text": "(Tiếp theo)", "bbox": [409.61, 117.81, 448.19, 125.81]},
    {"id": "p213-b19", "type": "paragraph", "text": "Công nghệ thông tin và viễn thông", "bbox": [557.71, 199.98, 708.32, 209.48]},
