  "blocks": [
    {"id": "p210-b1", "type": "heading", "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH HỢP NHẤT", "bbox": [258.9, 42.25, 696.64, 62.25]},
    {"id": "p210-b2", "type": "paragraph", "text": "Mẫu số B 09 – DN/HN", "bbox": [899.64, 48.6, 1016.96, 60.6]},
    {"id": "p210-b3", "type": "heading", "text": "CHO NĂM TÀI CHÍNH KẾT THÚC NGÀY 31 THÁNG 12 NĂM 2025", "bbox": [258.9, 65.25, 846.14, 85.25]},
    {"id": "p210-b4", "type": "paragraph", "text": "30. Chi phí bán hàng", "bbox": [259.27, 105.02, 411.87, 121.02]},
    {"id": "p210-b5", "type": "paragraph", "text": "Chi phí nhân viên", "bbox": [273.26, 173.28, 347.74, 182.78]},
    {"id": "p210-b6", "type": "paragraph", "text": "5.172.975.838.113", "bbox": [420.96, 173.28, 497.09, 182.78]},
    {"id": "p210-b7", "type": "paragraph", "text": "Khác (*)", "bbox": [273.26, 191.28, 308.43, 200.78]},
    {"id": "p210-b8", "type": "paragraph", "text": "2.389.684.802.341", "bbox": [415.89, 191.28, 497.09, 200.78]},
    {"id": "p210-b9", "type": "paragraph", "text": "7.562.660.640.454", "bbox": [414.62, 209.28, 497.09, 218.78]},
    {
      "id": "p210-b10",
      "type": "paragraph",
      "text": "(*) Khoản mục này chủ yếu bao gồm chi phí quảng cáo, khuyến mại, phí hoa hồng,\nthuê đất và văn phòng và các khoản chi phí bán hàng khác. Không có khoản mục\nchi phí nào chiếm hơn 10% trên tổng chi phí bán hàng.",
      "bbox": [258.39, 241.51, 623.68, 275.51]
    },
    {"id": "p210-b11", "type": "paragraph", "text": "31. Chi phí quản lý doanh nghiệp", "bbox": [259.27, 309.49, 497.69, 325.49]},
    {"id": "p210-b12", "type": "paragraph", "text": "4.707.387.477.210", "bbox": [418.63, 377.7, 497.09, 387.2]},
    {"id": "p210-b13", "type": "paragraph", "text": "Chi phí nhân viên", "bbox": [273.26, 377.75, 347.74, 387.25]},
    {"id": "p210-b14", "type": "paragraph", "text": "2.629.937.920.594", "bbox": [415.44, 395.7, 497.09, 405.2]},
    {"id": "p210-b15", "type": "paragraph", "text": "Khác (*)", "bbox": [273.26, 395.75, 308.43, 405.25]},
    {"id": "p210-b16", "type": "paragraph", "text": "7.337.325.397.804", "bbox": [416.07, 413.7, 497.09, 423.2]},
    {
      "id": "p210-b17",
      "type": "paragraph",
      "text": "(*) Khoản mục này chủ yếu bao gồm chi phí khấu hao TSCĐ, dịch vụ thuê ngoài,\ncông cụ dụng cụ, dự phòng khoản phải thu khó đòi và các khoản chi phí quản lý\ndoanh nghiệp khác. Không có khoản mục chi phí nào chiếm hơn 10% trên tổng chi\nphí quản lý doanh nghiệp.",
      "bbox": [258.39, 443.32, 623.71, 489.32]
    },
    {
      "id": "p210-b18",
      "type": "paragraph",
      "text": "32. Thuế thu nhập doanh nghiệp (“TNDN”)\nĐơn vị: VNĐ\nTheo quy định trong các Giấy Chứng nhận Đăng ký Doanh nghiệp của Công ty và",
      "bbox": [579.84, 105.02, 1016.82, 146.6]
    },
    {"id": "p210-b19", "type": "paragraph", "text": "2025", "bbox": [474.63, 146.41, 497.09, 155.91]},
    {
      "id": "p210-b20",
      "type": "paragraph",
      "text": "2024\ncác công ty con và các quy định thuế hiện hành, các công ty trong Tập đoàn hoạt\nđộng tại Việt Nam có nghĩa vụ nộp thuế TNDN với thuế suất 10% trên lợi nhuận\nchịu thuế đối với hoạt động cung cấp dịch vụ đào tạo; thuế suất ưu đãi theo địa",
      "bbox": [589.29, 146.41, 1016.82, 182.6]
    },
    {"id": "p210-b21", "type": "paragraph", "text": "4.076.793.428.900", "bbox": [529.47, 173.29, 612.0, 182.79]},
    {
      "id": "p210-b22",
      "type": "paragraph",
      "text": "bàn đối với hoạt động sản xuất kinh doanh của một số đơn vị trong các khu công",
      "bbox": [651.5, 184.6, 1016.8, 194.6]
    },
    {"id": "p210-b23", "type": "paragraph", "text": "2.039.168.542.883", "bbox": [530.77, 191.29, 612.0, 200.79]},
    {
      "id": "p210-b24",
      "type": "paragraph",
      "text": "nghệ cao; và 20% trên lợi nhuận chịu thuế đối với các hoạt động sản xuất kinh\ndoanh còn lại. Các công ty con ở nước ngoài đóng thuế theo thuế suất hiện hành",
      "bbox": [651.5, 196.6, 1016.78, 218.6]
    },
    {"id": "p210-b25", "type": "paragraph", "text": "6.115.961.971.783", "bbox": [537.65, 209.29, 612.0, 218.79]},
    {"id": "p210-b26", "type": "paragraph", "text": "quy định tại nước sở tại.", "bbox": [651.5, 220.6, 759.22, 230.6]},
    {"id": "p210-b27", "type": "paragraph", "text": "(a) Chi phí thuế TNDN hiện hành", "bbox": [657.7, 286.38, 798.29, 295.88]},
    {
      "id": "p210-b28",
      "type": "paragraph",
      "text": "• Chi phí thuế TNDN tính trên thu 1.951.805.682.650 1.914.485.537.410\nnhập chịu thuế năm hiện hành",
      "bbox": [671.7, 313.11, 1005.61, 331.64]
    },
    {"id": "p210-b29", "type": "paragraph", "text": "Đơn vị: VNĐ", "bbox": [579.84, 329.34, 623.15, 337.34]},
    {"id": "p210-b30", "type": "paragraph", "text": "• Điều chỉnh chi phí thuế TNDN của (34.807.490.208)", "bbox": [671.7, 349.11, 917.6, 358.64]},
    {"id": "p210-b31", "type": "paragraph", "text": "2025", "bbox": [474.63, 350.87, 497.09, 360.38]},
    {"id": "p210-b32", "type": "paragraph", "text": "2024", "bbox": [589.29, 350.87, 612.01, 360.38]},
    {"id": "p210-b33", "type": "paragraph", "text": "các năm trước vào chi phí thuế\nthu nhập hiện hành năm nay", "bbox": [680.2, 358.14, 813.7, 376.64]},
    {"id": "p210-b34", "type": "paragraph", "text": "4.251.955.881.293", "bbox": [533.13, 377.71, 612.0, 387.21]},
    {
      "id": "p210-b35",
      "type": "paragraph",
      "text": "Tổng chi phí thuế TNDN hiện hành (*) 1.916.998.192.442 1.922.927.614.658",
      "bbox": [657.7, 394.11, 1005.61, 403.63]
    },
    {"id": "p210-b36", "type": "paragraph", "text": "2.822.082.733.481", "bbox": [531.69, 395.71, 612.0, 405.21]},
    {"id": "p210-b37", "type": "paragraph", "text": "7.074.038.614.774", "bbox": [532.78, 413.71, 612.0, 423.21]},
    {"id": "p210-b38", "type": "paragraph", "text": "(b) Thu nhập thuế TNDN hoãn lại", "bbox": [657.7, 421.36, 800.06, 430.86]},
    {
      "id": "p210-b39",
      "type": "paragraph",
      "text": "• Thu nhập thuế TNDN hoãn lại\nphát sinh từ các khoản chênh\nlệch tạm thời được khấu trừ",
      "bbox": [671.7, 448.13, 807.42, 475.63]
    },
    {
      "id": "p210-b40",
      "type": "paragraph",
      "text": "• Chi phí thuế TNDN hoãn lại phát\nsinh từ các khoản chênh lệch tạm\nthời phải chịu thuế",
      "bbox": [671.7, 484.13, 824.92, 511.62]
    },
    {
      "id": "p210-b41",
      "type": "paragraph",
      "text": "Tổng thu nhập thuế TNDN hoãn lại (*) (105.704.809.379) (280.683.727.283)",
      "bbox": [657.7, 529.1, 1005.61, 538.62]
    },
    {"id": "p210-b42", "type": "paragraph", "text": "Đơn vị: VNĐ", "bbox": [972.44, 236.93, 1015.75, 244.93]},
    {"id": "p210-b43", "type": "paragraph", "text": "2025", "bbox": [895.13, 258.86, 917.6, 268.36]},
    {"id": "p210-b44", "type": "paragraph", "text": "2024", "bbox": [982.89, 258.86, 1005.61, 268.36]},
    {"id": "p210-b45", "type": "paragraph", "text": "8.442.077.248", "bbox": [943.34, 349.1, 1005.61, 358.6]},
    {"id": "p210-b46", "type": "paragraph", "text": "(241.646.085.537) (209.467.184.394)", "bbox": [838.87, 448.1, 1005.61, 457.61]},
    {"id": "p210-b47", "type": "paragraph", "text": "135.941.276.158 (71.216.542.889)", "bbox": [849.0, 484.1, 1005.61, 493.61]},
