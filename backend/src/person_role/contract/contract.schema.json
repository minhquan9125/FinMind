{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "document": {
      "oneOf": [
        {
          "$ref": "#/$defs/pdf_document"
        },
        {
          "$ref": "#/$defs/db_document"
        }
      ]
    },
    "chunk": {
      "oneOf": [
        {
          "$ref": "#/$defs/pdf_chunk"
        },
        {
          "$ref": "#/$defs/db_chunk"
        }
      ]
    },
    "entity": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "enum": [
            "Company",
            "Person",
            "Event"
          ]
        },
        "canonical_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolution_status": {
          "enum": [
            "resolved",
            "unresolved",
            "ambiguous"
          ]
        },
        "identity_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "attributes": {
          "type": "object"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "canonical_name",
        "aliases",
        "resolution_status",
        "identity_key",
        "attributes"
      ],
      "additionalProperties": false
    },
    "mention": {
      "type": "object",
      "properties": {
        "mention_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^doc:[a-f0-9]{64}$"
            },
            {
              "type": "string",
              "format": "uuid",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              }
            }
          ]
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "raw_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mention_id",
        "entity_id",
        "document_id",
        "chunk_id",
        "start",
        "end",
        "raw_name"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "document_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^doc:[a-f0-9]{64}$"
            },
            {
              "type": "string",
              "format": "uuid",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              }
            }
          ]
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "document_id",
        "chunk_id",
        "quote"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "relation_type": {
          "enum": [
            "OWNS_SHARES",
            "HAS_SUBSIDIARY",
            "HAS_ASSOCIATE",
            "HOLDS_ROLE",
            "APPOINTS",
            "DISMISSES",
            "INVOLVES",
            "COOPERATES_WITH"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "object"
        },
        "temporal": {
          "type": "object",
          "properties": {
            "as_of": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "valid_from": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "valid_to": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "as_of",
            "valid_from",
            "valid_to"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "PENDING",
                "APPROVED",
                "REJECTED"
              ]
            },
            "reviewer": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "reviewed_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "reviewer",
            "reviewed_at"
          ],
          "additionalProperties": false
        },
        "negated": {
          "type": "boolean"
        },
        "conditional": {
          "type": "boolean"
        }
      },
      "required": [
        "relation_id",
        "relation_type",
        "subject_id",
        "object_id",
        "attributes",
        "temporal",
        "evidence",
        "review"
      ],
      "additionalProperties": false
    },
    "pdf_document": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^doc:[a-f0-9]{64}$"
        },
        "document_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "extraction_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "extraction_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "document_id",
        "document_version",
        "source_sha256",
        "extraction_sha256",
        "source_path",
        "extraction_path"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "source_kind"
        ],
        "properties": {
          "source_kind": {
            "const": "db"
          }
        }
      }
    },
    "pdf_chunk": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^doc:[a-f0-9]{64}$"
        },
        "document_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "locator": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "block_id": {
              "type": "string",
              "minLength": 1
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "required": [
            "page",
            "block_id",
            "bbox"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "document_id",
        "document_version",
        "chunk_id",
        "text",
        "locator"
      ],
      "additionalProperties": false
    },
    "db_document": {
      "type": "object",
      "properties": {
        "source_kind": {
          "const": "db"
        },
        "document_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "document_version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "source_uri": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "index_version_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        }
      },
      "required": [
        "source_kind",
        "document_id",
        "document_version",
        "source_uri",
        "source_sha256",
        "index_version_id"
      ],
      "additionalProperties": true
    },
    "db_locator": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "db_text_span"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "section_index": {
          "type": "integer",
          "minimum": 0
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 1
        },
        "text_start": {
          "type": "integer",
          "minimum": 0
        },
        "offset_basis": {
          "const": "normalized_section_body"
        },
        "offset_unit": {
          "const": "unicode_codepoint"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "kind",
        "page",
        "section_index",
        "char_start",
        "char_end",
        "text_start",
        "offset_basis",
        "offset_unit",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "db_chunk": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "document_version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "chunk_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "text": {
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/db_locator"
        }
      },
      "required": [
        "document_id",
        "document_version",
        "chunk_id",
        "text",
        "locator"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "2.0.0",
        "2.1.0"
      ]
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mention"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "dataset_version",
    "documents",
    "chunks",
    "entities",
    "mentions",
    "relations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.0.0"
          }
        }
      },
      "then": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/$defs/pdf_document"
            }
          },
          "chunks": {
            "items": {
              "$ref": "#/$defs/pdf_chunk"
            }
          }
        }
      }
    }
  ]
}
