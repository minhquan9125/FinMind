# Copy to backend/.env and replace placeholders. Never commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:15433/DATABASE
# A connection with write access is required only for admin ingestion.
ADMIN_INGEST_DATABASE_URL=postgresql://WRITER:PASSWORD@127.0.0.1:15433/DATABASE
JWT_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Graph Viewer needs access to the group's Neo4j, separately from PostgreSQL.
# 17687 is a local tunnel example; each developer must open their own tunnel.
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=REPLACE_WITH_NEO4J_USER
NEO4J_PASSWORD=REPLACE_WITH_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

RESEARCH_CHAT_LIVE=true
RESEARCH_RETRIEVAL_BACKEND=hybrid
# Existing shared DB demo release. Use your own frozen corpus ID with another DB.
RESEARCH_CORPUS_VERSION_ID=9354eea4-5dc9-5079-ae81-72d0bc5d5abf
RESEARCH_WARMUP_ENABLED=true
RESEARCH_WARMUP_TIMEOUT_SECONDS=600
GEMINI_API_KEY=
# Optional extra keys of THIS team for failover rotation (comma or newline separated).
# Use only keys the team is entitled to; see docs/sprint4/ADMIN_OPERATIONS_V2.md.
# GEMINI_API_KEYS=
# Encrypts keys added from the admin page (16+ chars, random). Required to add keys on the web.
# GEMINI_KEYS_SECRET=
B1_GEMINI_FREE_TIER_CONFIRMED=false
ADMIN_NEWS_GENERATION_TIMEOUT_SECONDS=20

# Local control-plane folder. Do not copy another member's encrypted key store.
# A fresh clone uses outputs/admin-ingestion by default and the corpus ID above.
# ADMIN_INGESTION_DIRECTORY=C:/path/to/FinMind/outputs/admin-ingestion
# Optional external data/cache mounts; use paths on YOUR machine, never a teammate's.
# FINMIND_DATA_ROOT=C:/path/to/FinMind
# HF_HOME=C:/path/to/huggingface-cache
# Do not enable HF_HUB_OFFLINE/TRANSFORMERS_OFFLINE on a new machine before weights exist.

# Optional when the executables are already on PATH.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# PDFTOPPM_CMD=C:/tools/poppler/Library/bin/pdftoppm.exe
# TESSDATA_PREFIX=C:/path/to/FinMind/outputs/tools/tessdata
