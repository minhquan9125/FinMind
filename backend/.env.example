# Copy to backend/.env and replace placeholders. Never commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:15433/DATABASE
# A connection with write access is required only for admin ingestion.
ADMIN_INGEST_DATABASE_URL=postgresql://WRITER:PASSWORD@127.0.0.1:15433/DATABASE
JWT_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

RESEARCH_CHAT_LIVE=true
RESEARCH_RETRIEVAL_BACKEND=hybrid
# Existing shared DB demo release. Use your own frozen corpus ID with another DB.
RESEARCH_CORPUS_VERSION_ID=a530bc8a-e0f6-5003-9b9b-9c61b24dbcf1
RESEARCH_WARMUP_ENABLED=true
RESEARCH_WARMUP_TIMEOUT_SECONDS=600
GEMINI_API_KEY=
B1_GEMINI_FREE_TIER_CONFIRMED=false
ADMIN_NEWS_GENERATION_TIMEOUT_SECONDS=20

# Optional when the executables are already on PATH.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# PDFTOPPM_CMD=C:/tools/poppler/Library/bin/pdftoppm.exe
# TESSDATA_PREFIX=C:/path/to/FinMind/outputs/tools/tessdata
