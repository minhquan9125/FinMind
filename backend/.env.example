# FinMind backend - Vector RAG module configuration.
# Copy this file to .env and adjust for your machine before running the backend
# outside Docker Compose (docker-compose.yml already injects these values).

# PostgreSQL + pgvector (ADR01)
DATABASE_URL=postgresql://finmind:finmind@localhost:5432/finmind

# Embedding model (ADR04). BAAI/bge-m3 is the model specified in the project
# proposal (Section 9, ADR04) and is multilingual (Vietnamese + English).
# It is a large model (~2.2GB) downloaded from Hugging Face on first run.
# For local unit tests without network access to Hugging Face, override this
# with a small model such as sentence-transformers/all-MiniLM-L6-v2.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024

# Chunking parameters (same window/overlap as the original browser demo).
CHUNK_WORDS=130
CHUNK_STRIDE=100

# Vector search default
DEFAULT_TOP_K=5

# CORS - frontend origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:5173
