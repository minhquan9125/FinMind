  "blocks": [
    {"id": "p87-b1", "type": "paragraph", "text": "Khách hàng là trung tâm", "bbox": [39.69, 125.73, 397.7, 159.73]},
    {"id": "p87-b2", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN • 2025", "bbox": [448.19, 34.45, 555.59, 41.45]},
    {"id": "p87-b3", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN • 2025", "bbox": [634.96, 34.45, 742.36, 41.45]},
    {"id": "p87-b4", "type": "heading", "text": "CHƯƠNG 5 • BÁO CÁO PHÁT TRIỂN BỀN VỮNG • 169", "bbox": [975.2, 34.45, 1150.87, 41.45]},
    {"id": "p87-b5", "type": "paragraph", "text": "Tài chính xanh", "bbox": [634.96, 125.39, 770.46, 147.39]},
    {
      "id": "p87-b6",
      "type": "paragraph",
      "text": "Trong năm 2025, Khung Tín dụng xanh MB 4 đã được Đơn vị kiểm toán KPMG Ấn Độ thực",
      "bbox": [813.54, 164.46, 1150.87, 173.16]
    },
    {"id": "p87-b7", "type": "heading", "text": "ĐỊNH HƯỚNG", "bbox": [634.96, 165.23, 714.4, 177.23]},
    {
      "id": "p87-b8",
      "type": "paragraph",
      "text": "hiện đánh giá độc lập và phát hành ý kiến của Bên thứ hai (Second Party Opinion – SPO),",
      "bbox": [813.55, 174.66, 1150.81, 183.16]
    },
    {"id": "p87-b9", "type": "heading", "text": "TĂNG TRƯỞNG XANH", "bbox": [634.96, 179.63, 759.86, 191.63]},
    {"id": "p87-b10", "type": "paragraph", "text": "MB cam kết", "bbox": [275.39, 353.17, 319.89, 361.67]},
    {"id": "p87-b11", "type": "paragraph", "text": "“Tạo tác động tích cực\nthông qua\ncác sản phẩm xanh,\nbền vững”", "bbox": [213.19, 371.69, 382.09, 445.29]},
    {"id": "p87-b12", "type": "paragraph", "text": "Sản phẩm tài chính\nbền vững", "bbox": [240.62, 655.15, 348.33, 681.55]},
    {
      "id": "p87-b13",
      "type": "paragraph",
      "text": "Mở rộng tín dụng xanh, sản\nphẩm tài chính bền vững tài\ntrợ thân thiện môi trường\ngóp phần hỗ trợ doanh\nnghiệp và cộng đồng trong\nquá trình chuyển đổi xanh.",
      "bbox": [239.9, 690.49, 349.05, 749.99]
    },
    {"id": "p87-b14", "type": "paragraph", "text": "Trải nghiệm\nxuất sắc", "bbox": [467.46, 448.81, 532.8, 475.21]},
    {
      "id": "p87-b15",
      "type": "paragraph",
      "text": "Cam kết mang lại trải\nnghiệm xuất sắc cho khách\nhàng, nâng cao chất lượng\nsản phẩm – dịch vụ, đảm\nbảo minh bạch, an toàn và\nứng dụng mạnh mẽ công\nnghệ số.",
      "bbox": [445.56, 484.15, 554.7, 553.85]
    },
    {
      "id": "p87-b16",
      "type": "paragraph",
      "text": "là cơ sở quan trọng giúp MB nâng cao tính minh bạch, uy tín và khả năng tiếp cận nguồn\nvốn xanh quốc tế. Khung tín dụng xanh MB được xác nhận tuân thủ theo 04 thành phần\ncốt lõi theo tiêu chuẩn quốc tế gồm:",
      "bbox": [813.55, 184.66, 1150.91, 213.15]
    },
    {"id": "p87-b17", "type": "paragraph", "text": "Quy trình đánh giá và", "bbox": [1026.12, 234.96, 1111.35, 243.46]},
    {"id": "p87-b18", "type": "paragraph", "text": "Mục đích sử dụng vốn", "bbox": [854.52, 239.43, 940.36, 247.93]},
    {"id": "p87-b19", "type": "paragraph", "text": "lựa chọn dự án", "bbox": [1038.78, 243.96, 1098.69, 252.46]},
    {"id": "p87-b20", "type": "paragraph", "text": "Quản lý sử dụng vốn vay", "bbox": [848.95, 288.75, 945.93, 297.25]},
    {"id": "p87-b21", "type": "paragraph", "text": "Báo cáo tác động", "bbox": [1034.24, 288.75, 1103.24, 297.25]},
    {
      "id": "p87-b22",
      "type": "paragraph",
      "text": "Ngay sau khi Chính phủ ban hành Quyết định 21/2025/QĐ-TTg (QĐ21) về Danh mục phân\nloại xanh, MB đã cập nhật và bổ sung danh mục, tiêu chí dự án xanh đủ điều kiện vào\nKhung Tín dụng xanh MB, bảo đảm tuân thủ quy định luật pháp quốc gia. Đồng thời MB\nlà thành viên tích cực tham gia phối hợp cùng NHNN trong việc xây dựng Dự thảo hỗ trợ\nlãi suất từ nguồn vốn ngân sách đối với các dự án xanh đủ điều kiện theo QĐ21 – cụ thể\nhóa định hướng của Quốc hội và Chính phủ về chuyển dịch và tăng trưởng kinh tế xanh.",
      "bbox": [813.55, 326.27, 1150.92, 384.75]
    },
    {
      "id": "p87-b23",
      "type": "paragraph",
      "text": "MB tiếp tục đẩy mạnh tăng trưởng tín dụng xanh trong cơ cấu danh mục tín dụng, cụ thể:",
      "bbox": [813.55, 407.42, 1150.89, 415.92]
    },
    {"id": "p87-b24", "type": "paragraph", "text": "Kết quả triển khai\nnăm 2025", "bbox": [634.96, 408.54, 733.24, 434.94]},
    {"id": "p87-b25", "type": "paragraph", "text": "Huy động thành công", "bbox": [813.54, 426.39, 898.12, 434.89]},
    {"id": "p87-b26", "type": "paragraph", "text": "Quy mô dư nợ tín dụng xanh N2025 đạt", "bbox": [991.16, 426.39, 1146.74, 434.89]},
    {"id": "p87-b27", "type": "paragraph", "text": "500 triệu", "bbox": [813.54, 444.18, 912.68, 485.09]},
    {"id": "p87-b28", "type": "paragraph", "text": "68.501 tỷ đồng", "bbox": [991.82, 446.42, 1149.24, 486.89]},
    {"id": "p87-b29", "type": "paragraph", "text": "USD", "bbox": [887.24, 456.18, 911.33, 468.18]},
    {"id": "p87-b30", "type": "paragraph", "text": "vốn xanh quốc tế", "bbox": [813.54, 485.24, 878.47, 493.74]},
    {"id": "p87-b31", "type": "paragraph", "text": "cho 5.148 khoản vay/dự án xanh", "bbox": [993.16, 486.08, 1114.39, 494.58]},
    {"id": "p87-b32", "type": "paragraph", "text": "Cơ cấu dư nợ xanh:", "bbox": [634.96, 505.8, 710.37, 514.3]},
    {"id": "p87-b33", "type": "paragraph", "text": "Lĩnh vực nông, lâm nghiệp\nxanh bền vững", "bbox": [1062.34, 562.96, 1149.53, 580.74]},
    {"id": "p87-b34", "type": "paragraph", "text": "22%", "bbox": [1000.75, 572.81, 1021.78, 582.91]},
    {"id": "p87-b35", "type": "paragraph", "text": "Lĩnh vực năng lượng tái tạo và\nnăng lượng sạch", "bbox": [635.64, 606.96, 736.73, 624.74]},
    {"id": "p87-b36", "type": "paragraph", "text": "62%", "bbox": [753.62, 617.52, 775.08, 627.63]},
    {"id": "p87-b37", "type": "paragraph", "text": "Lĩnh vực công nghiệp xanh\n9%", "bbox": [1000.75, 624.88, 1149.53, 635.23]},
    {"id": "p87-b38", "type": "paragraph", "text": "Lĩnh vực giao thông xanh\n7%", "bbox": [996.16, 651.62, 1149.53, 661.97]},
    {"id": "p87-b39", "type": "paragraph", "text": "Lĩnh vực xanh khác", "bbox": [1085.48, 673.73, 1149.53, 681.81]},
    {"id": "p87-b40", "type": "paragraph", "text": "~1%", "bbox": [996.16, 673.98, 1015.71, 684.09]},
    {"id": "p87-b41", "type": "paragraph", "text": "168 • CHƯƠNG 5 • BÁO CÁO PHÁT TRIỂN BỀN VỮNG", "bbox": [39.69, 34.45, 215.42, 41.45]},
    {"id": "p87-b42", "type": "paragraph", "text": "An toàn – bảo mật\ntrong môi trường số", "bbox": [40.72, 448.81, 147.31, 475.21]},
    {
      "id": "p87-b43",
      "type": "paragraph",
      "text": "Không ngừng đổi mới và\nchuyển đổi số nhằm đơn\ngiản hóa quy trình, nâng cao\nhiệu quả phục vụ, đảm bảo\nan toàn – bảo mật trong môi\ntrường số và tăng cường\ntiếp cận tài chính, dịch vụ\nngân hàng cho khách hàng",
      "bbox": [39.69, 484.15, 148.65, 564.05]
    },
    {
      "id": "p87-b44",
      "type": "paragraph",
      "text": "4 Khung Tín dụng xanh MB đã được ban hành tháng 12/2024: với danh mục lĩnh vực xanh cùng các tiêu chí kỹ thuật chi\ntiết cho từng nhóm dự án, tạo cơ sở thống nhất trong đánh giá, thẩm định và đo lường các tác động tới môi trường,\nkhí hậu mà dự án, khoản vay mang lại.\nhttps://www.mbbank.com.vn/phat-trien-ben-vung",
      "bbox": [813.54, 780.99, 1150.85, 811.04]
    }
  ]
}
