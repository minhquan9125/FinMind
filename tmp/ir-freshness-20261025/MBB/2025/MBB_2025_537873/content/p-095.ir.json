    {"id": "p95-b22", "type": "paragraph", "text": "75,1\n79,2", "bbox": [264.9, 436.75, 345.26, 445.25]},
    {"id": "p95-b23", "type": "paragraph", "text": "-\n-\n5,4%", "bbox": [409.24, 436.75, 547.09, 445.25]},
    {"id": "p95-b24", "type": "paragraph", "text": "Tăng cường sử dụng taxi điện:", "bbox": [396.27, 588.29, 508.56, 596.29]},
    {"id": "p95-b25", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN • 2025", "bbox": [634.96, 34.45, 742.36, 41.45]},
    {"id": "p95-b26", "type": "paragraph", "text": "Quản lý nước tiêu thụ", "bbox": [635.38, 89.76, 799.44, 105.76]},
    {"id": "p95-b27", "type": "paragraph", "text": "Chi tiêu", "bbox": [643.46, 128.82, 673.86, 137.32]},
    {"id": "p95-b28", "type": "paragraph", "text": "Nhân sự làm việc tại Hội sở", "bbox": [643.46, 149.55, 748.87, 158.05]},
    {"id": "p95-b29", "type": "paragraph", "text": "Tổng lượng nước sử dụng", "bbox": [643.45, 167.45, 743.16, 175.95]},
    {"id": "p95-b30", "type": "paragraph", "text": "Nguồn từ các cơ sở cấp nước đô thị hoặc công cộng hoặc tư\nnhân khác", "bbox": [643.44, 185.36, 876.3, 203.86]},
    {"id": "p95-b31", "type": "paragraph", "text": "Cường độ sử dụng nước (m 3 /người)", "bbox": [643.43, 213.06, 778.83, 221.76]},
    {"id": "p95-b32", "type": "paragraph", "text": "Nguồn nước mặt", "bbox": [643.46, 231.16, 708.43, 239.66]},
    {"id": "p95-b33", "type": "paragraph", "text": "Nguồn nước ngầm", "bbox": [643.45, 249.07, 715.18, 257.57]},
    {"id": "p95-b34", "type": "paragraph", "text": "Nước tái chế", "bbox": [643.45, 266.96, 693.11, 275.46]},
    {"id": "p95-b35", "type": "paragraph", "text": "Tổng lượng nước tái chế", "bbox": [643.45, 284.87, 736.22, 293.37]},
    {"id": "p95-b36", "type": "paragraph", "text": "Tỷ lệ phần trăm nước tái chế trên tổng lượng nước sử dụng", "bbox": [643.44, 302.77, 867.83, 311.27]},
    {"id": "p95-b37", "type": "paragraph", "text": "Nước tái sử dụng", "bbox": [643.43, 320.66, 710.39, 329.16]},
    {"id": "p95-b38", "type": "paragraph", "text": "Tổng lượng nước tái sử dụng", "bbox": [643.43, 338.57, 753.13, 347.07]},
    {"id": "p95-b39", "type": "paragraph", "text": "Tỷ lệ phần trăm nước tái sử dụng trên tổng lượng nước sử dụng", "bbox": [643.42, 356.47, 874.54, 364.97]},
    {
      "id": "p95-b40",
      "type": "paragraph",
      "text": "Cường độ sử dụng nước trên người tại Hội sở năm 2025 là 9,2 m 3 /người, tăng 2,7% so với\nnăm 2024. Lý do là trong năm 2025, mặc dù lượng nước sử dụng giảm 1.047 m 3 nước, số\nlượng nhân sự tại Hội sở cũng giảm 200 người.",
      "bbox": [813.68, 385.43, 1150.02, 414.12]
    },
    {
      "id": "p95-b41",
      "type": "paragraph",
      "text": "Tại Hội sở: sử dụng nguồn nước cấp do Đơn vị cung cấp nước sạch Viwaco cung cấp, lưu",
      "bbox": [813.68, 430.44, 1150.02, 438.94]
    },
    {"id": "p95-b42", "type": "paragraph", "text": "Cơ sở tính toán lượng nước", "bbox": [634.54, 430.54, 788.77, 442.54]},
    {
      "id": "p95-b43",
      "type": "paragraph",
      "text": "lượng nước sử dụng được theo dõi, ghi chép hàng tháng qua đồng hồ nước. Nguồn nước",
      "bbox": [813.68, 440.44, 1150.06, 448.94]
    },
    {"id": "p95-b44", "type": "paragraph", "text": "tiêu thụ", "bbox": [634.54, 444.94, 676.68, 456.94]},
    {
      "id": "p95-b45",
      "type": "paragraph",
      "text": "được kiểm định định kỳ đáp ứng QCVN 01:2024/BYT về chất lượng nước sạch sử dụng\ncho mục đích sinh hoạt trước khi được phân phối sử dụng.",
      "bbox": [813.68, 450.43, 1150.04, 468.93]
    },
    {
      "id": "p95-b46",
      "type": "paragraph",
      "text": "Tại các chi nhánh và phòng giao dịch: sử dụng nguồn nước do các cơ sở cung cấp nước\nđược cấp phép, lưu lượng nước sử dụng cũng được theo dõi và ghi chép tổng hợp qua\nđồng hồ công tơ hàng tháng.",
      "bbox": [813.68, 480.43, 1150.07, 508.92]
    },
    {
      "id": "p95-b47",
      "type": "paragraph",
      "text": "Sử dụng vòi rửa tay cảm ứng và kiểm soát lưu lượng nước sử dụng thông qua phần mềm",
      "bbox": [813.68, 525.69, 1149.95, 534.19]
    },
    {"id": "p95-b48", "type": "paragraph", "text": "Các sáng kiến và biện pháp", "bbox": [634.54, 525.8, 787.93, 537.8]},
    {
      "id": "p95-b49",
      "type": "paragraph",
      "text": "BPM. Đồng thời, để đảm bảo sức khỏe của CBNV, Ngân hàng định kỳ thay thế hệ thống",
      "bbox": [813.68, 535.69, 1149.96, 544.19]
    },
    {"id": "p95-b50", "type": "paragraph", "text": "tiết kiệm nước", "bbox": [634.54, 540.2, 714.66, 552.2]},
    {
      "id": "p95-b51",
      "type": "paragraph",
      "text": "lọc và kiểm định chất lượng nước định kỳ tại các cây nước uống trực tiếp theo khuyến cáo\nvà tiêu chuẩn của nhà sản xuất.",
      "bbox": [813.68, 545.69, 1150.05, 564.18]
    },
    {
      "id": "p95-b52",
      "type": "paragraph",
      "text": "Thực hiện truyền thông Hướng dẫn môi trường làm việc xanh, sử dụng nước tiết kiệm,\nhiệu quả tới CBNV và nhân sự tại Hội sở, các CN/PGD MB.",
      "bbox": [813.68, 575.68, 1149.99, 594.18]
    },
