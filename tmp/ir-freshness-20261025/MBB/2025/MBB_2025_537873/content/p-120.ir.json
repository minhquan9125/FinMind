    {"id": "p120-b17", "type": "paragraph", "text": "Thành viên Ủy ban", "bbox": [402.52, 332.0, 473.77, 340.5]},
    {"id": "p120-b18", "type": "paragraph", "text": "Phạm Thị Quỳnh", "bbox": [226.77, 358.4, 290.58, 366.9]},
    {"id": "p120-b19", "type": "paragraph", "text": "Thành viên không có quyền biểu quyết", "bbox": [402.52, 358.4, 548.4, 366.9]},
    {
      "id": "p120-b20",
      "type": "paragraph",
      "text": "Nhiệm vụ chính của Ủy ban Công nghệ và Chuyển đổi số bao gồm xem xét các định hướng\nhoạt động của Ngân hàng, thực hiện đánh giá và rà soát các dự án công nghệ đang triển khai.",
      "bbox": [218.27, 390.38, 555.65, 408.88]
    },
    {
      "id": "p120-b21",
      "type": "paragraph",
      "text": "Trong năm 2025, Ủy ban Công nghệ và Chuyển đổi số đã tổ chức 02 cuộc họp, xem xét rà\nsoát, đánh giá và định hướng các dự án công nghệ trọng điểm.",
      "bbox": [218.27, 420.38, 555.55, 438.87]
    },
    {
      "id": "p120-b22",
      "type": "paragraph",
      "text": "Các thành viên tham gia cuộc họp Ủy ban bằng hình thức trực tiếp hoặc ủy quyền tham\ndự, đảm bảo đủ số lượng các Thành viên trong mỗi cuộc họp.",
      "bbox": [218.27, 450.37, 555.55, 468.87]
    },
    {"id": "p120-b23", "type": "heading", "text": "CÁC CUỘC HỌP CỦA ỦY BAN CÔNG NGHỆ VÀ CHUYỂN ĐỔI SỐ TRONG NĂM 2025", "bbox": [230.71, 499.44, 543.19, 507.44]},
    {"id": "p120-b24", "type": "paragraph", "text": "STT Ngày họp", "bbox": [227.13, 520.8, 297.23, 528.8]},
    {"id": "p120-b25", "type": "paragraph", "text": "Nội dung chính", "bbox": [324.07, 520.8, 380.12, 528.8]},
    {"id": "p120-b26", "type": "paragraph", "text": "Kết quả", "bbox": [440.79, 520.8, 469.44, 528.8]},
    {"id": "p120-b27", "type": "paragraph", "text": "Quý II/2025 Xem xét các định hướng Được thông qua\n1", "bbox": [227.13, 543.64, 503.13, 552.15]},
    {
      "id": "p120-b28",
      "type": "paragraph",
      "text": "hoạt động của Ngân\nhàng, thực hiện đánh giá\nvà rà soát các dự án công\nnghệ đang triển khai",
      "bbox": [324.07, 553.65, 423.78, 592.14]
    },
    {"id": "p120-b29", "type": "paragraph", "text": "Quý IV/2025 Xem xét các định hướng Được thông qua\n2", "bbox": [227.12, 607.18, 503.12, 615.71]},
    {
      "id": "p120-b30",
      "type": "paragraph",
      "text": "hoạt động của Ngân\nhàng, thực hiện đánh giá\nvà rà soát các dự án công\nnghệ đang triển khai và\nđịnh hướng kế hoạch các\nDự án trọng điểm năm\n2026",
      "bbox": [324.06, 617.2, 423.77, 685.68]
    },
    {"id": "p120-b31", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN • 2025", "bbox": [634.96, 34.45, 742.36, 41.45]},
