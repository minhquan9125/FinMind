  "blocks": [
    {"id": "p129-b1", "type": "paragraph", "text": "Đánh giá việc thực hiện các\nquy định về quản trị công ty", "bbox": [39.69, 90.28, 440.92, 162.29]},
    {"id": "p129-b2", "type": "paragraph", "text": "Hội đồng Quản trị của MB nhiệm kỳ 2024-2029", "bbox": [39.69, 184.4, 476.96, 206.4]},
    {"id": "p129-b3", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN • 2025", "bbox": [448.19, 34.45, 555.59, 41.45]},
    {"id": "p129-b4", "type": "paragraph", "text": "PHÓ", "bbox": [316.96, 354.92, 341.13, 366.94]},
    {"id": "p129-b5", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN • 2025", "bbox": [634.96, 34.45, 742.36, 41.45]},
    {"id": "p129-b6", "type": "paragraph", "text": "Thành viên\nHội đồng\nQuản trị", "bbox": [764.56, 270.2, 815.95, 304.27]},
    {"id": "p129-b7", "type": "paragraph", "text": "Thành viên\nHội đồng", "bbox": [820.16, 350.78, 871.56, 372.83]},
    {"id": "p129-b8", "type": "heading", "text": "CHƯƠNG 6 • QUẢN TRỊ CÔNG TY • 253", "bbox": [1019.59, 34.45, 1150.86, 41.45]},
    {
      "id": "p129-b9",
      "type": "paragraph",
      "text": "Hội đồng Quản trị của MB nhiệm kỳ 2024-\n2029 (tới thời điểm 31/12/2025) gồm 11 thành\nviên: 01 Chủ tịch, 03 Phó Chủ tịch, 06 Thành\nviên HĐQT và 01 Thành viên độc lập.",
      "bbox": [992.69, 184.02, 1150.88, 222.51]
    },
    {
      "id": "p129-b10",
      "type": "paragraph",
      "text": "Hội đồng Quản trị có 4/11 thành viên là nữ,\nchiếm tỷ lệ ~ 36,4%; 7/11 thành viên chuyên\ntrách, chiếm tỷ lệ ~63,6%).",
      "bbox": [992.69, 234.01, 1150.89, 262.5]
    },
    {
      "id": "p129-b11",
      "type": "paragraph",
      "text": "Hội đồng Quản trị (HĐQT) MB trong nhiệm\nkỳ hiện tại bao gồm các thành viên tiếp\ntục đảm nhiệm từ nhiệm kỳ trước, đồng\nthời được bổ sung thêm các đại diện đến\ntừ các cổ đông chiến lược, bao gồm: Tập\nđoàn Công nghiệp – Viễn thông Quân đội\n(Viettel), Tổng Công ty Tân Cảng Sài Gòn,\nTổng Công ty Trực thăng Việt Nam và\nTổng Công ty Đầu tư và Kinh doanh vốn\nNhà nước (SCIC). Sự tham gia của các",
      "bbox": [992.69, 274.0, 1150.89, 372.46]
    },
    {"id": "p129-b12", "type": "heading", "text": "CHỦ TỊCH", "bbox": [302.24, 368.1, 355.85, 380.12]},
    {"id": "p129-b13", "type": "paragraph", "text": "tổ chức lớn với năng lực tài chính và kinh", "bbox": [992.69, 373.96, 1150.89, 382.46]},
    {"id": "p129-b14", "type": "paragraph", "text": "Quản trị", "bbox": [826.65, 374.83, 865.06, 384.85]},
    {
      "id": "p129-b15",
      "type": "paragraph",
      "text": "nghiệm quản trị vững mạnh góp phần\ncủng cố nền tảng quản trị của MB.",
      "bbox": [992.69, 383.96, 1150.87, 402.45]
    },
    {
      "id": "p129-b16",
      "type": "paragraph",
      "text": "Cơ cấu nhân sự HĐQT được đánh giá là\ncó chất lượng cao, nhờ sự kết hợp giữa\nđội ngũ thành viên chuyên trách giàu kinh\nnghiệm trong lĩnh vực tài chính – ngân",
      "bbox": [992.69, 413.95, 1150.87, 452.44]
    },
    {"id": "p129-b17", "type": "paragraph", "text": "Thành viên", "bbox": [848.75, 446.42, 900.15, 456.44]},
    {"id": "p129-b18", "type": "paragraph", "text": "hàng và các thành viên là lãnh đạo cấp", "bbox": [992.69, 453.94, 1150.85, 462.44]},
    {"id": "p129-b19", "type": "paragraph", "text": "Hội đồng", "bbox": [853.38, 458.45, 895.5, 468.47]},
    {"id": "p129-b20", "type": "paragraph", "text": "cao của những tập đoàn, doanh nghiệp", "bbox": [992.69, 463.93, 1150.85, 472.43]},
    {"id": "p129-b21", "type": "paragraph", "text": "Quản trị", "bbox": [855.24, 470.47, 893.65, 480.49]},
    {
      "id": "p129-b22",
      "type": "paragraph",
      "text": "hàng đầu – đồng thời là cổ đông chiến\nlược của MB. Thành phần đa dạng về\nchuyên môn và kinh nghiệm giúp HĐQT",
      "bbox": [992.69, 473.93, 1150.87, 502.42]
    },
    {"id": "p129-b23", "type": "heading", "text": "CHỦ TỊCH", "bbox": [279.81, 500.56, 379.35, 522.61]},
    {"id": "p129-b24", "type": "paragraph", "text": "PHÓ", "bbox": [440.55, 568.99, 464.72, 581.01]},
    {
      "id": "p129-b25",
      "type": "paragraph",
      "text": "có góc nhìn toàn diện, tăng cường năng\nlực hoạch định chiến lược, giám sát và\nđiều hành theo chuẩn mực cao của quản\ntrị doanh nghiệp hiện đại.",
      "bbox": [992.69, 503.92, 1150.89, 542.4]
    },
    {"id": "p129-b26", "type": "paragraph", "text": "Thành viên\nHội đồng\nQuản trị", "bbox": [848.75, 544.53, 900.15, 578.6]},
    {"id": "p129-b27", "type": "heading", "text": "CHỦ TỊCH", "bbox": [425.83, 582.17, 479.44, 594.19]},
    {"id": "p129-b28", "type": "paragraph", "text": "Thành viên", "bbox": [820.65, 638.19, 872.05, 648.21]},
    {"id": "p129-b29", "type": "paragraph", "text": "Hội đồng\nQuản trị", "bbox": [825.28, 650.21, 867.4, 672.26]},
