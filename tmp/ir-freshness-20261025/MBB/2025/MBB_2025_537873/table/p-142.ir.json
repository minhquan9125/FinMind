    {
      "id": "p142-b36",
      "type": "paragraph",
      "text": "Người đại diện theo pháp luật của Ngân hàng trong năm và vào ngày lập báo cáo này",
      "bbox": [813.54, 701.83, 1150.91, 710.33]
    },
