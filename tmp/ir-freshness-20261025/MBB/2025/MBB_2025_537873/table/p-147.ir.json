    {"id": "p147-b3", "type": "paragraph", "text": "Chênh lệch số tiền thực thu từ hoạt động kinh doanh (ngoại tệ,", "bbox": [48.65, 367.61, 290.93, 376.11]},
    {"id": "p147-b4", "type": "paragraph", "text": "Tăng các khoản tiền gửi và cho vay các tổ chức tín dụng khác", "bbox": [48.65, 601.51, 287.71, 610.01]},
    {"id": "p147-b5", "type": "paragraph", "text": "Giảm nguồn dự phòng để bù đắp tổn thất các khoản tín dụng,", "bbox": [48.65, 728.67, 289.29, 737.17]},
