    {"id": "p147-b78", "type": "paragraph", "text": "288 • CHƯƠNG 7 • BÁO CÁO TÀI CHÍNH HỢP NHẤT ĐÃ KIỂM TOÁN", "bbox": [39.69, 34.45, 262.39, 41.45]},
    {"id": "p147-b79", "type": "paragraph", "text": "tiền tệ hợp nhất", "bbox": [39.69, 132.54, 271.33, 166.54]},
    {"id": "p147-b80", "type": "paragraph", "text": "LƯU CHUYỂN TIỀN TỪ HOẠT ĐỘNG KINH DOANH", "bbox": [48.65, 251.02, 235.1, 259.02]},
    {"id": "p147-b81", "type": "paragraph", "text": "Thu nhập lãi và các khoản thu nhập tương tự nhận được", "bbox": [48.65, 279.89, 268.92, 288.39]},
    {"id": "p147-b82", "type": "paragraph", "text": "Chi phí lãi và các chi phí tương tự đã trả", "bbox": [48.65, 309.13, 205.24, 317.63]},
    {"id": "p147-b83", "type": "paragraph", "text": "Thu nhập từ hoạt động dịch vụ nhận được", "bbox": [48.65, 338.37, 212.84, 346.87]},
    {"id": "p147-b84", "type": "paragraph", "text": "vàng bạc, chứng khoán) nhận được", "bbox": [48.65, 377.81, 186.27, 386.31]},
    {"id": "p147-b85", "type": "paragraph", "text": "Thu nhập khác nhận được", "bbox": [48.65, 407.05, 150.61, 415.55]},
    {
      "id": "p147-b86",
      "type": "paragraph",
      "text": "Tiền thu các khoản nợ đã được xử lý, bù đắp bằng nguồn dự\nphòng rủi ro",
      "bbox": [48.65, 436.29, 283.4, 454.99]
    },
    {"id": "p147-b87", "type": "paragraph", "text": "Tiền chi trả cho nhân viên và hoạt động quản lý, công vụ", "bbox": [48.65, 475.73, 266.73, 484.23]},
    {"id": "p147-b88", "type": "paragraph", "text": "Tiền thuế thu nhập thực nộp trong năm", "bbox": [48.65, 504.97, 200.93, 513.47]},
    {
      "id": "p147-b89",
      "type": "paragraph",
      "text": "Lưu chuyển tiền thuần từ hoạt động kinh doanh trước những\nthay đổi về tài sản và nợ phải trả hoạt động",
      "bbox": [48.65, 534.18, 274.2, 551.78]
    },
    {"id": "p147-b90", "type": "paragraph", "text": "Những thay đổi về tài sản hoạt động", "bbox": [48.65, 573.76, 171.64, 581.76]},
    {"id": "p147-b91", "type": "paragraph", "text": "Tăng các khoản về kinh doanh chứng khoán", "bbox": [48.65, 630.75, 219.94, 639.25]},
    {"id": "p147-b92", "type": "paragraph", "text": "Giảm các công cụ tài chính phái sinh và các tài sản tài\nchính khác", "bbox": [48.65, 659.99, 267.9, 678.69]},
    {"id": "p147-b93", "type": "paragraph", "text": "Tăng các khoản cho vay khách hàng và các khoản mua nợ", "bbox": [48.65, 699.43, 276.59, 707.93]},
    {"id": "p147-b94", "type": "paragraph", "text": "chứng khoán, đầu tư dài hạn, phải thu khác", "bbox": [48.65, 738.87, 217.81, 747.37]},
    {"id": "p147-b95", "type": "paragraph", "text": "(Tăng)/giảm khác về tài sản hoạt động", "bbox": [48.65, 768.11, 197.0, 776.61]},
