    {"id": "p147-b42", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN • 2025", "bbox": [634.96, 34.45, 742.36, 41.45]},
    {"id": "p147-b43", "type": "paragraph", "text": "Những thay đổi về nợ phải trả hoạt động", "bbox": [643.46, 252.53, 781.41, 260.53]},
    {"id": "p147-b44", "type": "paragraph", "text": "Tăng các khoản nợ chính phủ và Ngân hàng Nhà nước", "bbox": [643.46, 280.28, 855.79, 288.78]},
    {"id": "p147-b45", "type": "paragraph", "text": "Tăng các khoản tiền gửi, tiền vay các tổ chức tín dụng", "bbox": [643.46, 309.52, 852.11, 318.02]},
    {"id": "p147-b46", "type": "paragraph", "text": "Tiền gửi của khách hàng", "bbox": [643.46, 338.76, 738.72, 347.26]},
    {
      "id": "p147-b47",
      "type": "paragraph",
      "text": "Tăng/(giảm) phát hành giấy tờ có giá (ngoại trừ giấy tờ có giá\nphát hành được tính vào hoạt động tài chính)",
      "bbox": [643.46, 368.0, 883.6, 386.7]
    },
    {
      "id": "p147-b48",
      "type": "paragraph",
      "text": "Tăng/(giảm) vốn tài trợ, uỷ thác đầu tư, cho vay mà tổ chức tín\ndụng chịu rủi ro",
      "bbox": [643.46, 407.44, 884.64, 426.14]
    },
    {"id": "p147-b49", "type": "paragraph", "text": "Tăng công cụ tài chính phái sinh và các khoản nợ tài chính khác", "bbox": [643.46, 446.88, 880.29, 455.38]},
    {"id": "p147-b50", "type": "paragraph", "text": "Tăng/(giảm) khác về công nợ hoạt động", "bbox": [643.46, 476.12, 798.6, 484.62]},
    {"id": "p147-b51", "type": "paragraph", "text": "Chi từ quỹ của tổ chức tín dụng", "bbox": [643.46, 505.36, 765.45, 513.86]},
    {"id": "p147-b52", "type": "paragraph", "text": "Lưu chuyển tiền thuần sử dụng từ hoạt động kinh doanh", "bbox": [643.46, 534.57, 852.08, 542.57]},
