  "blocks": [
    {"id": "p78-b1", "type": "heading", "text": "CHƯƠNG 5 • BÁO CÁO PHÁT TRIỂN BỀN VỮNG", "bbox": [379.6, 30.85, 532.89, 37.85]},
    {
      "id": "p78-b2",
      "type": "paragraph",
      "text": "MB quản trị rủi ro chủ động thông minh bằng hiểu biết sâu sắc rủi ro, kết hợp với kiểm",
      "bbox": [206.36, 151.35, 532.81, 159.85]
    },
    {"id": "p78-b3", "type": "furniture", "text": "DOANH NGHIỆP SỐ TẬP ĐOÀN TÀI CHÍNH DẪN ĐẦU", "bbox": [657.65, 30.85, 828.85, 37.85]},
    {"id": "p78-b4", "type": "paragraph", "text": "155\nBÁO CÁO THƯỜNG NIÊN 2024", "bbox": [1000.69, 30.85, 1154.55, 37.85]},
    {"id": "p78-b5", "type": "heading", "text": "MỤC TIÊU PHÁT TRIỂN BỀN VỮNG", "bbox": [662.14, 151.5, 888.14, 165.5]},
    {
      "id": "p78-b6",
      "type": "paragraph",
      "text": "nghiệm thực tế, sử dụng các mô hình dữ liệu để cải tiến để tìm ra các giải pháp hướng\nđến khách hàng; Là Ngân hàng có trách nhiệm xã hội cao; Bảo vệ môi trường, phát\ntriển xanh và bền vững.",
      "bbox": [206.36, 165.34, 532.89, 201.84]
    },
    {"id": "p78-b7", "type": "paragraph", "text": "4 trụ cột phát triển bền vững của MB", "bbox": [206.36, 220.74, 409.93, 232.74]},
    {
      "id": "p78-b8",
      "type": "paragraph",
      "text": "Khách hàng\nTích cực đồng hành cùng khách hàng\ntrong hành trình chuyển đổi ESG thông\nqua hoạt động tài trợ có trách nhiệm và\ntrải nghiệm tài chính vượt trội",
      "bbox": [360.0, 287.08, 515.84, 354.18]
    },
    {"id": "p78-b9", "type": "paragraph", "text": "• Tài chính xanh", "bbox": [360.0, 365.34, 419.11, 373.84]},
    {"id": "p78-b10", "type": "paragraph", "text": "• Trải nghiệm khách hàng", "bbox": [360.0, 385.01, 455.22, 393.51]},
    {"id": "p78-b11", "type": "paragraph", "text": "• Tài chính toàn diện", "bbox": [360.0, 404.68, 435.74, 413.18]},
    {"id": "p78-b12", "type": "paragraph", "text": "Quản trị dữ liệu", "bbox": [254.15, 423.72, 314.75, 432.22]},
    {"id": "p78-b13", "type": "paragraph", "text": "Khách hàng", "bbox": [351.68, 464.69, 390.05, 471.69]},
    {"id": "p78-b14", "type": "paragraph", "text": "Hướng tới", "bbox": [261.93, 524.45, 308.98, 534.47]},
    {"id": "p78-b15", "type": "paragraph", "text": "Mục tiêu:", "bbox": [657.0, 214.35, 692.73, 222.85]},
    {"id": "p78-b16", "type": "paragraph", "text": "“Thực hành ESG\ntiên tiến, hướng tới\ntương lai Net Zero”", "bbox": [657.0, 228.77, 801.83, 284.77]},
    {
      "id": "p78-b17",
      "type": "paragraph",
      "text": "Mục tiêu phát triển bền vững MB được xây dựng phù hợp với các mục tiêu phát triển\nbền vững của Liên Hợp quốc, phù hợp Chiến lược quốc gia và Kế hoạch hành động\nngành ngân hàng về tăng trưởng xanh và biến đổi khí hậu, hướng tới phát triển mô\nhình Ngân hàng xanh, phù hợp với định hướng Chiến lược của MB mà Đại hội đồng Cổ\nđông nhiệm kỳ 2024 đã thông qua.",
      "bbox": [828.0, 215.78, 1154.52, 280.28]
    },
    {
      "id": "p78-b18",
      "type": "paragraph",
      "text": "Với mục tiêu phát triển bền vững, MB cam kết tạo tác động tích cực đến môi trường\nthông qua chủ động chuyển đổi trong hoạt động vận hành, giảm phát thải hướng tới\n“phát thải ròng bằng 0”; đồng hành và tác động tích cực tới khách hàng thông qua các\nsản phẩm xanh, bền vững; thực hành quản trị ESG tiên tiến; có trách nhiệm xã hội và\nlan truyền tác động tích cực tới cộng đồng.",
      "bbox": [828.0, 299.78, 1154.52, 364.28]
    },
    {"id": "p78-b19", "type": "heading", "text": "NET ZERO", "bbox": [243.82, 537.66, 327.11, 555.21]},
    {"id": "p78-b20", "type": "paragraph", "text": "Nền tảng Số hóa", "bbox": [253.44, 559.2, 317.46, 567.7]},
    {"id": "p78-b21", "type": "paragraph", "text": "An ninh\nmạng", "bbox": [390.94, 569.83, 420.6, 589.33]},
    {"id": "p78-b22", "type": "paragraph", "text": "Môi trường", "bbox": [355.05, 646.05, 390.98, 653.05]},
    {
      "id": "p78-b23",
      "type": "paragraph",
      "text": "Môi trường\nChủ động tích cực giảm phát thải trong vận\nhành và trong danh mục, tăng cường quản lý\nrủi ro khí hậu",
      "bbox": [360.56, 690.93, 525.8, 744.03]
    },
    {"id": "p78-b24", "type": "paragraph", "text": "• Giảm phát thải", "bbox": [360.56, 755.2, 422.78, 763.7]},
    {"id": "p78-b25", "type": "furniture", "text": "BÁO CÁO THƯỜNG NIÊN 2024", "bbox": [36.01, 30.85, 141.35, 37.85]},
    {"id": "p78-b26", "type": "paragraph", "text": "154", "bbox": [175.7, 30.85, 186.81, 37.85]},
    {"id": "p78-b27", "type": "paragraph", "text": "ĐỊNH HƯỚNG PHÁT\nTRIỂN BỀN VỮNG:\n“Là tổ chức phát\ntriển bền vững”", "bbox": [41.1, 151.5, 175.69, 224.02]},
    {
      "id": "p78-b28",
      "type": "paragraph",
      "text": "Quản trị\nCủng cố nền tảng quản trị vững mạnh,\ntiên tiến, bền vững và hội nhập theo xu\nhướng toàn cầu",
      "bbox": [36.0, 288.71, 192.9, 341.81]
    },
    {"id": "p78-b29", "type": "paragraph", "text": "• Tuân thủ quy định", "bbox": [36.0, 352.98, 107.58, 361.48]},
    {"id": "p78-b30", "type": "paragraph", "text": "• Đạo đức kinh doanh", "bbox": [36.0, 372.65, 117.28, 381.15]},
    {"id": "p78-b31", "type": "paragraph", "text": "Quản trị", "bbox": [187.09, 468.74, 213.4, 475.74]},
    {"id": "p78-b32", "type": "paragraph", "text": "Chuyển\nđổi số", "bbox": [148.54, 569.5, 177.98, 588.99]},
    {"id": "p78-b33", "type": "paragraph", "text": "Xã hội", "bbox": [190.05, 647.18, 210.44, 654.18]},
    {
      "id": "p78-b34",
      "type": "paragraph",
      "text": "Xã hội\nĐẩy mạnh đào tạo, nâng cao kỹ năng đội\nngũ nhân sự, tăng cường cam kết trách\nnhiệm xã hội và đóng góp cho cộng đồng",
      "bbox": [36.0, 690.75, 201.23, 743.85]
    },
    {"id": "p78-b35", "type": "paragraph", "text": "• Giáo dục & Đào tạo", "bbox": [36.0, 755.02, 114.13, 763.52]},
    {"id": "p78-b36", "type": "paragraph", "text": "• Đóng góp cho cộng đồng địa phương", "bbox": [36.0, 774.69, 181.15, 783.19]},
    {"id": "p78-b37", "type": "paragraph", "text": "• Quản lý rủi ro liên quan đến khí hậu", "bbox": [360.56, 774.86, 495.43, 783.36]}
  ]
}
