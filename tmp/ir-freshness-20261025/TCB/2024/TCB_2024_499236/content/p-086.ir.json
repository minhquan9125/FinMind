  "blocks": [
    {"id": "p86-b1", "type": "paragraph", "text": "Báo cáo Phát triển Bền vững", "bbox": [206.36, 29.15, 302.57, 36.15]},
    {"id": "p86-b2", "type": "paragraph", "text": "Thực tiễn xã hội và nội bộ", "bbox": [337.87, 59.32, 506.21, 74.32]},
    {"id": "p86-b3", "type": "heading", "text": "1 XÂY DỰNG KHÁT VỌNG VÀ CHIẾN LƯỢC ESG", "bbox": [790.81, 78.29, 994.33, 87.29]},
    {"id": "p86-b4", "type": "paragraph", "text": "Tích hợp yếu tố bền vững vào mọi hoạt động", "bbox": [314.65, 84.31, 496.09, 93.31]},
    {"id": "p86-b5", "type": "paragraph", "text": "Ngân hàng tích hợp yếu tố bền vững vào mọi hoạt động thông", "bbox": [314.65, 105.52, 559.49, 114.52]},
    {"id": "p86-b6", "type": "heading", "text": "TIÊU CHUẨN, QUẢN TRỊ VÀ", "bbox": [668.13, 111.32, 783.85, 120.32]},
    {"id": "p86-b7", "type": "heading", "text": "NĂNG LỰC", "bbox": [1048.82, 111.32, 1094.62, 120.32]},
    {"id": "p86-b8", "type": "heading", "text": "TẠO RA GIÁ TRỊ CHO KHÁCH HÀNG", "bbox": [846.78, 115.82, 997.01, 124.82]},
    {"id": "p86-b9", "type": "paragraph", "text": "Bên trong tổ chức, chúng tôi đang xây dựng một đội ngũ nhân", "bbox": [45.35, 116.32, 288.81, 125.32]},
    {"id": "p86-b10", "type": "paragraph", "text": "qua các kế hoạch và thực tiễn nội bộ có trách nhiệm. Thông", "bbox": [314.65, 116.32, 549.25, 125.32]},
    {"id": "p86-b11", "type": "heading", "text": "BÁO CÁO", "bbox": [668.13, 120.32, 708.55, 129.32]},
    {"id": "p86-b12", "type": "heading", "text": "VÀ VĂN HOÁ", "bbox": [1048.82, 120.32, 1103.78, 129.32]},
    {
      "id": "p86-b13",
      "type": "paragraph",
      "text": "sự toàn diện, có mục tiêu rõ ràng, thúc đẩy môi trường làm việc qua giảm dấu chân carbon, tối ưu hóa hiệu quả vận hành\nđa dạng và công bằng, nơi nhân viên được khuyến khích đóng",
      "bbox": [45.35, 127.12, 538.02, 146.92]
    },
    {"id": "p86-b14", "type": "paragraph", "text": "Trong lĩnh vực quy định, chúng tôi không chỉ cam kết dẫn đầu", "bbox": [45.35, 213.52, 286.39, 222.52]},
    {
      "id": "p86-b15",
      "type": "paragraph",
      "text": "và thực thi các chính sách thân thiện với môi trường, chúng\ntôi hướng đến giảm thiểu tác động tiêu cực đến môi trường.\nNgoài ra, chúng tôi cũng đầu tư vào các sáng kiến phát triển\ncộng đồng như nâng cao kiến thức tài chính, giáo dục và các\nchương trình trách nhiệm xã hội doanh nghiệp, khẳng định vai\ntrò của tổ chức tài chính tiên phong trong cam kết phát triển\nbền vững.",
      "bbox": [314.65, 137.92, 557.55, 211.72]
    },
    {"id": "p86-b16", "type": "paragraph", "text": "2 Tổ chức & Mô hình hoạt động", "bbox": [652.39, 153.56, 758.45, 160.56]},
    {"id": "p86-b17", "type": "paragraph", "text": "3 Quản trị", "bbox": [652.43, 195.64, 692.63, 202.64]},
    {"id": "p86-b18", "type": "paragraph", "text": "7\n8\n9", "bbox": [844.03, 138.77, 969.27, 144.77]},
    {"id": "p86-b19", "type": "paragraph", "text": "Đào tạo và", "bbox": [1048.82, 150.45, 1082.09, 157.45]},
    {"id": "p86-b20", "type": "paragraph", "text": "Lĩnh vực &\nSản phẩm tài\nGắn kết", "bbox": [829.76, 152.64, 979.29, 159.64]},
    {"id": "p86-b21", "type": "paragraph", "text": "16\nPhát triển Năng lực", "bbox": [1031.83, 154.09, 1107.12, 164.45]},
    {"id": "p86-b22", "type": "paragraph", "text": "Chiến lược ESG chính bền vững khách hàng\ntheo phân khúc", "bbox": [821.78, 160.64, 985.26, 175.64]},
    {"id": "p86-b23", "type": "paragraph", "text": "KPIs &\n17\nthưởng hiệu suất", "bbox": [1032.02, 191.83, 1100.19, 205.83]},
    {"id": "p86-b24", "type": "heading", "text": "TÍCH HỢP VÀO CÁC QUY TRÌNH", "bbox": [846.79, 215.88, 982.18, 224.88]},
    {
      "id": "p86-b25",
      "type": "paragraph",
      "text": "“Chuyển đổi ngành tài chính, Nâng tầm giá trị sống. Thúc đẩy mỗi người khai\nphá tiềm năng và bản lĩnh hành động cho những điều vượt trội.”",
      "bbox": [177.0, 304.23, 525.49, 326.23]
    },
    {
      "id": "p86-b26",
      "type": "paragraph",
      "text": "Dẫn dắt hành trình số hóa của ngành tài chính, tạo động lực cho mỗi cá nhân,\ndoanh nghiệp và tổ chức phát triển bền vững và bứt phá thành công.",
      "bbox": [177.0, 351.49, 517.19, 373.49]
    },
    {"id": "p86-b27", "type": "paragraph", "text": "4 Xây dựng mục tiêu Net Zero", "bbox": [652.4, 236.98, 754.31, 243.98]},
    {"id": "p86-b28", "type": "paragraph", "text": "5 Báo cáo nội bộ", "bbox": [652.37, 278.69, 714.26, 285.69]},
    {"id": "p86-b29", "type": "paragraph", "text": "Công bố thông tin\n6\n(cơ quan quản lý, nhà đầu tư)", "bbox": [652.37, 316.04, 755.87, 331.44]},
    {"id": "p86-b30", "type": "paragraph", "text": "10\n11\n12", "bbox": [842.57, 238.76, 970.48, 244.76]},
    {"id": "p86-b31", "type": "paragraph", "text": "Phân tích kịch bản Chính sách theo", "bbox": [819.1, 253.98, 931.34, 260.98]},
    {"id": "p86-b32", "type": "paragraph", "text": "Quản lý", "bbox": [955.62, 253.98, 979.18, 260.98]},
    {"id": "p86-b33", "type": "paragraph", "text": "khí hậu và kiểm\nlĩnh vực\ndanh mục", "bbox": [822.95, 260.98, 982.51, 267.98]},
    {"id": "p86-b34", "type": "paragraph", "text": "tra sức chịu đựng", "bbox": [820.71, 267.98, 870.49, 274.98]},
    {"id": "p86-b35", "type": "paragraph", "text": "13\n14\n15", "bbox": [842.67, 290.13, 970.5, 296.13]},
    {
      "id": "p86-b36",
      "type": "paragraph",
      "text": "Tuyên bố khẩu vị Quy trình phê Tích hợp vào\nrủi ro\nduyệt giao dịch thông điệp\nvà bảo lãnh\nthương hiệu\nphát hành",
      "bbox": [819.65, 304.35, 987.16, 332.35]
    },
    {"id": "p86-b37", "type": "paragraph", "text": "Định nghĩa và", "bbox": [805.04, 375.54, 847.16, 382.54]},
    {"id": "p86-b38", "type": "paragraph", "text": "19 Công cụ và Phân tích", "bbox": [909.94, 379.04, 990.98, 386.04]},
    {"id": "p86-b39", "type": "paragraph", "text": "20 Tăng cường nền tảng", "bbox": [1031.23, 379.04, 1112.89, 386.04]},
    {"id": "p86-b40", "type": "heading", "text": "DỮ LIỆU & CÔNG NGHỆ 18", "bbox": [668.13, 379.17, 794.16, 388.47]},
    {"id": "p86-b41", "type": "paragraph", "text": "tập hợp dữ liệu", "bbox": [805.04, 382.54, 850.94, 389.54]},
    {"id": "p86-b42", "type": "heading", "text": "THỰC TIỄN XÃ HỘI", "bbox": [472.21, 400.87, 553.51, 409.87]},
    {"id": "p86-b43", "type": "heading", "text": "QUY ĐỊNH", "bbox": [386.56, 406.37, 431.52, 415.37]},
    {"id": "p86-b44", "type": "heading", "text": "NHÂN VIÊN", "bbox": [278.19, 406.72, 328.44, 415.72]},
    {"id": "p86-b45", "type": "heading", "text": "CỔ ĐÔNG", "bbox": [177.24, 406.72, 219.83, 415.72]},
    {"id": "p86-b46", "type": "heading", "text": "VÀ NỘI BỘ", "bbox": [489.69, 411.66, 536.03, 420.66]},
    {"id": "p86-b47", "type": "paragraph", "text": "nguyên tắc ESG vào mọi khía cạnh của hoạt động kinh doanh,", "bbox": [45.35, 731.92, 289.07, 740.92]},
    {
      "id": "p86-b48",
      "type": "paragraph",
      "text": "tác và hỗ trợ mục tiêu đạt lượng phát thải ròng bằng không của cũng như môi trường pháp lý đang không ngừng thay đổi.",
      "bbox": [45.35, 753.53, 540.4, 762.53]
    },
    {"id": "p86-b49", "type": "paragraph", "text": "“Xây dựng một đội ngũ", "bbox": [266.08, 441.06, 340.53, 448.06]},
    {"id": "p86-b50", "type": "paragraph", "text": "“Dẫn đầu về tính liêm", "bbox": [373.29, 445.12, 442.88, 452.12]},
    {"id": "p86-b51", "type": "paragraph", "text": "“Tích hợp yếu tố bền vững", "bbox": [470.39, 445.12, 555.33, 452.12]},
    {"id": "p86-b52", "type": "paragraph", "text": "đoàn kết, hướng đến mục", "bbox": [262.18, 449.06, 344.44, 456.06]},
    {"id": "p86-b53", "type": "paragraph", "text": "chính và tuân thủ”", "bbox": [378.46, 453.12, 437.71, 460.12]},
    {"id": "p86-b54", "type": "paragraph", "text": "bền vững”", "bbox": [181.76, 457.06, 215.3, 464.06]},
    {"id": "p86-b55", "type": "paragraph", "text": "tiêu và giá trị chung”", "bbox": [269.7, 457.06, 336.92, 464.06]},
    {"id": "p86-b56", "type": "paragraph", "text": "Thúc đẩy môi trường làm", "bbox": [260.1, 485.7, 337.93, 492.7]},
    {"id": "p86-b57", "type": "paragraph", "text": "Tuân thủ các yêu cầu", "bbox": [368.5, 485.7, 434.85, 492.7]},
    {"id": "p86-b58", "type": "paragraph", "text": "Thực hiện các chính", "bbox": [473.39, 485.7, 536.2, 492.7]},
    {"id": "p86-b59", "type": "paragraph", "text": "việc đa dạng và toàn diện,", "bbox": [260.1, 493.7, 342.8, 500.7]},
    {"id": "p86-b60", "type": "paragraph", "text": "quy định về phát triển", "bbox": [368.5, 493.7, 437.16, 500.7]},
    {"id": "p86-b61", "type": "paragraph", "text": "sách và thực hành nội", "bbox": [473.39, 493.7, 541.73, 500.7]},
    {"id": "p86-b62", "type": "paragraph", "text": "nơi nhân viên được khuyến bền vững bằng cách áp", "bbox": [260.1, 501.7, 442.47, 508.7]},
    {"id": "p86-b63", "type": "paragraph", "text": "bộ nhằm giảm thiểu dấu", "bbox": [473.39, 501.7, 549.47, 508.7]},
    {"id": "p86-b64", "type": "paragraph", "text": "khích đóng góp vào các", "bbox": [260.1, 509.7, 335.26, 516.7]},
    {"id": "p86-b65", "type": "paragraph", "text": "dụng các thực hành tốt", "bbox": [368.5, 509.7, 440.65, 516.7]},
    {"id": "p86-b66", "type": "paragraph", "text": "chân carbon và thúc đẩy", "bbox": [473.39, 509.7, 550.38, 516.7]},
    {"id": "p86-b67", "type": "paragraph", "text": "mục tiêu và sáng kiến ESG", "bbox": [260.1, 517.7, 343.62, 524.7]},
    {"id": "p86-b68", "type": "paragraph", "text": "nhất trên thị trường.", "bbox": [368.5, 517.7, 430.97, 524.7]},
    {"id": "p86-b69", "type": "paragraph", "text": "các sáng kiến phát triển", "bbox": [473.39, 517.7, 548.64, 524.7]},
    {"id": "p86-b70", "type": "paragraph", "text": "của Ngân hàng.", "bbox": [260.1, 525.7, 309.66, 532.7]},
    {"id": "p86-b71", "type": "paragraph", "text": "cộng đồng.", "bbox": [473.39, 525.7, 509.07, 532.7]},
    {
      "id": "p86-b72",
      "type": "paragraph",
      "text": "Chúng tôi cam kết thúc đẩy tiến độ đạt được các Mục tiêu Phát triển Bền vững\n(SDG) và đã chọn tập trung vào tám SDG mà chúng tôi tin rằng mình có thể đóng\ngóp có ý nghĩa nhất.",
      "bbox": [177.0, 656.32, 531.93, 690.32]
    },
    {
      "id": "p86-b73",
      "type": "paragraph",
      "text": "Việt Nam vào năm 2050. Chúng tôi đã xác định rõ các thành\nphần cốt lõi trong chiến lược ESG của mình và đang xây dựng\nmột cách có hệ thống, phù hợp với nhu cầu của khách hàng",
      "bbox": [314.65, 721.12, 555.94, 751.73]
    },
    {"id": "p86-b74", "type": "paragraph", "text": "Đánh giá tính trọng yếu", "bbox": [629.29, 428.65, 746.77, 439.65]},
    {"id": "p86-b75", "type": "paragraph", "text": "vào mọi hoạt động”", "bbox": [481.18, 453.12, 544.55, 460.12]},
    {
      "id": "p86-b76",
      "type": "paragraph",
      "text": "Trong khuôn khổ ESG tổng thể, Techcombank đã thực\nhiện đánh giá tính trọng yếu nhằm đảm bảo Ngân hàng\ntập trung vào những chủ đề ESG có liên quan nhất, ưu\ntiên cho hoạt động kinh doanh và lợi ích của các đối\ntác. Những chủ đề này được đánh giá là có tiềm năng\ntác động lớn nhất đến giá trị dài hạn của các đối tác\ncủa Techcombank, đồng thời tạo ra ảnh hưởng đáng\nkể về mặt xã hội, môi trường và kinh tế. Quá trì nh đánh\ngiá tính trọng yếu của chúng tôi đã xem xét các ưu tiên\ncủa cả các đối tác nội bộ và bên ngoài. Quy trình đánh\ngiá dựa trên khảo sát nội bộ, đối sánh công bố thông\ntin của các doanh nghiệp cùng ngành, cũng như các\nyêu cầu pháp lý và quy định. Chúng tôi áp dụng quy\ntrình bốn bước:",
      "bbox": [629.29, 461.93, 846.27, 611.33]
    },
    {
      "id": "p86-b77",
      "type": "paragraph",
      "text": "1. Xác định và phân loại các chủ đề tiềm năng liên\nquan đến ESG\n2. Ưu tiên các chủ đề trọng yếu dựa trên tầm quan\ntrọng chiến lược đối với hoạt động kinh doanh, các\nđối tác và các cơ quan thiết lập tiêu chuẩn pháp lý\n3. Tham vấn ban lãnh đạo để kiểm tra và xác thực kết\nquả đánh giá với các đối tượng nội bộ quan trọng\nvà các chuyên gia trong lĩnh vực liên quan\n4. Xem xét, thảo luận và xác định danh sách cuối\ncùng sau nhiều vòng trao đổi với Ban lãnh đạo,\ntích hợp ý kiến từ các Giám đốc Khối và các cố vấn\nbên ngoài.",
      "bbox": [629.29, 624.19, 844.33, 752.0]
    },
    {"id": "p86-b78", "type": "paragraph", "text": "Techcombank đã xác định 17 chủ đề trọng yếu phù hợp", "bbox": [629.29, 764.33, 846.15, 773.33]},
    {"id": "p86-b79", "type": "paragraph", "text": "Phát thải khí nhà kính (GHG)\nMÔI TRƯỜNG", "bbox": [870.14, 441.71, 1039.06, 456.18]},
    {"id": "p86-b80", "type": "paragraph", "text": "Tài trợ cho tác động môi trường", "bbox": [941.1, 462.51, 1050.36, 470.51]},
    {"id": "p86-b81", "type": "paragraph", "text": "Biến đổi khí hậu", "bbox": [941.1, 483.31, 997.4, 491.31]},
    {"id": "p86-b82", "type": "paragraph", "text": "Mức tiêu thụ điện, nước sạch, phát thải", "bbox": [941.1, 504.11, 1075.66, 512.11]},
    {"id": "p86-b83", "type": "paragraph", "text": "Mối quan hệ với cộng đồng", "bbox": [941.1, 524.91, 1036.84, 532.91]},
    {"id": "p86-b84", "type": "paragraph", "text": "Tài chính toàn diện và tài trợ có trách nhiệm xã hội", "bbox": [941.1, 545.71, 1116.17, 553.71]},
    {"id": "p86-b85", "type": "paragraph", "text": "Chuyển đổi số\nXÃ HỘI", "bbox": [881.93, 566.51, 991.58, 578.47]},
    {"id": "p86-b86", "type": "paragraph", "text": "Đa dạng và hòa nhập", "bbox": [941.1, 587.31, 1016.19, 595.31]},
    {"id": "p86-b87", "type": "paragraph", "text": "Quản trị nguồn nhân lực và giữ chân nhân tài", "bbox": [941.1, 608.11, 1097.38, 616.11]},
    {"id": "p86-b88", "type": "paragraph", "text": "Nơi làm việc lành mạnh và an toàn", "bbox": [941.1, 628.91, 1060.91, 636.91]},
    {"id": "p86-b89", "type": "paragraph", "text": "Bảo mật và quyền riêng tư dữ liệu cá nhân", "bbox": [941.1, 649.71, 1088.35, 657.71]},
    {"id": "p86-b90", "type": "paragraph", "text": "Bảo vệ khách hàng và trách nhiệm với sản phẩm", "bbox": [941.1, 670.51, 1110.32, 678.51]},
    {"id": "p86-b91", "type": "paragraph", "text": "Đạo đức và triển khai", "bbox": [941.1, 691.31, 1015.34, 699.31]},
    {"id": "p86-b92", "type": "paragraph", "text": "QUẢN TRỊ\nTham nhũng và gian lận", "bbox": [876.97, 707.99, 1024.82, 720.11]},
    {"id": "p86-b93", "type": "paragraph", "text": "Tuân thủ", "bbox": [941.1, 732.91, 971.25, 740.91]},
    {"id": "p86-b94", "type": "paragraph", "text": "Quản trị doanh nghiệp, kiểm soát nội bộ, và quản trị rủi ro", "bbox": [941.1, 753.71, 1142.29, 761.71]},
    {"id": "p86-b95", "type": "paragraph", "text": "PHÁT TRIỂN BỀN VỮNG CÙNG TECH", "bbox": [45.24, 29.45, 173.56, 36.45]},
    {"id": "p86-b96", "type": "paragraph", "text": "Nhân viên", "bbox": [68.57, 58.42, 134.95, 73.42]},
    {"id": "p86-b97", "type": "paragraph", "text": "Xây dựng một đội ngũ đoàn kết, hướng đến mục tiêu và\ngiá trị chung", "bbox": [45.35, 84.31, 270.96, 104.11]},
    {"id": "p86-b98", "type": "paragraph", "text": "góp vào các mục tiêu và sáng kiến ESG.", "bbox": [45.35, 148.72, 202.51, 157.72]},
    {"id": "p86-b99", "type": "paragraph", "text": "Quy định\nHoạt động dựa trên tính chính trực và tuân thủ", "bbox": [45.35, 173.48, 234.04, 203.91]},
    {
      "id": "p86-b100",
      "type": "paragraph",
      "text": "về tính chính trực và tuân thủ nghiêm ngặt các quy định ESG\ncủa Việt Nam mà còn đặt mục tiêu vượt qua các tiêu chuẩn\ncủa ngành. Chúng tôi cũng chú trọng củng cố khung quản trị\nvà chính sách quản lý rủi ro nhằm duy trì các chuẩn mực kinh\ndoanh có đạo đức và trách nhiệm.",
      "bbox": [45.35, 224.32, 283.97, 276.52]
    },
    {"id": "p86-b101", "type": "paragraph", "text": "TẦM NHÌN", "bbox": [73.06, 311.22, 130.55, 323.22]},
    {"id": "p86-b102", "type": "paragraph", "text": "CHIẾN LƯỢC", "bbox": [64.06, 357.44, 135.42, 369.44]},
    {"id": "p86-b103", "type": "paragraph", "text": "KHÁCH HÀNG", "bbox": [63.41, 406.72, 124.11, 415.72]},
    {"id": "p86-b104", "type": "paragraph", "text": "“Trao quyền cho khách", "bbox": [56.57, 437.4, 130.94, 444.4]},
    {"id": "p86-b105", "type": "paragraph", "text": "“Tạo ra giá trị dài hạn", "bbox": [163.97, 441.06, 233.1, 448.06]},
    {"id": "p86-b106", "type": "paragraph", "text": "hàng với các giải pháp bền", "bbox": [50.61, 445.4, 136.9, 452.4]},
    {"id": "p86-b107", "type": "paragraph", "text": "thông qua tăng trưởng", "bbox": [162.02, 449.06, 235.04, 456.06]},
    {"id": "p86-b108", "type": "paragraph", "text": "vững và lấy khách hàng\nlàm trọng tâm”", "bbox": [55.68, 453.4, 131.83, 468.4]},
    {"id": "p86-b109", "type": "paragraph", "text": "Hỗ trợ khách hàng trên", "bbox": [50.55, 485.7, 123.08, 492.7]},
    {"id": "p86-b110", "type": "paragraph", "text": "Cung cấp các giá trị dài", "bbox": [158.14, 485.7, 231.9, 492.7]},
    {"id": "p86-b111", "type": "paragraph", "text": "hành trình phát triển bền", "bbox": [50.55, 493.7, 128.34, 500.7]},
    {"id": "p86-b112", "type": "paragraph", "text": "hạn và duy trì lợi ích bền", "bbox": [158.14, 493.7, 234.68, 500.7]},
    {"id": "p86-b113", "type": "paragraph", "text": "vững hơn và tích hợp tính", "bbox": [50.55, 501.7, 130.16, 508.7]},
    {"id": "p86-b114", "type": "paragraph", "text": "vững cho cổ đông.", "bbox": [158.14, 501.7, 216.64, 508.7]},
    {"id": "p86-b115", "type": "paragraph", "text": "bền vững vào các giải pháp\ntài chính và cơ hội đầu tư.", "bbox": [50.55, 509.7, 136.94, 524.7]},
    {
      "id": "p86-b116",
      "type": "paragraph",
      "text": "Cung cấp các giải pháp tài\nchính đơn giản, dễ tiếp cận\nvà hợp lý cho toàn xã hội.",
      "bbox": [50.55, 533.7, 135.84, 556.7]
    },
    {"id": "p86-b117", "type": "paragraph", "text": "PHÙ HỢP VỚI\nMỤC TIÊU PHÁT\nTRIỂN BỀN\nVỮNG CỦA LIÊN\nHỢP QUỐC", "bbox": [55.98, 612.65, 146.87, 682.25]},
    {"id": "p86-b118", "type": "paragraph", "text": "Thông qua năm trụ cột chính này, Techcombank tích hợp các", "bbox": [45.35, 721.12, 283.65, 730.12]},
    {"id": "p86-b119", "type": "paragraph", "text": "thúc đẩy tăng trưởng bền vững, nâng cao giá trị cho các đối", "bbox": [45.35, 742.73, 279.06, 751.73]},
    {"id": "p86-b120", "type": "paragraph", "text": "Minh bạch", "bbox": [941.1, 774.51, 977.45, 782.51]},
    {
      "id": "p86-b121",
      "type": "paragraph",
      "text": "với chiến lược, hoạt động của Ngân hàng, kỳ vọng của\ncác đối tác và các thông lệ tốt nhất.",
      "bbox": [629.29, 775.13, 842.38, 794.93]
    },
