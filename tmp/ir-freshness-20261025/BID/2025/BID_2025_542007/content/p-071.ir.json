  "blocks": [
    {"id": "p71-b1", "type": "paragraph", "text": "Hoạt động quản trị công ty", "bbox": [56.69, 47.41, 315.39, 67.41]},
    {"id": "p71-b2", "type": "heading", "text": "VIỆC THỰC HIỆN CÁC QUY ĐỊNH VỀ QUẢN TRỊ DOANH NGHIỆP", "bbox": [56.69, 129.37, 412.89, 141.37]},
    {
      "id": "p71-b3",
      "type": "paragraph",
      "text": "Đánh giá công tác quản trị công ty theo Thẻ điểm quản trị Công ty ASEAN",
      "bbox": [56.69, 168.77, 411.02, 178.77]
    },
    {"id": "p71-b4", "type": "paragraph", "text": "Chủ tịch của Ủy ban Thù lao/Lương thưởng có phải là thành", "bbox": [99.21, 247.72, 314.64, 255.72]},
    {"id": "p71-b5", "type": "paragraph", "text": "Công ty có công bố quy chế hoạt động/cơ cấu quản trị/điều", "bbox": [99.21, 281.62, 314.62, 289.62]},
    {
      "id": "p71-b6",
      "type": "paragraph",
      "text": "Sự tham gia của thành viên trong các cuộc họp của Ủy ban\nThù lao/Lương thưởng có được công bố công khai, nếu có,\nỦy ban Thù lao/Lương thưởng có họp tối thiểu hai lần trong",
      "bbox": [99.21, 315.52, 314.64, 347.52]
    },
    {
      "id": "p71-b7",
      "type": "paragraph",
      "text": "Ủy ban Kiểm toán có bao gồm toàn bộ thành viên HĐQT\nkhông điều hành với đa số thành viên/Ủy viên HĐQT độc lập?",
      "bbox": [99.21, 441.22, 314.64, 461.22]
    },
    {"id": "p71-b8", "type": "paragraph", "text": "Chủ tịch của Ủy ban Kiểm toán có phải là thành viên HĐQT", "bbox": [99.21, 475.12, 314.63, 483.12]},
    {"id": "p71-b9", "type": "paragraph", "text": "Công ty có công bố quy chế hoạt động/cơ cấu quản trị/điều", "bbox": [99.21, 509.02, 314.62, 517.02]},
    {
      "id": "p71-b10",
      "type": "paragraph",
      "text": "Tối thiểu một thành viên HĐQT độc lập của Ủy ban Kiểm toán\nD.2.22 có chuyên môn về kế toán không (trình độ chuyên môn hoặc",
      "bbox": [64.18, 542.92, 314.63, 562.92]
    },
    {
      "id": "p71-b11",
      "type": "paragraph",
      "text": "Sự tham gia của thành viên trong các cuộc họp của Ủy ban\nD.2.23 Kiểm toán có được công bố công khai, nếu có, Ủy ban Kiểm",
      "bbox": [64.14, 588.83, 314.62, 608.83]
    },
    {
      "id": "p71-b12",
      "type": "paragraph",
      "text": "Ủy ban Kiểm toán có trách nhiệm chính trong việc đưa ra\nkhuyến nghị về bổ nhiệm và miễn nhiệm kiểm toán độc lập?",
      "bbox": [99.21, 634.73, 314.64, 654.73]
    },
    {"id": "p71-b13", "type": "paragraph", "text": "Họp HĐQT có được lập kế hoạch trước khi bắt đầu năm tài", "bbox": [99.21, 712.43, 314.62, 720.43]},
    {"id": "p71-b14", "type": "paragraph", "text": "(tiếp theo)", "bbox": [323.9, 52.84, 370.8, 62.84]},
    {"id": "p71-b15", "type": "paragraph", "text": "Kết quả\nCơ sở đánh giá\nđánh giá", "bbox": [327.56, 213.38, 431.38, 233.38]},
    {
      "id": "p71-b16",
      "type": "paragraph",
      "text": "BIDV hiện có 01 thành viên HĐQT độc lập và\nX\nkhông phải là chủ tịch Ủy ban Nhân sự BIDV.",
      "bbox": [341.87, 247.72, 532.89, 267.72]
    },
    {"id": "p71-b17", "type": "paragraph", "text": "Thể hiện tại Báo cáo thường niên", "bbox": [374.17, 287.62, 491.27, 295.62]},
    {"id": "p71-b18", "type": "paragraph", "text": "Thể hiện tại Báo cáo thường niên", "bbox": [374.17, 333.52, 491.27, 341.52]},
    {
      "id": "p71-b19",
      "type": "paragraph",
      "text": "BIDV hoạt động theo mô hình có Ban Kiểm\nsoát thuộc ĐHĐCĐ, không hoạt động theo\nmô hình có Ủy ban Kiểm toán.",
      "bbox": [374.17, 395.32, 532.9, 427.32]
    },
    {"id": "p71-b20", "type": "paragraph", "text": "Thành viên của Ban Kiểm soát không phải\nX\nthành viên HĐQT.", "bbox": [341.87, 441.22, 532.9, 461.22]},
    {"id": "p71-b21", "type": "paragraph", "text": "Thành viên của Ban Kiểm soát không phải\nX\nthành viên HĐQT.", "bbox": [341.87, 475.12, 532.9, 495.12]},
    {"id": "p71-b22", "type": "paragraph", "text": "Thể hiện tại Báo cáo thường niên", "bbox": [374.17, 515.02, 491.27, 523.02]},
    {"id": "p71-b23", "type": "paragraph", "text": "Thành viên của Ban Kiểm soát không phải\nX\nthành viên HĐQT.", "bbox": [341.87, 548.92, 532.9, 568.92]},
    {"id": "p71-b24", "type": "paragraph", "text": "Thể hiện tại Báo cáo thường niên", "bbox": [374.17, 600.83, 491.27, 608.83]},
    {"id": "p71-b25", "type": "paragraph", "text": "Thể hiện tại Báo cáo thường niên", "bbox": [374.17, 640.73, 491.27, 648.73]},
    {"id": "p71-b26", "type": "paragraph", "text": "Họp HĐQT được lập kế hoạch trước khi bắt\nđầu năm tài chính", "bbox": [374.17, 712.43, 532.9, 732.43]},
    {"id": "p71-b27", "type": "paragraph", "text": "X - Tuân thủ một phần/Các lĩnh vực cần cải thiện", "bbox": [303.51, 760.0, 475.17, 768.0]},
    {"id": "p71-b28", "type": "paragraph", "text": "Mục Nội dung", "bbox": [661.82, 219.38, 729.71, 227.38]},
    {"id": "p71-b29", "type": "paragraph", "text": "D.3.2 Thành viên HĐQT có họp tối thiểu sáu lần trong năm?", "bbox": [661.57, 267.13, 884.2, 275.13]},
    {
      "id": "p71-b30",
      "type": "paragraph",
      "text": "Mỗi thành viên HĐQT có tham dự tối thiểu 75% số cuộc họp\nD.3.3\nHĐQT trong năm?",
      "bbox": [661.54, 308.45, 909.91, 328.45]
    },
    {
      "id": "p71-b31",
      "type": "paragraph",
      "text": "Công ty có yêu cầu về số đại biểu tham dự tối thiểu phải đạt\nD.3.4 2/3 số thành viên HĐQT đối với các cuộc họp cần ra quyết\nđịnh của HĐQT?",
      "bbox": [661.47, 342.35, 909.9, 374.35]
    },
    {
      "id": "p71-b32",
      "type": "paragraph",
      "text": "Thành viên HĐQT không điều hành của công ty có họp riêng\nD.3.5 tối thiểu một lần trong năm mà không có mặt các thành viên\nđiều hành?",
      "bbox": [661.43, 388.25, 909.91, 420.25]
    },
    {"id": "p71-b33", "type": "paragraph", "text": "Tiếp cận thông tin", "bbox": [694.49, 434.15, 764.76, 442.15]},
    {
      "id": "p71-b34",
      "type": "paragraph",
      "text": "Văn bản cho các cuộc họp HĐQT có được cung cấp cho\nD.3.6 HĐQT tối thiểu năm ngày làm việc trước khi diễn ra cuộc họp\nHĐQT?",
      "bbox": [661.45, 456.06, 909.9, 488.06]
    },
    {
      "id": "p71-b35",
      "type": "paragraph",
      "text": "Thư ký công ty có đóng vai trò quan trọng trong việc hỗ trợ\nD.3.7\nHĐQT thực hiện trách nhiệm của mình?",
      "bbox": [661.7, 501.96, 909.9, 521.96]
    },
    {
      "id": "p71-b36",
      "type": "paragraph",
      "text": "Thư ký công ty có được đào tạo về pháp lý, kế toán hay thực\nD.3.8 hành công tác thư ký công ty và được cập nhật các vấn đề\nmới có liên quan các nội dung trên?",
      "bbox": [661.47, 535.86, 909.9, 567.86]
    },
    {"id": "p71-b37", "type": "paragraph", "text": "Bổ nhiệm và tái cử thành viên HĐQT", "bbox": [694.49, 581.76, 832.71, 589.76]},
    {
      "id": "p71-b38",
      "type": "paragraph",
      "text": "Công ty có công bố các tiêu chí sử dụng để lựa chọn thành\nD.3.9\nviên HĐQT mới?",
      "bbox": [661.67, 615.66, 909.89, 635.66]
    },
    {
      "id": "p71-b39",
      "type": "paragraph",
      "text": "Công ty có mô tả quy trình được áp dụng trong việc bổ\nD.3.10\nnhiệm thành viên HĐQT mới?",
      "bbox": [660.13, 661.56, 909.9, 681.56]
    },
    {
      "id": "p71-b40",
      "type": "paragraph",
      "text": "Tất cả các thành viên HĐQT có được bầu lại tối thiểu 3 năm,\nhoặc 5 năm đối với công ty niêm yết ở những quốc gia có\nD.3.11 pháp luật quy định nhiệm kỳ 5 năm một lần?\nNhiệm kỳ 5 năm phải được yêu cầu bởi các đạo luật đã có từ\ntrước khi có Thẻ Điểm Quản trị Công ASEAN vào năm 2011",
      "bbox": [661.24, 695.46, 909.9, 751.46]
    },
    {"id": "p71-b41", "type": "paragraph", "text": "137", "bbox": [1163.86, 23.28, 1177.62, 32.28]},
