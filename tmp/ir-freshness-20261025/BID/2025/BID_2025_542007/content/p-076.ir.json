  "blocks": [
    {"id": "p76-b1", "type": "paragraph", "text": "Hoạt động quản trị công ty", "bbox": [56.69, 47.41, 315.39, 67.41]},
    {"id": "p76-b2", "type": "paragraph", "text": "147", "bbox": [1163.84, 23.28, 1177.64, 32.28]},
    {"id": "p76-b3", "type": "heading", "text": "I I Ớ Ớ", "bbox": [1168.86, 48.42, 1176.86, 56.84]},
    {"id": "p76-b4", "type": "paragraph", "text": "(tiếp theo)", "bbox": [323.9, 52.84, 370.8, 62.84]},
    {"id": "p76-b5", "type": "paragraph", "text": "Ư Ư\nL L\nG G\nN N\nẠ Ạ", "bbox": [1168.86, 56.84, 1176.86, 84.98]},
    {"id": "p76-b6", "type": "heading", "text": "M M", "bbox": [1168.86, 84.98, 1176.86, 91.78]},
    {"id": "p76-b7", "type": "heading", "text": "VIỆC THỰC HIỆN CÁC QUY ĐỊNH VỀ QUẢN TRỊ DOANH NGHIỆP", "bbox": [56.69, 129.37, 412.89, 141.37]},
    {"id": "p76-b8", "type": "paragraph", "text": "(P)D.1 Tuân thủ quy định, quy tắc và luật hiện hành về niêm yết", "bbox": [63.67, 266.78, 315.51, 274.78]},
    {
      "id": "p76-b9",
      "type": "paragraph",
      "text": "Có bằng chứng gì là công ty đã không tuân thủ quy tắc và quy định\n(P)D.1.1 nào về niêm yết trong năm qua ngoài các quy định về công bố thông",
      "bbox": [63.97, 287.27, 342.98, 308.27]
    },
    {
      "id": "p76-b10",
      "type": "paragraph",
      "text": "Có trường hợp nào mà thành viên HĐQT không điều hành đã từ\nnhiệm và nêu ra bất kỳ lo ngại nào liên quan đến quản trị?",
      "bbox": [99.21, 333.75, 342.98, 354.75]
    },
    {
      "id": "p76-b11",
      "type": "paragraph",
      "text": "Công ty có thành viên HĐQT độc lập nào đã phục vụ hơn 9 năm hay\nhai nhiệm kỳ 5 năm (chọn trường hợp nào cao hơn) với cùng chức",
      "bbox": [99.21, 387.72, 342.97, 408.72]
    },
    {"id": "p76-b12", "type": "paragraph", "text": "Nhiệm kỳ 5 năm phải được yêu cầu bởi các đạo luật đã có từ trước khi", "bbox": [99.21, 426.72, 342.96, 434.72]},
    {"id": "p76-b13", "type": "paragraph", "text": "Công ty đã không xác định rõ ai là thành viên HĐQT độc lập?", "bbox": [99.21, 468.7, 314.44, 476.7]},
    {
      "id": "p76-b14",
      "type": "paragraph",
      "text": "(P) Công ty có bất kỳ thành viên HĐQT độc lập nào giữ vài trò quản trị ở",
      "bbox": [70.33, 497.68, 342.98, 507.68]
    },
    {
      "id": "p76-b15",
      "type": "paragraph",
      "text": "(Trong hai năm trước) Có thành viên HĐQT hay lãnh đạo điều hành\n(P)D.3.1 cấp cao nào từng là nhân viên hoặc thành viên hợp danh của công ty",
      "bbox": [62.85, 555.65, 342.98, 576.65]
    },
    {
      "id": "p76-b16",
      "type": "paragraph",
      "text": "(P)D.4.1 Chủ tịch HĐQT có phải là TGĐ của Công ty trong 3 năm qua không?",
      "bbox": [62.8, 622.62, 340.71, 630.62]
    },
    {"id": "p76-b17", "type": "paragraph", "text": "(P) Các thành viên độc lập không điều hành có được nhận các quyền", "bbox": [70.33, 643.1, 342.96, 653.1]},
