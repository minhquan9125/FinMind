  "blocks": [
    {"id": "p70-b1", "type": "paragraph", "text": "Hoạt động quản trị công ty", "bbox": [56.69, 47.39, 315.39, 67.39]},
    {"id": "p70-b2", "type": "heading", "text": "VIỆC THỰC HIỆN CÁC QUY ĐỊNH VỀ QUẢN TRỊ DOANH NGHIỆP", "bbox": [56.69, 129.37, 412.89, 141.37]},
    {
      "id": "p70-b3",
      "type": "paragraph",
      "text": "Đánh giá công tác quản trị công ty theo Thẻ điểm quản trị Công ty ASEAN",
      "bbox": [56.69, 168.77, 411.02, 178.77]
    },
    {"id": "p70-b4", "type": "paragraph", "text": "Vai trò và trách nhiệm của thành viên HĐQT có được quy định", "bbox": [99.21, 247.72, 314.63, 255.72]},
    {"id": "p70-b5", "type": "paragraph", "text": "Công ty có công bố tầm nhìn và sứ mệnh được xem xét, cập", "bbox": [99.21, 303.52, 314.63, 311.52]},
    {
      "id": "p70-b6",
      "type": "paragraph",
      "text": "Thành viên HĐQT có đóng vai trò lãnh đạo trong quá trình\nxây dựng/theo dõi chiến lược của Công ty ít nhất một năm?",
      "bbox": [99.21, 349.42, 314.64, 369.42]
    },
    {"id": "p70-b7", "type": "paragraph", "text": "Thành viên HĐQT có quy trình xem xét, giám sát, theo dõi", "bbox": [99.21, 395.32, 314.64, 403.32]},
    {"id": "p70-b8", "type": "paragraph", "text": "Chi tiết của Bộ Quy tắc Đạo đức hoặc Ứng xử có được", "bbox": [99.21, 473.02, 314.61, 481.02]},
    {"id": "p70-b9", "type": "paragraph", "text": "Công ty có công bố về việc tất cả thành viên HĐQT, lãnh đạo", "bbox": [99.21, 506.92, 314.63, 514.92]},
    {"id": "p70-b10", "type": "paragraph", "text": "Công ty có công bố cách thực hiện và giám sát việc tuân thủ", "bbox": [99.21, 540.83, 314.62, 548.83]},
    {"id": "p70-b11", "type": "paragraph", "text": "Thành viên HĐQT độc lập có chiếm tối thiểu 50% số thành", "bbox": [99.21, 596.63, 314.63, 604.63]},
    {
      "id": "p70-b12",
      "type": "paragraph",
      "text": "Công ty có giới hạn về nhiệm kỳ tối đa 9 năm hoặc ít hơn\nhoặc tối đa 2 nhiệm kỳ 5 năm đối với mỗi thành viên HĐQT",
      "bbox": [99.21, 630.53, 314.63, 650.53]
    },
    {
      "id": "p70-b13",
      "type": "paragraph",
      "text": "Nhiệm kỳ 5 năm phải được yêu cầu bởi các đạo luật đã có\ntừ trước khi đưa ra Thẻ Điểm Quản trị Công ASEAN vào năm",
      "bbox": [99.21, 666.53, 314.63, 686.53]
    },
    {"id": "p70-b14", "type": "paragraph", "text": "(tiếp theo)", "bbox": [323.9, 52.82, 370.8, 62.82]},
    {"id": "p70-b15", "type": "paragraph", "text": "Kết quả\nCơ sở đánh giá\nđánh giá", "bbox": [327.56, 213.38, 431.38, 233.38]},
    {
      "id": "p70-b16",
      "type": "paragraph",
      "text": "Thể hiện tại Báo cáo Thường niên – Mục\nQuản trị Công ty và Điều lệ BIDV",
      "bbox": [374.17, 247.72, 532.9, 267.72]
    },
    {"id": "p70-b17", "type": "paragraph", "text": "Thể hiện tại Báo cáo thường niên và Website\nBIDV", "bbox": [374.17, 303.52, 532.9, 323.52]},
    {
      "id": "p70-b18",
      "type": "paragraph",
      "text": "Thể hiện tại Báo cáo kết quả hoạt động của\nHĐQT tại Tài liệu họp ĐHĐCĐ và tại Báo cáo\nthường niên - mục Hoạt động quản trị công\nty",
      "bbox": [374.17, 337.42, 532.91, 381.42]
    },
    {"id": "p70-b19", "type": "paragraph", "text": "Thể hiện tại Báo cáo thường niên", "bbox": [374.17, 401.32, 491.27, 409.32]},
    {"id": "p70-b20", "type": "paragraph", "text": "Thể hiện đầy đủ tại Website BIDV", "bbox": [374.17, 479.02, 491.74, 487.02]},
    {"id": "p70-b21", "type": "paragraph", "text": "Thể hiện đầy đủ tại Website BIDV", "bbox": [374.17, 512.92, 491.74, 520.92]},
    {"id": "p70-b22", "type": "paragraph", "text": "Thể hiện đầy đủ tại Website BIDV", "bbox": [374.17, 546.83, 491.74, 554.83]},
    {"id": "p70-b23", "type": "paragraph", "text": "X\nHiện BIDV có 01 thành viên HĐQT độc lập.", "bbox": [341.87, 602.63, 523.31, 610.63]},
    {"id": "p70-b24", "type": "paragraph", "text": "Quy định tại Điều lệ, Quy chế quản trị nội bộ\nNgân hàng", "bbox": [374.17, 654.53, 532.91, 674.53]},
    {"id": "p70-b25", "type": "paragraph", "text": "X - Tuân thủ một phần/Các lĩnh vực cần cải thiện", "bbox": [303.51, 760.0, 475.17, 768.0]},
    {"id": "p70-b26", "type": "paragraph", "text": "Mục Nội dung", "bbox": [661.82, 219.38, 729.71, 227.38]},
    {
      "id": "p70-b27",
      "type": "paragraph",
      "text": "Công ty có đặt ra giới hạn tối đa năm vị trí HĐQT mà một\nD.2.6 thành viên HĐQT độc lập/không điều hành có thể nắm giữ\nđồng thời tại những cty khác không?",
      "bbox": [661.43, 247.72, 909.91, 279.72]
    },
    {
      "id": "p70-b28",
      "type": "paragraph",
      "text": "Công ty có thành viên HĐQT điều hành nào phục vụ tại hơn 2\nD.2.7\nHĐQT của các công ty niêm yết ngoài tập đoàn?",
      "bbox": [661.68, 293.62, 909.91, 313.62]
    },
    {"id": "p70-b29", "type": "paragraph", "text": "Ủy ban Bổ nhiệm", "bbox": [694.49, 327.52, 759.28, 335.52]},
    {"id": "p70-b30", "type": "paragraph", "text": "D.2.8 Công ty có Ủy ban Bổ nhiệm không?", "bbox": [661.46, 367.42, 824.19, 375.42]},
    {"id": "p70-b31", "type": "paragraph", "text": "Ủy ban Bổ nhiệm có bao gồm đa số thành viên HĐQT độc\nD.2.9\nlập?", "bbox": [661.66, 413.32, 909.9, 433.32]},
    {"id": "p70-b32", "type": "paragraph", "text": "D.2.10 Chủ tịch của Ủy ban Bổ nhiệm có phải là thành viên độc lập?", "bbox": [660.12, 459.22, 908.41, 467.22]},
    {
      "id": "p70-b33",
      "type": "paragraph",
      "text": "Công ty có công bố quy chế hoạt động/ cơ cấu quản trị/ điều\nD.2.11\nlệ của Ủy ban Bổ nhiệm?",
      "bbox": [661.23, 487.12, 909.89, 507.12]
    },
    {
      "id": "p70-b34",
      "type": "paragraph",
      "text": "Sự tham gia của thành viên trong các cuộc họp của Ủy ban\nD.2.12 Bổ nhiệm có được công bố công khai, nếu có, Ủy ban Bổ\nnhiệm có họp tối thiểu hai lần trong năm ?",
      "bbox": [660.59, 551.02, 909.89, 583.02]
    },
    {"id": "p70-b35", "type": "paragraph", "text": "Ủy ban Thù lao/Lương thưởng", "bbox": [694.49, 626.92, 809.84, 634.92]},
    {"id": "p70-b36", "type": "paragraph", "text": "D.2.13 Công ty có Ủy ban Thù lao/Lương thưởng không?", "bbox": [660.56, 678.83, 869.37, 686.83]},
    {
      "id": "p70-b37",
      "type": "paragraph",
      "text": "Ủy ban Thù lao/Lương thưởng có bao gồm đa số thành viên\nD.2.14\nHĐQT độc lập?",
      "bbox": [660.33, 736.73, 909.91, 756.73]
    },
    {"id": "p70-b38", "type": "paragraph", "text": "135", "bbox": [1163.63, 23.28, 1177.84, 32.28]},
    {"id": "p70-b39", "type": "furniture", "text": "I Ớ\nƯ\nL\nG\nN\nẠ\nM", "bbox": [1168.86, 48.42, 1176.86, 91.78]},
    {"id": "p70-b40", "type": "paragraph", "text": "O H\nÁ N\nC Í H\nO C\nÁ I À\nB T", "bbox": [1163.36, 128.85, 1182.36, 165.83]},
    {"id": "p70-b41", "type": "paragraph", "text": "Ị R Y\nT T", "bbox": [1163.53, 206.44, 1182.53, 217.87]},
    {"id": "p70-b42", "type": "paragraph", "text": "Kết quả", "bbox": [924.77, 213.38, 954.6, 221.38]},
    {"id": "p70-b43", "type": "heading", "text": "N G", "bbox": [1163.53, 217.98, 1182.53, 225.41]},
    {"id": "p70-b44", "type": "paragraph", "text": "Cơ sở đánh giá", "bbox": [969.45, 219.38, 1026.66, 227.38]},
    {"id": "p70-b45", "type": "heading", "text": "Ả N", "bbox": [1163.53, 224.28, 1182.53, 230.86]},
    {"id": "p70-b46", "type": "paragraph", "text": "đánh giá", "bbox": [922.84, 225.38, 956.51, 233.38]},
    {"id": "p70-b47", "type": "paragraph", "text": "U Ô\nQ C", "bbox": [1163.53, 230.04, 1182.53, 242.55]},
    {"id": "p70-b48", "type": "paragraph", "text": "Quy định tại Điều lệ, Quy chế quản trị nội bộ\nNgân hàng", "bbox": [969.45, 253.72, 1128.18, 273.72]},
    {"id": "p70-b49", "type": "paragraph", "text": "A\nỦ\nC", "bbox": [1163.36, 283.25, 1171.36, 299.4]},
    {"id": "p70-b50", "type": "paragraph", "text": "Ngân hàng không phát sinh trường hợp này.", "bbox": [969.45, 299.62, 1125.63, 307.62]},
    {"id": "p70-b51", "type": "paragraph", "text": "Á H\nN\nI G\nÀ\nH H\nN U\nÁ Ề\nĐ I Đ\nO\nN\nÁ A", "bbox": [1163.36, 300.34, 1182.36, 353.8]},
    {"id": "p70-b52", "type": "paragraph", "text": "BIDV hiện nay có Ủy ban Nhân sự có chức", "bbox": [969.45, 349.42, 1128.17, 357.42]},
    {"id": "p70-b53", "type": "paragraph", "text": "C\nB\nO", "bbox": [1163.36, 351.65, 1182.36, 365.86]},
    {"id": "p70-b54", "type": "paragraph", "text": "năng nhiệm vụ tham mưu tư vấn, giúp việc", "bbox": [969.45, 361.42, 1128.19, 369.42]},
    {"id": "p70-b55", "type": "paragraph", "text": "Á\nB", "bbox": [1163.36, 365.58, 1171.36, 375.7]},
    {
      "id": "p70-b56",
      "type": "paragraph",
      "text": "HĐQT đối với công tác nhân sự tại BIDV\ntrong đó có công tác bổ nhiệm cán bộ.",
      "bbox": [969.45, 373.42, 1128.17, 393.42]
    },
    {"id": "p70-b57", "type": "paragraph", "text": "Số lượng Ủy viên HĐQT độc lập tại BIDV 01", "bbox": [969.45, 407.32, 1128.17, 415.32]},
    {"id": "p70-b58", "type": "heading", "text": "Ị R", "bbox": [1174.36, 418.18, 1182.36, 424.71]},
    {"id": "p70-b59", "type": "paragraph", "text": "người và hiện là thành viên của Ủy ban Nhân", "bbox": [969.45, 419.32, 1128.19, 427.32]},
    {"id": "p70-b60", "type": "paragraph", "text": "T\nA N", "bbox": [1163.36, 424.71, 1182.36, 436.38]},
    {"id": "p70-b61", "type": "paragraph", "text": "sự.", "bbox": [969.45, 431.32, 980.27, 439.32]},
    {"id": "p70-b62", "type": "paragraph", "text": "Ủ Ả\nC U\nÁ Q\nI", "bbox": [1163.36, 434.11, 1182.36, 454.13]},
    {"id": "p70-b63", "type": "paragraph", "text": "Chủ tịch Ủy ban Nhân sự tại BIDV không phải", "bbox": [969.45, 453.22, 1128.18, 461.22]},
    {"id": "p70-b64", "type": "heading", "text": "G G", "bbox": [1163.36, 454.13, 1182.36, 461.35]},
    {"id": "p70-b65", "type": "paragraph", "text": "X", "bbox": [937.14, 459.22, 942.23, 467.22]},
    {"id": "p70-b66", "type": "paragraph", "text": "N\nH", "bbox": [1163.36, 461.35, 1182.36, 467.78]},
    {"id": "p70-b67", "type": "paragraph", "text": "là thành viên độc lập.", "bbox": [969.45, 465.22, 1044.54, 473.22]},
    {"id": "p70-b68", "type": "paragraph", "text": "N Ồ\nÁ Đ\nĐ I\nỘ\nH", "bbox": [1163.36, 466.95, 1182.36, 494.87]},
    {"id": "p70-b69", "type": "paragraph", "text": "Thể hiện tại Báo cáo thường niên.", "bbox": [969.45, 493.12, 1088.45, 501.12]},
    {
      "id": "p70-b70",
      "type": "paragraph",
      "text": "Có xin ý kiến đối với các thành viên Ủy ban\nNhân sự khi có công việc phát sinh; hoặc\ncác thành viên Ủy Ban nhân sự có tham gia",
      "bbox": [969.45, 521.02, 1128.17, 553.02]
    },
    {"id": "p70-b71", "type": "paragraph", "text": "G H\nN N\nỘ A", "bbox": [1163.36, 545.83, 1182.36, 565.05]},
    {"id": "p70-b72", "type": "paragraph", "text": "chung cuộc họp với các Thành viên HĐQT,", "bbox": [969.45, 557.02, 1128.18, 565.02]},
    {"id": "p70-b73", "type": "paragraph", "text": "O\nĐ\nD", "bbox": [1163.36, 562.02, 1182.36, 574.18]},
    {"id": "p70-b74", "type": "paragraph", "text": "Ban Điều hành tùy theo nội dung cuộc họp;", "bbox": [969.45, 569.02, 1128.18, 577.02]},
    {"id": "p70-b75", "type": "paragraph", "text": "T\nẠ H", "bbox": [1163.36, 572.47, 1182.36, 581.52]},
    {"id": "p70-b76", "type": "paragraph", "text": "không có lịch cố định họp Ủy ban Nhân sự", "bbox": [969.45, 581.02, 1128.17, 589.02]},
    {"id": "p70-b77", "type": "paragraph", "text": "O N\nH I K", "bbox": [1163.36, 581.11, 1182.36, 593.96]},
    {
      "id": "p70-b78",
      "type": "paragraph",
      "text": "mà được bố trí tùy theo nội dung phát sinh\nvà có thông báo họp từng lần.",
      "bbox": [969.45, 593.02, 1128.18, 613.02]
    },
    {"id": "p70-b79", "type": "paragraph", "text": "N", "bbox": [1163.36, 648.48, 1171.36, 654.08]},
    {"id": "p70-b80", "type": "paragraph", "text": "BIDV có Ủy ban Nhân sự với chức năng tham", "bbox": [969.45, 648.83, 1128.17, 656.83]},
    {"id": "p70-b81", "type": "paragraph", "text": "A 5\nU 2", "bbox": [1163.36, 653.38, 1182.36, 664.38]},
    {"id": "p70-b82", "type": "paragraph", "text": "mưu, tư vấn, giúp việc HĐQT trong việc thực", "bbox": [969.45, 660.83, 1128.18, 668.83]},
    {"id": "p70-b83", "type": "paragraph", "text": "Q 0\n2\nG V", "bbox": [1163.36, 662.04, 1182.36, 679.05]},
    {"id": "p70-b84", "type": "paragraph", "text": "hiện nhiệm vụ, quyền hạn của HĐQT về các", "bbox": [969.45, 672.83, 1128.18, 680.83]},
    {"id": "p70-b85", "type": "paragraph", "text": "N D\nỔ I B", "bbox": [1163.36, 677.97, 1182.36, 691.2]},
    {"id": "p70-b86", "type": "paragraph", "text": "vấn đề liên quan đến công tác quản trị, phát", "bbox": [969.45, 684.83, 1128.17, 692.83]},
    {"id": "p70-b87", "type": "paragraph", "text": "T", "bbox": [1163.36, 690.88, 1171.36, 695.13]},
    {"id": "p70-b88", "type": "paragraph", "text": "triển nguồn nhân lực, nhân sự, tiền thưởng,\nthù lao.", "bbox": [969.45, 696.83, 1128.19, 716.83]},
    {"id": "p70-b89", "type": "paragraph", "text": "Số lượng Ủy viên HĐQT độc lập tại BIDV 01", "bbox": [969.45, 730.73, 1128.17, 738.73]},
    {"id": "p70-b90", "type": "paragraph", "text": "5\n2\n0", "bbox": [1168.86, 733.26, 1176.86, 747.1]},
    {"id": "p70-b91", "type": "paragraph", "text": "người và hiện là thành viên của Ủy ban Nhân", "bbox": [969.45, 742.73, 1128.19, 750.73]},
    {"id": "p70-b92", "type": "paragraph", "text": "2\nP", "bbox": [1168.86, 747.1, 1176.86, 757.61]},
    {"id": "p70-b93", "type": "paragraph", "text": "sự.", "bbox": [969.45, 754.73, 980.27, 762.73]},
    {"id": "p70-b94", "type": "paragraph", "text": "Ệ\nI Đ", "bbox": [1168.86, 757.61, 1176.86, 769.36]},
    {"id": "p70-b95", "type": "paragraph", "text": "Mục Nội dung", "bbox": [66.54, 219.38, 134.44, 227.38]},
    {"id": "p70-b96", "type": "paragraph", "text": "D.1.3\nvà công bố rõ ràng?", "bbox": [67.39, 253.72, 169.1, 267.72]},
    {"id": "p70-b97", "type": "paragraph", "text": "Tầm nhìn/sứ mệnh của Công ty", "bbox": [99.21, 281.62, 218.7, 289.62]},
    {"id": "p70-b98", "type": "paragraph", "text": "D.1.4\nnhật", "bbox": [67.32, 309.52, 115.3, 323.52]},
    {"id": "p70-b99", "type": "paragraph", "text": "D.1.5", "bbox": [67.27, 355.42, 82.96, 363.42]},
    {"id": "p70-b100", "type": "paragraph", "text": "D.1.6\nviệc thực hiện chiến lược của Công ty?", "bbox": [67.3, 401.32, 244.43, 415.32]},
    {"id": "p70-b101", "type": "paragraph", "text": "D.2 Cơ cấu HĐQT", "bbox": [68.24, 429.22, 150.47, 437.22]},
    {"id": "p70-b102", "type": "paragraph", "text": "Bộ Quy tắc Đạo đức hoặc Ứng xử", "bbox": [99.21, 451.12, 225.36, 459.12]},
    {"id": "p70-b103", "type": "paragraph", "text": "D.2.1\ncông bố công khai?", "bbox": [67.42, 479.02, 177.39, 493.02]},
    {"id": "p70-b104", "type": "paragraph", "text": "D.2.2\ncấp cao và nhân viên phải tuân thủ bộ quy tắc?", "bbox": [66.28, 512.92, 266.05, 526.92]},
