    {"id": "p83-b99", "type": "paragraph", "text": "Tiền và các khoản tương đương tiền đầu năm", "bbox": [657.64, 625.93, 832.55, 633.93]},
    {"id": "p83-b100", "type": "paragraph", "text": "Tiền và các khoản tương đương tiền cuối năm", "bbox": [657.64, 645.78, 834.51, 653.78]},
    {
      "id": "p83-b101",
      "type": "paragraph",
      "text": "(Toàn văn Báo cáo tài chính năm 2025 đã được kiểm toán của BIDV được đăng tải tại địa chỉ",
