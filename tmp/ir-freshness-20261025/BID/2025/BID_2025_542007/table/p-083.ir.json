    {"id": "p83-b130", "type": "paragraph", "text": "Tại ngày 31 tháng 12 năm 2025", "bbox": [56.69, 77.19, 190.41, 87.19]},
    {"id": "p83-b131", "type": "paragraph", "text": "Thu nhập lãi và các khoản thu nhập tương tự nhận được", "bbox": [62.36, 207.67, 260.34, 215.67]},
    {"id": "p83-b132", "type": "paragraph", "text": "Chi phí lãi và các chi phí tương tự đã trả", "bbox": [62.36, 227.77, 202.98, 235.77]},
    {"id": "p83-b133", "type": "paragraph", "text": "Thu nhập từ hoạt động dịch vụ nhận được", "bbox": [62.36, 247.86, 211.52, 255.86]},
    {"id": "p83-b134", "type": "paragraph", "text": "Chi hoạt động khác", "bbox": [62.36, 288.06, 132.29, 296.06]},
    {"id": "p83-b135", "type": "paragraph", "text": "rủi ro", "bbox": [62.36, 319.22, 81.02, 327.22]},
    {"id": "p83-b136", "type": "paragraph", "text": "Tiền chi trả cho nhân viên và hoạt động quản lý, công vụ", "bbox": [62.36, 337.38, 261.71, 345.38]},
    {"id": "p83-b137", "type": "paragraph", "text": "Tiền thuế thu nhập doanh nghiệp thực nộp trong năm", "bbox": [62.36, 357.35, 253.79, 365.35]},
    {"id": "p83-b138", "type": "paragraph", "text": "đổi về tài sản và vốn lưu động", "bbox": [62.36, 388.39, 176.37, 396.39]},
    {"id": "p83-b139", "type": "paragraph", "text": "Những thay đổi về tài sản hoạt động", "bbox": [62.36, 406.43, 202.13, 414.43]},
    {"id": "p83-b140", "type": "paragraph", "text": "(Tăng) các khoản tiền, vàng gửi và cho vay các TCTD khác", "bbox": [62.36, 426.27, 268.07, 434.27]},
    {"id": "p83-b141", "type": "paragraph", "text": "(Tăng) các khoản về kinh doanh chứng khoán", "bbox": [62.36, 446.11, 223.44, 454.11]},
    {"id": "p83-b142", "type": "paragraph", "text": "(Tăng) các khoản cho vay khách hàng", "bbox": [62.36, 485.8, 196.16, 493.8]},
    {"id": "p83-b143", "type": "paragraph", "text": "doanh nghiệp và tất toán trái phiếu đặc biệt", "bbox": [62.36, 520.83, 218.65, 528.83]},
    {"id": "p83-b144", "type": "paragraph", "text": "(Tăng) khác về tài sản hoạt động", "bbox": [62.36, 538.87, 177.97, 546.87]},
    {"id": "p83-b145", "type": "paragraph", "text": "Những thay đổi về công nợ hoạt động", "bbox": [62.36, 558.71, 207.9, 566.71]},
    {"id": "p83-b146", "type": "paragraph", "text": "Tăng các khoản nợ Chính phủ và NHNN", "bbox": [62.36, 578.56, 202.28, 586.56]},
    {"id": "p83-b147", "type": "paragraph", "text": "Tăng các khoản tiền gửi, tiền vay các TCTD khác", "bbox": [62.36, 598.4, 233.59, 606.4]},
    {"id": "p83-b148", "type": "paragraph", "text": "Tăng tiền gửi của khách hàng (bao gồm cả KBNN)", "bbox": [62.36, 618.24, 239.04, 626.24]},
    {"id": "p83-b149", "type": "paragraph", "text": "Tăng phát hành giấy tờ có giá (ngoại trừ giấy tờ", "bbox": [62.36, 638.08, 230.18, 646.08]},
    {"id": "p83-b150", "type": "paragraph", "text": "có giá phát hành được tính vào hoạt động tài chính)", "bbox": [62.36, 657.93, 246.26, 665.93]},
