    {"id": "p72-b8", "type": "heading", "text": "TÀI SẢN NGẮN HẠN", "bbox": [121.68, 110.11, 198.55, 118.11]},
    {"id": "p72-b9", "type": "paragraph", "text": "Tiền và các khoản tương đương tiền", "bbox": [122.34, 134.73, 261.5, 142.73]},
    {"id": "p72-b10", "type": "paragraph", "text": "Các khoản tương đương tiền", "bbox": [122.35, 159.95, 232.13, 167.95]},
    {"id": "p72-b11", "type": "paragraph", "text": "Đầu tư tài chính ngắn hạn", "bbox": [122.34, 179.11, 222.22, 187.11]},
    {"id": "p72-b12", "type": "paragraph", "text": "Đầu tư nắm giữ đến ngày đáo hạn", "bbox": [122.34, 192.57, 253.3, 200.57]},
    {"id": "p72-b13", "type": "paragraph", "text": "Các khoản phải thu ngắn hạn", "bbox": [122.21, 208.79, 235.16, 216.79]},
    {
      "id": "p72-b14",
      "type": "paragraph",
      "text": "Phải thu ngắn hạn của khách hàng\nTrả trước cho người bán ngắn hạn\nPhải thu ngắn hạn khác\nDự phòng phải thu ngắn hạn khó đòi",
      "bbox": [122.34, 223.51, 263.56, 270.51]
    },
    {"id": "p72-b15", "type": "paragraph", "text": "Hàng tồn kho\nHàng tồn kho", "bbox": [122.34, 282.74, 174.2, 303.74]},
    {
      "id": "p72-b16",
      "type": "paragraph",
      "text": "Tài sản ngắn hạn khác\nChi phí trả trước ngắn hạn\nThuế GTGT được khấu trừ\nThuế và các khoản khác phải thu Nhà nước",
      "bbox": [123.72, 312.35, 291.56, 359.35]
    },
    {"id": "p72-b17", "type": "heading", "text": "TÀI SẢN DÀI HẠN", "bbox": [122.61, 376.91, 190.13, 384.91]},
    {
      "id": "p72-b18",
      "type": "paragraph",
      "text": "Các khoản phải thu dài hạn\nPhải thu dài hạn khác\nTài sản cố định\nTài sản cố định hữu hình\nNguyên giá\nGiá trị khấu hao lũy kế\nTài sản cố định vô hình\nNguyên giá\nGiá trị hao mòn lũy kế\nTài sản dở dang dài hạn\nChi phí sản xuất, kinh doanh dở dang\nChi phí xây dựng cơ bản dở dang\nĐầu tư tài chính dài hạn\nĐầu tư vào công ty liên kết\nĐầu tư nắm giữ đến ngày đáo hạn\nTài sản dài hạn khác\nChi phí trả trước dài hạn\nTài sản thuế thu nhập hoãn lại\nLợi thế thương mại",
      "bbox": [122.02, 402.07, 266.03, 644.08]
    },
