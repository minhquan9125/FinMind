    {"id": "p65-b1", "type": "heading", "text": "BẢNG CÂN ĐỐI KẾ TOÁN RIÊNG", "bbox": [190.95, 78.67, 404.31, 92.67]},
    {"id": "p65-b2", "type": "paragraph", "text": "Ngày 31 tháng 3 năm 2025", "bbox": [232.23, 94.58, 363.04, 104.58]},
    {"id": "p65-b3", "type": "paragraph", "text": "TM", "bbox": [298.85, 124.38, 313.95, 134.38]},
    {"id": "p65-b4", "type": "paragraph", "text": "Số cuối năm", "bbox": [358.18, 124.38, 418.27, 134.38]},
    {"id": "p65-b5", "type": "paragraph", "text": "Đơn vị tính: VND", "bbox": [470.78, 108.38, 534.41, 116.38]},
    {"id": "p65-b6", "type": "paragraph", "text": "Số đầu năm", "bbox": [471.42, 124.38, 528.83, 134.38]},
    {"id": "p65-b7", "type": "heading", "text": "TÀI SẢN", "bbox": [152.56, 124.93, 192.22, 134.93]},
    {"id": "p65-b8", "type": "heading", "text": "TÀI SẢN NGẮN HẠN", "bbox": [123.91, 153.06, 200.78, 161.06]},
    {"id": "p65-b9", "type": "paragraph", "text": "Đầu tư tài chính ngắn hạn", "bbox": [124.57, 203.84, 224.45, 211.84]},
    {"id": "p65-b10", "type": "paragraph", "text": "Đầu tư nắm giữ đến ngày đáo hạn", "bbox": [124.57, 217.52, 255.53, 225.52]},
    {"id": "p65-b11", "type": "paragraph", "text": "Các khoản phải thu ngắn hạn", "bbox": [124.44, 233.75, 237.39, 241.75]},
    {
      "id": "p65-b12",
      "type": "paragraph",
      "text": "Phải thu ngắn hạn của khách hàng\nTrả trước cho người bán ngắn hạn\nPhải thu về cho vay ngắn hạn\nPhải thu ngắn hạn khác\nDự phòng phải thu ngắn hạn khó đòi",
      "bbox": [124.56, 248.46, 265.78, 308.46]
    },
    {
      "id": "p65-b13",
      "type": "paragraph",
      "text": "Tài sản ngắn hạn khác\nChi phí trả trước ngắn hạn\nThuế giá trị gia tăng được khấu trừ",
      "bbox": [124.56, 319.69, 259.68, 353.69]
    },
    {"id": "p65-b14", "type": "heading", "text": "TÀI SẢN DÀI HẠN", "bbox": [124.84, 374.86, 192.36, 382.86]},
    {"id": "p65-b15", "type": "paragraph", "text": "Các khoản phải thu dài hạn\nPhải thu dài hạn khác", "bbox": [124.57, 400.02, 230.29, 421.02]},
    {
      "id": "p65-b16",
      "type": "paragraph",
      "text": "Tài sản cố định\nTài sản cố định hữu hình\nNguyên giá\nGiá trị khấu hao lũy kế\nTài sản cố định vô hình\nNguyên giá\nGiá trị hao mòn lũy kế",
      "bbox": [124.56, 439.02, 220.56, 525.02]
    },
    {"id": "p65-b17", "type": "paragraph", "text": "Tài sản dở dang dài hạn\nChi phí xây dựng cơ bản dở dang", "bbox": [124.56, 543.02, 251.75, 564.02]},
    {
      "id": "p65-b18",
      "type": "paragraph",
      "text": "Đầu tư tài chính dài hạn\nĐầu tư vào công ty con\nĐầu tư vào công ty liên kết\nDự phòng đầu tư tài chính dài hạn",
      "bbox": [124.56, 582.02, 256.62, 629.02]
    },
    {"id": "p65-b19", "type": "paragraph", "text": "Tài sản dài hạn khác\nChi phí trả trước dài hạn", "bbox": [124.57, 647.02, 218.8, 668.02]},
