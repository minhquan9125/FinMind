    {"id": "p74-b21", "type": "paragraph", "text": "15. Tổng lợi nhuận kế toán trước thuế", "bbox": [82.99, 350.51, 249.26, 358.51]},
    {"id": "p74-b22", "type": "paragraph", "text": "16. Chi phí thuế TNDN hiện hành", "bbox": [82.99, 366.51, 229.85, 374.51]},
