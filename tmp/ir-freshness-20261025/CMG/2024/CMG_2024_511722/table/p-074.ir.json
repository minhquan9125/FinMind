      "type": "paragraph",
      "text": "BÁO CÁO KẾT QUẢ HOẠT ĐỘNG KINH DOANH HỢP NHẤT\nCho năm tài chính kết thúc ngày 31 tháng 3 năm 2025",
      "bbox": [107.12, 33.49, 493.22, 59.41]
    },
    {"id": "p74-b2", "type": "paragraph", "text": "TM\nNăm nay", "bbox": [333.73, 83.21, 434.99, 93.21]},
    {"id": "p74-b3", "type": "paragraph", "text": "Đơn vị tính: VND", "bbox": [477.18, 67.2, 540.81, 75.2]},
    {"id": "p74-b4", "type": "paragraph", "text": "Năm trước", "bbox": [488.06, 83.21, 538.99, 93.21]},
    {"id": "p74-b5", "type": "heading", "text": "CHỈ TIÊU", "bbox": [150.11, 83.75, 192.91, 93.75]},
    {"id": "p74-b6", "type": "paragraph", "text": "Doanh thu bán hàng và cung cấp dịch vụ", "bbox": [118.68, 110.51, 274.83, 118.51]},
    {"id": "p74-b7", "type": "paragraph", "text": "Các khoản giảm trừ doanh thu", "bbox": [118.68, 126.51, 234.65, 134.51]},
    {"id": "p74-b8", "type": "paragraph", "text": "Doanh thu thuần về bán hàng và cung cấp dịch vụ", "bbox": [118.68, 142.51, 310.44, 150.51]},
    {"id": "p74-b9", "type": "paragraph", "text": "Giá vốn hàng bán và dịch vụ cung cấp", "bbox": [118.68, 158.51, 264.16, 166.51]},
    {"id": "p74-b10", "type": "paragraph", "text": "Lợi nhuận gộp về bán hàng và cung cấp dịch vụ", "bbox": [118.68, 174.51, 301.39, 182.51]},
    {"id": "p74-b11", "type": "paragraph", "text": "Doanh thu hoạt động tài chính", "bbox": [118.68, 190.51, 235.32, 198.51]},
    {"id": "p74-b12", "type": "paragraph", "text": "Chi phí tài chính", "bbox": [118.68, 206.51, 181.55, 214.51]},
    {"id": "p74-b13", "type": "paragraph", "text": "Trong đó: Chi phí lãi vay", "bbox": [117.17, 222.51, 208.7, 230.51]},
    {"id": "p74-b14", "type": "paragraph", "text": "Phần lãi trong công ty liên kết", "bbox": [118.07, 238.51, 234.02, 246.51]},
    {"id": "p74-b15", "type": "paragraph", "text": "Chi phí bán hàng", "bbox": [118.68, 254.51, 183.32, 262.51]},
    {"id": "p74-b16", "type": "paragraph", "text": "10. Chi phí quản lý doanh nghiệp", "bbox": [82.99, 270.51, 230.57, 278.51]},
    {"id": "p74-b17", "type": "paragraph", "text": "11. Lợi nhuận thuần từ hoạt động kinh doanh", "bbox": [82.99, 286.51, 277.66, 294.51]},
    {"id": "p74-b18", "type": "paragraph", "text": "12. Thu nhập khác", "bbox": [82.99, 302.51, 174.99, 310.51]},
