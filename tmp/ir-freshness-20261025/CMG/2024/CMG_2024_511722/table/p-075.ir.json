  "blocks": [
    {"id": "p75-b1", "type": "heading", "text": "BÁO CÁO LƯU CHUYỂN TIỀN TỆ HỢP NHẤT", "bbox": [157.16, 33.49, 450.22, 47.49]},
    {"id": "p75-b2", "type": "paragraph", "text": "Cho năm tài chính kết thúc ngày 31 tháng 3 năm 2025", "bbox": [171.94, 49.41, 435.4, 59.41]},
    {"id": "p75-b3", "type": "paragraph", "text": "TM\nNăm nay", "bbox": [337.48, 79.21, 438.15, 89.21]},
    {"id": "p75-b4", "type": "paragraph", "text": "Đơn vị tính: VND", "bbox": [479.93, 63.2, 543.56, 71.2]},
    {"id": "p75-b5", "type": "heading", "text": "CHỈ TIÊU", "bbox": [153.64, 79.76, 196.44, 89.76]},
    {"id": "p75-b6", "type": "heading", "text": "LƯU CHUYỂN TIỀN TỪ HOẠT ĐỘNG KINH DOANH", "bbox": [93.0, 101.86, 282.93, 109.86]},
    {"id": "p75-b7", "type": "paragraph", "text": "Lợi nhuận trước thuế", "bbox": [93.01, 118.71, 174.03, 126.71]},
    {
      "id": "p75-b8",
      "type": "paragraph",
      "text": "Điều chỉnh cho các khoản:\nChi phí tiền thuê đất phân bổ, khấu hao tài sản cố\nđịnh hữu hình và hao mòn tài sản cố định vô hình\n(bao gồm phân bổ lợi thế thương mại)\nCác khoản trích lập dự phòng\nLãi chênh lệch tỷ giá hối đoái do đánh giá lại các\nkhoản mục tiền tệ có gốc ngoại tệ\nLãi từ hoạt động đầu tư\nChi phí lãi vay",
      "bbox": [56.66, 135.98, 285.94, 247.98]
    },
    {"id": "p75-b9", "type": "paragraph", "text": "Lợi nhuận từ hoạt động kinh doanh\ntrước thay đổi vốn lưu động", "bbox": [91.7, 257.54, 228.83, 278.54]},
    {
      "id": "p75-b10",
      "type": "paragraph",
      "text": "(Tăng)/giảm các khoản phải thu\n(Tăng)/giảm hàng tồn kho\nTăng/(giảm) các khoản phải trả\nTăng chi phí trả trước\nTiền lãi vay đã trả\nThuế thu nhập doanh nghiệp đã nộp\nTiền chi khác cho hoạt động kinh doanh",
      "bbox": [92.66, 284.93, 248.23, 370.93]
    },
    {"id": "p75-b11", "type": "paragraph", "text": "Lưu chuyển tiền thuần từ hoạt động kinh doanh", "bbox": [93.01, 380.09, 277.04, 388.09]},
    {"id": "p75-b12", "type": "heading", "text": "LƯU CHUYỂN TIỀN TỪ HOẠT ĐỘNG ĐẦU TƯ", "bbox": [92.99, 395.96, 261.81, 403.96]},
    {
      "id": "p75-b13",
      "type": "paragraph",
      "text": "Tiền chi để mua sắm, xây dựng tài sản cố định (TSCĐ) và\ncác tài sản dài hạn khác\nTiền chi cho vay, mua các công cụ nợ của đơn vị khác\nTiền thu hồi cho vay, bán lại công cụ nợ của đơn vị khác\nTiền thu hồi đầu tư góp vốn vào đơn vị khác\nTiền thu lãi cho vay, cổ tức và lợi nhuận được chia",
      "bbox": [92.67, 410.35, 314.52, 483.35]
    },
    {"id": "p75-b14", "type": "paragraph", "text": "Lưu chuyển tiền thuần sử dụng vào hoạt động đầu tư", "bbox": [93.4, 496.07, 298.29, 504.07]},
    {
      "id": "p75-b15",
      "type": "paragraph",
      "text": "LƯU CHUYỂN TIỀN TỪ HOẠT ĐỘNG TÀI CHÍNH\nTiền thu từ phát hành cổ phiếu, nhận vốn góp của chủ sở hữu\nTiền mua lại cổ phiếu đã phát hành\nTiền thu từ đi vay\nTiền trả nợ gốc vay\nCổ tức, lợi nhuận đã trả cho chủ sở hữu và cổ đông\nkhông kiểm soát",
      "bbox": [92.67, 512.04, 331.3, 596.12]
    },
    {"id": "p75-b16", "type": "paragraph", "text": "Lưu chuyển tiền thuần từ/(sử dụng vào) hoạt động tài chính", "bbox": [93.01, 610.03, 325.18, 618.03]},
    {"id": "p75-b17", "type": "paragraph", "text": "Lưu chuyển tiền thuần trong năm", "bbox": [93.01, 624.04, 221.83, 632.04]},
    {"id": "p75-b18", "type": "paragraph", "text": "Tiền và tương đương tiền đầu năm", "bbox": [93.01, 638.05, 225.85, 646.05]},
    {"id": "p75-b19", "type": "paragraph", "text": "Ảnh hưởng của thay đổi tỷ giá hối đoái quy đổi ngoại tệ", "bbox": [93.0, 652.06, 307.87, 660.06]},
    {"id": "p75-b20", "type": "paragraph", "text": "Tiền và tương đương tiền cuối năm", "bbox": [93.01, 665.74, 228.16, 673.74]},
    {"id": "p75-b21", "type": "paragraph", "text": "Kế toán trưởng", "bbox": [93.63, 688.16, 151.42, 696.16]},
    {"id": "p75-b22", "type": "paragraph", "text": "Giám đốc Tài chính", "bbox": [242.34, 688.08, 317.27, 696.08]},
