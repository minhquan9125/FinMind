  "blocks": [
    {"id": "p28-b1", "type": "paragraph", "text": "Quản trị công ty năm 2024", "bbox": [40.7, 25.6, 241.02, 41.56]},
    {"id": "p28-b2", "type": "paragraph", "text": "Thành viên HĐQT", "bbox": [64.03, 59.57, 181.12, 73.61]},
    {
      "id": "p28-b3",
      "type": "paragraph",
      "text": "ITD có 5 thành viên HĐQT (nhiệm kỳ 2024-2028, bao gồm 1 thành viên độc lập). Trước\nkỳ Đại hội cổ đông năm 2024, ITD có 8 thành viên HĐQT. Tại Đại hội 2024, công ty đã\nbầu lại thành viên HĐQT và duy trì 05 thành viên đến thời điểm hiện nay.",
      "bbox": [67.75, 87.68, 534.15, 128.52]
    },
    {"id": "p28-b4", "type": "paragraph", "text": "Thành viên HĐQT", "bbox": [87.55, 151.24, 179.81, 162.28]},
    {"id": "p28-b5", "type": "paragraph", "text": "1 Ông Mai Hoài An", "bbox": [33.19, 200.04, 154.28, 212.04]},
    {"id": "p28-b6", "type": "paragraph", "text": "2 Ông Nguyễn Hữu Dũng", "bbox": [33.19, 251.4, 189.83, 263.4]},
    {"id": "p28-b7", "type": "paragraph", "text": "4 Ông Nguyễn Ngọc Trung", "bbox": [33.19, 297.58, 196.31, 309.58]},
    {"id": "p28-b8", "type": "paragraph", "text": "3 Ông Nguyễn Vĩnh Thuận", "bbox": [33.19, 357.19, 196.2, 369.19]},
    {"id": "p28-b9", "type": "paragraph", "text": "5 Ông Đinh Thế Hiển", "bbox": [33.19, 414.82, 166.03, 426.82]},
    {"id": "p28-b10", "type": "paragraph", "text": "Chủ tịch HĐQT", "bbox": [86.42, 693.48, 181.36, 707.52]},
    {"id": "p28-b11", "type": "paragraph", "text": "Chức vụ", "bbox": [250.27, 151.24, 294.92, 162.28]},
    {"id": "p28-b12", "type": "paragraph", "text": "Chủ tịch HĐQT", "bbox": [231.91, 200.04, 313.17, 212.04]},
    {"id": "p28-b13", "type": "paragraph", "text": "Phó chủ tịch HĐQT", "bbox": [220.87, 251.4, 324.09, 263.4]},
    {"id": "p28-b14", "type": "paragraph", "text": "Phó chủ tịch HĐQT", "bbox": [220.87, 297.58, 324.09, 309.58]},
    {"id": "p28-b15", "type": "paragraph", "text": "TV HĐQT kiêm\nTổng Giám đốc", "bbox": [231.55, 349.99, 313.55, 376.39]},
    {"id": "p28-b16", "type": "paragraph", "text": "Thành viên\nđộc lập", "bbox": [242.95, 407.62, 302.07, 434.02]},
    {
      "id": "p28-b17",
      "type": "paragraph",
      "text": "Với nhiều kinh nghiệm trong lĩnh vực công nghệ\nthông tin và thị trường quốc tế, ông tham gia vào\nHĐQT ITD từ năm 2023, ông định hướng chiến lược\ncho các hoạt động kinh doanh, quản trị rủi ro, và công\nnghệ nhằm phát triển ITD trở thành công ty công\nnghệ hàng đầu tại Việt Nam.",
      "bbox": [268.25, 526.13, 554.48, 610.15]
    },
    {
      "id": "p28-b18",
      "type": "paragraph",
      "text": "Hiện Ông An là chủ tịch hội đồng quản trị của công ty\nIMT Solution, chủ tịch HĐQT của Công ty cổ phần\nđầu tư giải pháp công nghệ Tiên Phong và là ủy viên\nban chấp hành Hội tin học Thành phố Hồ Chí Minh",
      "bbox": [268.25, 618.55, 554.4, 673.75]
    },
    {
      "id": "p28-b19",
      "type": "paragraph",
      "text": "Ông tốt nghiệp Thạc sĩ Quản trị kinh doanh (MBA) và\nThạc sĩ Kỹ thuật",
      "bbox": [268.25, 682.15, 554.23, 712.51]
    },
