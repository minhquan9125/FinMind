    {"id": "p105-b28", "type": "paragraph", "text": "Hợp đồng khung nên không", "bbox": [404.45, 332.63, 507.63, 340.63]},
    {"id": "p105-b29", "type": "paragraph", "text": "26/12/2024", "bbox": [314.05, 337.03, 355.44, 345.03]},
    {"id": "p105-b30", "type": "paragraph", "text": "có số lượng, giá trị giao dịch\ncụ thể.", "bbox": [404.45, 341.43, 509.52, 358.23]},
    {
