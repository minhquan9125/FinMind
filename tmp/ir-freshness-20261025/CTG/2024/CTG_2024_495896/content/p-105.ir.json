    },
    {"id": "p105-b19", "type": "paragraph", "text": "2. Số lượng giao dịch: 1.", "bbox": [404.46, 259.69, 490.51, 267.88]},
    {"id": "p105-b20", "type": "paragraph", "text": "25/12/2024", "bbox": [314.06, 268.49, 355.6, 276.49]},
    {"id": "p105-b21", "type": "paragraph", "text": "3. Giá trị giao dịch: Phí bảo\nhiểm là 19.993.974.000 đồng.", "bbox": [404.46, 268.49, 506.33, 285.29]},
    {"id": "p105-b22", "type": "paragraph", "text": "Thông qua hợp đồng khung\nmua bán hàng hóa giữa", "bbox": [404.45, 297.43, 508.2, 314.23]},
    {"id": "p105-b23", "type": "paragraph", "text": "Nghị quyết số 502/", "bbox": [314.05, 310.63, 384.95, 318.63]},
    {"id": "p105-b24", "type": "paragraph", "text": "VietinBank và VietinBank Gold", "bbox": [404.45, 315.03, 515.33, 323.03]},
    {"id": "p105-b25", "type": "paragraph", "text": "NQ-HĐQT-NHCT-\nChưa thực hiện", "bbox": [251.12, 319.43, 381.71, 331.83]},
