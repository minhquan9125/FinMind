  "blocks": [
    {"id": "p99-b1", "type": "heading", "text": "PHƯƠNG HƯỚNG, ĐỊNH HƯỚNG HOẠT ĐỘNG CỦA HĐQT TRONG NĂM 2025", "bbox": [96.09, 148.63, 442.03, 158.63]},
    {
      "id": "p99-b2",
      "type": "paragraph",
      "text": "Với định hướng chiến lược phát triển rõ ràng, trong năm 2025 và các năm tiếp theo, HĐQT VietinBank",
      "bbox": [96.09, 172.46, 558.14, 182.46]
    },
    {
      "id": "p99-b3",
      "type": "paragraph",
      "text": "Tiếp tục đổi mới công tác quản trị, đẩy\nmạnh trao quyền, phân quyền và đánh giá\nhiệu quả công việc",
      "bbox": [238.81, 243.39, 477.16, 283.4]
    },
    {
      "id": "p99-b4",
      "type": "paragraph",
      "text": "Tăng cường hoạt động của các Ủy\nban trực thuộc HĐQT trong việc tham\nmưu, giám sát cho HĐQT các lĩnh vực\nphụ trách",
      "bbox": [312.21, 349.0, 521.41, 403.01]
    },
    {
      "id": "p99-b5",
      "type": "paragraph",
      "text": "Tiếp tục tham gia các khóa đào tạo\nvề quản trị công ty để nâng cao\nnăng lực và vận dụng vào thực tiễn",
      "bbox": [337.5, 469.48, 535.25, 509.49]
    },
    {
      "id": "p99-b6",
      "type": "paragraph",
      "text": "Tăng cường áp dụng công nghệ vào các\nquy trình quản trị nội bộ để tiết kiệm\nnguồn lực, nâng cao năng lực quản trị",
      "bbox": [308.25, 588.96, 532.19, 628.97]
    },
    {
      "id": "p99-b7",
      "type": "paragraph",
      "text": "Tiếp tục kiện toàn công tác kiểm tra\ngiám sát theo hướng hiện đại, hiệu quả",
      "bbox": [231.52, 693.15, 460.21, 719.15]
    },
    {"id": "p99-b8", "type": "paragraph", "text": "PHẦN 5 QUẢN TRỊ CÔNG TY", "bbox": [75.89, 23.46, 180.08, 31.46]},
