    {"id": "p123-b51", "type": "heading", "text": "18. TIỀN GỬI CỦA KHÁCH HÀNG", "bbox": [687.39, 112.73, 863.19, 122.69]},
    {"id": "p123-b52", "type": "paragraph", "text": "18.1 Thuyết minh theo loại hình tiền gửi", "bbox": [687.39, 135.78, 889.64, 145.74]},
    {
      "id": "p123-b53",
      "type": "paragraph",
      "text": "Tiền gửi không kỳ hạn\nTiền gửi không kỳ hạn bằng VND\nTiền gửi không kỳ hạn bằng ngoại tệ",
      "bbox": [723.04, 190.48, 885.16, 226.94]
    },
    {
      "id": "p123-b54",
      "type": "paragraph",
      "text": "Tiền gửi có kỳ hạn\nTiền gửi có kỳ hạn bằng VND\nTiền gửi có kỳ hạn bằng ngoại tệ",
      "bbox": [723.04, 235.0, 868.5, 272.69]
    },
    {
      "id": "p123-b55",
      "type": "paragraph",
      "text": "Tiền gửi ký quỹ\nTiền gửi ký quỹ bằng VND\nTiền gửi ký quỹ bằng ngoại tệ",
      "bbox": [723.04, 280.75, 854.71, 318.77]
    },
    {"id": "p123-b56", "type": "paragraph", "text": "Lãi suất năm của các khoản tiền gửi tại thời điểm cuối năm như sau:", "bbox": [722.8, 351.77, 1026.59, 361.73]},
    {"id": "p123-b57", "type": "paragraph", "text": "Tiền gửi không kỳ hạn\nBằng VND\nBằng ngoại tệ", "bbox": [723.4, 394.27, 829.95, 429.65]},
    {"id": "p123-b58", "type": "paragraph", "text": "Tiền gửi có kỳ hạn\nBằng VND\nBằng ngoại tệ", "bbox": [723.4, 437.73, 811.63, 473.23]},
    {"id": "p123-b59", "type": "paragraph", "text": "18.2 Thuyết minh theo đối tượng khách hàng, loại hình doanh nghiệp", "bbox": [687.4, 486.82, 1029.34, 496.78]},
    {"id": "p123-b60", "type": "paragraph", "text": "Tiền gửi của các tổ chức kinh tế", "bbox": [723.4, 541.77, 876.67, 551.73]},
    {
      "id": "p123-b61",
      "type": "paragraph",
      "text": "Công ty trách nhiệm hữu hạn Nhà nước\nCông ty trách nhiệm hữu hạn khác\nCông ty cổ phần có vốn cổ phần\ncủa Nhà nước\nCông ty cổ phần khác\nDoanh nghiệp tư nhân và công ty hợp danh\nDoanh nghiệp có vốn đầu tư nước ngoài\nHợp tác xã và liên hiệp hợp tác xã\nĐơn vị hành chính sự nghiệp, Đảng,\nđoàn thể và hiệp hội\nKhác",
      "bbox": [723.4, 558.79, 916.61, 683.74]
    },
    {"id": "p123-b62", "type": "paragraph", "text": "Tiền gửi của cá nhân", "bbox": [723.4, 693.24, 823.29, 703.2]},
