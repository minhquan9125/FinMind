    {"id": "p101-b23", "type": "paragraph", "text": "BÁO CÁO KẾT QUẢ HOẠT ĐỘNG HỢP NHẤT\ncho năm tài chính kết thúc ngày 31 tháng 12 năm 2024", "bbox": null},
    {"id": "p101-b24", "type": "paragraph", "text": "31/12/2024", "bbox": [973.15, 135.26, 1023.08, 145.22]},
    {"id": "p101-b25", "type": "paragraph", "text": "31/12/2023", "bbox": [1070.26, 135.26, 1120.19, 145.22]},
    {"id": "p101-b26", "type": "paragraph", "text": "triệu đồng", "bbox": [978.67, 147.26, 1023.04, 157.22]},
    {"id": "p101-b27", "type": "paragraph", "text": "triệu đồng", "bbox": [1075.78, 147.26, 1120.15, 157.22]},
    {"id": "p101-b28", "type": "paragraph", "text": "Thu nhập lãi và các khoản thu nhập tương tự\nChi phí lãi và các chi phí tương tự", "bbox": null},
    {"id": "p101-b29", "type": "paragraph", "text": "Thu nhập lãi thuần", "bbox": null},
    {"id": "p101-b30", "type": "paragraph", "text": "Thu nhập từ hoạt động dịch vụ\nChi phí hoạt động dịch vụ", "bbox": null},
    {"id": "p101-b31", "type": "paragraph", "text": "Lãi thuần từ hoạt động dịch vụ", "bbox": null},
    {"id": "p101-b32", "type": "paragraph", "text": "Lãi thuần từ hoạt động kinh doanh ngoại hối", "bbox": null},
    {"id": "p101-b33", "type": "paragraph", "text": "Lãi thuần từ mua bán chứng khoán kinh doanh", "bbox": null},
    {"id": "p101-b34", "type": "paragraph", "text": "Lãi thuần từ mua bán chứng khoán đầu tư", "bbox": null},
    {"id": "p101-b35", "type": "paragraph", "text": "Thu nhập từ hoạt động khác\nChi phí hoạt động khác", "bbox": null},
    {"id": "p101-b36", "type": "paragraph", "text": "Lãi thuần từ hoạt động khác", "bbox": null},
    {"id": "p101-b37", "type": "paragraph", "text": "Thu nhập từ góp vốn, mua cổ phần", "bbox": null},
    {"id": "p101-b38", "type": "paragraph", "text": "Tổng thu nhập hoạt động", "bbox": null},
    {"id": "p101-b39", "type": "paragraph", "text": "Chi phí hoạt động", "bbox": null},
    {"id": "p101-b40", "type": "paragraph", "text": "Lợi nhuận thuần từ hoạt động kinh doanh\ntrước chi phí dự phòng rủi ro tín dụng", "bbox": null},
    {"id": "p101-b41", "type": "paragraph", "text": "Chi phí dự phòng rủi ro tín dụng", "bbox": null},
    {"id": "p101-b42", "type": "paragraph", "text": "Tổng lợi nhuận trước thuế", "bbox": null},
    {"id": "p101-b43", "type": "paragraph", "text": "Chi phí thuế thu nhập doanh nghiệp hiện hành\nThu nhập thuế thu nhập doanh nghiệp hoãn lại", "bbox": null},
    {"id": "p101-b44", "type": "paragraph", "text": "Chi phí thuế thu nhập doanh nghiệp hiện hành", "bbox": null},
    {"id": "p101-b45", "type": "paragraph", "text": "Người phê duyệt:", "bbox": [980.71, 521.11, 1058.39, 531.07]},
    {"id": "p101-b46", "type": "paragraph", "text": "Lợi nhuận sau thuế", "bbox": null},
    {"id": "p101-b47", "type": "paragraph", "text": "Lợi ích cổ đông không kiểm soát", "bbox": null},
    {"id": "p101-b48", "type": "paragraph", "text": "Lợi nhuận thuần của cổ đông của Ngân hàng", "bbox": null},
    {"id": "p101-b49", "type": "paragraph", "text": "Lãi cơ bản trên cổ phiếu (đồng/cổ phiếu) (*)", "bbox": null},
    {"id": "p101-b50", "type": "paragraph", "text": "Ông Jens Lottner\nTổng Giám đốc", "bbox": [980.35, 605.23, 1056.95, 626.74]},
