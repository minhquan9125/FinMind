  "blocks": [
    {"id": "p12-b1", "type": "heading", "text": "VỀ CHÚNG TÔI", "bbox": [96.3, 110.34, 324.85, 144.34]},
    {
      "id": "p12-b2",
      "type": "paragraph",
      "text": "Ngân hàng hoạt động theo Giấy phép hoạt động Ngân hàng số 0038/GP-NHNN do Ngân hàng Nhà nước Việt Nam cấp ngày\n06/03/2018 (cấp đổi lại cho Giấy phép hoạt động số 0040/NH-GP ngày 06/08/1993)",
      "bbox": [53.86, 256.57, 544.07, 276.37]
    },
    {"id": "p12-b3", "type": "heading", "text": "CƠ CẤU VÀ TỶ LỆ SỞ HỮU CỦA TECHCOMBANK TẠI CÁC CÔNG TY CON (31/12/2024)", "bbox": [53.86, 541.07, 408.9, 550.07]},
    {"id": "p12-b4", "type": "paragraph", "text": "Về chúng tôi", "bbox": [167.17, 29.15, 209.46, 36.15]},
    {"id": "p12-b5", "type": "heading", "text": "NGÂN HÀNG THƯƠNG MẠI CỔ PHẦN KỸ THƯƠNG VIỆT NAM", "bbox": [226.06, 194.11, 473.22, 203.11]},
    {"id": "p12-b6", "type": "heading", "text": "VIETNAM TECHNOLOGICAL AND COMMERCIAL JOINT-STOCK BANK", "bbox": [226.06, 209.72, 502.16, 218.72]},
    {"id": "p12-b7", "type": "paragraph", "text": "TECHCOMBANK", "bbox": [226.06, 225.34, 292.42, 234.34]},
    {"id": "p12-b8", "type": "paragraph", "text": "TECHCOMBANK", "bbox": [226.06, 240.95, 292.42, 249.95]},
    {"id": "p12-b9", "type": "paragraph", "text": "07 tháng 09 năm 1993", "bbox": [226.06, 314.21, 314.48, 323.21]},
    {"id": "p12-b10", "type": "paragraph", "text": "03 tháng 01 năm 2024", "bbox": [226.06, 329.82, 315.0, 338.82]},
    {"id": "p12-b11", "type": "heading", "text": "VND 70,648,517,390,000", "bbox": [226.24, 361.44, 329.65, 370.44]},
    {
      "id": "p12-b12",
      "type": "paragraph",
      "text": "Bảy mươi nghìn sáu trăm bốn mươi tám tỷ, năm trăm mười bảy triệu, ba trăm\nchín mươi nghìn đồng chẵn.",
      "bbox": [226.06, 376.66, 522.29, 396.46]
    },
    {
      "id": "p12-b13",
      "type": "paragraph",
      "text": "Tòa nhà Techcombank – 06 Quang Trung, phường Trần Hưng Đạo, quận Hoàn Kiếm,\nHà Nội, Việt Nam.",
      "bbox": [226.06, 436.2, 558.54, 456.0]
    },
    {"id": "p12-b14", "type": "paragraph", "text": "(+84) (243) 944 6368", "bbox": [226.06, 462.61, 308.27, 471.61]},
    {"id": "p12-b15", "type": "paragraph", "text": "(+84) (243) 944 6395", "bbox": [226.06, 478.22, 308.35, 487.22]},
    {"id": "p12-b16", "type": "paragraph", "text": "https://techcombank.com", "bbox": [226.06, 493.84, 325.47, 502.84]},
    {"id": "p12-b17", "type": "paragraph", "text": "TCB", "bbox": [226.06, 509.45, 242.69, 518.45]},
    {"id": "p12-b18", "type": "paragraph", "text": "TECHCOMBANK", "bbox": [269.1, 585.22, 337.52, 594.22]},
    {
      "id": "p12-b19",
      "type": "paragraph",
      "text": "Techcombank mang\nsứ mệnh dẫn dắt hành trình\nsố hóa của ngành tài chính,\ntạo động lực cho mỗi\ncá nhân, doanh nghiệp và\ntổ chức phát triển bền vững\nvà bứt phá thành công.”",
      "bbox": [629.29, 404.38, 799.24, 526.38]
    },
    {"id": "p12-b20", "type": "paragraph", "text": "Dịch vụ ngân hàng", "bbox": [637.79, 629.67, 714.14, 638.67]},
    {
      "id": "p12-b21",
      "type": "paragraph",
      "text": "Techcombank được thành lập từ năm 1993 khi Việt Nam bắt đầu\nchuyển dịch từ nền kinh tế tập trung sang định hướng thị trường.\nLớn mạnh từng ngày trong 31 năm qua với số vốn điều lệ khởi điểm chỉ\n20 tỷ đồng, Techcombank hôm nay đã trở thành ngân hàng lớn thứ hai\nvề vốn điều lệ – một thành công được chúng tôi ươm mầm từ chiến lược\ntập trung giải quyết nhu cầu luôn thay đổi của khách hàng.",
      "bbox": [859.92, 364.73, 1141.9, 427.73]
    },
    {
      "id": "p12-b22",
      "type": "paragraph",
      "text": "Tới thời điểm hiện tại, Techcombank đã cung cấp nhiều loại sản phẩm và\ndịch vụ đa dạng cho hơn 15,4 triệu khách hàng cá nhân và doanh nghiệp\ntại Việt Nam, thông qua mạng lưới rộng khắp gồm một trụ sở chính,\nhai văn phòng đại diện và 299 điểm giao dịch tại 46 tỉnh thành trên\ncả nước, không chỉ đáp ứng nhu cầu giao dịch ngân hàng thông thường\nmà còn đảm bảo nhu cầu bảo mật và quản lý tài sản cho khách hàng.",
      "bbox": [859.92, 440.32, 1145.16, 503.32]
    },
    {
      "id": "p12-b23",
      "type": "paragraph",
      "text": "Xác định tầm nhìn “Chuyển đổi ngành tài chính, Nâng tầm giá trị sống”,\nTechcombank cam kết không ngừng mang tới những giá trị lớn hơn cho\nkhách hàng và cổ đông, đáp ứng nhu cầu thay đổi mỗi ngày bằng cách\ntập trung vào các giải pháp tiên phong, trở thành đối tác tài chính tin cậy\ncủa mọi khách hàng. Techcombank mang sứ mệnh dẫn lối hành trình\nchuyển đổi số của ngành tài chính, mở đường cho các cá nhân, doanh\nnghiệp và tổ chức vững bước trên hành trình phát triển bền vững,\nbứt phá thành công.",
      "bbox": [859.92, 515.92, 1143.42, 600.52]
    },
    {"id": "p12-b24", "type": "heading", "text": "1", "bbox": [955.04, 637.74, 966.75, 675.74]},
