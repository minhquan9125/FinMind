  "blocks": [
    {"id": "p64-b1", "type": "paragraph", "text": "Các Nghị quyết HĐQT ban hành trong năm 2024 – Xin ý kiến bằng văn bản", "bbox": [45.35, 73.51, 351.88, 82.51]},
    {
      "id": "p64-b2",
      "type": "paragraph",
      "text": "176 Số 0788/2024/NQ-HĐQT-TCB 29/11/2024 Miễn nhiệm và bổ nhiệm Giám đốc Chi nhánh thuộc Khối Ngân hàng Bán lẻ (RBG).",
      "bbox": [48.98, 153.76, 531.98, 161.76]
    },
    {
      "id": "p64-b3",
      "type": "paragraph",
      "text": "178 Số 0799/2024/Số-HĐQT-TCB 06/12/2024 người có liên quan của ông Nguyễn Đăng Quang – Phó Chủ tịch thứ nhất Hội đồng",
      "bbox": [49.02, 242.3, 535.27, 250.3]
    },
    {
      "id": "p64-b4",
      "type": "paragraph",
      "text": "179 Số 0806/2024/NQ-HĐQT-TCB 10/12/2024 với Công ty Cổ phần Chứng khoán Kỹ thương (TCBS) là người có liên quan với",
      "bbox": [48.98, 296.16, 515.62, 304.16]
    },
    {
      "id": "p64-b5",
      "type": "paragraph",
      "text": "184 Số 0819/2024/NQ-HĐQT-TCB 21/12/2024 khoán Kỹ thương (TCBS) là người có liên quan với Techcombank về cung cấp các dịch",
      "bbox": [48.84, 527.1, 543.55, 535.1]
    },
    {
      "id": "p64-b6",
      "type": "paragraph",
      "text": "185 Số 0827/2024/NQ-HĐQT-TCB 25/12/2024 Miễn nhiệm và bổ nhiệm Giám đốc Chi nhánh thuộc Khối Ngân hàng Bán lẻ (RBG).",
      "bbox": [48.72, 571.36, 531.98, 579.36]
    },
    {
      "id": "p64-b7",
      "type": "paragraph",
      "text": "186 Số 0832/2024/NQ-HĐQT-TCB 27/12/2024 Techcombank và công ty con giữa niên độ kết thúc ngày 30 tháng 6 và cho năm tài",
      "bbox": [48.71, 615.63, 535.15, 623.63]
    },
    {"id": "p64-b8", "type": "paragraph", "text": "Quản trị doanh nghiệp", "bbox": [206.93, 29.15, 282.76, 36.15]},
    {"id": "p64-b9", "type": "paragraph", "text": "Ngày ban hành", "bbox": [182.98, 111.76, 231.08, 118.76]},
    {"id": "p64-b10", "type": "paragraph", "text": "Nội dung chính", "bbox": [375.0, 111.76, 423.21, 118.76]},
    {
      "id": "p64-b11",
      "type": "paragraph",
      "text": "Phê duyệt giao dịch cấp hạn mức thẻ tín dụng giữa Techcombank và Khách hàng là\nngười có liên quan của ông Phùng Quang Hưng – Phó Tổng giám đốc Techcombank.",
      "bbox": [245.33, 188.43, 541.69, 206.03]
    },
    {
      "id": "p64-b12",
      "type": "paragraph",
      "text": "Phê duyệt giao dịch cấp hạn mức thẻ tín dụng giữa Techcombank và Khách hàng là",
      "bbox": [245.33, 232.7, 535.59, 240.7]
    },
    {"id": "p64-b13", "type": "paragraph", "text": "quản trị Techcombank.", "bbox": [245.33, 251.9, 324.57, 259.9]},
    {
      "id": "p64-b14",
      "type": "paragraph",
      "text": "Thông qua việc phê duyệt giao dịch ngoại tệ và phái sinh lãi suất giữa Techcombank",
      "bbox": [245.33, 286.56, 539.83, 294.56]
    },
    {"id": "p64-b15", "type": "paragraph", "text": "Techcombank.", "bbox": [245.33, 305.76, 296.02, 313.76]},
    {
      "id": "p64-b16",
      "type": "paragraph",
      "text": "Phê duyệt điều chỉnh ngày hiệu lực của Nghị quyết Hội đồng quản trị về miễn nhiệm và\nbổ nhiệm Giám đốc Chi nhánh Khối Ngân hàng Bán lẻ (RBG).",
      "bbox": [245.33, 340.43, 549.41, 358.03]
    },
    {
      "id": "p64-b17",
      "type": "paragraph",
      "text": "Ban hành thay thế Quy chế tổ chức và hoạt động của Hội Tín dụng Cao cấp số\n0018/2017/QC ngày 17/6/2017 và các văn bản, sửa đổi bổ sung.",
      "bbox": [245.33, 384.7, 519.29, 402.3]
    },
    {
      "id": "p64-b18",
      "type": "paragraph",
      "text": "Ban hành thay thế Quy định về hoạt động phê duyệt nghiệp vụ đối với Tổ chức tín dụng\nsố 0092/2018/QĐ1 ngày 29/12/2018 và các văn bản, sửa đổi bổ sung.",
      "bbox": [245.33, 428.96, 551.3, 446.56]
    },
    {
      "id": "p64-b19",
      "type": "paragraph",
      "text": "Phê duyệt Phương án phát hành riêng lẻ Trái phiếu Techcombank năm 2024 – Lần 17 –\ntối đa 450 tỷ VNĐ.",
      "bbox": [245.33, 473.23, 548.74, 490.83]
    },
    {
      "id": "p64-b20",
      "type": "paragraph",
      "text": "Thông qua việc phê duyệt giao dịch giữa Techcombank và Công ty Cổ phần Chứng",
      "bbox": [245.33, 517.5, 535.54, 525.5]
    },
    {
      "id": "p64-b21",
      "type": "paragraph",
      "text": "vụ liên quan đến phát hành riêng lẻ trái phiếu Techcombank năm 2024 – Lần 17.",
      "bbox": [245.33, 536.69, 524.34, 544.69]
    },
    {
      "id": "p64-b22",
      "type": "paragraph",
      "text": "Phê duyệt lựa chọn đối tác cung cấp dịch vụ kiểm toán báo cáo tài chính cho",
      "bbox": [245.33, 606.03, 513.19, 614.03]
    },
    {
      "id": "p64-b23",
      "type": "paragraph",
      "text": "chính kết thúc ngày 31 tháng 12 năm 2025 và các dịch vụ kiểm toán liên quan.",
      "bbox": [245.33, 625.23, 516.87, 633.23]
    },
    {
      "id": "p64-b24",
      "type": "paragraph",
      "text": "Cơ cấu thành phần HĐQT và các Ủy ban/Hội đồng do HĐQT thành lập – trực thuộc cấp Quản trị",
      "bbox": [629.29, 73.51, 1017.64, 82.51]
    },
