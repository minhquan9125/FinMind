      "text": "nhận 7 giải thưởng từ tổ chức VISA\n- số lượng giải nhiều nhất từng\nđược trao cho một ngân hàng.",
      "bbox": [343.56, 513.27, 447.98, 537.07]
    },
    {"id": "p15-b49", "type": "paragraph", "text": "2022", "bbox": [324.53, 569.78, 346.31, 578.78]},
    {
